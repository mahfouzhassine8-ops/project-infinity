+    // Fill Screen is geometry-only. It allocates every safe pixel to an active tile;
+    // video proportionality/crop is handled separately by cobraFitBinding().
+    static int[] rect(int index,int count,int width,int height,int enlarged,boolean fillScreen){
+      if(!fillScreen)return rect(index,count,width,height,enlarged);
+      if(count<1||count>4||index<0||index>=count||width<=0||height<=0)return new int[]{0,0,0,0};
+      if(count==1)return new int[]{0,0,width,height};
+      final boolean portrait=height>width;
+      if(enlarged>=0&&enlarged<count){
+        int rank=index<enlarged?index:index-1,small=count-1;
+        if(portrait){
+          int largeH=Math.max(1,Math.min(height-1,Math.round(height*.68f)));
+          if(index==enlarged)return new int[]{0,0,width,largeH};
+          int x=width*rank/small,right=width*(rank+1)/small;
+          return new int[]{x,largeH,right-x,height-largeH};
+        }
+        int largeW=Math.max(1,Math.min(width-1,Math.round(width*.72f)));
+        if(index==enlarged)return new int[]{0,0,largeW,height};
+        int y=height*rank/small,bottom=height*(rank+1)/small;
+        return new int[]{largeW,y,width-largeW,bottom-y};
+      }
+      if(count==2){
+        if(portrait){int y=height*index/2,bottom=height*(index+1)/2;return new int[]{0,y,width,bottom-y};}
+        int x=width*index/2,right=width*(index+1)/2;return new int[]{x,0,right-x,height};
+      }
+      if(count==3){
+        if(portrait){
+          int largeH=Math.max(1,Math.min(height-1,Math.round(height*.60f)));
+          if(index==0)return new int[]{0,0,width,largeH};
+          int rank=index-1,x=width*rank/2,right=width*(rank+1)/2;
+          return new int[]{x,largeH,right-x,height-largeH};
+        }
+        int largeW=Math.max(1,Math.min(width-1,Math.round(width*.60f)));
+        if(index==0)return new int[]{0,0,largeW,height};
+        int rank=index-1,y=height*rank/2,bottom=height*(rank+1)/2;
+        return new int[]{largeW,y,width-largeW,bottom-y};
+      }
+      int col=index%2,row=index/2,x=width*col/2,y=height*row/2;
+      int right=width*(col+1)/2,bottom=height*(row+1)/2;
+      return new int[]{x,y,right-x,bottom-y};
+    }
+  }
