// Host-only, synthetic peers. No file in the production tree includes this unit.
#include "InfinityCheckpointXml.h"
#include <algorithm>
#include <filesystem>
#include <fstream>
#include <functional>
#include <iostream>
#include <map>
#include <memory>
#include <mutex>
#include <set>
#include <stdexcept>
#include <string>
#include <vector>

namespace fs = std::filesystem;
#define CHECK(x) do { if (!(x)) throw std::runtime_error(std::string("assertion line ")+std::to_string(__LINE__)+": " #x); } while(false)
namespace Fault {
inline int failFileSync=0, failDirectorySyncAt=0, fileSyncs=0, directorySyncs=0;
inline bool failOrdinaryOpen=false;
inline void reset(){failFileSync=failDirectorySyncAt=fileSyncs=directorySyncs=0;failOrdinaryOpen=false;}
}
extern "C" int __real_fsync(int);
extern "C" int __wrap_fsync(int fd) {
  struct stat st{};
  if(::fstat(fd,&st)!=0)return -1;
  if(S_ISDIR(st.st_mode)) {
    ++Fault::directorySyncs;
    if(Fault::failDirectorySyncAt==Fault::directorySyncs){errno=EIO;return -1;}
  } else {
    ++Fault::fileSyncs;
    if(Fault::failFileSync>0){--Fault::failFileSync;errno=EIO;return -1;}
  }
  return __real_fsync(fd);
}
namespace InfinityAndroidCheckpoint {
bool persist=false, admit=true;
std::vector<std::string> failures;
bool IsActive(){return persist;}
bool IsPersistingOnThisThread(){return persist;}
void RecordPersistenceFailure(const char* owner,const char* detail){failures.emplace_back(std::string(owner)+":"+detail);}
CheckpointWriteGuard::CheckpointWriteGuard(const char*):m_admitted(admit){}
CheckpointWriteGuard::~CheckpointWriteGuard()=default;
}
struct TiXmlPrinter {
  std::string bytes;
  const char* CStr()const{return bytes.c_str();}
  size_t Size()const{return bytes.size();}
};
struct CXBMCTinyXML {
  std::string bytes;
  bool serialize=true;
  bool Accept(TiXmlPrinter* p)const{p->bytes=bytes;return serialize;}
  bool SaveFile(const std::string&)const;
};
namespace XFILE {
struct CFile {
  int fd=-1;
  ~CFile(){if(fd>=0)::close(fd);}
  bool OpenForWrite(const std::string& path,bool) {
    if(Fault::failOrdinaryOpen){errno=EACCES;return false;}
    fd=::open(path.c_str(),O_WRONLY|O_CREAT|O_TRUNC|O_CLOEXEC,0600);return fd>=0;
  }
  ssize_t Write(const char* bytes,size_t size){return ::write(fd,bytes,size);}
  // A normal flush is not the coordinator's verified file+directory checkpoint.
  void Flush(){(void)__real_fsync(fd);}
  static bool Exists(const std::string& p){return fs::exists(p);}
};
struct CDirectory {
  static bool Exists(const std::string& p){return fs::is_directory(p);}
  static bool Create(const std::string& p){return fs::create_directories(p);}
};
}
using XFILE::CFile;
using XFILE::CDirectory;
struct URIUtils {
  static std::string GetDirectory(const std::string& p){return p.substr(0,p.rfind('/')+1);}
  static std::string GetParentPath(std::string p){while(p.size()>1&&p.back()=='/')p.pop_back();return fs::path(p).parent_path().string()+"/";}
};
namespace ADDON {
struct CAddonSettings {
  std::string bytes;
  bool loaded=true,serializable=true;
  bool IsLoaded()const{return loaded;}
  bool Save(CXBMCTinyXML& doc)const{doc.bytes=bytes;return serializable;}
  const void* GetSettingsManager()const{return this;}
};
}
