  <include name="InfinityFavouritesList">
    <param name="left" />
    <param name="top" />
    <param name="width" />
    <param name="height" />
    <param name="row" />
    <param name="labelwidth" />
    <param name="right" />
    <param name="icontop" default="7" />
    <definition>
      <control type="list" id="450">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>$PARAM[height]</height>
        <onup>450</onup>
        <ondown>450</ondown>
        <onleft>450</onleft>
        <onright>$PARAM[right]</onright>
        <pagecontrol>61</pagecontrol>
        <scrolltime>180</scrolltime>
        <itemlayout width="$PARAM[width]" height="$PARAM[row]">
          <control type="image">
            <left>12</left>
            <top>$PARAM[icontop]</top>
            <width>60</width>
            <height>60</height>
            <aspectratio>keep</aspectratio>
            <texture fallback="DefaultFolder.png">$VAR[InfinityContentItemIcon]</texture>
          </control>
          <control type="label">
            <left>92</left>
            <width>$PARAM[labelwidth]</width>
            <height>$PARAM[row]</height>
            <font>font13</font>
            <aligny>center</aligny>
            <textcolor>$VAR[InfinityDiggzPrimaryText]</textcolor>
            <label>$INFO[ListItem.Label]</label>
          </control>
        </itemlayout>
        <focusedlayout width="$PARAM[width]" height="$PARAM[row]">
          <control type="image">
            <width>$PARAM[width]</width>
            <height>$PARAM[row]</height>
            <texture colordiffuse="$VAR[InfinityPaletteSurfaceElevated]">infinity_ui/contract_white.png</texture>
            <visible>Control.HasFocus(450)</visible>
          </control>
          <control type="image">
            <width>4</width>
            <height>$PARAM[row]</height>
            <texture colordiffuse="$VAR[InfinityPaletteFocus]">infinity_ui/contract_white.png</texture>
            <visible>Control.HasFocus(450)</visible>
          </control>
          <control type="image">
            <left>12</left>
            <top>$PARAM[icontop]</top>
            <width>60</width>
            <height>60</height>
            <aspectratio>keep</aspectratio>
            <texture fallback="DefaultFolder.png">$VAR[InfinityContentItemIcon]</texture>
          </control>
          <control type="label">
            <left>92</left>
            <width>$PARAM[labelwidth]</width>
            <height>$PARAM[row]</height>
            <font>font13</font>
            <aligny>center</aligny>
            <textcolor>$VAR[InfinityDiggzPrimaryText]</textcolor>
            <scroll>true</scroll>
            <label>$INFO[ListItem.Label]</label>
          </control>
        </focusedlayout>
      </control>
    </definition>
