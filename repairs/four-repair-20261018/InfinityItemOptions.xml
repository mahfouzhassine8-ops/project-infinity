<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol always="true">50</defaultcontrol>
  <controls>
    <control type="button" id="2">
      <left>0</left><top>0</top><width>100%</width><height>100%</height><label/>
      <texturefocus colordiffuse="55000000">infinity_ui/contract_white.png</texturefocus>
      <texturenofocus colordiffuse="55000000">infinity_ui/contract_white.png</texturenofocus>
    </control>
    <control type="group" id="100">
      <left>160</left><top>300</top><width>760</width><height>690</height>
      <control type="image">
        <left>0</left><top>0</top><width>100%</width><height>100%</height>
        <texture border="24" colordiffuse="$VAR[InfinityUIRepairSurface]">infinity_glass/surface.png</texture>
        <bordertexture border="24" colordiffuse="$VAR[InfinityLegacyBorder]">infinity_glass/rim.png</bordertexture><bordersize>2</bordersize>
      </control>
      <control type="label"><left>24</left><top>18</top><right>100</right><height>68</height>
        <font>InfinityBodyBold</font><textcolor>$VAR[InfinityLegacyText]</textcolor>
        <label>$INFO[Window.Property(Infinity.UI.Title)]</label><scroll>true</scroll><aligny>center</aligny>
      </control>
      <control type="button" id="9"><right>18</right><top>18</top><width>64</width><height>64</height><label/>
        <texturefocus colordiffuse="$VAR[InfinityLegacyAccent]">infinity_legacy/close_focus.png</texturefocus>
        <texturenofocus colordiffuse="$VAR[InfinityLegacyText]">infinity_legacy/close.png</texturenofocus>
        <onleft>50</onleft><onright>50</onright><onup>50</onup><ondown>50</ondown>
      </control>
      <control type="list" id="50"><left>18</left><right>18</right><top>98</top><bottom>18</bottom>
        <orientation>vertical</orientation><scrolltime>120</scrolltime><onleft>9</onleft><onright>9</onright>
        <itemlayout width="724" height="78">
          <control type="image"><left>0</left><top>0</top><width>100%</width><height>72</height>
            <texture border="12" colordiffuse="$VAR[InfinityLegacyField]">infinity_glass/field.png</texture>
          </control>
          <control type="label"><left>24</left><right>24</right><top>0</top><height>72</height>
            <font>InfinityBody</font><textcolor>$VAR[InfinityLegacyText]</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label]</label><scroll>true</scroll>
          </control>
        </itemlayout>
        <focusedlayout width="724" height="78">
          <control type="image"><left>0</left><top>0</top><width>100%</width><height>72</height>
            <texture border="16" colordiffuse="$VAR[InfinityLegacyAccent]">infinity_glass/focus.png</texture>
          </control>
          <control type="label"><left>24</left><right>24</right><top>0</top><height>72</height>
            <font>InfinityBody</font><textcolor>$VAR[InfinityLegacyText]</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label]</label><scroll>true</scroll>
          </control>
        </focusedlayout>
      </control>
    </control>
  </controls>
</window>
