@@ -0,0 +1,26 @@
+package @APP_PACKAGE@;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.Set;
+
+/** Team choices extend the existing follow list without migrating or deleting it. */
+final class CobraSportsPreferences {
+  static final String FAVORITES="cobra_sports_priority_teams", PINS="cobra_sports_pinned_teams";
+  static final String FOLLOWS="cobra_sports_favorite_teams", HIDE="cobra_sports_hide_scores";
+  static final String TICKER="cobra_sports_score_ticker", REVEALS="cobra_sports_revealed_games";
+  final SharedPreferences prefs;
+  CobraSportsPreferences(Context context){prefs=context.getSharedPreferences("infinity_cobra_live",Context.MODE_PRIVATE);}
+  Set<String> set(String key){return new HashSet<>(prefs.getStringSet(key,Collections.emptySet()));}
+  CobraSportsPreferences(SharedPreferences preferences){prefs=preferences;}
+  int rank(String team){if(team==null)return 3;return set(FAVORITES).contains(team)?0:set(PINS).contains(team)?1:set(FOLLOWS).contains(team)?2:3;}
+  boolean automatic(String away,String home){return Math.min(rank(away),rank(home))<2;}
+  Set<String> automaticTeams(){Set<String> teams=set(FAVORITES);teams.addAll(set(PINS));return teams;}
+  Set<String> myTeams(){Set<String> teams=automaticTeams();teams.addAll(set(FOLLOWS));return teams;}
+  void toggle(String key,String team){Set<String> teams=set(key);if(!teams.add(team))teams.remove(team);prefs.edit().putStringSet(key,teams).apply();}
+  boolean hidden(String game){return prefs.getBoolean(HIDE,false)&&!set(REVEALS).contains(game);}
+  void protection(boolean enabled){prefs.edit().putBoolean(HIDE,enabled).remove(REVEALS).apply();}
+  void reveal(String game){Set<String> games=set(REVEALS);games.add(game);prefs.edit().putStringSet(REVEALS,games).apply();}
+}
