+import java.util.Set;
+import java.util.HashSet;
+
+/** Refreshes opted-in team schedules without opening a player or starting Kodi. */
+public final class CobraSportsReminderJob extends JobService {
+  static final int JOB=331201;
+  private volatile int generation;
+  private volatile boolean stopped;
+  private volatile Thread worker;
+  private volatile HttpURLConnection connection;
+  static void schedule(Context context){
+    JobScheduler scheduler=(JobScheduler)context.getSystemService(Context.JOB_SCHEDULER_SERVICE);
+    if(scheduler==null)return;
+    if(leagues(context).isEmpty()){scheduler.cancel(JOB);return;}
+    for(JobInfo job:scheduler.getAllPendingJobs())if(job.getId()==JOB)return;
+    scheduler.schedule(new JobInfo.Builder(JOB,new ComponentName(context,CobraSportsReminderJob.class))
+        .setRequiredNetworkType(JobInfo.NETWORK_TYPE_ANY).setPersisted(true).setPeriodic(6*3600000L).build());
+  }
+  static Set<String> leagues(Context context){
+    Set<String> result=new HashSet<>();for(String team:new CobraSportsPreferences(context).automaticTeams())result.add(team.split("\\|",2)[0]);
+    JSONArray reminders=new InfinityCobraFeatureRuntime(context).reminders();
+    for(int i=0;i<reminders.length();i++){JSONObject item=reminders.optJSONObject(i);if(item!=null&&item.optBoolean("manual")&&item.optLong("start")>System.currentTimeMillis()){
+      String game=item.optString("sports_game");if(game.contains("|"))result.add(game.split("\\|",2)[0]);}}
+    return result;
+  }
+  static String route(String key){
+    switch(key){
+      case "nfl":return "football/nfl";case "nba":return "basketball/nba";case "mlb":return "baseball/mlb";
+      case "nhl":return "hockey/nhl";case "ncaaf":return "football/college-football";
+      case "ncaam":return "basketball/mens-college-basketball";case "wnba":return "basketball/wnba";
+      case "epl":return "soccer/eng.1";case "ucl":return "soccer/uefa.champions";case "mls":return "soccer/usa.1";
+      case "laliga":return "soccer/esp.1";case "bundesliga":return "soccer/ger.1";case "seriea":return "soccer/ita.1";
+      case "ligue1":return "soccer/fra.1";case "uel":return "soccer/uefa.europa";default:return "";
+    }
+  }
+  static long time(String text){for(String format:new String[]{"yyyy-MM-dd'T'HH:mmX","yyyy-MM-dd'T'HH:mm:ssX","yyyy-MM-dd'T'HH:mm:ss.SSSX"})
+    try{return new SimpleDateFormat(format,Locale.US).parse(text).getTime();}catch(Exception ignored){}return 0;}
+  static void ingest(Context context,String league,JSONObject root){
+    InfinityCobraFeatureRuntime runtime=new InfinityCobraFeatureRuntime(context);CobraSportsPreferences prefs=new CobraSportsPreferences(context);
+    JSONArray events=root.optJSONArray("events");if(events==null)return;
+    for(int i=0;i<events.length();i++)try{
+      JSONObject event=events.getJSONObject(i),competition=event.getJSONArray("competitions").getJSONObject(0);
+      JSONArray teams=competition.getJSONArray("competitors");String away="",home="";
+      for(int j=0;j<teams.length();j++){JSONObject team=teams.getJSONObject(j);String id=league+"|"+team.getJSONObject("team").getString("id");if("away".equals(team.optString("homeAway")))away=id;else home=id;}
+      String id=event.optString("id");if(id.isEmpty()||away.isEmpty()||home.isEmpty())continue;
+      String game=league+"|"+id;JSONObject existing=runtime.sportsReminder(game);
+      if(!prefs.automatic(away,home)&&existing==null)continue;
+      JSONObject status=competition.optJSONObject("status");if(status==null)status=event.optJSONObject("status");
+      JSONObject type=status==null?null:status.optJSONObject("type");
+      String state=type==null?"pre":type.optString("state");String name=type==null?"":type.optString("name");
+      boolean valid="pre".equals(state)&&!name.contains("CANCEL")&&!name.contains("POSTPON");
+      long start=valid?time(event.optString("date")):0;
+      runtime.sportsReminder(game,away,home,event.optString("name","Game starting soon"),start,prefs.automatic(away,home),existing!=null&&existing.optBoolean("manual"));
+    }catch(Exception ignored){}
+  }
+  @Override public boolean onStartJob(JobParameters params){
+    stopped=false;final int token=++generation;worker=new Thread(()->{
+      boolean failed=false;
+      try{
+        InfinityCobraFeatureRuntime runtime=new InfinityCobraFeatureRuntime(this);runtime.reconcileSportsReminders();
+        Set<String> leagues=leagues(this);
+        long now=System.currentTimeMillis(),deadline=android.os.SystemClock.elapsedRealtime()+120000L;SimpleDateFormat date=new SimpleDateFormat("yyyyMMdd",Locale.US);
+        outer: for(String league:leagues){String route=route(league);if(route.isEmpty())continue;
+          for(int day=0;day<8;day++){
+            if(stopped||token!=generation)break outer;
+            if(android.os.SystemClock.elapsedRealtime()>deadline){failed=true;break outer;}
+            HttpURLConnection request=null;
+            try{
+              String dates=date.format(new Date(now+day*86400000L));
+              request=(HttpURLConnection)new URL("https://site.api.espn.com/apis/site/v2/sports/"+route+"/scoreboard?dates="+dates+"&limit=1000"+("ncaaf".equals(league)?"&groups=80":"ncaam".equals(league)?"&groups=50":"")).openConnection();connection=request;
+              request.setConnectTimeout(8000);request.setReadTimeout(10000);request.setRequestProperty("User-Agent","Cobra-Sports/2103312");
+              try(InputStream in=request.getInputStream();ByteArrayOutputStream out=new ByteArrayOutputStream()){
+                byte[] buffer=new byte[8192];int n,total=0;while(!stopped&&token==generation&&(n=in.read(buffer))!=-1){total+=n;if(total>4*1024*1024)throw new java.io.IOException("Schedule too large");out.write(buffer,0,n);}
+                if(!stopped&&token==generation)ingest(this,league,new JSONObject(out.toString("UTF-8")));
+              }
+            }catch(Exception e){failed=true;break;}finally{if(request!=null)request.disconnect();if(connection==request)connection=null;}
+          }
+        }
+      }finally{if(!stopped&&token==generation){jobFinished(params,failed);worker=null;}}
+    },"Cobra-team-reminders");worker.start();return true;
+  }
+  @Override public boolean onStopJob(JobParameters params){stopped=true;generation++;if(connection!=null)connection.disconnect();if(worker!=null)worker.interrupt();return true;}
+}
