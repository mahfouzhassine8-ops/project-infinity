package @APP_PACKAGE@;

import android.app.Activity;
import android.content.Intent;
import android.view.View;
import android.view.ViewTreeObserver;

/** One Android handoff after a visible startup frame. No native/player/session ownership. */
final class InfinityStartupHandoff implements ViewTreeObserver.OnDrawListener {
  private final Activity owner;
  private final View frame;
  private Runnable pending;
  private boolean resumed, posted, closed, dispatched;
  private final Runnable dispatch = this::dispatchPending;
  private void dispatchPending() {
    posted = false;
    if (closed || !resumed || owner.isFinishing() || owner.isDestroyed()) return;
    Runnable action = pending;
    if (action == null) return;
    pending = null;
    dispatched = true;
    action.run();
  }

  InfinityStartupHandoff(Activity owner, View frame) {
    this.owner = owner;
    this.frame = frame;
    frame.getViewTreeObserver().addOnDrawListener(this);
  }

  static boolean isLive(Activity activity, boolean initialized, boolean destroying) {
    return activity != null && initialized && !destroying &&
        !activity.isFinishing() && !activity.isDestroyed();
  }

  static Intent mainIntent(Activity owner, Intent incoming, boolean live) {
    Intent intent = incoming == null ? new Intent() : new Intent(incoming);
    intent.setClass(owner, Main.class);
    // Launcher reset/clear flags can finish a valid finishOnTaskLaunch Main.
    // Retain URI grant flags and all content/extras for existing deep-link behavior.
    int unsafe = Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED | Intent.FLAG_ACTIVITY_CLEAR_TASK |
        Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_MULTIPLE_TASK |
        Intent.FLAG_ACTIVITY_NEW_DOCUMENT | Intent.FLAG_ACTIVITY_PREVIOUS_IS_TOP |
        Intent.FLAG_ACTIVITY_REORDER_TO_FRONT;
    intent.setFlags((intent.getFlags() & ~unsafe) | Intent.FLAG_ACTIVITY_NEW_TASK |
        Intent.FLAG_ACTIVITY_SINGLE_TOP | (live ? Intent.FLAG_ACTIVITY_REORDER_TO_FRONT : 0));
    return intent;
  }

  boolean enqueue(Runnable action) {
    if (closed || dispatched || pending != null || owner.isFinishing() || owner.isDestroyed()) return false;
    pending = action;
    frame.invalidate();
    return true;
  }

  void resume() { resumed = true; if (pending != null) frame.invalidate(); }
  void pause() { resumed = false; frame.removeCallbacks(dispatch); posted = false; }

  @Override public void onDraw() {
    if (closed || !resumed || pending == null || posted || !frame.isShown() ||
        frame.getWindowVisibility() != View.VISIBLE || frame.getWidth() <= 0 || frame.getHeight() <= 0) return;
    // Post from draw, not onCreate/onLayout: let this traversal submit actual pixels first.
    posted = frame.post(dispatch);
  }

  void close() {
    closed = true; pending = null; pause();
    if (frame.getViewTreeObserver().isAlive()) frame.getViewTreeObserver().removeOnDrawListener(this);
  }
}
