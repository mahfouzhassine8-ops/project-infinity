<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.projectinfinity</groupId>
  <artifactId>isolation-boundary-tests</artifactId>
  <version>1</version>
  <properties>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <repositories>
    <repository>
      <id>google</id>
      <url>https://dl.google.com/dl/android/maven2/</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>local.review</groupId>
      <artifactId>delta</artifactId>
      <version>1</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/production.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>local.review</groupId>
      <artifactId>baseline</artifactId>
      <version>1</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/support.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.robolectric</groupId>
      <artifactId>android-all</artifactId>
      <version>15-robolectric-12650502</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.robolectric</groupId>
      <artifactId>robolectric</artifactId>
      <version>4.14.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.robolectric</groupId>
      <artifactId>nativeruntime</artifactId>
      <version>4.14.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.robolectric</groupId>
      <artifactId>nativeruntime-dist-compat</artifactId>
      <version>1.0.16</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>-Djava.io.tmpdir=/tmp/cobra444/java-tmp --add-opens java.base/sun.nio.ch=ALL-UNNAMED</argLine>
          <reuseForks>false</reuseForks>
          <systemPropertyVariables>
            <robolectric.dependency.repo.url>https://repo.maven.apache.org/maven2</robolectric.dependency.repo.url>
            <integrated.output>${project.basedir}/measurements</integrated.output>
          <drawer.output>${project.basedir}/measurements</drawer.output><cards.layout.output>${project.basedir}/measurements</cards.layout.output><drawer.baseline>/workspace/cobra-evidence/drawer435-negative-baseline/measurements</drawer.baseline><drawer.candidate>true</drawer.candidate><rejected434.output>/tmp/preview440/evidence</rejected434.output><reuse.output>${project.basedir}/measurements</reuse.output><projection.output>${project.basedir}/measurements</projection.output></systemPropertyVariables>
          <additionalClasspathElements>
            <additionalClasspathElement>${project.basedir}/android-test-libs/monitor.jar</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/android-test-libs/espresso.jar</additionalClasspathElement>
          </additionalClasspathElements>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>