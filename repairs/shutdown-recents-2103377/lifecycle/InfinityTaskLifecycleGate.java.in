package @APP_PACKAGE@;

import java.io.File;
import java.io.IOException;
import java.io.RandomAccessFile;
import java.nio.channels.FileLock;

/**
 * Serializes process entry against confirmed-dead task retirement. It does not
 * authorize checkpoint success, native termination, or release of an owner.
 *
 * A Kodi process retains a shared lease before preparation and native entry.
 * The close guard retains an exclusive lease throughout ownership validation
 * and task-manager removal. All acquisition is nonblocking. The entry lease
 * is deliberately process-lifetime, including native destruction; do not add
 * an Activity.onPause/onStop/onDestroy release or unlink this coordination file.
 */
final class InfinityTaskLifecycleGate {
  static final String FILE_NAME = "infinity-native-task-entry-v1.lock";
  private static RandomAccessFile entryFile;
  private static FileLock entryLock;
  private static File entryDirectory;
  private static Removal removal;

  private InfinityTaskLifecycleGate() {}

  static synchronized boolean retainEntry(File directory) {
    try {
      File actual = directory.getCanonicalFile();
      // Never open another descriptor while this process holds the inode:
      // closing it can release process-associated locks on some platforms.
      if (entryLock != null)
        return entryLock.isValid() && actual.equals(entryDirectory);
      if (removal != null) return false;
      RandomAccessFile opened = new RandomAccessFile(new File(actual, FILE_NAME), "rw");
      try {
        FileLock acquired = opened.getChannel().tryLock(0, 1, true);
        if (acquired == null) { opened.close(); return false; }
        entryFile = opened;
        entryLock = acquired;
        entryDirectory = actual;
        return true;
      } catch (IOException | RuntimeException unavailable) {
        opened.close();
        return false;
      }
    } catch (IOException | RuntimeException unavailable) { return false; }
  }

  static synchronized Removal beginRemoval(File directory) throws IOException {
    if (entryLock != null || removal != null) return null;
    RandomAccessFile opened = new RandomAccessFile(
        new File(directory.getCanonicalFile(), FILE_NAME), "rw");
    try {
      FileLock acquired = opened.getChannel().tryLock(0, 1, false);
      if (acquired == null) { opened.close(); return null; }
      removal = new Removal(opened, acquired);
      return removal;
    } catch (IOException | RuntimeException unavailable) {
      opened.close();
      throw unavailable;
    }
  }

  static final class Removal implements AutoCloseable {
    private final RandomAccessFile file;
    private final FileLock lock;
    private boolean closed;
    private Removal(RandomAccessFile file, FileLock lock) { this.file = file; this.lock = lock; }
    @Override public void close() throws IOException {
      synchronized (InfinityTaskLifecycleGate.class) {
        if (closed) return;
        closed = true;
        try { lock.release(); }
        finally {
          try { file.close(); }
          finally { if (removal == this) removal = null; }
        }
      }
    }
  }
}
