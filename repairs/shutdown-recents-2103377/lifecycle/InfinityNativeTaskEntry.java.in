package @APP_PACKAGE@;

import android.app.Activity;
import android.app.ActivityManager;
import android.content.ComponentName;
import android.content.Intent;
import android.os.Build;
import java.util.UUID;

/** A process-local, single-use preparation handoff; never a save/close receipt. */
final class InfinityNativeTaskEntry {
  static final String TICKET = "infinity_native_entry_ticket_v1";
  private static String pendingTicket;
  private static boolean nativeAdmissionUsed;
  private InfinityNativeTaskEntry() {}

  static synchronized void prepareFreshIntent(Intent target) {
    pendingTicket = UUID.randomUUID().toString();
    target.putExtra(TICKET, pendingTicket);
  }

  static synchronized boolean hasFreshIntent(Intent target) {
    return target != null && pendingTicket != null
        && pendingTicket.equals(target.getStringExtra(TICKET));
  }

  static synchronized boolean admit(Activity owner) {
    Intent incoming = owner.getIntent();
    if (nativeAdmissionUsed || !hasFreshIntent(incoming)) return false;
    pendingTicket = null;
    incoming.removeExtra(TICKET);
    if (!InfinityTaskLifecycleGate.retainEntry(owner.getFilesDir())) return false;
    if (!ownsCurrentMainTask(owner)) return false;
    // One native engine per process. Do not reset from an Activity lifecycle
    // callback: native/global destruction may still be running after Java exit.
    nativeAdmissionUsed = true;
    return true;
  }

  static boolean ownsCurrentMainTask(Activity owner) {
    try {
      if (owner.isFinishing() || owner.isDestroyed()) return false;
      int id = owner.getTaskId();
      if (id < 0) return false;
      ActivityManager manager = (ActivityManager) owner.getSystemService(Activity.ACTIVITY_SERVICE);
      if (manager == null) return false;
      for (ActivityManager.AppTask task : manager.getAppTasks()) {
        ActivityManager.RecentTaskInfo info = task.getTaskInfo();
        if (info == null || (Build.VERSION.SDK_INT >= 29 ? info.taskId : info.persistentId) != id) continue;
        ComponentName root = Build.VERSION.SDK_INT >= 23 ? info.baseActivity : null;
        if (root == null && info.baseIntent != null) root = info.baseIntent.getComponent();
        return root != null && owner.getPackageName().equals(root.getPackageName())
            && Main.class.getName().equals(root.getClassName())
            && !owner.isFinishing() && !owner.isDestroyed();
      }
    } catch (RuntimeException unavailable) { return false; }
    return false;
  }

  static Intent chooserIntent(Activity owner, boolean recovery) {
    Intent incoming = owner.getIntent();
    Intent target = incoming == null ? new Intent(Intent.ACTION_MAIN) : new Intent(incoming);
    target.setClass(owner, Splash.class);
    target.removeExtra(TICKET);
    target.removeExtra(InfinityKodiShutdown.TOKEN);
    int grants = Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_GRANT_WRITE_URI_PERMISSION
        | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION | Intent.FLAG_GRANT_PREFIX_URI_PERMISSION;
    target.setFlags((target.getFlags() & grants) | Intent.FLAG_ACTIVITY_NEW_TASK
        | Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_SINGLE_TOP);
    // Ordinary cold Recents goes through the unchanged Ask Every Time/fixed
    // experience/deep-link logic. A contended entry uses existing recovery UI.
    if (recovery) target.putExtra("infinity_checkpoint_chooser", true);
    return target;
  }

  static void returnToChooser(Activity owner, boolean recovery) {
    try { owner.startActivity(chooserIntent(owner, recovery)); }
    catch (RuntimeException unavailable) {
      InfinityExitDiagnostics.breadcrumb(owner.getApplicationContext(), "main.nativeEntry.chooserUnavailable");
    }
    finally { owner.finish(); }
  }
}
