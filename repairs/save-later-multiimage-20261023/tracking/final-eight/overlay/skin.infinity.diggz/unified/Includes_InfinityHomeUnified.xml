<?xml version='1.0' encoding='utf-8'?>
<includes>
  <include name="InfinityHomeStatusCluster">
    <param name="statusleft" />
    <param name="statuswidth" />
    <param name="datetop" />
    <param name="dateheight" />
    <param name="weathertop" />
    <param name="weatherheight" />
    <param name="weatherfont" default="InfinityTiny" />
    <param name="timeleft" />
    <param name="timetop" />
    <param name="timewidth" />
    <param name="timeheight" />
    <definition>
      <control type="image">
        <left>708</left>
        <top>$PARAM[timetop]</top>
        <width>18</width>
        <height>18</height>
        <texture colordiffuse="$VAR[InfinityHealthOrbColor]">infinity_experience/health-orb.png</texture>
        <visible>String.IsEqual(Window(Home).Property(Infinity.RuntimeBadgesVisible),true) + !Player.HasMedia</visible>
        <animation effect="fade" start="70" end="100" time="2100" pulse="true" condition="String.IsEqual(Window(Home).Property(Infinity.OptionalMotionAllowed),true) + !String.IsEqual(Window(Home).Property(Infinity.HealthOrb.State),unknown)">Conditional</animation>
      </control>
      <control type="label">
        <left>$PARAM[statusleft]</left>
        <top>$PARAM[datetop]</top>
        <width>$PARAM[statuswidth]</width>
        <height>$PARAM[dateheight]</height>
        <font>InfinityTiny</font>
        <textcolor>$VAR[InfinityPaletteTextSecondary]</textcolor>
        <align>right</align>
        <aligny>center</aligny>
        <label>$INFO[System.Date]</label>
      </control>
      <control type="label">
        <left>$PARAM[statusleft]</left>
        <top>$PARAM[weathertop]</top>
        <width>$PARAM[statuswidth]</width>
        <height>$PARAM[weatherheight]</height>
        <font>$PARAM[weatherfont]</font>
        <textcolor>$VAR[InfinityPaletteTextPrimary]</textcolor>
        <align>right</align>
        <aligny>center</aligny>
        <label>$INFO[Weather.Location]  •  $INFO[Weather.Temperature]  $INFO[Weather.Conditions]</label>
        <scroll>true</scroll>
      </control>
      <control type="grouplist"><left>$PARAM[timeleft]</left><top>$PARAM[timetop]</top><width>$PARAM[timewidth]</width><height>$PARAM[timeheight]</height><orientation>horizontal</orientation><align>right</align><itemgap>8</itemgap><usecontrolcoords>true</usecontrolcoords><control type="image"><texture>infinity_ui/clock_moon.png</texture><aspectratio>keep</aspectratio><visible>![String.IsEqual(Window(Home).Property(Infinity.SystemTheme),light) | String.IsEqual(Window(Home).Property(Infinity.SystemTheme),Light) | [String.IsEmpty(Window(Home).Property(Infinity.SystemTheme)) + String.IsEqual(Window(Home).Property(Infinity.NativeSystemTheme),light)] | [String.IsEmpty(Window(Home).Property(Infinity.SystemTheme)) + String.IsEqual(Window(Home).Property(Infinity.NativeSystemTheme),Light)]] + !Control.IsVisible(29900)</visible><left>0</left><centertop>50%</centertop><width>18</width><height>18</height></control><control type="label">
        <font>InfinityClock</font>
        <textcolor>$VAR[InfinityPaletteTextPrimary]</textcolor>
        <aligny>center</aligny>
        <label>$INFO[System.Time]</label>
      <left>0</left><top>0</top><height>$PARAM[timeheight]</height><align>left</align><width min="1" max="100%">auto</width></control>
    </control></definition>
  </include>
  <include name="InfinityHomeAddonCardNormal">
    <param name="surfaceleft" />
    <param name="surfacetop" />
    <param name="surfacewidth" />
