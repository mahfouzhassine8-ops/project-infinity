    <param name="labelheight" />
    <param name="accentleft" />
    <param name="accenttop" />
    <param name="accentwidth" />
    <definition>
      <control type="image">
        <left>$PARAM[surfaceleft]</left>
        <top>$PARAM[surfacetop]</top>
        <width>$PARAM[surfacewidth]</width>
        <height>$PARAM[surfaceheight]</height>
        <texture border="16" colordiffuse="$VAR[InfinityPaletteCardSurface]">infinity_ui/contract_white.png</texture>
      </control>
      <control type="image">
        <left>$PARAM[frameleft]</left>
        <top>$PARAM[frametop]</top>
        <width>$PARAM[framewidth]</width>
        <height>$PARAM[frameheight]</height>
        <texture border="18" colordiffuse="$VAR[InfinityCollectiveFrameSoft]">infinity_ui/frame_soft.png</texture>
      </control>
      <control type="image">
        <left>$PARAM[artleft]</left>
        <top>$PARAM[arttop]</top>
        <width>$PARAM[artwidth]</width>
        <height>$PARAM[artheight]</height>
        <aspectratio>keep</aspectratio>
        <texture fallback="DefaultAddon.png" background="true">$INFO[ListItem.Thumb]</texture>
      </control>
      <control type="label">
        <left>$PARAM[labelleft]</left>
        <top>$PARAM[labeltop]</top>
        <width>$PARAM[labelwidth]</width>
        <height>$PARAM[labelheight]</height>
        <align>center</align>
        <aligny>center</aligny>
        <font>InfinityTiny</font>
        <textcolor>$VAR[InfinityCollectiveTextSecondary]</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
      <control type="image">
        <left>$PARAM[accentleft]</left>
        <top>$PARAM[accenttop]</top>
        <width>$PARAM[accentwidth]</width>
        <height>2</height>
        <texture colordiffuse="$VAR[InfinityCollectiveFrameSoft]">infinity_ui/contract_white.png</texture>
      </control>
    </definition>
  </include>
