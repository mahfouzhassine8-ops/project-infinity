package @APP_PACKAGE@;

import android.animation.ValueAnimator;
import android.content.Context;
import android.graphics.Bitmap;
import android.graphics.Canvas;
import android.graphics.Color;
import android.graphics.ColorMatrix;
import android.graphics.ColorMatrixColorFilter;
import android.graphics.Paint;
import android.graphics.Rect;
import android.graphics.RectF;
import android.graphics.Path;
import android.graphics.drawable.Drawable;
import android.view.ViewGroup;
import java.util.ArrayList;
import android.os.Build;
import android.os.Handler;
import android.os.Looper;
import android.view.TextureView;
import android.view.View;
import android.view.animation.PathInterpolator;

/**
 * Presentation-only mini-player ambient renderer.
 *
 * The directional edge-projection approach is adapted from the MIT-licensed
 * x-ambient project by mmnga (https://github.com/mmnga/x-ambient). Cobra keeps
 * playback ownership in InfinityLiveActivity; this view only samples the
 * already-visible TextureView at low resolution and draws behind the UI.
 */
final class CobraImmersiveAmbient extends View {
  static final int SAMPLE_WIDTH = 144;
  static final int MIN_SAMPLE_HEIGHT = 48;
  static final int MAX_SAMPLE_HEIGHT = 144;
  static final long FRAME_INTERVAL_MS = 83L; // <= ~12 fps, matching the reference design.
  static final int RAY_STEPS = 48;
  static final float SATURATION = 1.65f;
  // Keep the upstream MIT notice in compiled bytecode without introducing an Android R resource.
  static final String X_AMBIENT_MIT_NOTICE =
      "MIT License\\n\\nCopyright (c) 2026 mmnga\\n\\n" +
      "Permission is hereby granted, free of charge, to any person obtaining a copy " +
      "of this software and associated documentation files (the \"Software\"), to deal " +
      "in the Software without restriction, including without limitation the rights " +
      "to use, copy, modify, merge, publish, distribute, sublicense, and/or sell " +
      "copies of the Software, and to permit persons to whom the Software is " +
      "furnished to do so, subject to the following conditions:\\n\\n" +
      "The above copyright notice and this permission notice shall be included in all " +
      "copies or substantial portions of the Software.\\n\\n" +
      "THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR " +
      "IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, " +
      "FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE " +
      "AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER " +
      "LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, " +
      "OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.";

  private final Handler main = new Handler(Looper.getMainLooper());
  private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG | Paint.DITHER_FLAG);
  private final Rect src = new Rect();
  private final RectF dst = new RectF();
  private final RectF sourceRect = new RectF();
  private final int[] selfLocation = new int[2];
  private final int[] hostLocation = new int[2];
  private final ColorMatrixColorFilter saturation;
  private TextureView source;
  private View sourceHost;
  private Bitmap raw;
  private Bitmap smoothed;
  private Bitmap field;
  private Canvas fieldCanvas;
  private int[] pixels, history, filtered, blurScratch;
  private final RectF fieldAnchor = new RectF();
  private final RectF windowRect = new RectF();
  private boolean fieldDirty = true;
  private boolean captureFailed;
  private String session = "";
  private boolean awaitNewFrame;
  private long previousTimestamp;
  private final ArrayList<IlluminatedGlass> glass = new ArrayList<>();
  private boolean enabled;
  private boolean animateFrames;
  private boolean haveFrame;
  private boolean lightAppearance;
  private boolean released;
  private boolean scheduled;
  private long lastCapture;
  private ValueAnimator visibilityAnimator;
  private int captures;
  private boolean testFrameMode;
  private boolean controlsOnly;
  private final ArrayList<View> watchRoots=new ArrayList<>();
  private View watchProgress;
  private Bitmap watchCapture,watchPalette;
  private Canvas watchRawCanvas,watchPaletteCanvas;
  private android.graphics.BitmapShader watchShader;
  private final android.graphics.Matrix watchMatrix=new android.graphics.Matrix();
  private final RectF watchPicture=new RectF();
  private final Rect watchCrop=new Rect();
  private final Paint watchPaint=new Paint(Paint.ANTI_ALIAS_FLAG|Paint.FILTER_BITMAP_FLAG);
  private final int[] watchPixels=new int[24*16],watchScratch=new int[24*16];

  private final Runnable frame = new Runnable() {
    @Override public void run() {
      scheduled = false;
      if (!enabled || released || !isAttachedToWindow()) return;
      if(controlsOnly&&!watchControlsVisible()){state(false,false);return;}
      long now = android.os.SystemClock.uptimeMillis();
      if (now - lastCapture >= FRAME_INTERVAL_MS) {
        capture();
        lastCapture = now;
      }
      if (animateFrames && !captureFailed) schedule();
    }
  };

  static boolean eligible(int mode, boolean visualAllowed, boolean fullscreen, boolean multiView, boolean pip,
      boolean background, boolean shellAttached, boolean hostVisible, boolean textureReady, boolean playerReady) {
    return mode == CobraPresentationEffects.IMMERSIVE && visualAllowed && !fullscreen && !multiView && !pip
        && !background && shellAttached && hostVisible && textureReady && playerReady;
  }

  static boolean watchEligible(int mode,boolean allowed,boolean fullscreen,boolean multi,boolean pip,
      boolean background,boolean host,boolean texture,boolean player,boolean controls) {
    return mode==CobraPresentationEffects.IMMERSIVE&&allowed&&fullscreen&&!multi&&!pip&&!background&&host&&texture&&player&&controls;
  }
  void controlsOnly(boolean value) {
    if(controlsOnly==value)return;
    restoreGlass();clearFrames();controlsOnly=value;watchRoots.clear();watchProgress=null;
  }
  private boolean watchControlsVisible(){for(View root:watchRoots)if(root!=null&&root.isShown())return true;return false;}

  CobraImmersiveAmbient(Context context) {
    super(context);
    setTag("cobra_immersive_edge_ambient");
    setClickable(false);
    setFocusable(false);
    setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
    setWillNotDraw(false);
    setAlpha(0f);
    ColorMatrix matrix = new ColorMatrix();
    matrix.setSaturation(SATURATION);
    saturation = new ColorMatrixColorFilter(matrix);
    paint.setColorFilter(saturation);
    // Blur the reused low-resolution field, then mask the video rectangle.
    // A View RenderEffect would blur across that mask and onto the video.

  }

  void bind(TextureView texture, View host, boolean light, String key) {
    if (!session.equals(key)) {
      boolean switching=!session.isEmpty() && source==texture;
      session=key;clearFrames();captureFailed=false;setAlpha(0f);
      awaitNewFrame=switching;
      try {previousTimestamp=texture!=null&&texture.getSurfaceTexture()!=null?texture.getSurfaceTexture().getTimestamp():0L;}
      catch(RuntimeException unavailable){captureFailed=true;}
    }
    bind(texture,host,light);
  }

  void bind(TextureView texture, View host, boolean light) {
    if (source != texture) {
      source = texture;
      sourceHost = host;
      clearFrames(); captureFailed = false;
    } else sourceHost = host;
    if (lightAppearance != light) {
      lightAppearance = light; fieldDirty = true;
      invalidate();
    }
  }

  void state(boolean active, boolean moving) {
    if (released) return;
    animateFrames = active && moving;
    if (enabled == active) {
      if (enabled && !haveFrame) capture();
      if (animateFrames && !captureFailed) schedule(); else cancelSchedule();
      return;
    }
    enabled = active;
    if (active) {
      setVisibility(VISIBLE);
      clearFrames(); captureFailed = false;
      capture();
      if (animateFrames && !captureFailed) schedule();
    } else {
      cancelSchedule();
      fadeTo(0f, 180L);
    }
  }

  void release() {
    released = true;
    enabled = false;
    animateFrames = false;
    cancelSchedule();
    if (visibilityAnimator != null) visibilityAnimator.cancel();
    visibilityAnimator = null;
    restoreGlass(); clearFrames();
    source = null;
    sourceHost = null;watchRoots.clear();watchProgress=null;
  }

  boolean isAmbientActive() { return enabled; }
  int captureCount() { return captures; }
  RectF sourceBoundsForTest() { return new RectF(sourceRect); }

  private void fadeTo(float value, long duration) {
    if (visibilityAnimator != null) visibilityAnimator.cancel();
    if (!isAttachedToWindow() || Build.VERSION.SDK_INT < 11) {
      setAlpha(value);
      if (value == 0f) setVisibility(INVISIBLE);
      return;
    }
    float start = getAlpha();
    visibilityAnimator = ValueAnimator.ofFloat(start, value);
    visibilityAnimator.setDuration(duration);
    visibilityAnimator.setInterpolator(new PathInterpolator(.2f, 0f, 0f, 1f));
    visibilityAnimator.addUpdateListener(a -> { setAlpha((Float) a.getAnimatedValue()); invalidateGlass(); });
    visibilityAnimator.addListener(new android.animation.AnimatorListenerAdapter() {
      @Override public void onAnimationEnd(android.animation.Animator animation) {
        if (!enabled && value == 0f) { setVisibility(INVISIBLE); restoreGlass(); clearFrames(); }
      }
    });
    visibilityAnimator.start();
  }

  private void schedule() {
    if (scheduled || released || captureFailed || !enabled || !animateFrames) return;
    scheduled = true;
    main.postDelayed(frame, FRAME_INTERVAL_MS);
  }

  private void cancelSchedule() {
    scheduled = false;
    main.removeCallbacks(frame);
  }

  private void clearFrames() {
    haveFrame = false;
    testFrameMode = false;
    captures = 0;
    if(watchCapture!=null)watchCapture.recycle();watchCapture=null;watchRawCanvas=null;
    if(watchPalette!=null)watchPalette.recycle();watchPalette=null;watchPaletteCanvas=null;watchShader=null;
    if (raw != null) raw.recycle();
    if (smoothed != null) smoothed.recycle();
    raw = null;
    smoothed = null; pixels = null; history = null;
    if (field != null) field.recycle();
    field = null; fieldCanvas = null; filtered = null; blurScratch = null; fieldDirty = true;
    invalidate();
  }

  private void ensureBuffers(int width, int height) {
    if (raw != null && raw.getWidth() == width && raw.getHeight() == height
        && smoothed != null && smoothed.getWidth() == width && smoothed.getHeight() == height) return;
    clearFrames();
    raw = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
    smoothed = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
    pixels = new int[width * height]; history = new int[width * height];
  }

  private boolean capture() {
    try { return captureInternal(); }
    catch (RuntimeException | OutOfMemoryError unavailable) {
      captureFailed=true;cancelSchedule();clearFrames();invalidateGlass();return false;
    }
  }
  private boolean captureInternal() {
    testFrameMode = false;
    TextureView texture = source;
    View host = sourceHost;
    if (captureFailed || !enabled || texture == null || host == null || !texture.isAvailable()
        || !texture.isShown() || !host.isShown() || texture.getWidth() < 2 || texture.getHeight() < 2) return false;
    if(awaitNewFrame) {
      android.graphics.SurfaceTexture surface=texture.getSurfaceTexture();
      if(surface==null||surface.getTimestamp()==previousTimestamp)return false;
      awaitNewFrame=false;
    }
    int width = SAMPLE_WIDTH;
    int height = Math.max(MIN_SAMPLE_HEIGHT, Math.min(MAX_SAMPLE_HEIGHT,
        Math.round(width * (texture.getHeight() / (float) texture.getWidth()))));
    ensureBuffers(width, height);
    Bitmap value;
    try { value = controlsOnly ? captureWatch(texture,width,height) : texture.getBitmap(raw); }
    catch (RuntimeException unavailable) { captureFailed = true; clearFrames(); invalidateGlass(); return false; }
    if (value == null) { captureFailed = true; clearFrames(); invalidateGlass(); return false; }
    // Reject neutral/near-black energy rather than blooming gray or pale white.
    raw.getPixels(pixels,0,width,0,0,width,height);
    for (int i=0;i<pixels.length;i++) pixels[i]=lightPixel(pixels[i],lightAppearance);
    for(int i=0;i<pixels.length;i++) {
      int next=pixels[i],old=history[i];
      if(!haveFrame)history[i]=next;
      else {
        float oa=Color.alpha(old)*.56f,na=Color.alpha(next)*.44f,total=oa+na;
        history[i]=total<.5f?0:Color.argb(Math.round(total),
          Math.round((Color.red(old)*oa+Color.red(next)*na)/total),
          Math.round((Color.green(old)*oa+Color.green(next)*na)/total),
          Math.round((Color.blue(old)*oa+Color.blue(next)*na)/total));
      }
    }
    smoothed.setPixels(history,0,width,0,0,width,height);haveFrame=true;
    paint.setColorFilter(saturation);
    if(controlsOnly)updateWatchPalette();
    captures++; fieldDirty = true;
    updateSourceRect();
    invalidate(); invalidateGlass();
    if (getAlpha() < .05f) fadeTo(1f, 260L);
    return true;
  }

  private Bitmap captureWatch(TextureView texture,int width,int height) {
    int captureHeight=Math.max(2,Math.min(512,Math.round(SAMPLE_WIDTH*texture.getHeight()/(float)texture.getWidth())));
    if(watchCapture==null||watchCapture.getHeight()!=captureHeight){
      if(watchCapture!=null)watchCapture.recycle();
      watchCapture=Bitmap.createBitmap(SAMPLE_WIDTH,captureHeight,Bitmap.Config.ARGB_8888);
    }
    Bitmap value=texture.getBitmap(watchCapture);if(value==null)return null;
    visiblePicture(texture,watchPicture,watchMatrix);
    watchCrop.set(Math.max(0,(int)Math.ceil(watchPicture.left*SAMPLE_WIDTH/texture.getWidth())),
        Math.max(0,(int)Math.ceil(watchPicture.top*captureHeight/texture.getHeight())),
        Math.min(SAMPLE_WIDTH,(int)Math.floor(watchPicture.right*SAMPLE_WIDTH/texture.getWidth())),
        Math.min(captureHeight,(int)Math.floor(watchPicture.bottom*captureHeight/texture.getHeight())));
    if(watchCrop.isEmpty())return null;
    if(watchRawCanvas==null)watchRawCanvas=new Canvas(raw);
    dst.set(0,0,width,height);watchPaint.setShader(null);watchPaint.setAlpha(255);
    watchRawCanvas.drawBitmap(watchCapture,watchCrop,dst,watchPaint);return raw;
  }
  static void visiblePicture(TextureView texture,RectF out,android.graphics.Matrix matrix){
    out.set(0,0,texture.getWidth(),texture.getHeight());texture.getTransform(matrix);matrix.mapRect(out);
    if(!out.intersect(0,0,texture.getWidth(),texture.getHeight()))out.setEmpty();
  }
  private void updateWatchPalette(){
    if(smoothed==null)return;
    if(watchPalette==null){watchPalette=Bitmap.createBitmap(24,16,Bitmap.Config.ARGB_8888);watchPaletteCanvas=new Canvas(watchPalette);
      watchShader=new android.graphics.BitmapShader(watchPalette,android.graphics.Shader.TileMode.CLAMP,android.graphics.Shader.TileMode.CLAMP);}
    watchPaint.setShader(null);watchPaint.setAlpha(255);watchPaint.setColorFilter(saturation);
    watchPaletteCanvas.drawColor(Color.TRANSPARENT,android.graphics.PorterDuff.Mode.CLEAR);
    // A tiny four-edge field for control illumination; no dominant centre-scene tint.
    int w=smoothed.getWidth(),h=smoothed.getHeight(),ex=Math.max(1,Math.round(w*.04f)),ey=Math.max(1,Math.round(h*.04f));
    src.set(0,0,w,ey);dst.set(0,0,24,8);watchPaletteCanvas.drawBitmap(smoothed,src,dst,watchPaint);
    src.set(0,h-ey,w,h);dst.set(0,8,24,16);watchPaletteCanvas.drawBitmap(smoothed,src,dst,watchPaint);
    src.set(0,0,ex,h);dst.set(0,0,4,16);watchPaletteCanvas.drawBitmap(smoothed,src,dst,watchPaint);
    src.set(w-ex,0,w,h);dst.set(20,0,24,16);watchPaletteCanvas.drawBitmap(smoothed,src,dst,watchPaint);watchPaint.setColorFilter(null);
    watchPalette.getPixels(watchPixels,0,24,0,0,24,16);blur(watchPixels,watchScratch,24,16,true);blur(watchScratch,watchPixels,24,16,false);
    watchPalette.setPixels(watchPixels,0,24,0,0,24,16);
  }
  private void watchLight(Paint target,float x,float y,int alpha){
    watchMatrix.setScale(sourceRect.width()/24f,sourceRect.height()/16f);
    watchMatrix.postTranslate(sourceRect.left-x,sourceRect.top-y);watchShader.setLocalMatrix(watchMatrix);
    target.setShader(watchShader);target.setAlpha(Math.round(alpha*getAlpha()));
  }
  void drawWatchProgress(Canvas canvas,View owner,float fraction){
    if(!controlsOnly||!enabled||!haveFrame||watchShader==null||sourceRect.isEmpty())return;
    owner.getLocationOnScreen(hostLocation);getLocationOnScreen(selfLocation);
    watchLight(watchPaint,hostLocation[0]-selfLocation[0],hostLocation[1]-selfLocation[1],lightAppearance?165:230);
    float left=owner.getPaddingLeft(),right=owner.getWidth()-owner.getPaddingRight(),width=right-left;
    float amount=Math.max(0,Math.min(1,fraction));
    if(owner.getLayoutDirection()==View.LAYOUT_DIRECTION_RTL)left=right-width*amount;else right=left+width*amount;
    canvas.drawRect(left,owner.getPaddingTop(),right,owner.getHeight()-owner.getPaddingBottom(),watchPaint);watchPaint.setShader(null);
  }

  // A paused frame must follow a resized/repositioned player without a ticker.
  void geometryChanged() {
    updateSourceRect();fieldDirty=true;invalidate();invalidateGlass();
    if(enabled&&!animateFrames&&haveFrame)capture();
  }

  private void updateSourceRect() {
    if (testFrameMode) return;
    View host = sourceHost;
    if (host == null || getWidth() <= 0 || getHeight() <= 0) { sourceRect.setEmpty(); return; }
    getLocationOnScreen(selfLocation);
    host.getLocationOnScreen(hostLocation);
    float left = hostLocation[0] - selfLocation[0];
    float top = hostLocation[1] - selfLocation[1];
    sourceRect.set(left, top, left + host.getWidth(), top + host.getHeight());
    if(controlsOnly&&source!=null){visiblePicture(source,watchPicture,watchMatrix);source.getLocationOnScreen(hostLocation);
      sourceRect.set(watchPicture);sourceRect.offset(hostLocation[0]-selfLocation[0],hostLocation[1]-selfLocation[1]);}
  }

  @Override protected void onAttachedToWindow() {
    super.onAttachedToWindow();
    if (enabled) { capture(); if (animateFrames && !captureFailed) schedule(); }
  }

  @Override protected void onDetachedFromWindow() {
    cancelSchedule();
    super.onDetachedFromWindow();
  }

  @Override protected void onSizeChanged(int w, int h, int oldw, int oldh) {
    super.onSizeChanged(w, h, oldw, oldh);
    updateSourceRect();
  }

  static int lightPixel(int color, boolean light) {
    float r=Color.red(color)/255f,g=Color.green(color)/255f,b=Color.blue(color)/255f;
    float max=Math.max(r,Math.max(g,b)),min=Math.min(r,Math.min(g,b));
    float chroma=max-min;
    float neutral=light?0f:.55f*Math.max(0f,(max-.55f)/.45f);
    float energy=Math.min(1f,Math.max(0f,(max-.045f)/.45f)) * Math.min(1f,Math.max(chroma/.22f,neutral));
    float luminance=.2126f*r+.7152f*g+.0722f*b;
    if(light) energy*=1f-.70f*Math.max(0f,(luminance-.65f)/.35f);
    return Color.argb(Math.round(255f*energy),Color.red(color),Color.green(color),Color.blue(color));
  }

  private void rebuildField() {
    updateSourceRect();
    if (!haveFrame || smoothed==null || getWidth()<2 || getHeight()<2 || sourceRect.isEmpty()) return;
    int w=SAMPLE_WIDTH,h=Math.max(48,Math.min(512,Math.round(w*getHeight()/(float)getWidth())));
    if(field==null||field.getWidth()!=w||field.getHeight()!=h) {
      if(field!=null)field.recycle();
      field=Bitmap.createBitmap(w,h,Bitmap.Config.ARGB_8888);fieldCanvas=new Canvas(field);
      filtered=new int[w*h];blurScratch=new int[w*h];fieldDirty=true;
    }
    if(!fieldAnchor.equals(sourceRect))fieldDirty=true;
    if(!fieldDirty)return;
    fieldAnchor.set(sourceRect);fieldDirty=false;
    fieldCanvas.drawColor(Color.TRANSPARENT,android.graphics.PorterDuff.Mode.CLEAR);
    int save=fieldCanvas.save();fieldCanvas.scale(w/(float)getWidth(),h/(float)getHeight());
    float cx=sourceRect.centerX(),cy=sourceRect.centerY(),hw=sourceRect.width()/2f,hh=sourceRect.height()/2f;
    float outerScale=Math.max(1f,Math.max(Math.max(cx/hw,(getWidth()-cx)/hw),Math.max(cy/hh,(getHeight()-cy)/hh)));
    // Long falloff reaches far UI, with no enlarged frame or uniform tint pass.
    float reach=Math.max(getWidth(),getHeight())*.80f;
    int ex=Math.max(1,Math.round(smoothed.getWidth()*.04f)),ey=Math.max(1,Math.round(smoothed.getHeight()*.04f));
    int intensity=lightAppearance?62:218;
    paint.setColorFilter(saturation);
    for(int i=0;i<RAY_STEPS;i++) {
      float inner=1f+(outerScale-1f)*i/RAY_STEPS,outer=1f+(outerScale-1f)*(i+1f)/RAY_STEPS;
      float l=cx-hw*outer,t=cy-hh*outer,dx=hw*(outer-inner)+1.2f,dy=hh*(outer-inner)+1.2f;
      paint.setAlpha(Math.round(intensity*(float)Math.exp(-hh*(inner-1f)/reach)));
      src.set(0,0,smoothed.getWidth(),ey);dst.set(l,t,cx+hw*outer,t+dy);fieldCanvas.drawBitmap(smoothed,src,dst,paint);
      src.set(0,smoothed.getHeight()-ey,smoothed.getWidth(),smoothed.getHeight());
      dst.set(l,cy+hh*inner-.6f,cx+hw*outer,cy+hh*inner-.6f+dy);fieldCanvas.drawBitmap(smoothed,src,dst,paint);
      paint.setAlpha(Math.round(intensity*(float)Math.exp(-hw*(inner-1f)/reach)));
      src.set(0,0,ex,smoothed.getHeight());dst.set(l,cy-hh*inner,l+dx,cy+hh*inner+.6f);fieldCanvas.drawBitmap(smoothed,src,dst,paint);
      src.set(smoothed.getWidth()-ex,0,smoothed.getWidth(),smoothed.getHeight());
      dst.set(cx+hw*inner-.6f,cy-hh*inner,cx+hw*inner-.6f+dx,cy+hh*inner+.6f);fieldCanvas.drawBitmap(smoothed,src,dst,paint);
    }
    fieldCanvas.restoreToCount(save);paint.setColorFilter(null);paint.setAlpha(255);
    // Separable box blur in premultiplied colour. All arrays and bitmaps are reused.
    field.getPixels(filtered,0,w,0,0,w,h);
    blur(filtered,blurScratch,w,h,true);blur(blurScratch,filtered,w,h,false);
    field.setPixels(filtered,0,w,0,0,w,h);
  }

  private static void blur(int[] input,int[] output,int w,int h,boolean horizontal) {
    final int radius=4;
    for(int y=0;y<h;y++)for(int x=0;x<w;x++) {
      int sa=0,sr=0,sg=0,sb=0,count=0;
      for(int d=-radius;d<=radius;d++) {
        int xx=horizontal?x+d:x,yy=horizontal?y:y+d;
        if(xx<0||xx>=w||yy<0||yy>=h)continue;
        int c=input[yy*w+xx],a=Color.alpha(c);sa+=a;sr+=Color.red(c)*a;sg+=Color.green(c)*a;sb+=Color.blue(c)*a;count++;
      }
      output[y*w+x]=sa==0?0:Color.argb(sa/count,sr/sa,sg/sa,sb/sa);
    }
  }

  @SuppressWarnings("deprecation")
  private static void cut(Canvas canvas,float left,float top,float right,float bottom) {
    if(Build.VERSION.SDK_INT>=26)canvas.clipOutRect(left,top,right,bottom);
    else canvas.clipRect(left,top,right,bottom,android.graphics.Region.Op.DIFFERENCE);
  }

  @Override protected void onDraw(Canvas canvas) {
    super.onDraw(canvas);
    if(controlsOnly||!haveFrame||getAlpha()<=0f)return;
    try {rebuildField();}
    catch(RuntimeException | OutOfMemoryError unavailable) {
      captureFailed=true;enabled=false;cancelSchedule();haveFrame=false;restoreGlass();return;
    }
    if(field==null)return;
    int save=canvas.save();cut(canvas,sourceRect.left,sourceRect.top,sourceRect.right,sourceRect.bottom);
    windowRect.set(0,0,getWidth(),getHeight());paint.setColorFilter(null);paint.setAlpha(255);
    canvas.drawBitmap(field,null,windowRect,paint);canvas.restoreToCount(save);
  }

  void restoreGlass() {
    for(IlluminatedGlass item:glass){
      if(item.thumb){android.widget.SeekBar seek=(android.widget.SeekBar)item.owner;if(seek.getThumb()==item)seek.setThumb(item.base);}
      else if(item.owner.getBackground()==item){item.owner.setBackground(item.base);item.base.setCallback(item.owner);}
    }
    glass.clear();
  }
  void illuminate(View root) {
    restoreGlass();if(!enabled)return;collectGlass(root,0);
  }
  private void collectGlass(View view,int depth) {
    if(view==null||view==sourceHost||view==this||view instanceof TextureView||view instanceof android.view.SurfaceView
        ||view instanceof android.webkit.WebView||depth>24||glass.size()>=512)return;
    Drawable background=view.getBackground();
    // Structural containers retain their material identity. Add local transmission
    // over existing surfaces, never replace text/focus/selection drawables.
    if(background!=null && view!=getParent() && view!=rootViewForGlass() && !"cobra-browse-background".equals(view.getTag())) {
      IlluminatedGlass item=new IlluminatedGlass(view,background);glass.add(item);view.setBackground(item);
    }
    if(view instanceof ViewGroup) {ViewGroup group=(ViewGroup)view;for(int i=0;i<group.getChildCount();i++)collectGlass(group.getChildAt(i),depth+1);}
  }
  void illuminateWatch(View progress,View... roots){
    restoreGlass();watchRoots.clear();watchProgress=progress;
    for(View root:roots)if(root!=null){watchRoots.add(root);if(enabled)collectWatch(root,0);}
  }
  private void collectWatch(View view,int depth){
    if(view==null||view==source||view==this||view instanceof TextureView||view instanceof android.view.SurfaceView||depth>24||glass.size()>=512)return;
    Drawable base=view.getBackground();
    if(base instanceof CobraVisualRenderer.Glass||base instanceof android.graphics.drawable.RippleDrawable
        ||base instanceof android.graphics.drawable.StateListDrawable||view instanceof android.widget.Button){
      if(base!=null){IlluminatedGlass item=new IlluminatedGlass(view,base);glass.add(item);view.setBackground(item);}
    }
    if(view instanceof android.widget.SeekBar){android.widget.SeekBar seek=(android.widget.SeekBar)view;
      if(seek.getThumb()!=null){IlluminatedGlass item=new IlluminatedGlass(view,seek.getThumb());item.thumb=true;glass.add(item);seek.setThumb(item);}}
    if(view instanceof ViewGroup){ViewGroup group=(ViewGroup)view;for(int i=0;i<group.getChildCount();i++)collectWatch(group.getChildAt(i),depth+1);}
  }
  private View rootViewForGlass(){return getRootView();}
  private void invalidateGlass(){for(IlluminatedGlass item:glass)item.invalidateSelf();if(watchProgress!=null)watchProgress.invalidate();}

  private final class IlluminatedGlass extends Drawable implements Drawable.Callback {
    final View owner;final Drawable base;final int[] location=new int[2];boolean thumb;
    final RectF local=new RectF(),projection=new RectF();final Path shape=new Path(),rim=new Path();
    final Paint transmission=new Paint(Paint.ANTI_ALIAS_FLAG|Paint.FILTER_BITMAP_FLAG);
    IlluminatedGlass(View view,Drawable drawable){owner=view;base=drawable;base.setCallback(this);}
    @Override public void draw(Canvas canvas) {
      base.setBounds(getBounds());base.draw(canvas);
      if(controlsOnly){drawWatch(canvas);return;}
      if(!haveFrame||CobraImmersiveAmbient.this.getAlpha()<=0f||field==null||owner==sourceHost)return;
      owner.getLocationOnScreen(location);getLocationOnScreen(selfLocation);
      float x=location[0]-selfLocation[0],y=location[1]-selfLocation[1];
      local.set(getBounds());float radius=base instanceof CobraVisualRenderer.Glass?((CobraVisualRenderer.Glass)base).radius:12f*getResources().getDisplayMetrics().density;
      shape.reset();shape.addRoundRect(local,radius,radius,Path.Direction.CW);
      projection.set(-x,-y,getWidth()-x,getHeight()-y);
      int save=canvas.save();canvas.clipPath(shape);
      // Keep the sacred player rectangle masked even for ancestor surfaces.
      cut(canvas,sourceRect.left-x,sourceRect.top-y,sourceRect.right-x,sourceRect.bottom-y);
      transmission.setAlpha(Math.round((lightAppearance?68:105)*CobraImmersiveAmbient.this.getAlpha()));canvas.drawBitmap(field,null,projection,transmission);
      rim.reset();rim.addRoundRect(local,radius,radius,Path.Direction.CW);
      dst.set(local);float lip=Math.max(1f,getResources().getDisplayMetrics().density*1.4f);dst.inset(lip,lip);
      rim.addRoundRect(dst,Math.max(0,radius-lip),Math.max(0,radius-lip),Path.Direction.CCW);canvas.clipPath(rim);
      transmission.setAlpha(Math.round((lightAppearance?220:245)*CobraImmersiveAmbient.this.getAlpha()));canvas.drawBitmap(field,null,projection,transmission);
      canvas.restoreToCount(save);
    }
    private void drawWatch(Canvas canvas){
      if(!haveFrame||watchShader==null||sourceRect.isEmpty()||getAlpha()<=0f)return;
      owner.getLocationOnScreen(location);getLocationOnScreen(selfLocation);
      local.set(getBounds());float radius=thumb||"cobra_player_play_pause".equals(owner.getTag())?Math.min(local.width(),local.height())/2
          :base instanceof CobraVisualRenderer.Glass?((CobraVisualRenderer.Glass)base).radius:12f*getResources().getDisplayMetrics().density;
      shape.reset();shape.addRoundRect(local,radius,radius,Path.Direction.CW);int save=canvas.save();canvas.clipPath(shape);
      float x=location[0]-selfLocation[0],y=location[1]-selfLocation[1];
      watchLight(transmission,x,y,thumb?230:lightAppearance?62:95);canvas.drawRect(local,transmission);
      rim.reset();rim.addRoundRect(local,radius,radius,Path.Direction.CW);dst.set(local);float lip=getResources().getDisplayMetrics().density*1.5f;dst.inset(lip,lip);
      rim.addRoundRect(dst,Math.max(0,radius-lip),Math.max(0,radius-lip),Path.Direction.CCW);canvas.clipPath(rim);
      watchLight(transmission,x,y,owner.isFocused()||owner.isPressed()||owner.isSelected()?90:lightAppearance?195:245);canvas.drawRect(local,transmission);
      transmission.setShader(null);canvas.restoreToCount(save);
    }
    @Override protected boolean onStateChange(int[] states){boolean changed=base.setState(states);invalidateSelf();return changed;}
    @Override public boolean isStateful(){return base.isStateful();}
    @Override protected boolean onLevelChange(int level){return base.setLevel(level);}
    @Override public int getIntrinsicWidth(){return base.getIntrinsicWidth();}
    @Override public int getIntrinsicHeight(){return base.getIntrinsicHeight();}
    @Override public int getMinimumWidth(){return base.getMinimumWidth();}
    @Override public int getMinimumHeight(){return base.getMinimumHeight();}
    @Override public boolean setVisible(boolean visible,boolean restart){boolean changed=base.setVisible(visible,restart);return super.setVisible(visible,restart)||changed;}
    @Override public boolean getPadding(Rect padding){return base.getPadding(padding);}
    @Override public void getOutline(android.graphics.Outline outline){base.getOutline(outline);}
    @Override public void setAlpha(int alpha){base.setAlpha(alpha);}
    @Override public void setColorFilter(android.graphics.ColorFilter filter){base.setColorFilter(filter);}
    @Override public int getOpacity(){return android.graphics.PixelFormat.TRANSLUCENT;}
    @Override public void jumpToCurrentState(){base.jumpToCurrentState();}
    @Override public void invalidateDrawable(Drawable who){invalidateSelf();}
    @Override public void scheduleDrawable(Drawable who,Runnable what,long when){scheduleSelf(what,when);}
    @Override public void unscheduleDrawable(Drawable who,Runnable what){unscheduleSelf(what);}
  }

  // Deterministic rendering hooks for tests; production never calls these.
  void testPlainRendering(boolean value) {
    // Production and tests use the same bounded bitmap blur.

  }
  void testAnchor(View host) {sourceHost=host;testFrameMode=false;fieldDirty=true;updateSourceRect();}
  void testFrame(Bitmap bitmap, RectF rect, boolean light) {
    if (bitmap == null) return;
    ensureBuffers(bitmap.getWidth(), bitmap.getHeight());
    Canvas c = new Canvas(smoothed);c.drawColor(Color.TRANSPARENT, android.graphics.PorterDuff.Mode.CLEAR);
    paint.setColorFilter(null);paint.setAlpha(255);c.drawBitmap(bitmap, 0, 0, paint);paint.setColorFilter(saturation);
    fieldDirty = true;haveFrame = true;enabled = true;testFrameMode = true;lightAppearance = light;sourceRect.set(rect);setAlpha(1f);setVisibility(VISIBLE);
    if(controlsOnly)updateWatchPalette();invalidate();
  }
}
