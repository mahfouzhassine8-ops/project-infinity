+def _progress_rows(data, query=None):
+    """One alias proof input for Continue, Progress Shows and Next Episodes."""
+    locations = [(bucket, key, value) for bucket in ('watched', 'items')
+                 for key, value in data[bucket].items()
+                 if isinstance(value, dict)]
+    if query is not None:
+        locations.append(('query', query.get('key'), query))
+    groups = _resume_groups([value for _, _, value in locations], series=True)
+    def contradictory_parent(value):
+        identity = _resume_identity(value)
+        if not identity or identity.get('scope') not in ('show_episode', 'show', 'show_season') or value.get('show_ids_verified') is not True:
+            return False
+        parent = verified_ids({name: value.get('show_' + name) for name in ('tmdb', 'tvdb', 'imdb')})
+        return any(identity['ids'][name] != parent[name] for name in set(identity['ids']) & set(parent))
+    # A replay can retain both watched and unfinished state under one original
+    # key even when no parent-series identity is known. Keep that exact record
+    # together without merging different legacy keys or guessing a series.
+    unproven = {}
+    for index, (_, key, value) in enumerate(locations):
+        if value.get('media') != 'tv':
+            continue
+        prior = unproven.get(key)
+        if prior is not None:
+            other = locations[prior][2]
+            if contradictory_parent(value) or contradictory_parent(other):
+                continue
+            known, previous = continue_series_ids(value), continue_series_ids(other)
+            if known and previous:
+                continue  # Conflicting proven components must stay quarantined.
+            a, b = _resume_identity(other), _resume_identity(value)
+            if (same_identity(a, b) or (not a and not b and
+                    all(other.get(name) == value.get(name) for name in ('media', 'source', 'season', 'episode')))):
+                if known:
+                    groups[prior] = groups[index]
+                else:
+                    groups[index] = groups[prior]
+        else:
+            unproven[key] = index
+    return [(bucket, key, value, group) for (bucket, key, value), group in zip(locations, groups)]
+
