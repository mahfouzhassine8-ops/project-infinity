+def exact_progress(data, entry):
+    """Current progress for one playable movie/episode, never a series card.
+
+    All saved projections use the same existing identity/alias contracts. This
+    does not change identities, routes, membership, history or progress keys.
+    """
+    import math
+    if not isinstance(data, dict) or not isinstance(entry, dict) or entry.get('synthetic_next'):
+        return None
+    identity = _resume_identity(entry)
+    locations = []
+    if identity:
+        if identity.get('kind') not in ('movie', 'episode'):
+            return None
+        values = []
+        for bucket in ('items', 'watched'):
+            for key, row in _dict(data.get(bucket)).items():
+                if KEY_RE.fullmatch(str(key)) and isinstance(row, dict) and _resume_identity(row):
+                    values.append(row)
+                    locations.append((bucket, key, row))
+        groups = _resume_groups(values + [entry], series=False)
+        locations = [location for location, group in zip(locations, groups) if group == groups[-1]]
+    else:
+        # Retain an old row's own existing offset without guessing a new typed
+        # identity. Legacy keys never join other records by title or source.
+        key = entry.get('key')
+        old = _dict(data.get('items')).get(key)
+        if (not KEY_RE.fullmatch(str(key)) or not isinstance(old, dict) or
+                entry.get('media') not in ('movie', 'tv') or
+                any(old.get(name) != entry.get(name) for name in ('media', 'source', 'season', 'episode'))):
+            return None
+        a = verified_ids({name: old.get(name) for name in ('tmdb', 'tvdb', 'imdb')})
+        b = verified_ids({name: entry.get(name) for name in ('tmdb', 'tvdb', 'imdb')})
+        if any(a[name] != b[name] for name in set(a) & set(b)) or (_resume_identity(old) and not _agreeing_ids(a, b)):
+            return None
+        locations = [('items', key, old)]
+        watched = _dict(data.get('watched')).get(key)
+        if isinstance(watched, dict):
+            locations.append(('watched', key, watched))
+    items = [(key, row) for bucket, key, row in locations if bucket == 'items']
+    if not items:
+        return None
+
+    def marker(row):
+        try:
+            return (int(row.get('updated') or row.get('watched_at') or 0), int(row.get('resume_revision') or 0))
+        except (TypeError, ValueError, OverflowError):
+            return (0, 0)
+
+    key, row = max(items, key=lambda pair: (marker(pair[1]), pair[0]))
+    if not resume_visible(data, key):
+        return None
+    for bucket, _, watched in locations:
+        if bucket == 'watched' and (marker(watched) >= marker(row) or
+                (row.get('playback_occurrence') and watched.get('completed_occurrence') == row['playback_occurrence'])):
+            return None
+    try:
+        if type(row.get('position')) is bool or type(row.get('duration')) is bool:
+            return None
+        position, duration = float(row.get('position')), float(row.get('duration'))
+        if not (math.isfinite(position) and math.isfinite(duration) and
+                0 < position < duration and position / duration < .95):
+            return None
+    except (TypeError, ValueError, OverflowError):
+        return None
+    return _entry_copy(row, key)
+
