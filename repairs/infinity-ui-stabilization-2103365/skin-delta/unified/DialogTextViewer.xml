<?xml version='1.0' encoding='utf-8'?>
<window>
  <defaultcontrol always="true">62</defaultcontrol>
  <animation effect="fade" start="0" end="100" time="160" condition="!String.IsEqual(Window(Home).Property(Infinity.OptionalMotionAllowed),false)">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="110" condition="!String.IsEqual(Window(Home).Property(Infinity.OptionalMotionAllowed),false)">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>100%</width>
      <height>100%</height>
      <texture colordiffuse="$VAR[InfinityLegacyScrim]">infinity_ui/contract_white.png</texture>
    </control>
    <control type="group" id="9900">
      <left>3.5%</left>
      <right>3.5%</right>
      <top>3.5%</top>
      <bottom>3.5%</bottom>
      <control type="image">
        <left>0</left>
        <top>0</top>
        <width>100%</width>
        <height>100%</height>
        <texture colordiffuse="$VAR[InfinityUIRepairSurface]" border="24">infinity_glass/surface.png</texture>
      </control>
      <control type="image">
        <left>0</left>
        <top>0</top>
        <width>100%</width>
        <height>100%</height>
        <texture colordiffuse="$VAR[InfinityGlassSpecular]" border="24">infinity_glass/rim.png</texture>
      </control>
      <control type="button" id="995">
        <right>18</right>
        <top>18</top>
        <width>64</width>
        <height>64</height>
        <label />
        <onclick>Dialog.Close(textviewer)</onclick>
        <onleft>61</onleft>
        <onright>61</onright>
        <onup>61</onup>
        <ondown>61</ondown>
        <texturefocus colordiffuse="$VAR[InfinityLegacyAccent]">infinity_legacy/close_focus.png</texturefocus>
        <texturenofocus colordiffuse="$VAR[InfinityLegacyText]">infinity_legacy/close.png</texturenofocus>
      </control>
      <control type="button" id="62">
        <onclick>Dialog.Close(textviewer)</onclick>
        <onleft>Dialog.Close(textviewer)</onleft>
        <onright>Dialog.Close(textviewer)</onright>
        <onup>PageUp(61)</onup>
        <ondown>PageDown(61)</ondown>
        <include>InfinityLegacy_HiddenObject</include>
      </control>
      <control type="label" id="1">
        <font>InfinityTitle</font>
        <align>center</align>
        <textcolor>$VAR[InfinityLegacyText]</textcolor>
        <left>24</left>
        <top>18</top>
        <right>106</right>
        <height>64</height>
        <scroll>true</scroll>
      </control>
      <control type="textbox" id="5">
        <textcolor>$VAR[InfinityLegacyText]</textcolor>
        <pagecontrol>61</pagecontrol>
        <left>24</left>
        <top>104</top>
        <right>62</right>
        <bottom>24</bottom>
        <font>InfinityBody</font>
      </control>
      <control type="scrollbar" id="61">
        <ondown>61</ondown>
        <onup>61</onup>
        <showonepage>false</showonepage>
        <texturesliderbackground border="6" colordiffuse="$VAR[InfinityLegacyField]">infinity_legacy/track.png</texturesliderbackground>
        <texturesliderbar border="6" colordiffuse="$VAR[InfinityLegacyTrack]">infinity_legacy/track.png</texturesliderbar>
        <texturesliderbarfocus border="6" colordiffuse="$VAR[InfinityLegacyAccent]">infinity_legacy/track.png</texturesliderbarfocus>
        <right>22</right>
        <top>104</top>
        <width>26</width>
        <bottom>24</bottom>
        <onleft>995</onleft>
        <onright>995</onright>
      </control>
    </control>
  </controls>
</window>
