package @APP_PACKAGE@;

import android.app.Activity;
import android.app.Dialog;
import android.content.Context;
import android.content.DialogInterface;
import android.content.SharedPreferences;
import android.content.res.Configuration;
import android.graphics.*;
import android.graphics.drawable.*;
import android.content.res.ColorStateList;
import android.os.Build;
import android.view.*;
import android.view.accessibility.AccessibilityNodeInfo;
import android.widget.*;

/** Chooser options presentation only. Labels and action indices come from Splash unchanged.
 * Uses the same independent glass/brand plates as the accepted chooser. No native calls,
 * activity launch, preference writes, media, networking, window-blur dependency or timers.
 */
final class InfinityGlassOptions extends Dialog {
  interface Appearance { boolean light(); }
  static final int ROW_ID = 0x00f02580, CANCEL_ID = 0x00f02589;
  final Activity owner;
  final boolean cobra;
  final String heading;
  final String[] labels;
  final Appearance appearance;
  final DialogInterface.OnClickListener action;
  final SharedPreferences preferences;
  Panel panel;
  boolean light, delivered, subscribed;
  private int lastWidth, lastHeight;
  private ViewTreeObserver observedTree;
  private final ViewTreeObserver.OnGlobalLayoutListener resize = () -> fitWindow();
  private final Runnable refresh = this::refreshPresentation;
  private void refreshPresentation() {
    if (!isShowing()) return;
    if (light != appearance.light()) {
      int selected = panel == null || panel.findFocus() == null ? View.NO_ID : panel.findFocus().getId();
      int position = panel == null ? 0 : panel.scroll.getScrollY();
      rebuild(); fitWindow();
      if (selected != View.NO_ID) {
        View v = panel.findViewById(selected); if (v != null) v.requestFocus();
      }
      panel.scroll.post(() -> panel.scroll.scrollTo(0, position));
    } else fitWindow();
  }
  private final SharedPreferences.OnSharedPreferenceChangeListener preferenceChanged = (p,key) -> {
    if (key == null || "cobra_appearance_mode".equals(key) || "cobra_system_dark_variant".equals(key)) queueRefresh();
  };

  InfinityGlassOptions(Activity owner, boolean cobra, String heading, String[] labels,
                       Appearance appearance, DialogInterface.OnClickListener action) {
    super(owner, android.R.style.Theme_Material_Dialog_Alert);
    if (labels == null || labels.length != (cobra ? 5 : 4)) throw new IllegalArgumentException("Unexpected options contract");
    this.owner=owner;this.cobra=cobra;this.heading=heading;this.labels=labels.clone();
    this.appearance=appearance;this.action=action;
    preferences=owner.getSharedPreferences("infinity_cobra_live",Context.MODE_PRIVATE);
    setOwnerActivity(owner);requestWindowFeature(Window.FEATURE_NO_TITLE);setTitle(heading);
    setCancelable(true);setCanceledOnTouchOutside(true);rebuild();
    Window window=getWindow();
    if(window != null) {
      window.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
      window.addFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
      window.setDimAmount(light ? .24f : .43f);
      window.setGravity(Gravity.CENTER);
      window.getDecorView().setTag("experience_glass_options_dialog");
    }
  }
  private void rebuild() {
    int launchChoice=panel==null?ROW_ID+1:panel.launchChoices.getCheckedRadioButtonId();
    light=appearance.light();panel=new Panel(owner,light,cobra,heading,labels,this::choose,this::cancel,this::queueRefresh);
    panel.launchChoices.check(launchChoice);
    setContentView(panel);
    if(getWindow()!=null) getWindow().setDimAmount(light ? .24f : .43f);
  }
  private void choose(int index) {
    if(delivered || !isShowing() || index<0 || index>=labels.length) return;
    delivered=true;
    // Dismiss before an action opens a different window/activity, avoiding orphan dialogs.
    dismiss();action.onClick(this,index);
  }
  private void queueRefresh() {
    if(panel!=null) {panel.removeCallbacks(refresh);panel.post(refresh);}
  }
  @Override protected void onStart() {
    super.onStart();
    if(!subscribed) {preferences.registerOnSharedPreferenceChangeListener(preferenceChanged);subscribed=true;}
    observedTree=owner.getWindow().getDecorView().getViewTreeObserver();
    observedTree.addOnGlobalLayoutListener(resize);fitWindow();queueRefresh();
  }
  @Override protected void onStop() {
    if(subscribed){preferences.unregisterOnSharedPreferenceChangeListener(preferenceChanged);subscribed=false;}
    if(observedTree!=null && observedTree.isAlive())observedTree.removeOnGlobalLayoutListener(resize);
    observedTree=null;if(panel!=null)panel.removeCallbacks(refresh);super.onStop();
  }
  private void fitWindow() {
    Window window=getWindow();if(window==null||panel==null)return;
    Rect visible=new Rect();View decor=owner.getWindow().getDecorView();decor.getWindowVisibleDisplayFrame(visible);
    int width=visible.width(),height=visible.height();
    if(width<=0)width=decor.getWidth();if(height<=0)height=decor.getHeight();
    if(width<=0)width=owner.getResources().getDisplayMetrics().widthPixels;
    if(height<=0)height=owner.getResources().getDisplayMetrics().heightPixels;
    int target=Math.max(1,Math.min(width-panel.dp(24),panel.dp(460)));
    int cap=Math.max(1,height-panel.dp(24));
    if(lastWidth!=target || lastHeight!=cap || panel.maxHeight!=cap) {
      lastWidth=target;lastHeight=cap;panel.maxHeight=cap;panel.requestLayout();
      window.setLayout(target,WindowManager.LayoutParams.WRAP_CONTENT);
    }
  }
  interface Pick {void at(int index);}

  /** Header and Cancel stay visible; only options scroll in a short/folded window. */
  static final class Panel extends ViewGroup {
    final boolean light,cobra;final Palette palette;
    final LinearLayout header,footer,rows;final ScrollView scroll;
    final RadioGroup launchChoices;
    final TextView title,cancel;final View divider;final Runnable changed;
    int maxHeight=Integer.MAX_VALUE;
    Panel(Context c,boolean light,boolean cobra,String heading,String[] labels,Pick pick,Runnable close,Runnable changed){
      super(c);this.light=light;this.cobra=cobra;this.changed=changed;palette=new Palette(light,cobra);
      setTag("experience_glass_options_panel");setBackground(new GlassSurface(c,palette));
      setClipChildren(true);setClipToPadding(true);setClipToOutline(true);
      header=new LinearLayout(c);header.setGravity(Gravity.CENTER_VERTICAL);
      BrandMark mark=new BrandMark(c,cobra);
      LinearLayout.LayoutParams logo=new LinearLayout.LayoutParams(dp(48),dp(48));logo.rightMargin=dp(12);header.addView(mark,logo);
      title=text(c,heading,22,palette.ink,true);title.setGravity(Gravity.CENTER_VERTICAL);
      if(Build.VERSION.SDK_INT>=28)title.setAccessibilityHeading(true);
      header.addView(title,new LinearLayout.LayoutParams(0,LayoutParams.WRAP_CONTENT,1));addView(header);
      divider=new View(c);divider.setBackground(new GradientDrawable(GradientDrawable.Orientation.LEFT_RIGHT,
          new int[]{alpha(palette.accent,0),alpha(palette.accent,120),alpha(palette.accent,0)}));addView(divider);
      rows=new LinearLayout(c);rows.setOrientation(LinearLayout.VERTICAL);
      // One launch-behaviour section, not three independent settings/actions.
      LinearLayout launch=new LinearLayout(c);launch.setOrientation(LinearLayout.VERTICAL);
      launch.setTag("experience_launch_section");launch.setPadding(dp(12),dp(12),dp(12),dp(12));
      launch.setBackground(rowSurface(palette,dp(18)));
      TextView launchHeading=text(c,"Launch behaviour",16,palette.ink,false);
      if(Build.VERSION.SDK_INT>=28)launchHeading.setAccessibilityHeading(true);
      launch.addView(launchHeading,new LinearLayout.LayoutParams(-1,-2));
      launchChoices=new RadioGroup(c);launchChoices.setOrientation(RadioGroup.VERTICAL);
      for(int i=0;i<3;i++) {
        RadioButton choice=new RadioButton(c);choice.setId(ROW_ID+i);choice.setText(labels[i]);
        choice.setTag("experience_launch_choice_"+i);choice.setTextColor(palette.ink);
        choice.setTextSize(16);choice.setTypeface(Typeface.create("sans-serif",Typeface.NORMAL));
        choice.setMinHeight(dp(48));choice.setPadding(dp(4),dp(8),dp(4),dp(8));
        choice.setButtonTintList(ColorStateList.valueOf(palette.accent));
        launchChoices.addView(choice,new RadioGroup.LayoutParams(-1,-2));
      }
      launchChoices.check(ROW_ID+1);launch.addView(launchChoices,new LinearLayout.LayoutParams(-1,-2));
      TextView launchAction=text(c,cobra?"Launch Cobra":"Launch Infinity",16,palette.accent,false);
      launchAction.setTag("experience_launch_apply");launchAction.setId(ROW_ID+16);
      launchAction.setGravity(Gravity.CENTER);launchAction.setMinHeight(dp(48));
      launchAction.setFocusable(true);launchAction.setClickable(true);
      launchAction.setBackground(rowSurface(palette,dp(14)));
      launchChoices.setOnCheckedChangeListener((group,id)->launchAction.setText(
          id==ROW_ID+2?"Save choice":cobra?"Launch Cobra":"Launch Infinity"));
      launchAction.setOnClickListener(v->pick.at(launchChoices.getCheckedRadioButtonId()-ROW_ID));
      launch.addView(launchAction,new LinearLayout.LayoutParams(-1,-2));
      LinearLayout.LayoutParams launchBounds=new LinearLayout.LayoutParams(-1,-2);launchBounds.bottomMargin=dp(12);
      rows.addView(launch,launchBounds);
      for(int i=3;i<labels.length;i++) {
        final int index=i;OptionRow row=new OptionRow(c,labels[i],i,palette);row.setId(ROW_ID+i);
        row.setTag("experience_glass_options_row_"+i);row.setOnClickListener(v->pick.at(index));
        row.setNextFocusUpId(i==0?CANCEL_ID:ROW_ID+i-1);row.setNextFocusDownId(i+1==labels.length?CANCEL_ID:ROW_ID+i+1);
        LinearLayout.LayoutParams lp=new LinearLayout.LayoutParams(-1,-2);lp.bottomMargin=i+1==labels.length?0:dp(8);rows.addView(row,lp);
      }
      scroll=new ScrollView(c);scroll.setVerticalScrollBarEnabled(false);scroll.setOverScrollMode(OVER_SCROLL_IF_CONTENT_SCROLLS);
      scroll.addView(rows,new ScrollView.LayoutParams(-1,-2));addView(scroll);
      footer=new LinearLayout(c);footer.setGravity(Gravity.END|Gravity.CENTER_VERTICAL);
      cancel=text(c,"Cancel",14,palette.accent,false);cancel.setGravity(Gravity.CENTER);cancel.setMinHeight(dp(48));
      cancel.setPadding(dp(26),dp(10),dp(26),dp(10));cancel.setFocusable(true);cancel.setClickable(true);cancel.setId(CANCEL_ID);
      cancel.setTag("experience_glass_options_cancel");cancel.setBackground(rowSurface(palette,dp(24)));
      cancel.setOnClickListener(v->close.run());cancel.setNextFocusUpId(ROW_ID+labels.length-1);cancel.setNextFocusDownId(ROW_ID);
      footer.addView(cancel,new LinearLayout.LayoutParams(-2,-2));addView(footer);
    }
    int dp(float n){return Math.round(n*getResources().getDisplayMetrics().density);}
    @Override protected void onConfigurationChanged(Configuration c){super.onConfigurationChanged(c);post(changed);}
    @Override protected void onMeasure(int ws,int hs){
      int w=MeasureSpec.getSize(ws);if(w<=0)w=dp(360);
      int cap=maxHeight;if(MeasureSpec.getMode(hs)!=MeasureSpec.UNSPECIFIED)cap=Math.min(cap,MeasureSpec.getSize(hs));
      int pad=dp(24),gap=dp(12),inner=Math.max(1,w-pad*2);
      int childWidth=MeasureSpec.makeMeasureSpec(inner,MeasureSpec.EXACTLY);
      int free=MeasureSpec.makeMeasureSpec(0,MeasureSpec.UNSPECIFIED);
      header.measure(childWidth,free);footer.measure(childWidth,free);
      divider.measure(childWidth,MeasureSpec.makeMeasureSpec(Math.max(1,dp(1)),MeasureSpec.EXACTLY));
      int reserved=pad*2+header.getMeasuredHeight()+footer.getMeasuredHeight()+gap*3+divider.getMeasuredHeight();
      int remaining=Math.max(1,cap==Integer.MAX_VALUE?dp(1200):cap-reserved);
      scroll.measure(childWidth,MeasureSpec.makeMeasureSpec(remaining,MeasureSpec.AT_MOST));
      setMeasuredDimension(w,Math.min(cap,reserved+scroll.getMeasuredHeight()));
    }
    @Override protected void onLayout(boolean changed,int l,int t,int r,int b){
      int p=dp(24),g=dp(12),right=getWidth()-p,y=p;
      header.layout(p,y,right,y+header.getMeasuredHeight());y+=header.getMeasuredHeight()+g;
      divider.layout(p,y,right,y+divider.getMeasuredHeight());y+=divider.getMeasuredHeight()+g;
      scroll.layout(p,y,right,y+scroll.getMeasuredHeight());
      footer.layout(p,getHeight()-p-footer.getMeasuredHeight(),right,getHeight()-p);
    }
  }
  static final class OptionRow extends LinearLayout {
    OptionRow(Context c,String label,int icon,Palette p){
      super(c);
      setOrientation(HORIZONTAL);setGravity(Gravity.CENTER_VERTICAL);setMinimumHeight(dp(c,60));
      setPadding(dp(c,12),dp(c,12),dp(c,14),dp(c,12));setFocusable(true);setClickable(true);
      setBackground(rowSurface(p,dp(c,18)));setContentDescription(label);
      setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_YES);
      Glyph glyph=new Glyph(c,icon,p);LinearLayout.LayoutParams glp=new LinearLayout.LayoutParams(dp(c,34),dp(c,34));glp.rightMargin=dp(c,12);addView(glyph,glp);
      TextView text=text(c,label,16,p.ink,false);text.setGravity(Gravity.CENTER_VERTICAL);text.setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
      addView(text,new LinearLayout.LayoutParams(0,LayoutParams.WRAP_CONTENT,1));
      TextView chevron=text(c,"›",24,p.accent,false);chevron.setGravity(Gravity.CENTER);chevron.setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
      LinearLayout.LayoutParams end=new LinearLayout.LayoutParams(dp(c,16),dp(c,28));end.leftMargin=dp(c,8);addView(chevron,end);
    }
    @Override public void onInitializeAccessibilityNodeInfo(AccessibilityNodeInfo info){super.onInitializeAccessibilityNodeInfo(info);info.setClassName("android.widget.Button");}
  }
  static final class Palette {
    final boolean light,cobra;final int ink,accent,top,bottom;
    Palette(boolean light,boolean cobra){this.light=light;this.cobra=cobra;
      ink=light?0xff0b2239:0xfff1f6ff;
      accent=light?(cobra?0xff08708b:0xff82601e):(cobra?0xff6fe4ff:0xfff5d28c);
      top=light?0xfff8fbff:0xff142637;bottom=light?0xffe8edf3:0xff081624;
    }
  }
  private static int dp(Context c,float n){return Math.round(n*c.getResources().getDisplayMetrics().density);}
  private static int alpha(int color,int opacity){return(color&0x00ffffff)|(opacity<<24);}
  static TextView text(Context c,String text,float sp,int color,boolean serif){
    TextView t=new TextView(c);t.setText(text);t.setTextSize(sp);t.setTextColor(color);t.setIncludeFontPadding(false);
    t.setTypeface(Typeface.create(serif?"serif":"sans-serif",Typeface.NORMAL));t.setLetterSpacing(serif?.015f:.01f);
    t.setLineSpacing(dp(c,2),1f);return t;
  }
  static Drawable rowSurface(Palette p,float radius){
    GradientDrawable plain=new GradientDrawable(GradientDrawable.Orientation.TL_BR,
        p.light?new int[]{0xdfffffff,0x86f4faff,0xb3ffffff}:new int[]{0xa02a3a4f,0x80122233,0xa00c1c2d});
    plain.setCornerRadius(radius);plain.setStroke(1,alpha(p.accent,p.light?65:75));
    GradientDrawable focus=new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
        new int[]{alpha(p.accent,p.light?45:70),alpha(p.accent,p.light?20:30)});
    focus.setCornerRadius(radius);focus.setStroke(2,alpha(p.accent,230));
    StateListDrawable states=new StateListDrawable();states.addState(new int[]{android.R.attr.state_focused},focus);states.addState(new int[]{},plain);
    GradientDrawable mask=new GradientDrawable();mask.setColor(Color.WHITE);mask.setCornerRadius(radius);
    return new RippleDrawable(ColorStateList.valueOf(alpha(p.accent,55)),states,mask);
  }
  /** One continuous opaque-backed optical surface: no frame-slice seams or text bleed.
   * Glass depth comes from low-contrast highlights above the backing, not transparency
   * onto the chooser's lettering. All gradients are prepared only when bounds change.
   */
  static final class GlassSurface extends Drawable {
    final Palette palette;final Paint paint=new Paint(Paint.ANTI_ALIAS_FLAG);
    final RectF box=new RectF(),rim=new RectF();final Path clip=new Path();
    final float density,radius;Shader base,glow,sheen,bevel;int opacity=255;ColorFilter filter;
    GlassSurface(Context c,Palette p){palette=p;density=c.getResources().getDisplayMetrics().density;radius=28*density;}
    @Override protected void onBoundsChange(Rect bounds){
      box.set(bounds);clip.reset();clip.addRoundRect(box,radius,radius,Path.Direction.CW);
      int middle=palette.light?(palette.cobra?0xffe5f0f5:0xfff2ede3):
          (palette.cobra?0xff102839:0xff29271f);
      base=new LinearGradient(box.left,box.top,box.right,box.bottom,
          new int[]{palette.top,middle,palette.bottom},new float[]{0,.56f,1},Shader.TileMode.CLAMP);
      glow=new RadialGradient(box.right,box.top,Math.max(1,box.width()*.9f),
          new int[]{alpha(palette.accent,palette.light?22:28),alpha(palette.accent,0)},null,Shader.TileMode.CLAMP);
      sheen=new LinearGradient(box.left,box.top,box.right,box.top+Math.max(1,box.height()*.28f),
          new int[]{alpha(Color.WHITE,palette.light?105:24),alpha(Color.WHITE,0)},null,Shader.TileMode.CLAMP);
      bevel=new LinearGradient(box.left,box.top,box.right,box.bottom,
          new int[]{alpha(Color.WHITE,245),alpha(palette.accent,150),alpha(Color.WHITE,palette.light?225:135),alpha(palette.accent,235)},
          new float[]{0,.34f,.64f,1},Shader.TileMode.CLAMP);
    }
    @Override public void draw(Canvas canvas){
      int save=canvas.save();canvas.clipPath(clip);
      paint.setStyle(Paint.Style.FILL);paint.setColorFilter(filter);paint.setAlpha(opacity);
      paint.setShader(base);canvas.drawRect(box,paint);
      paint.setShader(glow);canvas.drawRect(box,paint);
      paint.setShader(sheen);canvas.drawRect(box,paint);
      paint.setStyle(Paint.Style.STROKE);paint.setShader(bevel);
      rim.set(box);rim.inset(2.5f*density,2.5f*density);paint.setStrokeWidth(4*density);
      canvas.drawRoundRect(rim,radius-2.5f*density,radius-2.5f*density,paint);
      paint.setShader(null);paint.setColor(alpha(palette.accent,palette.light?150:185));
      paint.setAlpha(Math.round(Color.alpha(paint.getColor())*(opacity/255f)));paint.setStrokeWidth(.75f*density);
      rim.set(box);rim.inset(.6f*density,.6f*density);canvas.drawRoundRect(rim,radius-.6f*density,radius-.6f*density,paint);
      paint.setColor(alpha(Color.WHITE,palette.light?220:64));paint.setAlpha(Math.round(Color.alpha(paint.getColor())*(opacity/255f)));
      rim.set(box);rim.inset(5*density,5*density);canvas.drawRoundRect(rim,radius-5*density,radius-5*density,paint);
      paint.setColorFilter(null);paint.setShader(null);canvas.restoreToCount(save);
    }
    @Override public void getOutline(Outline out){out.setRoundRect(getBounds(),radius);}
    @Override public void setAlpha(int a){opacity=a;invalidateSelf();}
    @Override public void setColorFilter(ColorFilter f){filter=f;invalidateSelf();}
    @Override public int getOpacity(){return PixelFormat.TRANSLUCENT;}
  }
  /** No rectangular matte: reuse the approved transparent Cobra mark and native Infinity curve. */
  static final class BrandMark extends View {
    final boolean cobra;final Paint paint=new Paint(Paint.ANTI_ALIAS_FLAG);final Path loop=new Path();final RectF bounds=new RectF();
    BrandMark(Context c,boolean cobra){super(c);this.cobra=cobra;if(cobra)CobraEmblem.prepare(c);setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);}
    @Override protected void onSizeChanged(int w,int h,int ow,int oh){
      bounds.set(0,0,w,h);if(cobra)return;
      float cx=w/2f,cy=h/2f,rx=w*.42f,ry=h*.29f;loop.reset();loop.moveTo(cx,cy);
      loop.cubicTo(cx-rx*.45f,cy-ry,cx-rx,cy-ry,cx-rx,cy);
      loop.cubicTo(cx-rx,cy+ry,cx-rx*.45f,cy+ry,cx,cy);
      loop.cubicTo(cx+rx*.45f,cy-ry,cx+rx,cy-ry,cx+rx,cy);
      loop.cubicTo(cx+rx,cy+ry,cx+rx*.45f,cy+ry,cx,cy);
      paint.setStyle(Paint.Style.STROKE);paint.setStrokeWidth(Math.max(2,Math.min(w,h)*.07f));paint.setStrokeCap(Paint.Cap.ROUND);
      paint.setShader(new LinearGradient(0,0,w,h,new int[]{0xffab7e20,0xffffe8a1,0xffb88b2c},null,Shader.TileMode.CLAMP));
    }
    @Override protected void onDraw(Canvas c){if(cobra)CobraEmblem.draw(c,bounds,Color.WHITE,255);else c.drawPath(loop,paint);}
  }
  /** Small line icons describe existing actions only; none is a new control or state badge. */
  static final class Glyph extends View {
    final int kind;final Palette palette;final Paint p=new Paint(Paint.ANTI_ALIAS_FLAG);final Path path=new Path();final RectF r=new RectF();
    Glyph(Context c,int kind,Palette palette){super(c);this.kind=kind;this.palette=palette;setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);}
    @Override protected void onDraw(Canvas c){
      float s=Math.min(getWidth(),getHeight());int save=c.save();c.translate((getWidth()-s)/2,(getHeight()-s)/2);c.scale(s/34,s/34);
      r.set(0,0,34,34);p.setStyle(Paint.Style.FILL);p.setColor(alpha(palette.accent,palette.light?20:26));c.drawRoundRect(r,11,11,p);
      p.setColor(palette.accent);p.setStyle(Paint.Style.STROKE);p.setStrokeWidth(1.6f);p.setStrokeCap(Paint.Cap.ROUND);p.setStrokeJoin(Paint.Join.ROUND);path.reset();
      if(kind==0){path.moveTo(11,10);path.lineTo(23,10);path.lineTo(21,17);path.lineTo(24,21);path.lineTo(10,21);path.lineTo(13,17);path.close();c.drawPath(path,p);c.drawLine(17,21,17,26,p);}
      else if(kind==1){path.moveTo(13,9);path.lineTo(25,17);path.lineTo(13,25);path.close();c.drawPath(path,p);}
      else if(kind==2){r.set(9,9,25,25);c.drawRoundRect(r,4,4,p);c.drawLine(17,9,17,25,p);c.drawLine(12,14,14,14,p);c.drawLine(20,20,22,20,p);}
      else if(kind==3){r.set(8,8,26,26);c.drawRoundRect(r,6,6,p);path.moveTo(11,18);path.lineTo(14,18);path.lineTo(16,13);path.lineTo(19,22);path.lineTo(21,17);path.lineTo(24,17);c.drawPath(path,p);}
      else{path.moveTo(17,7);path.lineTo(26,11);path.lineTo(24,21);path.quadTo(22,25,17,28);path.quadTo(12,25,10,21);path.lineTo(8,11);path.close();c.drawPath(path,p);c.drawLine(13,17,16,20,p);c.drawLine(16,20,22,14,p);}
      c.restoreToCount(save);
    }
  }
}
