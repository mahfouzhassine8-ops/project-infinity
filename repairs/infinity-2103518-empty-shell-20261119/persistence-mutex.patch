diff --git a/xbmc/platform/android/activity/InfinityPersistenceWaitTrace.h b/xbmc/platform/android/activity/InfinityPersistenceWaitTrace.h
new file mode 100644
index 0000000000000000000000000000000000000000..e08b9b757a61ba6ef5bf1eb4f689cdca85189747
--- /dev/null
+++ b/xbmc/platform/android/activity/InfinityPersistenceWaitTrace.h
@@ -0,0 +1,314 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <mutex>
+
+#if defined(TARGET_ANDROID) || defined(INFINITY_PERSISTENCE_WAIT_TRACE_HOST)
+#include "interfaces/generic/InfinityStartupTrace.h"
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <pthread.h>
+#include <time.h>
+#ifdef TARGET_ANDROID
+#include <android/log.h>
+#endif
+#endif
+
+namespace InfinityPersistenceWaitTrace __attribute__((visibility("hidden")))
+{
+enum class Site : unsigned { Ledger = 1, ProtectedWrite, PythonObserver };
+
+#if defined(TARGET_ANDROID) || defined(INFINITY_PERSISTENCE_WAIT_TRACE_HOST)
+using Number = unsigned long long;
+constexpr unsigned WAIT_SLOTS = 128;
+constexpr unsigned COMPLETED_SLOTS = 128;
+constexpr Number SLOW_US = 100000;
+constexpr Number RESAMPLE_US = 2000000;
+constexpr unsigned SAMPLE_LIMIT = 1024;
+static_assert(std::atomic<Number>::is_always_lock_free &&
+              std::atomic<unsigned>::is_always_lock_free);
+
+struct Ticket
+{
+  Number id{0}, started{0};
+  unsigned tid{0}, site{0}, line{0};
+};
+
+struct WaitSlot
+{
+  // 0 is free, 1 is reserved, and each published value is a unique ticket.
+  std::atomic<Number> id{0}, started{0};
+  std::atomic<unsigned> tid{0}, site{0}, line{0};
+};
+
+struct Ownership
+{
+  // Only threads holding the original mutex publish ownership updates.
+  std::atomic<Number> version{0}, id{0}, acquired{0};
+  std::atomic<unsigned> tid{0}, site{0}, line{0};
+};
+
+struct Completion
+{
+  Ticket ticket;
+  Number acquired, released;
+};
+
+struct CompletionSlot
+{
+  // Writers publish complete records with release. The sampler frees a
+  // record only after copying it and never blocks a writer on a full slot.
+  std::atomic<unsigned> state{0};
+  Completion record{};
+};
+
+inline WaitSlot waits[WAIT_SLOTS];
+inline CompletionSlot completions[COMPLETED_SLOTS];
+inline Ownership owner;
+inline std::atomic<Number> nextId{2}, nextCompletion{0}, lostWait{0}, lostCompletion{0};
+inline std::atomic<bool> started{false};
+
+inline Number Now() noexcept { return InfinityStartupTrace::Now(); }
+inline unsigned Tid() noexcept { return static_cast<unsigned>(::syscall(SYS_gettid)); }
+
+inline bool PublishWait(const Ticket& ticket) noexcept
+{
+  auto& slot = waits[ticket.id % WAIT_SLOTS];
+  Number free = 0;
+  if (!slot.id.compare_exchange_strong(free, 1))
+  {
+    ++lostWait;
+    return false;
+  }
+  slot.started.store(ticket.started);
+  slot.tid.store(ticket.tid);
+  slot.site.store(ticket.site);
+  slot.line.store(ticket.line);
+  slot.id.store(ticket.id);
+  return true;
+}
+
+inline void PublishOwner(const Ticket& ticket, Number acquired) noexcept
+{
+  ++owner.version;
+  owner.id.store(ticket.id);
+  owner.tid.store(ticket.tid);
+  owner.site.store(ticket.site);
+  owner.line.store(ticket.line);
+  owner.acquired.store(acquired);
+  ++owner.version;
+}
+
+inline void PublishCompletion(const Completion& record) noexcept
+{
+  auto& slot = completions[nextCompletion.fetch_add(1, std::memory_order_relaxed) % COMPLETED_SLOTS];
+  unsigned free = 0;
+  if (!slot.state.compare_exchange_strong(free, 1))
+  {
+    ++lostCompletion;
+    return;
+  }
+  slot.record = record;
+  slot.state.store(2, std::memory_order_release);
+}
+
+struct PendingWait
+{
+  Ticket waiter;
+  Ticket holder;
+  Number observed;
+};
+
+inline bool ReadWait(const WaitSlot& slot, PendingWait& sample, Number now) noexcept
+{
+  const auto id = slot.id.load();
+  if (id < 2)
+    return false;
+  const Ticket waiter{id, slot.started.load(), slot.tid.load(), slot.site.load(), slot.line.load()};
+  if (now < waiter.started || now - waiter.started < SLOW_US)
+    return false;
+  const auto version = owner.version.load();
+  if (version & 1)
+    return false;
+  const Ticket holder{owner.id.load(), owner.acquired.load(), owner.tid.load(),
+                      owner.site.load(), owner.line.load()};
+  if (holder.tid == waiter.tid || owner.version.load() != version || slot.id.load() != id)
+    return false;
+  sample = {waiter, holder, now};
+  return true;
+}
+
+class Guard
+{
+public:
+  Guard(std::mutex& mutex, Site site, unsigned line) : m_mutex(mutex)
+  {
+    const int entryErrno = errno;
+    if (InfinityStartupTrace::Enabled())
+    {
+      m_ticket = {nextId.fetch_add(1, std::memory_order_relaxed), Now(), Tid(),
+                  static_cast<unsigned>(site), line};
+      m_published = PublishWait(m_ticket);
+    }
+    errno = entryErrno;
+    try
+    {
+      m_mutex.lock();
+    }
+    catch (...)
+    {
+      ClearWait();
+      throw;
+    }
+    const int lockedErrno = errno;
+    if (m_ticket.id)
+    {
+      m_acquired = Now();
+      PublishOwner(m_ticket, m_acquired);
+      ClearWait();
+    }
+    errno = lockedErrno;
+  }
+
+  ~Guard()
+  {
+    const int entryErrno = errno;
+    if (m_ticket.id)
+      PublishOwner({}, 0);
+    errno = entryErrno;
+    m_mutex.unlock();
+    const int unlockedErrno = errno;
+    if (m_ticket.id)
+    {
+      const auto released = Now();
+      if (released - m_ticket.started >= SLOW_US)
+        PublishCompletion({m_ticket, m_acquired, released});
+    }
+    errno = unlockedErrno;
+  }
+
+  Guard(const Guard&) = delete;
+  Guard& operator=(const Guard&) = delete;
+
+private:
+  void ClearWait() noexcept
+  {
+    if (m_published)
+      waits[m_ticket.id % WAIT_SLOTS].id.store(0);
+  }
+
+  std::mutex& m_mutex;
+  Ticket m_ticket;
+  Number m_acquired{0};
+  bool m_published{false};
+};
+
+#ifdef TARGET_ANDROID
+inline void* Observe(void*) noexcept
+{
+  constexpr char tag[] = "InfinityPersistenceMutex";
+  Number sampleId[WAIT_SLOTS]{}, sampleOwner[WAIT_SLOTS]{}, sampleTime[WAIT_SLOTS]{};
+  Number count = 0, limitLoss = 0, logLoss = 0;
+  Number lastWaitLoss = 0, lastCompletionLoss = 0, lastLimitLoss = 0, lastLogLoss = 0;
+  const Number deadline = Now() + 1200000000ULL;
+  if (__android_log_print(ANDROID_LOG_INFO, tag, "phase=observer_start") < 0)
+    ++logLoss;
+  do
+  {
+    const auto now = Now();
+    for (unsigned i = 0; i < WAIT_SLOTS; ++i)
+    {
+      PendingWait sample{};
+      if (!ReadWait(waits[i], sample, now) ||
+          (sampleId[i] == sample.waiter.id && sampleOwner[i] == sample.holder.id &&
+           now - sampleTime[i] < RESAMPLE_US))
+        continue;
+      sampleId[i] = sample.waiter.id;
+      sampleOwner[i] = sample.holder.id;
+      sampleTime[i] = now;
+      if (count++ >= SAMPLE_LIMIT)
+      {
+        ++limitLoss;
+        continue;
+      }
+      if (__android_log_print(ANDROID_LOG_INFO, tag,
+          "phase=waiting ticket=%llu tid=%u site=%u line=%u started_us=%llu observed_us=%llu wait_us=%llu "
+          "owner_ticket=%llu owner_tid=%u owner_site=%u owner_line=%u acquired_us=%llu",
+          sample.waiter.id, sample.waiter.tid, sample.waiter.site, sample.waiter.line,
+          sample.waiter.started, sample.observed, sample.observed - sample.waiter.started,
+          sample.holder.id, sample.holder.tid, sample.holder.site, sample.holder.line,
+          sample.holder.started) < 0)
+        ++logLoss;
+    }
+    for (auto& slot : completions)
+    {
+      if (slot.state.load(std::memory_order_acquire) != 2)
+        continue;
+      const auto record = slot.record;
+      slot.state.store(0, std::memory_order_release);
+      if (count++ >= SAMPLE_LIMIT)
+      {
+        ++limitLoss;
+        continue;
+      }
+      if (__android_log_print(ANDROID_LOG_INFO, tag,
+          "phase=completed ticket=%llu tid=%u site=%u line=%u started_us=%llu acquired_us=%llu "
+          "released_us=%llu wait_us=%llu",
+          record.ticket.id, record.ticket.tid, record.ticket.site, record.ticket.line,
+          record.ticket.started, record.acquired, record.released,
+          record.acquired - record.ticket.started) < 0)
+        ++logLoss;
+    }
+    const auto waitLoss = lostWait.load(), completionLoss = lostCompletion.load();
+    if (waitLoss != lastWaitLoss || completionLoss != lastCompletionLoss ||
+        limitLoss != lastLimitLoss || logLoss != lastLogLoss)
+    {
+      lastWaitLoss = waitLoss;
+      lastCompletionLoss = completionLoss;
+      lastLimitLoss = limitLoss;
+      lastLogLoss = logLoss;
+      if (__android_log_print(ANDROID_LOG_WARN, tag,
+          "phase=loss wait_slots=%llu completion_slots=%llu sample_limit=%llu log_writes=%llu",
+          waitLoss, completionLoss, limitLoss, logLoss) < 0)
+        ++logLoss;
+    }
+    timespec pause{0, 100000000};
+    nanosleep(&pause, nullptr);
+  } while (Now() < deadline);
+  __android_log_print(ANDROID_LOG_INFO, tag, "phase=observer_end");
+  return nullptr;
+}
+
+inline void StartObserver() noexcept
+{
+  if (!InfinityStartupTrace::Enabled() || started.exchange(true))
+    return;
+  const int savedErrno = errno;
+  pthread_attr_t attr;
+  int error = pthread_attr_init(&attr);
+  if (!error)
+  {
+    error = pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    pthread_t thread;
+    if (!error)
+      error = pthread_create(&thread, &attr, Observe, nullptr);
+    pthread_attr_destroy(&attr);
+  }
+  if (error)
+    __android_log_print(ANDROID_LOG_WARN, "InfinityPersistenceMutex",
+                        "phase=observer_start_failed result=%d", error);
+  errno = savedErrno;
+}
+#else
+inline void StartObserver() noexcept {}
+#endif
+#else
+class Guard : private std::lock_guard<std::mutex>
+{
+public:
+  Guard(std::mutex& mutex, Site, unsigned) : std::lock_guard<std::mutex>(mutex) {}
+};
+inline void StartObserver() noexcept {}
+#endif
+} // namespace InfinityPersistenceWaitTrace
