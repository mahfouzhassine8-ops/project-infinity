+
+/** Presentation only. No player, decoder, network, surface or transport dependency. */
+final class CobraPresentationEffects implements AutoCloseable {
+  static final String AMBIENT = "cobra_ambient_mode";
+  static final String NIGHT = "cobra_night_cinema";
+  static final String GREETING = "cobra_custom_greeting";
+  static final String EXTRA_ENTRY_TOKEN = "cobra_explicit_entry_token";
+  static final String SAVED_ENTRY_TOKEN = "cobra_welcome_consumed_token";
+  static final int OFF = 0, SUBTLE = 1, IMMERSIVE = 2;
+  static final long WELCOME_MS = 2200L;
+
+  enum PulseState {
+    NONE(0, ""), NORMAL(0xff62aaff, "Normal playback"),
+    BUFFERING(0xff62aaff, "Buffering"), TIMESHIFT(0xff54df8e, "Timeshift"),
+    RECORDING(0xff54df8e, "Recording"), LIVE(0xfff5fbff, "Live edge"),
+    BACKGROUND(0xffffc65e, "Background playback"),
+    NETWORK(0xffff6767, "Network trouble"), RECOVERING(0xffbb8aff, "Recovering");
+    final int color; final String label;
+    PulseState(int color, String label) { this.color = color; this.label = label; }
+    boolean animated() { return this == BUFFERING || this == RECOVERING; }
+  }
+
+  static int ambientMode(SharedPreferences prefs) {
+    String value = prefs == null ? "off" : prefs.getString(AMBIENT, "off");
+    return "subtle".equals(value) ? SUBTLE : "immersive".equals(value) ? IMMERSIVE : OFF;
+  }
+  static String ambientLabel(int mode) {
+    return mode == SUBTLE ? "Subtle" : mode == IMMERSIVE ? "Immersive" : "Off";
+  }
+  static String boundedGreeting(String raw) {
+    String value = raw == null ? "" : raw.trim();
+    // Count Unicode code points, not UTF-16 units: never cut an emoji in half.
+    if (value.codePointCount(0, value.length()) > 120)
+      value = value.substring(0, value.offsetByCodePoints(0, 120));
+    return value.isEmpty() ? "Welcome back" : value;
+  }
+  static String greeting(SharedPreferences prefs) {
+    return boundedGreeting(prefs == null ? "" : prefs.getString(GREETING, ""));
+  }
+  static long chromeDelay(boolean night) { return night ? 2100L : 3500L; }
+  static boolean motionAllowed() {
+    return Build.VERSION.SDK_INT < 26 || ValueAnimator.areAnimatorsEnabled();
+  }
+  static int blend(int base, int tint, float fraction) {
+    float amount = Math.max(0f, Math.min(1f, fraction));
+    return Color.argb(Color.alpha(base),
+        Math.round(Color.red(base) * (1f - amount) + Color.red(tint) * amount),
+        Math.round(Color.green(base) * (1f - amount) + Color.green(tint) * amount),
+        Math.round(Color.blue(base) * (1f - amount) + Color.blue(tint) * amount));
+  }
+  static int contextTint(String sourceColor) {
+    try { return Color.parseColor(sourceColor); }
+    catch (RuntimeException invalid) { return 0xff62aaff; }
+  }
+  static int ambientColor(String role, int base, int mode, int tint) {
+    if (mode != SUBTLE && mode != IMMERSIVE) return base;
+    float amount;
+    if ("accent".equals(role) || "accent_soft".equals(role)) amount = .12f;
+    else if ("focus".equals(role)) amount = .10f;
+    else if ("line".equals(role)) amount = .06f;
+    else if ("panel".equals(role) || "panel2".equals(role) || "rail".equals(role)) amount = .035f;
+    else return base; // Text, error colours, video and the opaque OLED canvas remain unchanged.
