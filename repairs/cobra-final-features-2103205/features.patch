+  private CobraEmblem() {}
+  private static Path hood() {
+    Path p=new Path();p.moveTo(42,14);p.cubicTo(33,8,19,10,13,20);p.cubicTo(6,30,10,40,20,49);
+    p.cubicTo(31,59,39,68,39,82);p.lineTo(38,91);p.cubicTo(44,83,44,72,39,62);
+    p.cubicTo(34,52,24,46,18,39);p.cubicTo(12,32,14,23,21,20);p.cubicTo(27,16,34,18,39,22);
+    p.moveTo(58,14);p.cubicTo(67,8,81,10,87,20);p.cubicTo(94,30,90,40,80,49);
+    p.cubicTo(69,59,61,67,60,79);p.cubicTo(59,89,52,97,43,98);p.cubicTo(54,87,53,77,54,65);
+    p.cubicTo(55,53,62,47,72,40);p.cubicTo(81,34,87,27,80,21);p.cubicTo(73,16,66,18,61,22);return p;
+  }
+  private static Path head() {
+    Path p=new Path();p.moveTo(38,13);p.cubicTo(38,9,43,8,48,11);p.lineTo(52,11);p.cubicTo(57,8,62,9,62,13);
+    p.lineTo(65,19);p.lineTo(60,26);p.lineTo(57,28);p.lineTo(55,39);p.lineTo(51,33);p.lineTo(49,33);
+    p.lineTo(45,39);p.lineTo(43,28);p.lineTo(40,26);p.lineTo(35,19);p.close();return p;
+  }
+  private static Path face() {
+    Path p=new Path();p.moveTo(40,18);p.lineTo(46,21);p.lineTo(43,23);p.close();
+    p.moveTo(60,18);p.lineTo(54,21);p.lineTo(57,23);p.close();
+    p.moveTo(47,27);p.lineTo(50,25);p.lineTo(53,27);p.lineTo(50,30);p.close();return p;
+  }
+  private static Path scales() {
+    Path p=new Path();p.moveTo(48,39);p.lineTo(54,41);p.moveTo(48,46);p.lineTo(55,48);
+    p.moveTo(48,54);p.lineTo(54,56);p.moveTo(47,62);p.lineTo(53,64);p.moveTo(46,70);p.lineTo(52,72);
+    p.moveTo(45,78);p.lineTo(50,80);p.moveTo(43,86);p.lineTo(47,87);return p;
+  }
+  private static Path inner() {
+    Path p=new Path();p.moveTo(23,26);p.cubicTo(29,24,33,27,37,31);p.moveTo(20,33);p.lineTo(33,36);
+    p.moveTo(25,42);p.lineTo(38,43);p.moveTo(31,51);p.lineTo(42,50);p.moveTo(76,26);p.cubicTo(70,24,66,27,62,31);
+    p.moveTo(79,33);p.lineTo(66,36);p.moveTo(74,42);p.lineTo(61,43);p.moveTo(68,51);p.lineTo(57,50);return p;
+  }
+  private static final Path HOOD=hood(),HEAD=head(),FACE=face(),SCALES=scales(),INNER=inner();
+  private static final ThreadLocal<Paint> PAINT = new ThreadLocal<Paint>() {
+    @Override protected Paint initialValue() { return new Paint(Paint.ANTI_ALIAS_FLAG); }
+  };
+
+  static void draw(Canvas canvas, RectF bounds, int color, int alpha) {
+    if (canvas == null || bounds == null || bounds.width() <= 0 || bounds.height() <= 0 || alpha <= 0) return;
+    Paint paint = PAINT.get();
+    int saved = canvas.save();
+    float scale = Math.min(bounds.width(), bounds.height()) / 104f;
+    canvas.translate(bounds.centerX() - 50f * scale, bounds.centerY() - 52f * scale);
+    canvas.scale(scale, scale);
+    int opacity = Math.min(255, alpha) * Color.alpha(color) / 255;
+    paint.setColor(color);
+    paint.setStyle(Paint.Style.STROKE);
+    paint.setStrokeCap(Paint.Cap.ROUND);
+    paint.setStrokeJoin(Paint.Join.ROUND);
+    paint.setStrokeWidth(7f);
+    paint.setAlpha(opacity / 12);
+    canvas.drawPath(HOOD, paint);
+    canvas.drawPath(HEAD, paint);
+    paint.setStrokeWidth(3.2f);
+    paint.setAlpha(opacity);
+    canvas.drawPath(HOOD, paint);
+    paint.setStyle(Paint.Style.FILL);
+    paint.setAlpha(opacity * 3 / 4);
+    canvas.drawPath(HEAD, paint);
+    paint.setStyle(Paint.Style.STROKE);
+    paint.setStrokeWidth(1.8f);
+    paint.setAlpha(opacity);
+    canvas.drawPath(HEAD, paint);
+    paint.setStrokeWidth(1.3f);
+    paint.setAlpha(opacity / 2);
+    canvas.drawPath(INNER, paint);
+    paint.setAlpha(opacity * 3 / 4);
+    canvas.drawPath(SCALES, paint);
+    paint.setStyle(Paint.Style.FILL);
+    paint.setColor(Color.BLACK);
+    paint.setAlpha(opacity * 4 / 5);
+    canvas.drawPath(FACE, paint);
+    paint.setAlpha(255);
+    canvas.restoreToCount(saved);
+  }
+}
