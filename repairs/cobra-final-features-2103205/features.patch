+package @APP_PACKAGE@;
+
+import android.content.Context;
+import android.net.ConnectivityManager;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.net.NetworkInfo;
+import android.net.NetworkRequest;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/** Passive, bounded Android routing observations. Never owns a player, socket, or preference. */
+final class CobraNetworkIntelligence implements AutoCloseable {
+  static final int WIFI=1,CELLULAR=2,ETHERNET=4,VPN=8,OTHER=16;
+  private final ConnectivityManager manager;
+  private final Handler main=new Handler(Looper.getMainLooper());
+  private final State state=new State();
+  private ConnectivityManager.NetworkCallback callback;
+  private volatile boolean closed;
+  private boolean started,registered;
+  private String observation="Not started";
+  private final Runnable legacySample=()->sampleCurrent();
+
+  CobraNetworkIntelligence(Context context){
+    ConnectivityManager service=null;
+    try{Context app=context==null?null:context.getApplicationContext();if(app!=null)service=(ConnectivityManager)app.getSystemService(Context.CONNECTIVITY_SERVICE);}catch(RuntimeException ignored){}
+    manager=service;
+  }
+
+  synchronized void start(){
+    if(started||closed)return;started=true;
+    if(manager==null){observation="Unavailable";return;}
+    sampleCurrent();
+    callback=new ConnectivityManager.NetworkCallback(){
+      @Override public void onAvailable(Network network){
+        if(closed)return;
+        if(Build.VERSION.SDK_INT>=24)state.available(network,SystemClock.elapsedRealtime());else scheduleLegacySample();
+      }
+      @Override public void onCapabilitiesChanged(Network network,NetworkCapabilities capabilities){
+        if(closed)return;
+        // Callback-supplied capabilities avoid a synchronous query racing a new default route.
+        if(Build.VERSION.SDK_INT>=24)state.capabilities(network,transports(capabilities),
+            capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET),true,
+            capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED),true,
+            !capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_METERED),
+            capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_CAPTIVE_PORTAL),SystemClock.elapsedRealtime());
+        else scheduleLegacySample();
+      }
+      @Override public void onLost(Network network){
+        if(closed)return;
+        if(Build.VERSION.SDK_INT>=24)state.lost(network,SystemClock.elapsedRealtime());else scheduleLegacySample();
+      }
+    };
+    try{
+      if(Build.VERSION.SDK_INT>=24)manager.registerDefaultNetworkCallback(callback);
+      else manager.registerNetworkCallback(new NetworkRequest.Builder()
+          .addCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+          .removeCapability(NetworkCapabilities.NET_CAPABILITY_NOT_VPN).build(),callback);
+      registered=true;observation=Build.VERSION.SDK_INT>=24?"Default network callback":"Legacy active-route observation";
+    }catch(RuntimeException unavailable){callback=null;observation="Snapshot only; network callback unavailable";}
+  }
+
+  private void scheduleLegacySample(){
+    synchronized(this){if(closed)return;main.removeCallbacks(legacySample);main.post(legacySample);}
+  }
+
+  @SuppressWarnings("deprecation") private synchronized void sampleCurrent(){
+    if(closed||manager==null)return;
+    try{
+      long now=SystemClock.elapsedRealtime();
+      if(Build.VERSION.SDK_INT>=23){
+        Network current=manager.getActiveNetwork();
+        if(current==null){state.disconnected(now);return;}
+        NetworkCapabilities capabilities=manager.getNetworkCapabilities(current);
+        state.available(current,now);
+        if(capabilities!=null)state.capabilities(current,transports(capabilities),
+            capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET),true,
+            capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED),true,
+            !capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_METERED),
+            capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_CAPTIVE_PORTAL),now);
+      }else{
+        NetworkInfo info=manager.getActiveNetworkInfo();
+        if(info==null||!info.isConnected()){state.disconnected(now);return;}
+        int type=info.getType(),bits=type==ConnectivityManager.TYPE_WIFI?WIFI:
+            type==ConnectivityManager.TYPE_MOBILE?CELLULAR:type==ConnectivityManager.TYPE_ETHERNET?ETHERNET:
+            type==ConnectivityManager.TYPE_VPN?VPN:OTHER;
+        Object route=Integer.valueOf(type);state.available(route,now);
+        state.capabilities(route,bits,true,false,false,true,manager.isActiveNetworkMetered(),false,now);
+      }
+    }catch(RuntimeException unavailable){state.unavailable(SystemClock.elapsedRealtime());}
+  }
+
+  synchronized Snapshot snapshot(){
+    // Old Android and callback-registration failures use snapshots, not periodic polling.
+    if(started&&!closed&&(!registered||Build.VERSION.SDK_INT<24))sampleCurrent();
+    return state.snapshot(SystemClock.elapsedRealtime(),closed?"Closed":observation);
+  }
+
+  synchronized Snapshot cachedSnapshot(){
+    return state.snapshot(SystemClock.elapsedRealtime(),closed?"Closed":observation);
+  }
+
+  @Override public synchronized void close(){
+    if(closed)return;closed=true;main.removeCallbacks(legacySample);state.close();
+    if(registered&&callback!=null&&manager!=null)try{manager.unregisterNetworkCallback(callback);}catch(RuntimeException ignored){}
+    registered=false;callback=null;
+  }
+
+  static int transports(NetworkCapabilities capabilities){
+    int bits=0;if(capabilities.hasTransport(NetworkCapabilities.TRANSPORT_WIFI))bits|=WIFI;
+    if(capabilities.hasTransport(NetworkCapabilities.TRANSPORT_CELLULAR))bits|=CELLULAR;
+    if(capabilities.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET))bits|=ETHERNET;
+    if(capabilities.hasTransport(NetworkCapabilities.TRANSPORT_VPN))bits|=VPN;
+    return bits==0?OTHER:bits;
+  }
+
+  static String transportLabel(int bits){
+    StringBuilder value=new StringBuilder();int[] masks={VPN,WIFI,CELLULAR,ETHERNET,OTHER};
+    String[] names={"VPN","Wi-Fi","Cellular","Ethernet","Other"};
+    for(int i=0;i<masks.length;i++)if((bits&masks[i])!=0){if(value.length()>0)value.append(" + ");value.append(names[i]);}
+    return value.length()==0?"Not reported":value.toString();
+  }
+
+  static final class Snapshot {
+    final boolean known,connected,capabilitiesKnown,validatedKnown,validated,meteredKnown,metered,captivePortal;
+    final int transportBits,recentChanges;
+    final long transitions,disconnects,reconnections,changedAgeMs,recoveryAgeMs;
+    final String observation,status;
+    Snapshot(State state,long now,String owner){
+      known=state.known;connected=state.connected;capabilitiesKnown=state.capabilitiesKnown;
+      validatedKnown=state.validatedKnown;validated=state.validated;meteredKnown=state.meteredKnown;
+      metered=state.metered;captivePortal=state.captivePortal;transportBits=state.transportBits;
+      transitions=state.transitions;disconnects=state.disconnects;reconnections=state.reconnections;
+      recentChanges=state.recent(now);changedAgeMs=age(now,state.changedAt);recoveryAgeMs=age(now,state.recoveredAt);
+      observation=owner==null?"Not reported":owner;
+      status=!known?"Not reported":!connected?"No default network":!capabilitiesKnown?"Connecting":
+          captivePortal?"Sign-in may be required":validatedKnown&&!validated?"Internet not validated":
+          recoveryAgeMs>=0&&recoveryAgeMs<State.RECOVERY_WINDOW_MS?"Reconnected":
+          recentChanges>=State.UNSTABLE_TRANSITIONS?"Frequent route changes":"Connected";
+    }
+    private static long age(long now,long then){return then<0||now<then?-1L:now-then;}
+    String summary(){
+      StringBuilder value=new StringBuilder(transportLabel(transportBits)).append(" • ").append(status);
+      if(meteredKnown&&connected)value.append(metered?" • Metered":" • Unmetered");
+      if(connected&&recentChanges>=State.UNSTABLE_TRANSITIONS&&!"Frequent route changes".equals(status))value.append(" • Frequent route changes");
+      return value.toString();
+    }
+    JSONObject json()throws JSONException{
+      return new JSONObject().put("observation",observation).put("state",status)
+          .put("transport",transportLabel(transportBits)).put("known",known)
+          .put("connected",known?Boolean.valueOf(connected):JSONObject.NULL)
+          .put("internet_validated",validatedKnown?Boolean.valueOf(validated):JSONObject.NULL)
+          .put("metered",meteredKnown?Boolean.valueOf(metered):JSONObject.NULL)
+          .put("captive_portal",capabilitiesKnown?Boolean.valueOf(captivePortal):JSONObject.NULL)
+          .put("recent_changes_30s",recentChanges).put("route_changes",transitions)
+          .put("default_route_losses",disconnects).put("reconnections",reconnections)
+          .put("last_change_age_ms",changedAgeMs).put("reconnected_age_ms",recoveryAgeMs)
+          .put("policy","observation_only; user playback preferences unchanged")
+          .put("limitation","Android routing observations do not prove provider reachability or throughput");
+    }
+  }
+
+  /** Deterministic, fixed-memory state; opaque network keys never leave this object. */
+  static final class State {
+    static final long CHANGE_WINDOW_MS=30000L,RECOVERY_WINDOW_MS=10000L;
+    static final int UNSTABLE_TRANSITIONS=3;
+    private final long[] changes=new long[8];private int changeCount,changeNext;
+    private Object route;
+    private boolean closed,known,connected,capabilitiesKnown,validatedKnown,validated,meteredKnown,metered,captivePortal;
+    private boolean waitingForRecovery;
+    private int transportBits;
+    private long transitions,disconnects,reconnections,changedAt=-1,recoveredAt=-1,lastAt=-1;
+
+    synchronized void available(Object next,long now){
+      if(closed||next==null)return;clock(now);
+      boolean same=known&&connected&&next.equals(route);
+      if(same)return;
+      if(known)changed(now);
+      known=true;connected=true;route=next;capabilitiesKnown=false;validatedKnown=false;validated=false;
+      meteredKnown=false;metered=false;captivePortal=false;transportBits=0;recoveredAt=-1;
+    }
+    synchronized void capabilities(Object current,int bits,boolean internet,boolean validationKnown,
+        boolean validation,boolean costKnown,boolean cost,boolean captive,long now){
+      if(closed||!connected||route==null||!route.equals(current))return;clock(now);
+      if(capabilitiesKnown&&(transportBits!=bits||(validatedKnown&&validationKnown&&validated!=validation))){
+        changed(now);if(validatedKnown&&validated&&validationKnown&&!validation)waitingForRecovery=true;
+      }
+      capabilitiesKnown=true;transportBits=bits;validatedKnown=validationKnown;validated=validation;
+      meteredKnown=costKnown;metered=cost;captivePortal=captive;
+      if(waitingForRecovery&&internet&&!captive&&(!validationKnown||validation)){
+        reconnections++;recoveredAt=now;waitingForRecovery=false;
+      }
+    }
+    synchronized void lost(Object previous,long now){
+      if(closed||!connected||route==null||!route.equals(previous))return;
+      disconnected(now);
+    }
+    synchronized void disconnected(long now){
+      if(closed)return;clock(now);
+      if(known&&connected){changed(now);disconnects++;waitingForRecovery=true;}
+      known=true;connected=false;route=null;capabilitiesKnown=false;transportBits=0;
+      validatedKnown=false;validated=false;meteredKnown=false;metered=false;captivePortal=false;recoveredAt=-1;
+    }
+    synchronized void unavailable(long now){
+      if(closed)return;clock(now);known=false;connected=false;route=null;capabilitiesKnown=false;
+      transportBits=0;validatedKnown=false;validated=false;meteredKnown=false;metered=false;captivePortal=false;
+    }
+    synchronized void close(){closed=true;route=null;}
+    synchronized Snapshot snapshot(long now,String observation){return new Snapshot(this,now,observation);}
+    private void clock(long now){
+      if(lastAt>=0&&now<lastAt){changeCount=0;changeNext=0;changedAt=-1;recoveredAt=-1;waitingForRecovery=false;}
+      lastAt=now;
+    }
+    private void changed(long now){
+      transitions++;changedAt=now;changes[changeNext]=now;changeNext=(changeNext+1)%changes.length;
+      if(changeCount<changes.length)changeCount++;
+    }
+    private int recent(long now){int count=0;for(int i=0;i<changeCount;i++)if(now>=changes[i]&&now-changes[i]<CHANGE_WINDOW_MS)count++;return count;}
+  }
+}
