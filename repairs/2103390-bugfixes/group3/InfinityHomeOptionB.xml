<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
  <defaultcontrol always="true">101</defaultcontrol>
  <animation effect="fade" start="0" end="100" time="170" condition="!String.IsEqual(Window(Home).Property(Infinity.OptionalMotionAllowed),false)">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="140" condition="!String.IsEqual(Window(Home).Property(Infinity.OptionalMotionAllowed),false)">WindowClose</animation>
  <controls>
    <!-- Same Home remains visible under a restrained dim overlay. -->
    <control type="button" id="2">
      <left>0</left><top>0</top><width>100%</width><height>100%</height><label />
      <texturefocus colordiffuse="99000000">infinity_ui/contract_white.png</texturefocus>
      <texturenofocus colordiffuse="99000000">infinity_ui/contract_white.png</texturenofocus>
    </control>
    <control type="group" id="100">
      <centerleft>50%</centerleft><centertop>50%</centertop>
      <width max="920">88%</width><height max="580">74%</height>
      <control type="image" id="110">
        <left>0</left><top>0</top><width>100%</width><height>100%</height>
        <texture border="24" colordiffuse="$VAR[InfinityLegacySurface]">infinity_glass/surface.png</texture>
      </control>
      <control type="image" id="111">
        <left>0</left><top>0</top><width>100%</width><height>100%</height>
        <texture border="24" colordiffuse="$VAR[InfinityLegacyBorder]">infinity_glass/rim.png</texture>
      </control>
      <control type="image" id="112">
        <left>28</left><top>91</top><width>228</width><height>354</height><aspectratio>keep</aspectratio>
        <texture fallback="DefaultVideo.png">$INFO[Window.Property(Infinity.HomeOptionB.Poster)]</texture>
      </control>
      <control type="label" id="120">
        <left>288</left><top>87</top><right>96</right><height>64</height>
        <font>InfinityBodyBold</font><textcolor>$VAR[InfinityLegacyText]</textcolor>
        <aligny>center</aligny><scroll>true</scroll>
        <label>$INFO[Window.Property(Infinity.HomeOptionB.Title)]</label>
      </control>
      <control type="button" id="9">
        <right>20</right><top>16</top><width>72</width><height>72</height><label />
        <texturefocus colordiffuse="$VAR[InfinityLegacyAccent]">infinity_legacy/close_focus.png</texturefocus>
        <texturenofocus colordiffuse="$VAR[InfinityLegacyText]">infinity_legacy/close.png</texturenofocus>
        <onleft>104</onleft><onright>101</onright><onup>104</onup><ondown>101</ondown>
      </control>
      <control type="label" id="121">
        <left>288</left><top>153</top><right>34</right><height>40</height>
        <font>InfinitySmall</font><textcolor>$VAR[InfinityLegacyAccent]</textcolor><aligny>center</aligny>
        <label>$INFO[Window.Property(Infinity.HomeOptionB.YearAndEpisode)]</label>
      </control>
      <!-- Four discreet factual metadata tokens, blank when unavailable. -->
      <control type="label" id="122"><left>288</left><top>203</top><width>95</width><height>34</height>
        <font>InfinitySmall</font><textcolor>$VAR[InfinityLegacyText]</textcolor>
        <label>$INFO[Window.Property(Infinity.HomeOptionB.Certification)]</label></control>
      <control type="label" id="123"><left>385</left><top>203</top><width>110</width><height>34</height>
        <font>InfinitySmall</font><textcolor>$VAR[InfinityLegacyText]</textcolor>
        <label>$INFO[Window.Property(Infinity.HomeOptionB.Runtime)]</label></control>
      <control type="label" id="124"><left>498</left><top>203</top><width>110</width><height>34</height>
        <font>InfinitySmall</font><textcolor>$VAR[InfinityLegacyText]</textcolor>
        <label>$INFO[Window.Property(Infinity.HomeOptionB.Rating)]</label></control>
      <control type="textbox" id="125"><left>288</left><top>248</top><right>34</right><height>58</height>
        <font>InfinitySmall</font><textcolor>$VAR[InfinityLegacyDisabled]</textcolor>
        <label>$INFO[Window.Property(Infinity.HomeOptionB.Genres)]</label></control>
      <control type="textbox" id="126"><left>288</left><top>318</top><right>34</right><bottom>120</bottom>
        <font>InfinityBody</font><textcolor>$VAR[InfinityLegacyText]</textcolor>
        <label>$INFO[Window.Property(Infinity.HomeOptionB.Synopsis)]</label></control>
      <!-- Exactly the four approved Option B actions, in the locked order. -->
      <control type="button" id="101">
        <left>24</left><bottom>20</bottom><width>207</width><height>74</height>
        <label>Play</label><font>InfinityBodyBold</font><align>center</align><aligny>center</aligny>
        <texturefocus border="16" colordiffuse="$VAR[InfinityLegacyAccent]">infinity_glass/focus.png</texturefocus>
        <texturenofocus border="16" colordiffuse="$VAR[InfinityLegacyAccent]">infinity_glass/field.png</texturenofocus>
        <textcolor>$VAR[InfinityLegacyText]</textcolor><onleft>104</onleft><onright>102</onright><onup>9</onup>
        <enable>String.IsEqual(Window.Property(Infinity.HomeOptionB.PlayAvailable),true)</enable>
      </control>
      <control type="button" id="102">
        <left>245</left><bottom>20</bottom><width>207</width><height>74</height>
        <label>Trailer</label><font>InfinityBody</font><align>center</align><aligny>center</aligny>
        <texturefocus border="16" colordiffuse="$VAR[InfinityLegacyAccent]">infinity_glass/focus.png</texturefocus>
        <texturenofocus border="16" colordiffuse="$VAR[InfinityLegacyField]">infinity_glass/field.png</texturenofocus>
        <textcolor>$VAR[InfinityLegacyText]</textcolor><onleft>101</onleft><onright>103</onright><onup>9</onup>
        <enable>String.IsEqual(Window.Property(Infinity.HomeOptionB.TrailerAvailable),true)</enable>
      </control>
      <control type="button" id="103">
        <left>466</left><bottom>20</bottom><width>207</width><height>74</height>
        <label>Favorite</label><font>InfinityBody</font><align>center</align><aligny>center</aligny>
        <texturefocus border="16" colordiffuse="$VAR[InfinityLegacyAccent]">infinity_glass/focus.png</texturefocus>
        <texturenofocus border="16" colordiffuse="$VAR[InfinityLegacyField]">infinity_glass/field.png</texturenofocus>
        <textcolor>$VAR[InfinityLegacyText]</textcolor><onleft>102</onleft><onright>104</onright><onup>9</onup>
        <enable>String.IsEqual(Window.Property(Infinity.HomeOptionB.FavoriteAvailable),true)</enable>
      </control>
      <control type="button" id="104">
        <left>687</left><bottom>20</bottom><width>207</width><height>74</height>
        <label>More Info</label><font>InfinityBody</font><align>center</align><aligny>center</aligny>
        <texturefocus border="16" colordiffuse="$VAR[InfinityLegacyAccent]">infinity_glass/focus.png</texturefocus>
        <texturenofocus border="16" colordiffuse="$VAR[InfinityLegacyField]">infinity_glass/field.png</texturenofocus>
        <textcolor>$VAR[InfinityLegacyText]</textcolor><onleft>103</onleft><onright>101</onright><onup>9</onup>
        <enable>String.IsEqual(Window.Property(Infinity.HomeOptionB.InfoAvailable),true)</enable>
      </control>
    </control>
  </controls>
</window>
