package @APP_PACKAGE@;

/** Private, no-display bridge. Never creates/reinitializes a Kodi Main. */
public final class InfinityPowerControlActivity extends android.app.Activity {
  @Override protected void onCreate(android.os.Bundle state) {
    super.onCreate(state);
    try {
      String action = getIntent() == null ? null : getIntent().getAction();
      Main owner = Main.MainActivity;
      if (InfinityExitCompletion.NORMAL.equals(action)) {
        if (!InfinityExitCompletion.requestNormal(owner))
          android.widget.Toast.makeText(this, "Infinity could not begin a normal close. Nothing was force-stopped.", android.widget.Toast.LENGTH_LONG).show();
      } else if (InfinityExitCompletion.FORCE.equals(action)) {
        InfinityExitCompletion.requestForce(owner, this);
      }
    } finally { finish(); }
  }
}
