 Object[] sportsFixtures()throws Exception{
  Object[] games={model("CobraSportsGame"),model("CobraSportsGame")};for(int i=0;i<2;i++){Object game=games[i];put(game,"id","boundary-"+i);put(game,"leagueKey","nfl");put(game,"leagueLabel","Audit NFL");put(game,"state","in");put(game,"startMs",System.currentTimeMillis());((List<String>)get(game,"broadcasts")).add(i==0?"Wide":"Classic");Object home=model("CobraSportsTeam"),away=model("CobraSportsTeam");put(home,"name","Audit Home");put(away,"name","Audit Away");put(game,"home",home);put(game,"away",away);}runUi(()->{List list=(List)get(a,"mCobraSportsGames");list.clear();Collections.addAll(list,games);put(a,"mCobraSportsLastRefresh",System.currentTimeMillis());call(a,"cobraSelectDrawerOwner","SPORTS");call(a,"showCobraSportsGame","boundary-0");});return games;
 }
 @Test public void remainingBoundaries()throws Exception{
  launch(true);
  check("Late Sports Watch result cannot open playback after drawer navigation",()->{
   Object[] games=sportsFixtures();runUi(()->{call(a,"cobraSportsWatch",games[0]);call(a,"cobraSelectDrawerOwner","MOVIES");call(a,"showCobraPrimaryView");});SystemClock.sleep(2500);assertEquals("movies",ui(()->call(a,"cobraDrawerOwner")));assertNull("Old Sports action opened video over Movies",ui(()->get(a,"mPlayerOverlay")));screenshot("late-watch-stays-movies");
  });
  check("Late Smart Sports Multi-View result cannot replace a newer drawer destination",()->{
   toGuide();sportsFixtures();runUi(()->{call(a,"cobraSportsOpenSmartMultiView","nfl","boundary-0");call(a,"cobraSelectDrawerOwner","SHOWS");call(a,"showCobraPrimaryView");});SystemClock.sleep(2500);assertEquals("shows",ui(()->call(a,"cobraDrawerOwner")));assertNull("Old Sports action opened Multi-View after leaving",ui(()->get(a,"mMultiOverlay")));screenshot("late-multi-stays-shows");
  });
  check("Extended background setting starts native foreground service and Normal releases it",()->{
   toGuide();runUi(()->call(a,"showCobraBackgroundModePicker"));tag("cobra-background-mode:extended");await("extended Android service",()->InfinityExtendedBackgroundService.isEnabled(a)&&InfinityExtendedBackgroundService.isRunning(),8000);shell("input keyevent KEYCODE_HOME");SystemClock.sleep(1200);assertTrue(InfinityExtendedBackgroundService.isRunning());foreground();runUi(()->call(a,"showCobraBackgroundModePicker"));tag("cobra-background-mode:normal");await("normal releases continuity service",()->!InfinityExtendedBackgroundService.isEnabled(a)&&!InfinityExtendedBackgroundService.isRunning(),8000);
  });
  check("Profile selection isolates favorites and rejects an incorrect PIN",()->{
   toGuide();Object c=channel("Wide"),features=get(a,"mFeatures");String original=(String)call(features,"activeProfileId");runUi(()->call(a,"toggleFavorite",c));String profile=(String)call(features,"createProfile","Audit profile","2468",true);assertFalse(profile.isEmpty());assertFalse((Boolean)call(features,"unlockAndSelectProfile",profile,"9999"));assertEquals(original,call(features,"activeProfileId"));assertTrue((Boolean)call(features,"unlockAndSelectProfile",profile,"2468"));runUi(()->call(a,"reloadProfileCollections"));assertFalse(ui(()->((Set)get(a,"mFavorites")).contains(get(c,"id"))));assertTrue((Boolean)call(features,"unlockAndSelectProfile",original,""));runUi(()->call(a,"reloadProfileCollections"));assertTrue(ui(()->((Set)get(a,"mFavorites")).contains(get(c,"id"))));
  });
  check("System file picker result plays a content URI and preserves section on return",()->{
   toGuide();android.content.ContentValues values=new android.content.ContentValues();values.put(android.provider.MediaStore.MediaColumns.DISPLAY_NAME,"Cobra-audit-local.mp4");values.put(android.provider.MediaStore.MediaColumns.MIME_TYPE,"video/mp4");android.net.Uri target=ins.getTargetContext().getContentResolver().insert(android.provider.MediaStore.Downloads.EXTERNAL_CONTENT_URI,values);assertNotNull(target);try(InputStream in=new java.net.URL("http://10.0.2.2:8765/classic.mp4").openStream();OutputStream dst=ins.getTargetContext().getContentResolver().openOutputStream(target)){byte[] buffer=new byte[16384];int n;while((n=in.read(buffer))!=-1)dst.write(buffer,0,n);}final Intent[] captured={null};Instrumentation.ActivityMonitor monitor=new Instrumentation.ActivityMonitor(){@Override public Instrumentation.ActivityResult onStartActivity(Intent intent){if(Intent.ACTION_OPEN_DOCUMENT.equals(intent.getAction())){captured[0]=new Intent(intent);return new Instrumentation.ActivityResult(Activity.RESULT_OK,new Intent().setData(target).addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION));}return null;}};ins.addMonitor(monitor);
   try{runUi(()->{call(a,"showCobraFilePickerPicker");});tag("cobra-file-picker:system");runUi(()->{call(a,"cobraSelectDrawerOwner","MOVIES");call(a,"showCobraPrimaryView");call(a,"openDocumentPicker");});await("content URI decode",()->{ExoPlayer p=(ExoPlayer)get(a,"mPlayer");return captured[0]!=null&&p!=null&&p.isPlaying()&&p.getVideoSize().width>0;},15000);assertTrue(ui(()->(Boolean)call(a,"cobraVodSeekable")));screenshot("local-content-uri-playing");runUi(()->call(a,"closeFullscreenToCobraView"));assertEquals("movies",ui(()->call(a,"cobraDrawerOwner")));}finally{ins.removeMonitor(monitor);ins.getTargetContext().getContentResolver().delete(target,null,null);}
  });saveResults();runUi(()->a.finish());assertTrue(errors.toString(),errors.isEmpty());
 }
