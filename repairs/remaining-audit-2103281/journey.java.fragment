 Object model(String name)throws Exception{Class<?> c=Class.forName("com.projectinfinity.kodi.InfinityLiveActivity$"+name);Constructor<?> k=c.getDeclaredConstructor();k.setAccessible(true);return k.newInstance();}
 void clickTextCallback(String label)throws Exception{runUi(()->{View v=textView(a.getWindow().getDecorView(),label);assertNotNull(label,v);while(!v.isClickable()&&v.getParent() instanceof View)v=(View)v.getParent();assertTrue(label,v.performClick());});ins.waitForIdleSync();}
 void longTouch(float x,float y)throws Exception{long t=SystemClock.uptimeMillis();MotionEvent e=MotionEvent.obtain(t,t,MotionEvent.ACTION_DOWN,x,y,0);try{ins.sendPointerSync(e);}finally{e.recycle();}SystemClock.sleep(850);e=MotionEvent.obtain(t,SystemClock.uptimeMillis(),MotionEvent.ACTION_UP,x,y,0);try{ins.sendPointerSync(e);}finally{e.recycle();}ins.waitForIdleSync();}
 JSONObject selectedSettings()throws Exception{return ui(()->{JSONObject o=new JSONObject();for(String name:new String[]{"cobraRefreshMode","cobraNetworkFamilyMode","cobraManualCallResumeEnabled","cobraSportsHideScores","cobraSportsMultiOverlay","cobraTimeshiftSeconds"})o.put(name,String.valueOf(call(a,name)));SharedPreferences p=(SharedPreferences)get(a,"mPrefs");o.put("ambient",p.getString("cobra_ambient_mode",""));o.put("night",p.getBoolean("cobra_night_cinema",false));return o;});}
 @Test public void additionalRuntimeJourney()throws Exception{
  launch(true);
  check("Player lock blocks touch and unlock restores controls; video long press has no Channels popup",()->{
   watch("Wide");ExoPlayer same=ui(()->(ExoPlayer)get(a,"mPlayer"));press("Lock controls");assertTrue(ui(()->(Boolean)get(a,"mCobraPlayerLocked")));long p=ui(same::getCurrentPosition);longTouch(540,800);assertTrue(ui(()->(Boolean)get(a,"mCobraPlayerLocked")));assertTrue(ui(same::isPlaying));assertTrue(ui(same::getCurrentPosition)>p);assertNull(ui(()->get(a,"mCobraPlayerDrawer")));tag("cobra_player_unlock");assertFalse(ui(()->(Boolean)get(a,"mCobraPlayerLocked")));runUi(()->((Runnable)get(a,"mHideChrome")).run());longTouch(540,800);assertNull(ui(()->get(a,"mCobraPlayerDrawer")));assertNull(ui(()->get(a,"mCobraActionSheet")));assertSame(same,ui(()->get(a,"mPlayer")));screenshot("unlocked-no-longpress-popup");
  });
  check("Channel PiP Off prevents framework PiP and returns to the same decoder",()->{
   watch("Wide");ExoPlayer same=ui(()->(ExoPlayer)get(a,"mPlayer"));Object c=channel("Wide");runUi(()->call(a,"cobraShowChannelSwitch",c,"pip"));tag("cobra-channel-pip:off");assertFalse(ui(()->(Boolean)call(a,"cobraChannelPipEnabled",c)));runUi(()->call(a,"closeCobraActionSheet"));shell("input keyevent KEYCODE_HOME");SystemClock.sleep(1200);assertFalse(a.isInPictureInPictureMode());foreground();assertSame(same,ui(()->get(a,"mPlayer")));runUi(()->call(a,"cobraShowChannelSwitch",c,"pip"));tag("cobra-channel-pip:inherit");
  });
  check("Fullscreen Display changes the existing decoder and retains its selected override",()->{
   watch("Wide");ExoPlayer same=ui(()->(ExoPlayer)get(a,"mPlayer"));Object c=channel("Wide");runUi(()->call(a,"showCobraAspectPicker"));tag("cobra-channel-aspect:13");assertEquals(13,ui(()->((Number)call(a,"cobraChannelAspect",c)).intValue()).intValue());assertSame(same,ui(()->get(a,"mPlayer")));runUi(()->call(a,"closeCobraActionSheet"));screenshot("display-fill-selected");runUi(()->call(a,"cobraShowChannelAspect",c));tag("cobra-channel-aspect:-1");
  });
  check("Recording survives actual Activity recreation, stops, and a second recording can start",()->{
   watch("Rewind");Object c=channel("Rewind");runUi(()->call(a,"toggleRecording",c));SystemClock.sleep(250);tapText("Until I stop it");await("recording bytes",()->{File f=recorded("Rewind");return f!=null&&f.length()>65536;},15000);String id=ui(()->(String)get(a,"mRecordingSession"));File f=recorded("Rewind");long before=f.length();InfinityLiveActivity old=a;runUi(old::recreate);
   await("new resumed Activity",()->{for(Activity current:androidx.test.runner.lifecycle.ActivityLifecycleMonitorRegistry.getInstance().getActivitiesInStage(androidx.test.runner.lifecycle.Stage.RESUMED))if(current instanceof InfinityLiveActivity&&current!=old){a=(InfinityLiveActivity)current;return true;}return false;},12000);
   assertEquals(id,ui(()->get(a,"mRecordingSession")));await("same recording keeps writing",()->f.length()>before+16384,8000);runUi(()->call(a,"toggleRecording",c));await("recording stops after recreation",()->!recordingServiceRunning(),10000);
   watch("Rewind");Object c2=channel("Rewind");runUi(()->call(a,"toggleRecording",c2));SystemClock.sleep(250);tapText("Until I stop it");await("second recording active",()->{String next=(String)get(a,"mRecordingSession");return !next.isEmpty()&&!next.equals(id)&&recordingServiceRunning();},8000);runUi(()->call(a,"toggleRecording",c2));await("second service stops",()->!recordingServiceRunning(),10000);screenshot("recording-recreated-stopped");
  });
  check("Sports Watch Live and Smart Multi-View resolve fixture broadcasts into real playback",()->{
   toGuide();Object first=model("CobraSportsGame"),second=model("CobraSportsGame");int i=0;for(Object game:new Object[]{first,second}){put(game,"id","audit-game-"+i);put(game,"leagueKey","nfl");put(game,"leagueLabel","Audit NFL");put(game,"state","in");put(game,"startMs",System.currentTimeMillis());((List<String>)get(game,"broadcasts")).add(i==0?"Wide":"Classic");Object home=model("CobraSportsTeam"),away=model("CobraSportsTeam");for(Object team:new Object[]{home,away}){put(team,"key","nfl|audit-"+i+"-"+(team==home?"h":"a"));put(team,"name",team==home?"Audit Home":"Audit Away");put(team,"abbreviation",team==home?"AHM":"AAW");put(team,"score",team==home?"42":"17");}put(game,"home",home);put(game,"away",away);i++;}
   runUi(()->{put(a,"mCobraSportsLastRefresh",System.currentTimeMillis());List list=(List)get(a,"mCobraSportsGames");list.clear();list.add(first);list.add(second);call(a,"cobraSelectDrawerOwner","SPORTS");call(a,"showCobraSportsGame","audit-game-0");});clickTextCallback("Watch Live");await("resolved sports playback",()->{ExoPlayer p=(ExoPlayer)get(a,"mPlayer");return p!=null&&p.isPlaying()&&p.getVideoSize().width>0&&"Sports Wide".equals(get(get(a,"mPlaying"),"name"));},15000);screenshot("sports-watch-playing");runUi(()->{call(a,"closeFullscreenToCobraView");call(a,"showCobraSportsGame","audit-game-0");});assertEquals("sports",ui(()->call(a,"cobraDrawerOwner")));clickTextCallback("Multi-View");await("sports two real decoders",()->{ExoPlayer[] ps=(ExoPlayer[])get(a,"mMultiPlayers");if(ps==null||ps.length!=2)return false;for(ExoPlayer p:ps)if(!p.isPlaying()||p.getVideoSize().width==0)return false;return true;},20000);assertEquals(2,ui(()->((Map)get(a,"mCobraSportsMultiAssignments")).size()).intValue());screenshot("sports-smart-multi");toGuide();
  });
  check("Trailer callback hands the provider URL to Android and keeps Movies ownership",()->{
   toGuide();runUi(()->{call(a,"cobraSelectDrawerOwner","MOVIES");call(a,"showCobraPrimaryView");});Class<?> c=Class.forName("com.projectinfinity.kodi.InfinityLiveActivity$VodItem");Constructor<?> k=c.getDeclaredConstructor(String.class,String.class,String.class,String.class,String.class,String.class,boolean.class);k.setAccessible(true);Object item=k.newInstance("audit","trailer","Audit Movie","","","mp4",false);final Intent[] captured={null};Instrumentation.ActivityMonitor monitor=new Instrumentation.ActivityMonitor(){@Override public Instrumentation.ActivityResult onStartActivity(Intent intent){if(Intent.ACTION_VIEW.equals(intent.getAction())){captured[0]=new Intent(intent);return new Instrumentation.ActivityResult(Activity.RESULT_CANCELED,null);}return null;}};ins.addMonitor(monitor);
   try{runUi(()->call(a,"cobraOpenVodTrailer",item,new JSONObject().put("youtube_trailer","abcdefghijk")));assertNotNull(captured[0]);assertEquals("https://www.youtube.com/watch?v=abcdefghijk",captured[0].getDataString());assertEquals("movies",ui(()->call(a,"cobraDrawerOwner")));}finally{ins.removeMonitor(monitor);}
  });
  check("Diagnostics action exports a readable ZIP through Android content provider",()->{
   android.content.ContentValues values=new android.content.ContentValues();values.put(android.provider.MediaStore.MediaColumns.DISPLAY_NAME,"Cobra-audit-diagnostics.zip");values.put(android.provider.MediaStore.MediaColumns.MIME_TYPE,"application/zip");android.net.Uri target=ins.getTargetContext().getContentResolver().insert(android.provider.MediaStore.Downloads.EXTERNAL_CONTENT_URI,values);assertNotNull(target);final Intent[] captured={null};Instrumentation.ActivityMonitor monitor=new Instrumentation.ActivityMonitor(){@Override public Instrumentation.ActivityResult onStartActivity(Intent intent){if(Intent.ACTION_CREATE_DOCUMENT.equals(intent.getAction())){captured[0]=new Intent(intent);return new Instrumentation.ActivityResult(Activity.RESULT_OK,new Intent().setData(target));}return null;}};ins.addMonitor(monitor);
   try{runUi(()->call(a,"showCobraDiagnosticExport"));clickTextCallback("Choose save location");await("document request and export finished",()->captured[0]!=null&&!InfinityCobraDiagnostics.exporting()&&!(Boolean)get(a,"mCobraDiagnosticsPicker"),20000);ArrayList<String> entries=new ArrayList<>();try(java.util.zip.ZipInputStream z=new java.util.zip.ZipInputStream(ins.getTargetContext().getContentResolver().openInputStream(target))){java.util.zip.ZipEntry entry;while((entry=z.getNextEntry())!=null){entries.add(entry.getName());ByteArrayOutputStream b=new ByteArrayOutputStream();byte[] buffer=new byte[4096];int n;while((n=z.read(buffer))!=-1)b.write(buffer,0,n);assertTrue("Bounded entry",b.size()<4000000);}}assertTrue(entries.toString(),entries.contains("snapshot.txt"));assertTrue(entries.contains("README.txt"));try(FileWriter w=new FileWriter(new File(out,"diagnostics-entries.json"))){w.write(new JSONArray(entries).toString(2));}}finally{ins.removeMonitor(monitor);ins.getTargetContext().getContentResolver().delete(target,null,null);}
  });
  check("Additional settings callbacks change real policies and persist across process restart",()->{
   toGuide();runUi(()->call(a,"showCobraDisplayPerformancePicker"));tag("cobra-refresh:60");assertEquals("60",ui(()->call(a,"cobraRefreshMode")));runUi(()->call(a,"showCobraNetworkFamilyPicker"));tag("cobra-provider-network:ipv4");assertEquals(4,ui(()->((Number)call(a,"cobraNetworkFamilyMode")).intValue()).intValue());
   Object c=channel("Wide");runUi(()->call(a,"cobraShowMediaDuringCalls",c));tag("cobra-media-during-calls:manual");assertTrue(ui(()->(Boolean)call(a,"cobraManualCallResumeEnabled")));runUi(()->call(a,"showCobraLiveRewindPicker"));clickTextCallback("Local rewind buffer • 120 sec");assertEquals(120,ui(()->((Number)call(a,"cobraTimeshiftSeconds")).intValue()).intValue());
   runUi(()->call(a,"showCobraSportsSettings"));clickTextCallback("Hide scores");assertTrue(ui(()->(Boolean)call(a,"cobraSportsHideScores")));runUi(()->call(a,"showCobraSportsSettings"));boolean overlay=ui(()->(Boolean)call(a,"cobraSportsMultiOverlay"));clickTextCallback("Sports Multi-View overlay");assertEquals(!overlay,ui(()->call(a,"cobraSportsMultiOverlay")));
   runUi(()->call(a,"cobraShowVisualMenu",(Object)null));tag("cobra-visual-night:on");runUi(()->call(a,"cobraShowVisualMenu",(Object)null));tag("cobra-visual-ambient:off");JSONObject expected=selectedSettings();try(FileWriter w=new FileWriter(new File(out,"expected-settings.json"))){w.write(expected.toString());}screenshot("additional-settings-selected");
  });
  saveResults();runUi(()->a.finish());assertTrue(errors.toString(),errors.isEmpty());
 }
 @Test public void settingsAfterProcessRestart()throws Exception{
  launch(false);check("Additional settings survive a distinct Android process",()->{String expected;try(BufferedReader r=new BufferedReader(new FileReader(new File(out,"expected-settings.json")))){expected=r.readLine();}JSONObject saved=new JSONObject(expected),actual=selectedSettings();Iterator<String> keys=saved.keys();while(keys.hasNext()){String k=keys.next();assertEquals(k,String.valueOf(saved.get(k)),String.valueOf(actual.get(k)));}screenshot("additional-settings-after-restart");});saveResults();runUi(()->a.finish());assertTrue(errors.toString(),errors.isEmpty());
 }
}
