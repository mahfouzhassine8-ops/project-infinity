+    private void guardNonProPreview(UiDevice device, String mode) throws Exception {
+        assertEquals("Wrong foreground package", PACKAGE, device.getCurrentPackageName());
+        assertTrue("Exact non-Pro mode heading missing", new UiObject(new UiSelector()
+                .packageName(PACKAGE).text(mode)).exists());
+        assertFalse("Pro heading must not be present", new UiObject(new UiSelector()
+                .packageName(PACKAGE).text("Pro")).exists());
+        assertFalse("Pro source control must not be present", new UiObject(new UiSelector()
+                .packageName(PACKAGE).description("Previous Pro source")).exists());
+        assertFalse("Fullscreen preview-return control must not be present", new UiObject(new UiSelector()
+                .packageName(PACKAGE).description("Return to preview")).exists());
+        assertFalse("Fullscreen preview-return label must not be present", new UiObject(new UiSelector()
+                .packageName(PACKAGE).text("Return to preview")).exists());
+    }
+
+    private Rect[] nonProPreviewBounds(UiDevice device, String mode) throws Exception {
+        guardNonProPreview(device, mode);
+        String[] descriptions = {"Fullscreen", "Picture-in-Picture", "Channel actions"};
+        Rect[] result = new Rect[descriptions.length];
+        for (int index = 0; index < descriptions.length; index++) {
+            UiSelector selector = action(descriptions[index]);
+            UiObject target = new UiObject(selector.instance(0));
+            assertTrue("Required native non-Pro preview button missing: " + descriptions[index], target.exists());
+            assertFalse("Ambiguous native non-Pro preview button: " + descriptions[index],
+                    new UiObject(selector.instance(1)).exists());
+            assertEquals("Native button identity changed", descriptions[index], target.getContentDescription());
+            Rect visible = new Rect(target.getVisibleBounds());
+            assertTrue("Native non-Pro preview target is too small: " + descriptions[index],
+                    visible.width() >= MIN_HIT_PX && visible.height() >= MIN_HIT_PX);
+            assertTrue("Native non-Pro target extends outside the display", visible.left >= 0
+                    && visible.top >= 0 && visible.right <= device.getDisplayWidth()
+                    && visible.bottom <= device.getDisplayHeight());
+            result[index] = visible;
+        }
+        int bandTop = Math.max(result[0].top, Math.max(result[1].top, result[2].top));
+        int bandBottom = Math.min(result[0].bottom, Math.min(result[1].bottom, result[2].bottom));
+        assertTrue("Native preview buttons do not share a usable horizontal band",
+                bandBottom - bandTop >= MIN_HIT_PX);
+        assertTrue("Native preview button order or hitbox separation changed",
+                result[0].left < result[1].left && result[1].left < result[2].left
+                && result[0].right <= result[1].left && result[1].right <= result[2].left);
+        return result;
+    }
