+def prepare_native_framework(native_jar, out):
+    """Fail before APK installation if the legacy OS runner cannot load its deps."""
+    out.mkdir(parents=True, exist_ok=False)
+    report = {'scope': 'QA_FRAMEWORK_ONLY_BEFORE_APK_INSTALL; NO_INPUT',
+              'status': 'NOT_COMPLETED', 'shutdown': 'NOT_RUN'}
+    try:
+        serial = adb('get-serialno').strip()
+        sdk = adb('shell', 'getprop', 'ro.build.version.sdk').strip()
+        qemu = adb('shell', 'getprop', 'ro.kernel.qemu').strip()
+        assert serial.startswith('emulator-') and sdk == '37' and qemu == '1', 'Fresh API37 emulator required'
+        assert not adb('shell', 'pm', 'path', PACKAGE, check=False).strip(), 'Existing application refused; never clear data'
+        report.update(serial=serial, sdk=sdk)
+        script = adb('shell', 'cat', '/system/bin/uiautomator')
+        (out/'OS-uiautomator-script.txt').write_text(script)
+        assert '/system/framework/android.test.runner.jar' in script and '/system/framework/uiautomator.jar' in script
+        inventory = {}
+        for path in (*NATIVE_FRAMEWORK_JARS, '/system/framework/android.test.runner.jar', '/system/framework/uiautomator.jar'):
+            fields = adb('shell', 'sha256sum', path).split()
+            assert len(fields) == 2 and re.fullmatch(r'[0-9a-f]{64}', fields[0]) and fields[1] == path, 'Missing OS framework JAR: '+path
+            inventory[path] = fields[0]
+        report['actual_OS_framework_sha256'] = inventory
+        expected = hashlib.sha256(native_jar.read_bytes()).hexdigest()
+        adb('push', str(native_jar), NATIVE_QA_JAR)
+        fields = adb('shell', 'sha256sum', NATIVE_QA_JAR).split()
+        assert fields and fields[0] == expected, 'Native QA JAR transfer mismatch'
+        report['native_QA_JAR_sha256'] = expected
+        raw = adb(*native_runner_args('testFrameworkReady'), check=False)
+        (out/'runner.txt').write_text(raw)
+        matches = re.findall(r'COBRA_NATIVE_FRAMEWORK_READY=(\{[^\r\n]+\})', raw)
+        assert len(matches) == 1, 'One OS framework readiness record required; see runner.txt'
+        ready = json.loads(matches[0]);report['readiness'] = ready
+        assert ready.get('status') == 'FRAMEWORK_CLASSES_RESOLVED' and ready.get('scope') == 'QA_FRAMEWORK_ONLY_NO_INPUT', ready
+        assert re.search(r'\bOK\s*\(1 test\)', raw) and 'FAILURES!!!' not in raw and 'shortMsg=' not in raw and 'Test run aborted' not in raw, 'Native framework runner aborted'
+        assert {'android.test.RepetitiveTest', 'android.test.mock.MockContext',
+                'com.android.uiautomator.core.UiDevice', 'com.android.uiautomator.testrunner.UiAutomatorTestCase'} <= set(ready.get('classes', [])), ready
+        report['status'] = 'PASS_ACTUAL_OS_DEPENDENCIES_RESOLVED_BEFORE_APK_INSTALL'
+        return report
+    except Exception as exc:
+        report['status'] = 'FAILED_BEFORE_APK_INSTALL';report['error'] = str(exc)
+        raise
+    finally:
+        (out/'OUTCOME.json').write_text(json.dumps(report, indent=2)+'\n')
