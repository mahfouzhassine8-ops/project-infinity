+        JSONObject report = new JSONObject().put("scope", "ON_DEVICE_PUBLIC_NONPRO_PREVIEW_COORDINATE_TAP")
+                .put("package", PACKAGE).put("mode", mode).put("requested_label", label)
+                .put("press_deadline_ms", PRESS_DEADLINE_MS).put("injection_attempted", false)
+                .put("status", "FAILED_CLOSED").put("shutdown", "NOT_RUN");
+        UiDevice device = getUiDevice();
+        Configurator config = Configurator.getInstance();
+        long oldIdle = config.getWaitForIdleTimeout(), oldSelector = config.getWaitForSelectorTimeout();
+        try {
+            assertTrue("Unsupported non-Pro mode", mode.equals("Mobile") || mode.equals("Compact")
+                    || mode.equals("Cards") || mode.equals("TV Grid"));
+            assertTrue("Unsupported non-Pro target", label.equals("Fullscreen") || label.equals("PiP")
+                    || label.equals("More"));
+            assertTrue("Unsafe or missing public QA capture basename",
+                    capturePrefix.matches("[A-Za-z0-9][A-Za-z0-9_-]{0,63}"));
+            final File beforeXml = new File("/data/local/tmp", capturePrefix + "-before.xml");
+            final File beforePng = new File("/data/local/tmp", capturePrefix + "-before.png");
+            final File postXml = new File("/data/local/tmp", capturePrefix + ".xml");
+            final File postPng = new File("/data/local/tmp", capturePrefix + ".png");
+            assertFalse("Refuse stale public QA before XML", beforeXml.exists());
+            assertFalse("Refuse stale public QA before PNG", beforePng.exists());
+            assertFalse("Refuse stale public QA post XML", postXml.exists());
+            assertFalse("Refuse stale public QA post PNG", postPng.exists());
+            // QA bridge timeouts only. No app timer, control, scroll or reveal is changed.
+            config.setWaitForIdleTimeout(0).setWaitForSelectorTimeout(0);
+            nonProPreviewBounds(device, mode);
+            report.put("pre_ui_xml", beforeXml.getAbsolutePath()).put("pre_ui_png", beforePng.getAbsolutePath());
+            device.dumpWindowHierarchy(capturePrefix + "-before.xml");
+            assertTrue("Native before-press XML capture missing", beforeXml.isFile() && beforeXml.length() > 0);
+            assertTrue("Native before-press PNG capture failed", device.takeScreenshot(beforePng)
+                    && beforePng.isFile() && beforePng.length() > 0);
+
+            long freshStarted = SystemClock.uptimeMillis();
+            Rect[] first = nonProPreviewBounds(device, mode);
+            SystemClock.sleep(32);
+            Rect[] second = nonProPreviewBounds(device, mode);
+            for (int index = 0; index < first.length; index++) {
+                assertEquals("Native preview bounds changed after first fresh observation", first[index], second[index]);
+            }
+            int selected = label.equals("Fullscreen") ? 0 : label.equals("PiP") ? 1 : 2;
+            String description = selected == 0 ? "Fullscreen" : selected == 1 ? "Picture-in-Picture" : "Channel actions";
+            Rect hit = second[selected];
+            report.put("observed_native_label", description).put("visible_hit_bounds", rect(hit))
+                    .put("all_preview_bounds", new JSONObject().put("Fullscreen", rect(second[0]))
+                            .put("PiP", rect(second[1])).put("More", rect(second[2])))
+                    .put("coordinate", new JSONArray().put(hit.centerX()).put(hit.centerY()))
+                    .put("native_elapsed_before_injection_ms", SystemClock.uptimeMillis() - freshStarted);
+            assertTrue("Native non-Pro target exceeded unchanged freshness deadline",
+                    SystemClock.uptimeMillis() - freshStarted < PRESS_DEADLINE_MS);
+            report.put("injection_attempted", true);
+            boolean injected = device.click(hit.centerX(), hit.centerY());
+            long elapsed = SystemClock.uptimeMillis() - freshStarted;
+            report.put("injection_result", injected).put("native_elapsed_ms", elapsed);
+            assertTrue("Coordinate injection failed; do not retry uncertain press", injected);
+            assertTrue("Press completed after unchanged deadline; do not retry uncertain press",
+                    elapsed < PRESS_DEADLINE_MS);
+            report.put("post_ui_xml", postXml.getAbsolutePath()).put("post_ui_png", postPng.getAbsolutePath());
+            SystemClock.sleep(80);
