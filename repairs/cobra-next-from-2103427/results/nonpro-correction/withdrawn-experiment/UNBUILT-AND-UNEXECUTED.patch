+    /** Resolves the real OS runner dependencies before any application UI test. */
+    public void testFrameworkReady() throws Exception {
+        JSONObject report = new JSONObject().put("scope", "QA_FRAMEWORK_ONLY_NO_INPUT")
+                .put("status", "FAILED_CLOSED").put("classes", new JSONArray());
+        String[] names = {
+                "android.test.RepetitiveTest", "android.test.FlakyTest", "android.test.UiThreadTest",
+                "android.test.mock.MockContext", "junit.framework.TestCase",
+                "com.android.uiautomator.testrunner.UiAutomatorTestCase",
+                "com.android.uiautomator.testrunner.UiAutomatorTestRunner",
+                "com.android.uiautomator.core.UiDevice", "com.android.uiautomator.core.Configurator",
+                "com.android.uiautomator.core.UiObject", "com.android.uiautomator.core.UiSelector"
+        };
+        try {
+            for (String name : names) {
+                report.put("resolving", name);
+                Class<?> resolved = Class.forName(name);
+                assertEquals("Unexpected runtime class identity", name, resolved.getName());
+                report.getJSONArray("classes").put(resolved.getName());
+            }
+            Class<?> repetitive = Class.forName("android.test.RepetitiveTest");
+            assertTrue("OS RepetitiveTest must remain an annotation", repetitive.isAnnotation());
+            assertEquals("OS RepetitiveTest default changed", Integer.valueOf(1),
+                    repetitive.getMethod("numIterations").getDefaultValue());
+            report.put("RepetitiveTest_is_annotation", true)
+                    .put("RepetitiveTest_default_iterations", 1)
+                    .put("status", "FRAMEWORK_CLASSES_RESOLVED");
+        } finally {
+            System.out.println("COBRA_NATIVE_FRAMEWORK_READY=" + report.toString());
+        }
+    }
