+/* SPDX-License-Identifier: GPL-2.0-or-later */
+package @APP_PACKAGE@;
+
+import android.app.Activity;
+import android.content.*;
+import android.content.res.*;
+import android.graphics.*;
+import android.graphics.drawable.*;
+import android.os.*;
+import android.view.*;
+import android.widget.*;
+
+/** Small, non-modal-to-shutdown Android presentation in the DEFAULT process.
+ * No Kodi calls, service starts, stop requests, native loading or completion writes.
+ * Back only hides the card; actual shutdown and its independent notification continue. */
+public final class InfinityClosingActivity extends Activity {
+  private static final String START="ui_close_started";
+  private final Handler ui=new Handler(Looper.getMainLooper());
+  private int pid;private String owner;private long started;
+  private TextView stage,elapsed,hint;
+  private ProgressBar progress;
+  private InfinityKodiShutdown.Watch watch;
+  private boolean observedOwner;
+  static Intent intent(Context context,int pid,String owner,long started){
+    return new Intent(context,InfinityClosingActivity.class)
+        .putExtra(InfinityKodiShutdown.PID,pid).putExtra(InfinityKodiShutdown.OWNER,owner)
+        .putExtra(START,started)
+        .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK|Intent.FLAG_ACTIVITY_SINGLE_TOP|Intent.FLAG_ACTIVITY_NO_ANIMATION);
+  }
+  static boolean valid(Intent intent,long now){
+    if(intent==null)return false;
+    String token=intent.getStringExtra(InfinityKodiShutdown.OWNER);
+    long at=intent.getLongExtra(START,-1);
+    return intent.getIntExtra(InfinityKodiShutdown.PID,-1)>0&&token!=null&&
+        token.matches("[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")&&
+        at>=0&&now>=at&&now-at<=InfinityCloseGuardService.MAX_PROTECTION_MS;
+  }
+  @Override protected void onCreate(Bundle saved){
+    super.onCreate(saved);
+    if(!valid(getIntent(),SystemClock.elapsedRealtime())){finish();return;}
+    pid=getIntent().getIntExtra(InfinityKodiShutdown.PID,-1);
+    owner=getIntent().getStringExtra(InfinityKodiShutdown.OWNER);
+    started=getIntent().getLongExtra(START,-1);
+    setFinishOnTouchOutside(false);
+    render();
+    watch=new InfinityKodiShutdown.Watch(this,state->{
+      if(state.pid==pid&&owner.equals(state.owner)){
+        observedOwner=true;
+        // This is only UI dismissal. Existing owner/receipt code decides clean vs unclean.
+        if(!state.alive)finish();
+      }else if(observedOwner&&state.pid>0){finish();}
+    });
+    ui.post(tick);
+  }
+  private int dp(float n){return Math.round(n*getResources().getDisplayMetrics().density);}
+  private TextView label(String text,int size,int color,boolean bold){
+    TextView v=new TextView(this);v.setText(text);v.setTextSize(size);v.setTextColor(color);
+    v.setTypeface(Typeface.create(bold?"sans-serif-medium":"sans-serif",Typeface.NORMAL));
+    v.setIncludeFontPadding(false);return v;
+  }
+  private void render(){
+    boolean dark=(getResources().getConfiguration().uiMode&Configuration.UI_MODE_NIGHT_MASK)==Configuration.UI_MODE_NIGHT_YES;
+    int ink=dark?0xFFF3F7FF:0xFF102A43,muted=dark?0xFFBECFE0:0xFF455E73;
+    int accent=dark?0xFF47C9EE:0xFF087DA4;
+    LinearLayout body=new LinearLayout(this);body.setOrientation(LinearLayout.VERTICAL);
+    body.setPadding(dp(20),dp(18),dp(20),dp(18));
+    GradientDrawable glass=new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
+        dark?new int[]{0xFA142334,0xFA081321}:new int[]{0xFAF7FBFF,0xFAE7F3FC});
+    glass.setCornerRadius(dp(20));glass.setStroke(dp(1),dark?0xFF285B78:0xFF9DCDE5);
+    body.setBackground(glass);body.setElevation(dp(8));
+    LinearLayout title=new LinearLayout(this);title.setGravity(Gravity.CENTER_VERTICAL);
+    TextView mark=label("\u221e",34,accent,false);
+    title.addView(mark,new LinearLayout.LayoutParams(dp(46),dp(38)));
+    TextView heading=label("CLOSING INFINITY...",18,ink,true);
+    title.addView(heading,new LinearLayout.LayoutParams(0,LinearLayout.LayoutParams.WRAP_CONTENT,1));
+    body.addView(title);
+    stage=label("Preparing shutdown",17,ink,true);stage.setPadding(0,dp(16),0,dp(7));
+    stage.setAccessibilityLiveRegion(View.ACCESSIBILITY_LIVE_REGION_POLITE);body.addView(stage);
+    hint=label("Please wait while your session closes safely.",13,muted,false);
+    body.addView(hint);
+    progress=new ProgressBar(this,null,android.R.attr.progressBarStyleHorizontal);
+    boolean animate=Build.VERSION.SDK_INT<26||android.animation.ValueAnimator.areAnimatorsEnabled();
+    progress.setIndeterminate(animate);progress.setIndeterminateTintList(ColorStateList.valueOf(accent));
+    if(!animate)progress.setVisibility(View.GONE);
+    LinearLayout.LayoutParams bar=new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT,dp(8));
+    bar.topMargin=dp(15);bar.bottomMargin=dp(12);body.addView(progress,bar);
+    elapsed=label("Live shutdown status",12,muted,false);body.addView(elapsed);
+    ScrollView scroll=new ScrollView(this);scroll.setFillViewport(false);scroll.addView(body);
+    setContentView(scroll);
+    Window window=getWindow();window.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
+    window.clearFlags(WindowManager.LayoutParams.FLAG_DIM_BEHIND);
+    window.addFlags(WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL);
+    WindowManager.LayoutParams params=window.getAttributes();
+    params.gravity=Gravity.BOTTOM|Gravity.END;params.x=dp(12);params.y=dp(20);
+    params.width=Math.max(1,Math.min(dp(420),getResources().getDisplayMetrics().widthPixels-dp(24)));
+    body.measure(View.MeasureSpec.makeMeasureSpec(params.width,View.MeasureSpec.EXACTLY),
+        View.MeasureSpec.makeMeasureSpec(0,View.MeasureSpec.UNSPECIFIED));
+    params.height=Math.max(1,Math.min(body.getMeasuredHeight(),getResources().getDisplayMetrics().heightPixels-dp(40)));
+    params.windowAnimations=0;window.setAttributes(params);
+  }
+  private final Runnable tick=new Runnable(){public void run(){
+    if(isFinishing()||isDestroyed())return;
+    long seconds=Math.max(0,(SystemClock.elapsedRealtime()-started)/1000);
+    InfinityCloseProgress.Display state=InfinityCloseProgress.display;
+    if(state!=null&&state.matches(pid,owner)){
+      String message=state.ended?"Waiting for shutdown confirmation":state.message;
+      if(!message.contentEquals(stage.getText()))stage.setText(message);
+      if(state.ended)hint.setText("If this persists, open Health Center from the chooser.");
+    }else if(seconds>=10){
+      stage.setText("Waiting for live shutdown status");
+      hint.setText("No completion has been confirmed. Back hides this card.");
+    }
+    String clock="Live shutdown status  |  "+seconds+" s elapsed";
+    if(!clock.contentEquals(elapsed.getText()))elapsed.setText(clock);
+    // Only elapsed time changes here. No timer changes the reported native stage.
+    ui.postDelayed(this,250);
+  }};
+  @Override public void onConfigurationChanged(Configuration config){super.onConfigurationChanged(config);render();}
+  @Override protected void onDestroy(){ui.removeCallbacksAndMessages(null);if(watch!=null)watch.close();super.onDestroy();}
+}
