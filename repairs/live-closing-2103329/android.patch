+/** Read-only presentation of the existing 2103327 trace. Never owns shutdown,
+ * advances by a timer, calls Kodi, or treats a returned span as a clean exit. */
+final class InfinityCloseProgress {
+  static final String ENGINE="infinity-shutdown-2103327-v1";
+  static final String FILE="infinity-shutdown-native.jsonl.critical";
+  static final int MAX_LINE=8192, MAX_READ=128*1024, MAX_SPANS=1024;
+  static volatile Display display;
+  static final class Display {
+    final int pid; final String owner,stage,message; final long started; final boolean ended;
+    Display(int p,String o,long s,String st,String m,boolean e){pid=p;owner=o;started=s;stage=st;message=m;ended=e;}
+    boolean matches(int p,String o){return p==pid&&owner.equals(o);}
+  }
+  static final class Phase {
+    final String name,text; final int importance;
+    Phase(String n,String t,int i){name=n;text=t;importance=i;}
+  }
+  static Phase phase(String name) {
+    if(name.equals("pre.save_settings")||name.equals("pre.save_skin")||
+       name.equals("stop.save_settings")||name.equals("stop.save_skin"))
+      return new Phase("saving","Saving settings and session state",4);
+    if(name.equals("stop.close_player")||name.equals("cleanup.stop_playing"))
+      return new Phase("playback","Stopping playback",4);
+    if(name.equals("pre.stop_services")||name.equals("stop.services")||name.startsWith("services.stop"))
+      return new Phase("services","Stopping add-on services",3);
+    if(name.startsWith("scripts.")||name.startsWith("python.runtime")||
+       name.equals("pre.stop_scripts")||name.equals("stop.scripts")||name.equals("cleanup.scripts_uninitialize"))
+      return new Phase("scripts","Finishing scripts",4);
+    if(name.equals("stop.cancel_jobs")||name.equals("pre.begin_job_shutdown"))
+      return new Phase("jobs","Finishing background work",4);
+    if(name.equals("stop.audio_engine"))return new Phase("audio","Releasing audio",4);
+    if(name.equals("stop.network")||name.equals("stop.vfs_disconnect"))
+      return new Phase("network","Closing connections",4);
+    if(name.startsWith("cleanup.")||name.equals("application.cleanup")||name.equals("application.stop"))
+      return new Phase("cleanup","Cleaning up application resources",1);
+    if(name.equals("android.environment_teardown")||name.equals("android.native_destroy"))
+      return new Phase("closing","Finishing native cleanup",2);
+    if(name.equals("application.pre_destroy"))return new Phase("preparing","Preparing shutdown",0);
+    return null;
+  }
+  static final class Span {
+    final long at,seq;final Phase phase;
+    Span(long a,long s,Phase p){at=a;seq=s;phase=p;}
+  }
+  static final class Reader {
+    final int pid; final long earliestNs; final File file;
+    long offset,session=-1,lastBoot=-1; boolean exitRequested,limited,invalid;
+    String header="",status="Waiting for live shutdown status";
+    final LinkedHashMap<Long,Span> active=new LinkedHashMap<>();
+    final ByteArrayOutputStream partial=new ByteArrayOutputStream();
+    final HashSet<Long> seen=new HashSet<>(),finished=new HashSet<>();
+    boolean dropLine;
+    Reader(File directory,int pid,long startedMs){this.file=new File(directory,FILE);this.pid=pid;earliestNs=startedMs*1000000L;}
+    void read(long nowNs) {
+      try(RandomAccessFile input=new RandomAccessFile(file,"r")) {
+        // Reopen each poll so rotation cannot leave us following an old inode.
+        String first=readHeader(input);
+        if(!first.equals(header)||input.length()<offset){reset();header=first;}
+        if(first.isEmpty())return;
+        input.seek(offset);
+        byte[] bytes=new byte[MAX_READ];int count=input.read(bytes);
+        if(count<=0)return;
+        offset+=count;
+        for(int i=0;i<count;i++){
+          int b=bytes[i]&255;
+          if(b==10){
+            if(!dropLine&&partial.size()>0) accept(new String(partial.toByteArray(),StandardCharsets.UTF_8),nowNs);
+            partial.reset();dropLine=false;
+          }else if(!dropLine){
+            if(partial.size()>=MAX_LINE){partial.reset();dropLine=true;invalid=true;}
+            else partial.write(b);
+          }
+        }
+      }catch(IOException|SecurityException unavailable){status="Live status temporarily unavailable";}
+    }
+    private static String readHeader(RandomAccessFile in)throws IOException{
+      ByteArrayOutputStream line=new ByteArrayOutputStream();int b;
+      while(line.size()<=MAX_LINE&&(b=in.read())>=0){if(b==10)return new String(line.toByteArray(),StandardCharsets.UTF_8);line.write(b);}
+      return ""; // a partial first line is not yet an event
+    }
+    private void reset(){offset=0;session=-1;lastBoot=-1;exitRequested=false;limited=false;invalid=false;active.clear();seen.clear();finished.clear();partial.reset();dropLine=false;}
+    void accept(String line,long nowNs){
+      try{
+        JSONObject row=new JSONObject(line);
+        if(row.optInt("schema",-1)!=1||row.optInt("pid",-1)!=pid)return;
+        String kind=row.optString("kind"),name=row.optString("phase");
+        long origin=row.optLong("session_start_ns",-1),at=row.optLong("boot_ns",-1),seq=row.optLong("seq",-1);
+        if(origin<earliestNs||origin>nowNs+1000000000L||at<origin||at>nowNs+1000000000L||seq<0)return;
+        if(name.equals("capture.begin")&&kind.equals("milestone")&&ENGINE.equals(row.optString("engine"))&&seq==0){
+          if(session<0){session=origin;status="Preparing shutdown";}else if(session!=origin)return;
+        }
+        if(session!=origin)return;
+        if(name.equals("capture.event_limit")){limited=true;return;}
+        if(!ENGINE.equals(row.optString("engine")))return;
+        if(seen.size()>=2048){limited=true;return;}
+        if(!seen.add(seq))return;
+        lastBoot=Math.max(lastBoot,at);status="Live shutdown status";
+        if(kind.equals("milestone")&&name.equals("process.exit_requested")){exitRequested=true;return;}
+        long span=row.optLong("span_id",0);
+        if(kind.equals("end")){active.remove(span);if(span>0)finished.add(span);return;}
+        Phase p=phase(name);
+        if(kind.equals("begin")&&span>0&&p!=null&&!finished.contains(span)){
+          if(active.size()>=MAX_SPANS){limited=true;return;}
+          active.put(span,new Span(at,seq,p));
+        }
+      }catch(Exception malformed){invalid=true;}
+    }
+    Phase current(){
+      if(exitRequested)return new Phase("closing","Waiting for Kodi to exit",2);
+      Span best=null;
+      for(Span s:active.values()) if(best==null||s.phase.importance>best.phase.importance||
+          (s.phase.importance==best.phase.importance&&(s.at>best.at||(s.at==best.at&&s.seq>best.seq))))best=s;
+      if(best!=null)return best.phase;
+      return new Phase("waiting",session<0?status:"Finishing shutdown",0);
+    }
+    String note(){return limited?"Last recorded stage - trace limit reached":invalid?"Partial trace - showing available status":status;}
+  }
+  private InfinityCloseProgress(){}
+}
