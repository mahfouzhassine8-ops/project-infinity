// Production method bodies are injected by test_checked_sqlite.py.
// SQLite operations below execute the installed SQLite library; none are mocked.
#if __has_include(<sqlite3.h>)
#include <sqlite3.h>
#else
// Minimal stable SQLite C ABI declarations for hosts with the runtime but no
// development headers. This declares, and does not implement, SQLite functions.
extern "C" {
struct sqlite3;
int sqlite3_open(const char*, sqlite3**);
int sqlite3_close(sqlite3*);
int sqlite3_exec(sqlite3*, const char*, int (*)(void*, int, char**, char**), void*, char**);
int sqlite3_get_autocommit(sqlite3*);
const char* sqlite3_errmsg(sqlite3*);
const char* sqlite3_libversion();
int sqlite3_busy_timeout(sqlite3*, int);
int sqlite3_set_authorizer(sqlite3*, int (*)(void*, int, const char*, const char*, const char*, const char*), void*);
}
constexpr int SQLITE_OK = 0;
constexpr int SQLITE_DENY = 1;
constexpr int SQLITE_FULL = 13;
constexpr int SQLITE_TRANSACTION = 22;
#endif

#include <cstdarg>
#include <cstdio>
#include <functional>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

// Only Kodi framework/diagnostic dependencies are substituted. The code under
// test is extracted verbatim from the guarded transformed production source.
namespace InfinityShutdownTrace {
struct Scope { Scope(const char*, int, const void*, const void*) {} };
}
constexpr int LOGERROR = 1;
struct CLog { static void Log(int, const char*) {} };
class DbErrors {
  std::string message;
public:
  explicit DbErrors(const char* format, ...) {
    char buffer[2048];
    va_list args;
    va_start(args, format);
    std::vsnprintf(buffer, sizeof(buffer), format, args);
    va_end(args);
    message = buffer;
  }
  const char* getMsg() const { return message.c_str(); }
};
class SqliteDatabase {
public:
  sqlite3* conn = nullptr;
  bool active = false;
  bool _in_transaction = false;
  std::string error;
  void start_transaction();
  void commit_transaction();
  void rollback_transaction();
  int setErr(int result, const char* sql) {
    error = std::string(sql) + ": " + sqlite3_errmsg(conn);
    return result;
  }
  const char* getErrorMsg() { return error.c_str(); }
};
class CDatabase {
public:
  SqliteDatabase* m_pDB = nullptr;
  bool CommitTransaction();
};

// @PRODUCTION_FUNCTIONS@

void require(bool condition, const char* message) {
  if (!condition) throw std::runtime_error(message);
}
void exec(sqlite3* db, const char* sql) {
  if (sqlite3_exec(db, sql, nullptr, nullptr, nullptr) != SQLITE_OK)
    throw std::runtime_error(std::string(sql) + ": " + sqlite3_errmsg(db));
}
int countRows(sqlite3* db) {
  int count = -1;
  const int result = sqlite3_exec(db, "SELECT count(*) FROM items",
    [](void* out, int, char** values, char**) -> int {
      *static_cast<int*>(out) = std::stoi(values[0]); return 0;
    }, &count, nullptr);
  require(result == SQLITE_OK, "count query failed");
  return count;
}
template<typename Function> void expectDbError(Function fn, const char* message) {
  bool rejected = false;
  try { fn(); } catch (const DbErrors& error) {
    require(std::string(error.getMsg()).size() > 0, "missing SQLite failure details");
    rejected = true;
  }
  require(rejected, message);
}
struct Connection : SqliteDatabase {
  explicit Connection(const std::string& file = ":memory:") {
    require(sqlite3_open(file.c_str(), &conn) == SQLITE_OK, "SQLite open failed");
    active = true;
    require(sqlite3_busy_timeout(conn, 0) == SQLITE_OK, "busy timeout setup failed");
  }
  ~Connection() {
    sqlite3_set_authorizer(conn, nullptr, nullptr);
    if (!sqlite3_get_autocommit(conn)) sqlite3_exec(conn, "ROLLBACK", nullptr, nullptr, nullptr);
    sqlite3_close(conn);
    conn = nullptr;
    active = false;
  }
};

int main(int argc, char** argv) {
  require(argc == 2, "expected scratch directory");
  const std::string directory = argv[1];
  int failures = 0;
  auto run = [&](const char* name, std::function<void()> test) {
    try { test(); std::cout << "PASS " << name << '\n'; }
    catch (const DbErrors& error) {
      ++failures; std::cout << "FAIL " << name << ": " << error.getMsg() << '\n';
    }
    catch (const std::exception& error) {
      ++failures; std::cout << "FAIL " << name << ": " << error.what() << '\n';
    }
  };
  run("ordinary_commit_and_rollback", [&] {
    const std::string path = directory + "/ordinary.db";
    {
      Connection db(path);
      exec(db.conn, "CREATE TABLE items(value INTEGER)");
      CDatabase outer; outer.m_pDB = &db;
      db.start_transaction();
      require(db._in_transaction && !sqlite3_get_autocommit(db.conn), "begin state incorrect");
      exec(db.conn, "INSERT INTO items VALUES(1)");
      require(outer.CommitTransaction(), "ordinary commit rejected");
      require(!db._in_transaction && sqlite3_get_autocommit(db.conn), "commit state incorrect");
      db.start_transaction();
      exec(db.conn, "INSERT INTO items VALUES(2)");
      db.rollback_transaction();
      require(!db._in_transaction && sqlite3_get_autocommit(db.conn), "rollback state incorrect");
    }
    Connection reopened(path);
    require(countRows(reopened.conn) == 1, "committed state did not survive connection reopen");
  });
  run("busy_begin_does_not_claim_active_transaction", [&] {
    const std::string path = directory + "/busy-begin.db";
    Connection owner(path), contender(path);
    exec(owner.conn, "CREATE TABLE items(value INTEGER)");
    owner.start_transaction();
    contender._in_transaction = true; // Ensure error handling refreshes stale bookkeeping.
    expectDbError([&] { contender.start_transaction(); }, "BUSY begin was reported as successful");
    require(!contender._in_transaction && sqlite3_get_autocommit(contender.conn), "failed begin left false active state");
    owner.rollback_transaction();
    contender.start_transaction();
    contender.rollback_transaction();
  });
  run("nested_begin_preserves_actual_active_transaction", [&] {
    Connection db;
    db.start_transaction();
    expectDbError([&] { db.start_transaction(); }, "nested begin did not report failure");
    require(db._in_transaction && !sqlite3_get_autocommit(db.conn), "nested begin lost active transaction");
    db.rollback_transaction();
  });
  run("busy_commit_retains_transaction_and_retry_persists", [&] {
    const std::string path = directory + "/busy-commit.db";
    Connection writer(path), reader(path);
    exec(writer.conn, "PRAGMA journal_mode=DELETE; CREATE TABLE items(value INTEGER); INSERT INTO items VALUES(1)");
    exec(reader.conn, "BEGIN; SELECT * FROM items"); // Shared read lock remains until COMMIT.
    writer.start_transaction();
    exec(writer.conn, "INSERT INTO items VALUES(2)");
    CDatabase outer; outer.m_pDB = &writer;
    require(!outer.CommitTransaction(), "BUSY commit escaped as success");
    require(writer._in_transaction && !sqlite3_get_autocommit(writer.conn), "BUSY commit lost pending transaction");
    require(countRows(writer.conn) == 2 && countRows(reader.conn) == 1, "uncommitted change visibility incorrect");
    exec(reader.conn, "COMMIT");
    require(outer.CommitTransaction(), "retry after reader released failed");
    require(!writer._in_transaction && sqlite3_get_autocommit(writer.conn), "retry left stale transaction flag");
    Connection reopened(path);
    require(countRows(reopened.conn) == 2, "retry did not persist pending changes");
  });
  run("deferred_constraint_commit_failure_preserves_transaction", [&] {
    Connection db;
    exec(db.conn, "PRAGMA foreign_keys=ON; CREATE TABLE parent(id INTEGER PRIMARY KEY); CREATE TABLE child(id INTEGER REFERENCES parent(id) DEFERRABLE INITIALLY DEFERRED)");
    db.start_transaction();
    exec(db.conn, "INSERT INTO child VALUES(9)");
    CDatabase outer; outer.m_pDB = &db;
    require(!outer.CommitTransaction(), "deferred foreign-key failure escaped as success");
    require(db._in_transaction && !sqlite3_get_autocommit(db.conn), "constraint failure lost transaction state");
    exec(db.conn, "INSERT INTO parent VALUES(9)");
    require(outer.CommitTransaction(), "commit after repairing constraint failed");
    require(!db._in_transaction, "repaired commit left stale flag");
  });
  run("sqlite_full_automatic_rollback_clears_stale_transaction", [&] {
    Connection db;
    exec(db.conn, "PRAGMA page_size=512; PRAGMA max_page_count=2; CREATE TABLE items(value BLOB)");
    db.start_transaction();
    require(sqlite3_exec(db.conn, "INSERT INTO items VALUES(zeroblob(100000))", nullptr, nullptr, nullptr) == SQLITE_FULL,
            "expected SQLite's real full-database failure");
    require(sqlite3_get_autocommit(db.conn), "SQLite did not automatically roll back full transaction");
    require(db._in_transaction, "fixture must retain prior begin bookkeeping until commit attempt");
    CDatabase outer; outer.m_pDB = &db;
    require(!outer.CommitTransaction(), "commit after automatic rollback claimed success");
    require(!db._in_transaction && countRows(db.conn) == 0, "automatic rollback left stale transaction state");
  });
  run("rollback_error_preserves_actual_transaction", [&] {
    Connection db;
    exec(db.conn, "CREATE TABLE items(value INTEGER)");
    db.start_transaction();
    exec(db.conn, "INSERT INTO items VALUES(1)");
    sqlite3_set_authorizer(db.conn,
      [](void*, int action, const char* name, const char*, const char*, const char*) -> int {
        return action == SQLITE_TRANSACTION && name && std::string(name) == "ROLLBACK" ? SQLITE_DENY : SQLITE_OK;
      }, nullptr);
    expectDbError([&] { db.rollback_transaction(); }, "denied rollback was reported as success");
    require(db._in_transaction && !sqlite3_get_autocommit(db.conn), "denied rollback lost active transaction");
    sqlite3_set_authorizer(db.conn, nullptr, nullptr);
    db.rollback_transaction();
    require(!db._in_transaction && countRows(db.conn) == 0, "rollback retry failed");
  });
  run("no_transaction_commit_and_rollback_reject", [&] {
    Connection db;
    CDatabase outer; outer.m_pDB = &db;
    require(!outer.CommitTransaction(), "commit without transaction claimed success");
    require(!db._in_transaction, "commit failure invented active state");
    expectDbError([&] { db.rollback_transaction(); }, "rollback without transaction claimed success");
    require(!db._in_transaction, "rollback failure invented active state");
  });
  run("missing_or_inactive_connection_rejects", [&] {
    CDatabase outer;
    require(!outer.CommitTransaction(), "null database claimed successful commit");
    SqliteDatabase inactive;
    outer.m_pDB = &inactive;
    require(!outer.CommitTransaction(), "inactive database claimed successful commit");
    expectDbError([&] { inactive.start_transaction(); }, "inactive begin claimed success");
    expectDbError([&] { inactive.rollback_transaction(); }, "inactive rollback claimed success");
  });
  std::cout << "SQLite " << sqlite3_libversion() << "; failures=" << failures << '\n';
  return failures == 0 ? 0 : 1;
}
