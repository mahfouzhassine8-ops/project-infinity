package @APP_PACKAGE@;

import android.content.Context;
import android.util.AtomicFile;
import java.io.File;
import java.io.FileOutputStream;
import java.io.FileInputStream;
import java.io.ByteArrayOutputStream;
import java.nio.charset.StandardCharsets;
import java.util.Arrays;
import org.json.JSONObject;

/** Disposable read-only mirror of the exact coordinator evidence. No authority. */
final class InfinityCheckpointEvidence {
  private static File privateRoot, publicRoot;
  private static boolean startupSnapshot;
  private InfinityCheckpointEvidence() {}
  static synchronized void register(Context context) {
    try {
      privateRoot = context.getFilesDir().getCanonicalFile();
      File storage = context.getExternalFilesDir(null);
      publicRoot = (storage == null ? privateRoot : storage.getCanonicalFile());
      File receipt = new File(privateRoot, InfinityCheckpointProtocol.RECEIPT);
      startupSnapshot = true;
      try { if (receipt.isFile()) mirror(receipt, InfinityCheckpointProtocol.read(privateRoot)); }
      finally { startupSnapshot = false; }
    } catch (Throwable unavailable) { unavailable(); }
  }
  static synchronized void mirror(File source, JSONObject row) {
    try {
      if (privateRoot == null || publicRoot == null ||
          !source.getCanonicalFile().equals(new File(privateRoot, InfinityCheckpointProtocol.RECEIPT))) return;
      byte[] bytes = row.toString().getBytes(StandardCharsets.UTF_8);
      if (bytes.length > 262144) return;
      // The diagnostic bridge publishes only the exact durable source bytes.
      byte[] sourceBytes = readBounded(source);
      if (!Arrays.equals(bytes, sourceBytes)) return;
      File destination = new File(publicRoot, InfinityCheckpointProtocol.RECEIPT);
      if (!destination.getAbsoluteFile().equals(destination.getCanonicalFile()) || destination.equals(source)) return;
      writeExact(destination, bytes);
      JSONObject evidence = new JSONObject();
      evidence.put("schema", 1); evidence.put("read_only", true);
      evidence.put("source", "private-coordinator-receipt");
      evidence.put("receipt_sha256", InfinityCheckpointProtocol.proof(new String(bytes, StandardCharsets.UTF_8)));
      evidence.put("source_modified_epoch_ms", source.lastModified());
      evidence.put("captured_epoch_ms", System.currentTimeMillis());
      evidence.put("captured_elapsed_ms", android.os.SystemClock.elapsedRealtime());
      evidence.put("collector_pid", android.os.Process.myPid());
      evidence.put("publication", startupSnapshot ? "startup_snapshot" : "coordinator_write");
      evidence.put("session", row.optString("session", ""));
      evidence.put("receipt_pid", row.optInt("pid", 0));
      evidence.put("phase", row.optString("phase", ""));
      evidence.put("evidence_scope", "COMPLETE".equals(row.optString("phase")) ? "previous_close" : "close_attempt");
      evidence.put("current_process_health", "UNVERIFIED");
      writeExact(new File(publicRoot, "infinity-checkpoint-mirror.json"), evidence.toString().getBytes(StandardCharsets.UTF_8));
    } catch (Throwable unavailable) { unavailable(); }
  }
  private static byte[] readBounded(File source) throws Exception {
    try (FileInputStream input = new FileInputStream(source)) {
      ByteArrayOutputStream output = new ByteArrayOutputStream();
      byte[] buffer = new byte[8192];
      for (int count; (count = input.read(buffer)) != -1;) {
        if (output.size() + count > 262144) throw new java.io.IOException("source bound");
        output.write(buffer, 0, count);
      }
      return output.toByteArray();
    }
  }
  private static void writeExact(File destination, byte[] bytes) throws Exception {
      if (!destination.getAbsoluteFile().equals(destination.getCanonicalFile())) throw new java.io.IOException("linked mirror");
      for (String suffix : new String[]{".new", ".bak"}) {
        File side = new File(publicRoot, destination.getName() + suffix);
        if (!side.getAbsoluteFile().equals(side.getCanonicalFile())) throw new java.io.IOException("linked mirror sidecar");
      }
      AtomicFile output = new AtomicFile(destination);
      if (destination.isFile() && destination.length() <= 262144 &&
          Arrays.equals(bytes, output.readFully())) return;
      FileOutputStream stream = null;
      try {
        stream = output.startWrite(); stream.write(bytes); stream.getFD().sync();
        output.finishWrite(stream); stream = null;
        java.io.FileDescriptor directory = android.system.Os.open(publicRoot.getAbsolutePath(), android.system.OsConstants.O_RDONLY, 0);
        try { android.system.Os.fsync(directory); } finally { android.system.Os.close(directory); }
        if (!Arrays.equals(bytes, output.readFully())) throw new java.io.IOException("mirror readback");
      } catch (Exception failed) { if (stream != null) output.failWrite(stream); throw failed; }
  }
  private static void unavailable() {
    // Optional evidence publication cannot affect checkpoint authorization.
    try { android.util.Log.w("InfinityEvidence", "Receipt mirror unavailable"); }
    catch (Throwable unavailable) { /* Even logging remains subordinate. */ }
  }
}
