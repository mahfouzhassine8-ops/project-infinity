    android.widget.LinearLayout.LayoutParams scrollLp=new android.widget.LinearLayout.LayoutParams(-1,0,1);
    scrollLp.bottomMargin=chooserDp(10);shell.addView(scroll,scrollLp);

    android.widget.Button close=new android.widget.Button(this);
    close.setText("Close");close.setAllCaps(false);close.setTextColor(accent);close.setTextSize(13);
    close.setBackground(chooserControlSurface(panel,rim,14,accent));close.setOnClickListener(v->dialog.dismiss());
    shell.addView(close,new android.widget.LinearLayout.LayoutParams(-1,chooserDp(48)));
    dialog.show();
    android.view.Window w=dialog.getWindow();
    if(w!=null){
      int available=getResources().getDisplayMetrics().widthPixels-chooserDp(28);
      int width=Math.min(chooserDp(520),available);
      int maxHeight=(int)(getResources().getDisplayMetrics().heightPixels*.78f);
      w.setLayout(width,maxHeight);
    }
  }



  private String infinityHealthBuildInfo()
  {
    String versionName="unknown";long versionCode=0L;
    try{
      android.content.pm.PackageInfo info=getPackageManager().getPackageInfo(getPackageName(),0);
      versionName=info.versionName==null?"unknown":info.versionName;
      versionCode=Build.VERSION.SDK_INT>=28?info.getLongVersionCode():info.versionCode;
    }catch(Exception ignored){}
    StringBuilder out=new StringBuilder();
    out.append("Infinity diagnostic environment\n\n");
    out.append("Package: ").append(getPackageName()).append('\n');
    out.append("Version: ").append(versionName).append(" (").append(versionCode).append(")\n");
    out.append("Device: ").append(Build.MANUFACTURER).append(' ').append(Build.MODEL).append('\n');
    out.append("Android: ").append(Build.VERSION.RELEASE).append(" / API ").append(Build.VERSION.SDK_INT).append('\n');
    out.append("Build fingerprint: ").append(Build.FINGERPRINT).append('\n');
    out.append("Device elapsed uptime: ").append(android.os.SystemClock.elapsedRealtime()/1000L).append("s\n");
    out.append("Diagnostics owner: Infinity Android chooser (Kodi-independent)\n");
    return out.toString();
  }

  private String infinityExitReasonName(int reason)
  {
    switch(reason){
      case 1:return "self exit";
      case 2:return "signal";
      case 3:return "low memory";
      case 4:return "Java crash";
      case 5:return "native crash";
      case 6:return "ANR";
      case 7:return "initialization failure";
      case 8:return "permission change";
      case 9:return "excessive resource use";
      case 10:return "user requested";
      case 11:return "user stopped";
      case 12:return "dependency died";
      case 13:return "other";
      case 14:return "freezer";
      case 15:return "package state change";
      case 16:return "package updated";
      default:return "unknown ("+reason+")";
    }
  }

  private long infinityNewestAbnormalExit()
  {
    if(Build.VERSION.SDK_INT<30)return 0L;
    try{
      ActivityManager manager=(ActivityManager)getSystemService(Context.ACTIVITY_SERVICE);
      if(manager==null)return 0L;
      java.util.List<android.app.ApplicationExitInfo> rows=
          manager.getHistoricalProcessExitReasons(getPackageName(),0,12);
      for(android.app.ApplicationExitInfo row:rows){
        int reason=row.getReason();
        if(reason==4||reason==5||reason==6)return row.getTimestamp();
      }
    }catch(Exception ignored){}
    return 0L;
  }

  private boolean infinityShouldOfferCrashRecovery()
  {
    long timestamp=mInfinityAbnormalExit;
    if(timestamp<=0L)return false;
    android.content.SharedPreferences prefs=getSharedPreferences(INFINITY_EXPERIENCE_PREFS,MODE_PRIVATE);
    long seen=prefs.getLong("health_last_acknowledged_exit",0L);
    if(timestamp<=seen)return false;
    prefs.edit().putLong("health_last_acknowledged_exit",timestamp).apply();
    return true;
  }

  private String infinityHealthExitHistory(boolean includeTrace)
  {
    StringBuilder out=new StringBuilder("Exit records are historical. The current APK version does not identify the version that produced each older exit.\n");
    if(Build.VERSION.SDK_INT<30){
      out.append("Android exit history requires Android 11 or newer.\n");
      return out.toString();
    }
    try{
      ActivityManager manager=(ActivityManager)getSystemService(Context.ACTIVITY_SERVICE);
      if(manager==null)return "Android ActivityManager is unavailable.\n";
      java.util.List<android.app.ApplicationExitInfo> rows=
          manager.getHistoricalProcessExitReasons(getPackageName(),0,12);
      if(rows==null||rows.isEmpty())return "No recent Infinity process exits were reported by Android.\n";
      java.text.SimpleDateFormat stamp=new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss",java.util.Locale.US);
      int index=0;
      for(android.app.ApplicationExitInfo row:rows){
        out.append("#").append(++index).append("  ")
            .append(stamp.format(new java.util.Date(row.getTimestamp()))).append('\n');
        out.append("Reason: ").append(infinityExitReasonName(row.getReason())).append('\n');
        out.append("Process: ").append(row.getProcessName()).append('\n');
        if(row.getDescription()!=null&&!row.getDescription().trim().isEmpty())
          out.append("Description: ").append(row.getDescription().trim()).append('\n');
        out.append("Status: ").append(row.getStatus()).append("  Importance: ").append(row.getImportance()).append('\n');
        out.append("PSS/RSS: ").append(row.getPss()).append('/').append(row.getRss()).append(" KB\n");
        out.append('\n');
      }
    }catch(Exception e){
      out.append("Could not read Android exit history: ").append(e.getClass().getSimpleName()).append('\n');
    }
    return out.toString();
  }

  private String infinityHealthReport()
  {
    String trace=InfinityResponsiveTrace.isEnabled(this)
        ?"Responsive/Fold trace: ACTIVE — reproduce the problem, then return to Health Center and stop/export it.\n"
        :"Historical completed Responsive/Fold trace\n=========================================\nThis retained trace has its own session/date below. It is not a measurement of this launch.\n"+InfinityResponsiveTrace.latestSummary(this)+"\n";
    return infinityHealthBuildInfo()+"\n"+InfinityStartupTrace.report(this)+"\n"+InfinityExitCompletion.report(this)+"\n"+InfinityResponsiveness.report(this)+"\n"+trace+"\nRecent process exits\n====================\n"+
        infinityHealthExitHistory(false)+"\nRaw Android crash/ANR traces are included separately in Export diagnostics ZIP when available.\n";
  }

  private void infinityStartResponsiveTrace()
  {
    try
    {
      InfinityResponsiveTrace.start(this);
      android.widget.Toast.makeText(this,
          "Responsive/Fold trace started. Reproduce the resize problem, then return to Health Center.",
          android.widget.Toast.LENGTH_LONG).show();
    }
    catch(Exception e)
    {
      android.widget.Toast.makeText(this,"Could not start Responsive/Fold trace: "+e.getClass().getSimpleName(),
          android.widget.Toast.LENGTH_LONG).show();
    }
  }

  private void infinityExportResponsiveTrace()
  {
    try
    {
      mInfinityResponsiveTraceExportFile=InfinityResponsiveTrace.stopAndBuildArchive(this);
      Intent intent=new Intent(Intent.ACTION_CREATE_DOCUMENT);
      intent.addCategory(Intent.CATEGORY_OPENABLE);intent.setType("application/zip");
      intent.putExtra(Intent.EXTRA_TITLE,mInfinityResponsiveTraceExportFile.getName());
      startActivityForResult(intent,INFINITY_RESPONSIVE_TRACE_EXPORT_RESULT_CODE);
    }
    catch(Exception e)
    {
      mInfinityResponsiveTraceExportFile=null;
      android.widget.Toast.makeText(this,"Could not finish Responsive/Fold trace: "+e.getClass().getSimpleName(),
          android.widget.Toast.LENGTH_LONG).show();
    }
  }

  private void infinityHealthToast(String message)
  {
    runOnUiThread(() -> {
      if (!isFinishing() && !isDestroyed())
        android.widget.Toast.makeText(this,message,android.widget.Toast.LENGTH_LONG).show();
    });
  }

  private void infinityCopyHealthReport()
  {
    if (!mInfinityHealthBusy.compareAndSet(false,true)) return;
    Thread worker=new Thread(() -> {
      try {
        android.os.Process.setThreadPriority(android.os.Process.THREAD_PRIORITY_BACKGROUND);
        String report=infinityHealthReport();
        // Binder/clipboard stays bounded, even if a retained report grows.
        final String copy=report.length()>120000
            ?report.substring(0,120000)+"\n[Clipboard summary truncated; export diagnostics ZIP for full evidence.]"
            :report;
        runOnUiThread(() -> {
          if (isFinishing() || isDestroyed()) return;
          try {
            android.content.ClipboardManager clipboard=(android.content.ClipboardManager)getSystemService(Context.CLIPBOARD_SERVICE);
            if (clipboard!=null) {
              clipboard.setPrimaryClip(android.content.ClipData.newPlainText("Infinity diagnostics",copy));
              infinityHealthToast("Infinity diagnostic summary copied.");
            }
          } catch (RuntimeException failure) { infinityHealthToast("Could not copy the diagnostic summary."); }
        });
      } catch (Exception failure) { infinityHealthToast("Could not collect the diagnostic summary."); }
      finally { mInfinityHealthBusy.set(false); }
    },"InfinityHealthCopy");
    worker.setDaemon(true);worker.start();
  }

  private void infinityExportHealthReport()
  {
    if (mInfinityHealthBusy.get()) return;
    Intent intent=new Intent(Intent.ACTION_CREATE_DOCUMENT);
    intent.addCategory(Intent.CATEGORY_OPENABLE);
    intent.setType("application/zip");
    String stamp=new java.text.SimpleDateFormat("yyyyMMdd-HHmmss",java.util.Locale.US).format(new java.util.Date());
    intent.putExtra(Intent.EXTRA_TITLE,"Infinity-Diagnostics-"+stamp+".zip");
    try{startActivityForResult(intent,INFINITY_HEALTH_EXPORT_RESULT_CODE);}
    catch(Exception e){infinityHealthToast("No compatible file saver is available.");}
  }

  private void infinitySaveHealthArchive(android.net.Uri destination)
  {
    if (!mInfinityHealthBusy.compareAndSet(false,true)) return;
    final Context app=getApplicationContext();
    Thread worker=new Thread(() -> {
      try {
        android.os.Process.setThreadPriority(android.os.Process.THREAD_PRIORITY_BACKGROUND);
        String report=infinityHealthReport();
        try (java.io.OutputStream output=app.getContentResolver().openOutputStream(destination,"w")) {
          if(output==null)throw new java.io.IOException("No document output stream");
          InfinityHealthExport.write(app,output,report);
        }
        infinityHealthToast("Infinity diagnostic ZIP saved.");
      } catch (Exception failure) {
        android.util.Log.w("InfinityHealth","Diagnostic export failed: "+failure.getClass().getSimpleName());
        infinityHealthToast("Could not finish the diagnostic ZIP. The selected file may be incomplete.");
      } finally { mInfinityHealthBusy.set(false); }
    },"InfinityHealthExport");
    worker.setDaemon(true);worker.start();
  }

  private void showInfinityExperienceChooser()
  {
    mInfinityChooserVisible = true;
    if (mInfinityStartupTrace != null) {
      mInfinityStartupTrace.event("chooser.compose");
      if (mInfinityChooserFrame != null) mInfinityChooserFrame.close();
      mInfinityChooserFrame = new InfinityStartupHandoff(this,findViewById(android.R.id.content));
      mInfinityChooserFrame.enqueue(() -> mInfinityStartupTrace.event("chooser.firstFrame"));
      if (mInfinityResumed) mInfinityChooserFrame.resume();
    }
    if (showLockedGlassChooser()) return;
    ExperienceTheme theme = loadExperienceTheme();
    if(theme==null&&vtheme().installed()){
      try{org.json.JSONObject defaults=new org.json.JSONObject();defaults.put("schema",1);defaults.put("scope","infinity-experience-chooser");defaults.put("minimum_bridge",1);defaults.put("copy",new org.json.JSONObject());defaults.put("palette",new org.json.JSONObject());theme=new ExperienceTheme(defaults);}catch(Exception invalid){theme=null;}
    }
    if (theme == null)
    {
      showLegacyInfinityExperienceChooser();
      return;
    }
    showStyledInfinityExperienceChooser(resolveVisualExperienceTheme(theme));
  }

  /** Built-in locked phone visual; original native routing/recovery own all actions. */
  private boolean showLockedGlassChooser() {
    if (isAndroidTV() || CobraPresentationSafety.isSafe(this)) return false;
    try {
      InfinityGlassChooser glass = new InfinityGlassChooser(this, new InfinityGlassChooser.Actions() {
        public void enter(String experience) { launchInfinityExperience(experience); }
        public void settings(String experience) { showExperienceCardSettings(experience); }
        public void themes() { vtheme().manager(Splash.this); }
        public String appearance() { return chooserAppearanceMode(); }
        public void appearanceChanged() { cobraRefreshSafetyChooser(); }
      });
      org.json.JSONObject spec = new org.json.JSONObject();
      spec.put("schema",1);spec.put("scope","infinity-experience-chooser");spec.put("minimum_bridge",1);
      spec.put("copy",new org.json.JSONObject());
      org.json.JSONObject palette = new org.json.JSONObject();
      palette.put("background",glass.light?"#EEF1F5":"#041326");spec.put("palette",palette);
      ExperienceTheme bars = new ExperienceTheme(spec);
      setContentView(glass);
      cobraPrepareExperienceSystemBars(bars,glass,glass.content);
      glass.focusEntry();
      return true;
    } catch (RuntimeException | org.json.JSONException failed) {
      // Presentation failure returns to the existing native chooser; never reset user data.
      android.util.Log.e("InfinityChooser","Glass presentation unavailable; using existing chooser",failed);
      return false;
    }
  }

  void cobraRefreshSafetyChooser(){if(!isFinishing()&&!isDestroyed())showInfinityExperienceChooser();}

  private InfinityGlassRecovery.Builder cobraRecoveryDialog(){
    return new InfinityGlassRecovery.Builder(this,()->"light".equals(chooserAppearanceMode()),
        new CobraVisualRenderer.DialogBuilder(this,vtheme(),"chooser.recovery"),
        !isAndroidTV() && !CobraPresentationSafety.isSafe(this));
  }

  private void showInfinityClosingRecovery(){
    InfinityKodiShutdown.Snapshot owner=InfinityKodiShutdown.state();
    if(!owner.stalled())return;
    android.content.DialogInterface.OnClickListener force=(dialog,which)->{
      InfinityKodiShutdown.Snapshot current=InfinityKodiShutdown.state();
      if(current.pid==owner.pid&&current.owner.equals(owner.owner)&&current.stalled())
        startActivity(InfinityKodiShutdown.force(this,current));
    };
    InfinityGlassRecovery.Builder recovery=cobraRecoveryDialog().setTitle(owner.closeTitle()).setMessage(owner.closeMessage());
    if(owner.checkpointFailed())
      recovery.setPositiveButton("Health Center",(dialog,which)->showInfinityHealthCenter()).setNegativeButton("Force Close",force);
    else recovery.setPositiveButton("Force Close",force).setNegativeButton("Keep waiting",null);
    recovery.show();
  }

  private String infinityBlockedCloseEvent(){
    return InfinityKodiShutdown.state().checkpointFailed()?"handoff.checkpointFailed.recoveryAvailable":"handoff.waitClosingOwner";
  }

  private void showCobraRecovery(){
    cobraRecoveryDialog()
        .setTitle("Cobra Recovery")
        .setItems(new String[]{"Start Cobra in Safe Mode","Restore Built-in Theme"},(dialog,which)->{
          if(which==0)launchInfinityExperience("live",true,true);
          else cobraRecoveryDialog()
              .setTitle("Restore Built-in Theme?")
              .setMessage("Restore Cobra's built-in presentation. Your themes, sources, settings and playback data are kept.")
              .setPositiveButton("Restore",(d,w)->CobraPresentationSafety.restoreBuiltIn(this,null))
              .setNegativeButton("Cancel",null).show();
        }).setNegativeButton("Close",null).show();
  }

  // Custom chooser scenes may hide or move their own gear slot. This native
  // instance of the same Cobra gear remains outside imported scene ownership.
  private void cobraAttachRecoveryGear(android.widget.FrameLayout root){
    // The approved built-in/legacy chooser keeps its original card gear exactly.
    // Only imported visual scenes can arbitrarily hide the escape route.
    if(root==null||!vtheme().visualInstalled())return;
    View hostView=findViewById(android.R.id.content);if(!(hostView instanceof android.widget.FrameLayout))return;
    android.widget.FrameLayout host=(android.widget.FrameLayout)hostView;
    if(mCobraRecoveryGear!=null&&mCobraRecoveryGear.getParent()==host)return;
    View prior=root.findViewWithTag("experience-settings-cobra");
    if(prior!=null&&prior.getParent() instanceof android.view.ViewGroup)((android.view.ViewGroup)prior.getParent()).removeView(prior);
    android.widget.Button gear=new android.widget.Button(this);gear.setText("Cobra ⚙");gear.setAllCaps(false);
    gear.setTextColor(0xfff7faff);gear.setTextSize(13);gear.setTypeface(android.graphics.Typeface.create("sans-serif-medium",0));
    gear.setContentDescription("Cobra settings and recovery");gear.setTag("experience-settings-cobra");mCobraRecoveryGear=gear;
    android.graphics.drawable.GradientDrawable bg=new android.graphics.drawable.GradientDrawable();bg.setColor(0xff0b0f16);bg.setCornerRadius(chooserDp(14));bg.setStroke(Math.max(1,chooserDp(1)),0xff62aaff);gear.setBackground(bg);
    gear.setPadding(chooserDp(12),0,chooserDp(12),0);gear.setMinHeight(chooserDp(48));gear.setOnClickListener(v->showExperienceCardSettings("live"));
    android.widget.FrameLayout.LayoutParams p=new android.widget.FrameLayout.LayoutParams(-2,chooserDp(48),android.view.Gravity.END|android.view.Gravity.TOP);p.setMargins(chooserDp(12),chooserDp(12),chooserDp(12),0);host.addView(gear,p);
    gear.setElevation(chooserDp(20));
    gear.setOnApplyWindowInsetsListener((view,insets)->{android.widget.FrameLayout.LayoutParams lp=(android.widget.FrameLayout.LayoutParams)gear.getLayoutParams();lp.topMargin=chooserDp(12)+insets.getSystemWindowInsetTop();lp.rightMargin=chooserDp(12)+insets.getSystemWindowInsetRight();gear.setLayoutParams(lp);return insets;});gear.requestApplyInsets();
  }
  private View mCobraRecoveryGear;

