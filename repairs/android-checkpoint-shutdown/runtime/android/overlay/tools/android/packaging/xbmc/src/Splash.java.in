    personalized.addView(initials, new android.widget.LinearLayout.LayoutParams(chooserDp(vtheme().dimension("chooser.showStyledInfinityExperienceChooser.dimensions.5",48)), chooserDp(vtheme().dimension("chooser.showStyledInfinityExperienceChooser.dimensions.6",48))));
    android.widget.TextView personal = chooserStyledText(theme.personalization, theme.muted, 8, false, android.view.Gravity.CENTER); personal.setLetterSpacing(vtheme().number("chooser.showStyledInfinityExperienceChooser.numbers.3",.12f,-0.02f,0.25f)); personal.setMaxLines(1); personalized.addView(personal);
    android.widget.FrameLayout.LayoutParams personalizedParams = new android.widget.FrameLayout.LayoutParams(chooserDp(vtheme().dimension("chooser.showStyledInfinityExperienceChooser.dimensions.7",128)), -2, android.view.Gravity.END | android.view.Gravity.TOP);
    identity.addView(personalized, personalizedParams);
    content.addView(identity, new android.widget.LinearLayout.LayoutParams(-1, chooserDp(compactHeight?74:vtheme().dimension("chooser.showStyledInfinityExperienceChooser.dimensions.8",98))));

