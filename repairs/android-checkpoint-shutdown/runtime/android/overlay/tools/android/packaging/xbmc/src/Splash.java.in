    ExperienceMark mark = new ExperienceMark(!infinity, border); mark.setTag(infinity ? "experience-mark-infinity" : "experience-mark-cobra");
    body.addView(mark, new android.widget.LinearLayout.LayoutParams(chooserDp(vtheme().dimension("chooser.chooserExperienceCard.dimensions.5",112)), chooserDp(vtheme().dimension("chooser.chooserExperienceCard.dimensions.6",78))));
    android.widget.TextView heading = chooserStyledText(title, theme.text, 23, true, android.view.Gravity.CENTER); heading.setLetterSpacing(vtheme().number("chooser.chooserExperienceCard.numbers.1",.12f,-0.02f,0.25f)); body.addView(heading);
    android.widget.TextView copy = chooserStyledText(subtitle, theme.text, 12, false, android.view.Gravity.CENTER); copy.setLetterSpacing(vtheme().number("chooser.chooserExperienceCard.numbers.2",.06f,-0.02f,0.25f)); copy.setMaxLines(3);
    android.widget.LinearLayout.LayoutParams copyParams = new android.widget.LinearLayout.LayoutParams(-1, -2); copyParams.topMargin = chooserDp(vtheme().dimension("chooser.chooserExperienceCard.dimensions.7",10)); body.addView(copy, copyParams);
    card.addView(body, new android.widget.FrameLayout.LayoutParams(-1, -1));

    android.widget.TextView gear = chooserStyledText(vtheme().copy("chooser.chooserExperienceCard.copy.1","⚙"), theme.text, 17, false, android.view.Gravity.CENTER);
    gear.setFocusable(true); gear.setClickable(true); gear.setTag(infinity ? "experience-settings-infinity" : "experience-settings-cobra"); gear.setContentDescription(title + " settings");
    gear.setBackground(chooserControlSurface((top & 0x00ffffff) | 0xdd000000, border, 16, glow));
    if(!infinity&&!vtheme().visualInstalled()){
      // Legacy chooser palette files can contain equal foreground/background
      // colors. Keep the existing Cobra gear and bounds, with independent ink.
      boolean light="light".equals(chooserAppearanceMode());gear.setText("⚙");
      gear.setTextColor(light?0xff101b2c:0xfff7faff);
      gear.setTypeface(android.graphics.Typeface.create("sans-serif",0));
      gear.setBackground(chooserControlSurface(light?0xfff5f8fd:0xff0b0f16,light?0xff145fdf:0xff62aaff,16,light?0xff145fdf:0xff62aaff));
    }
    gear.setOnClickListener(v -> settings.run());
    android.widget.FrameLayout.LayoutParams gearParams = new android.widget.FrameLayout.LayoutParams(chooserDp(vtheme().dimension("chooser.chooserExperienceCard.dimensions.8",44)), chooserDp(vtheme().dimension("chooser.chooserExperienceCard.dimensions.9",44)), android.view.Gravity.TOP | android.view.Gravity.END);
    card.addView(gear, gearParams);

    card.setOnClickListener(v -> launch.run());
    card.setOnFocusChangeListener((v, focused) -> {
      card.setBackground(chooserGradient(top, bottom, focused ? glow : border, theme.cardRadius, focused));
      card.animate().cancel();
      long duration = vtheme().motion("chooser.layout.motion_ms", theme.motionMs);
      if (duration == 0) { card.setScaleX(focused ? 1.015f : 1f); card.setScaleY(focused ? 1.015f : 1f); }
      else card.animate().scaleX(focused ? 1.015f : 1f).scaleY(focused ? 1.015f : 1f)
          .setDuration(duration).setInterpolator(new android.view.animation.DecelerateInterpolator()).start();
      card.setElevation(chooserDp(focused ? 9 : 3));vtheme().paint(card,infinity?"chooser.card.infinity":"chooser.card.cobra");
    });
    vtheme().tree(card,infinity?"chooser.card.infinity":"chooser.card.cobra");return card;
  }
