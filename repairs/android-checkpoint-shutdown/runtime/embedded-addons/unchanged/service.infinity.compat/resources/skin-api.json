{
  "schema": 3,
  "skin_api": "1.0",
  "hook_api": "1.0",
  "theme_contract": "1.1",
  "layout_api": "1.2",
  "description": "Declarative contract for Infinity-compatible skins. Native bridge v5 owns raw Android display/theme facts; the layout/theme services publish effective skin state.",
  "properties": [
    "Infinity.SkinAPI",
    "Infinity.HookAPI",
    "Infinity.NativeSystemTheme",
    "Infinity.SystemTheme",
    "Infinity.ThemeRevision",
    "Infinity.NativeDeviceMode",
    "Infinity.NativeLayout",
    "Infinity.NativeWidthDp",
    "Infinity.NativeHeightDp",
    "Infinity.NativeDisplayRevision",
    "Infinity.NativeReady",
    "Infinity.DeviceMode",
    "Infinity.Orientation",
    "Infinity.Layout",
    "Infinity.PaneMode",
    "Infinity.WindowWidth",
    "Infinity.WindowHeight",
    "Infinity.WindowWidthDp",
    "Infinity.WindowHeightDp",
    "Infinity.DensityDpi",
    "Infinity.AspectClass",
    "Infinity.SafeInsetTop",
    "Infinity.SafeInsetBottom",
    "Infinity.SafeInsetLeft",
    "Infinity.SafeInsetRight",
    "Infinity.TouchClass",
    "Infinity.DisplaySource",
    "Infinity.MotionPolicy",
    "Infinity.RefreshPolicy",
    "Infinity.PowerPolicy",
    "Infinity.PerformanceMode",
    "Infinity.SafeMode",
    "Infinity.CompatMode",
    "Infinity.ProtectedPlayerUI"
  ],
  "palette_tokens": [
    "Infinity.Palette.Background",
    "Infinity.Palette.Surface",
    "Infinity.Palette.SurfaceElevated",
    "Infinity.Palette.TextPrimary",
    "Infinity.Palette.TextSecondary",
    "Infinity.Palette.Border",
    "Infinity.Palette.Focus",
    "Infinity.Palette.Accent",
    "Infinity.Palette.Danger",
    "Infinity.Palette.Scrim"
  ],
  "theme_values": ["light", "dark", "OLED"],
  "device_modes": ["cover/front", "inner/large", "phone", "tablet", "tv", "unknown"],
  "layouts": ["compact", "medium", "expanded", "unknown"],
  "pane_modes": ["overlay", "pane"],
  "orientations": ["portrait", "landscape", "square", "unknown"],
  "aspect_classes": ["portrait", "square-ish", "standard-landscape", "ultrawide", "unknown"],
  "touch_classes": ["compact", "normal", "large-display", "unknown"],
  "motion_policies": ["normal", "reduced", "performance"],
  "refresh_policies": ["normal", "high-refresh", "video-match"],
  "protected_zones": [
    "VideoOSD.xml",
    "DialogSeekBar.xml",
    "Custom_1197_InfinityPlayerPanel.xml",
    "Custom_1199_InfinityVideoLock.xml"
  ],
  "player_contract": {
    "owner": "Infinity",
    "replaceable_by_skin": false,
    "panel_window": 1197,
    "direction": "subtitles/audio left; transport center; secondary controls right; protected navigation panel; adaptive portrait/large-display variants; no skin-owned videowindow"
  },
  "skin_registration": {
    "manifest_name": "infinity-skin.json",
    "required": ["skin_id", "name", "skin_api"],
    "optional": ["capabilities", "protected_zone_policy", "theme_support", "notes"]
  }
}
