package @APP_PACKAGE@;

import android.content.Context;
import android.os.Handler;
import android.os.Looper;
import java.io.*;
import java.util.*;
import java.util.concurrent.*;
import java.util.zip.*;

/** Application-owned, single-flight boot preparation. Never owns an Activity or player. */
final class InfinityStartupPreparation {
  interface Callback { void ready(Result result); }
  interface Work { Result run(Context app, InfinityStartupTrace trace) throws Exception; }
  static final class Result {
    final File home, apk;
    final String error;
    final long abnormalExit;
    Result(File home, File apk, String error, long abnormalExit) {
      this.home=home; this.apk=apk; this.error=error; this.abnormalExit=abnormalExit;
    }
  }
  static final class Ticket implements AutoCloseable {
    private final InfinityStartupPreparation manager;
    private Callback callback;
    private volatile boolean closed;
    Ticket(InfinityStartupPreparation manager, Callback callback) { this.manager=manager;this.callback=callback; }
    public void close() { synchronized(manager) { closed=true;callback=null;manager.waiters.remove(this); } }
  }
  private static InfinityStartupPreparation shared=new InfinityStartupPreparation(
      Executors.newSingleThreadExecutor(r->{Thread t=new Thread(r,"InfinityStartup");t.setDaemon(true);return t;}),
      InfinityStartupPreparation::prepare);
  static InfinityStartupPreparation shared() { return shared; }
  private final Executor executor;
  private final Work work;
  private final Handler ui=new Handler(Looper.getMainLooper());
  private final List<Ticket> waiters=new ArrayList<>();
  private boolean running;
  InfinityStartupPreparation(Executor executor, Work work) { this.executor=executor;this.work=work; }
  synchronized Ticket subscribe(Context context, InfinityStartupTrace trace, Callback callback) {
    Ticket ticket=new Ticket(this,callback);waiters.add(ticket);
    if (!running) {
      running=true;
      final Context app=context.getApplicationContext();
      executor.execute(()->{
        Result result;
        trace.event("prepare.begin");
        try { result=work.run(app,trace); }
        catch(Exception failure) {
          trace.event("prepare.failed."+failure.getClass().getSimpleName());
          result=new Result(null,null,"Infinity startup preparation failed. Your saved data was not reset. Retry the launch or export Health Center diagnostics.",0);
        }
        trace.event(result.error==null?"prepare.ready":"prepare.error");
        final Result completed=result;
        final List<Ticket> recipients;
        synchronized(this) { recipients=new ArrayList<>(waiters);waiters.clear();running=false; }
        ui.post(()->{ for(Ticket next:recipients) {
          Callback target;
          synchronized(this) { target=next.closed?null:next.callback;next.callback=null; }
          if(target!=null)target.ready(completed);
        }});
      });
    } else trace.event("prepare.joinExisting");
    return ticket;
  }

  private static Result prepare(Context app, InfinityStartupTrace trace) throws Exception {
    if(Looper.myLooper()==Looper.getMainLooper())throw new IllegalStateException("Preparation must not run on UI thread");
    trace.event("properties.begin");
    XBMCProperties.initializeProperties();
    trace.event("properties.end");
    File cache=app.getCacheDir();
    if(cache==null)throw new IOException("Cache unavailable");
    File home=resolveDisposable("xbmc.home",new File(cache,"apk"),trace);
    String data=XBMCProperties.getStringProperty("xbmc.data","");
    if(!data.isEmpty()&&!new File(data).isDirectory()) {
      // A temporary unavailable volume is not permission to create a new user profile.
      trace.event("path.data.unavailable.preserved");
      return new Result(null,null,"The configured Infinity data storage is unavailable. Reconnect or unlock that storage and retry. Your original data path and saved session have NOT been reset.",0);
    }
    trace.event(data.isEmpty()?"path.data.default":"path.data.valid");
    resolveDisposable("xbmc.temp",null,trace);
    new File(cache,"lib").mkdirs();
    File apk=new File(app.getPackageResourcePath());
    File pending=new File(cache,"infinity-startup-cache.pending");
    if(home.isDirectory()&&home.lastModified()>=apk.lastModified()&&!pending.exists()) {
      trace.event("cache.reuse");
    } else {
      trace.event("cache.extract.begin");
      if(!pending.createNewFile()&&!pending.isFile())throw new IOException("Cannot mark cache work");
      extractAssets(apk,home);
      if(!home.setLastModified(apk.lastModified()))throw new IOException("Cannot stamp completed cache");
      if(!pending.delete())throw new IOException("Cannot mark cache complete");
      trace.event("cache.extract.end");
    }
    long abnormal=0;
    if(android.os.Build.VERSION.SDK_INT>=30) {
      trace.event("exitHistory.begin");
      try {
        android.app.ActivityManager manager=(android.app.ActivityManager)app.getSystemService(Context.ACTIVITY_SERVICE);
        if(manager!=null)for(android.app.ApplicationExitInfo row:manager.getHistoricalProcessExitReasons(app.getPackageName(),0,12)) {
          int reason=row.getReason();if(reason==4||reason==5||reason==6){abnormal=row.getTimestamp();break;}
        }
      }catch(RuntimeException ignored){trace.event("exitHistory.unavailable");}
      trace.event("exitHistory.end");
    }
    return new Result(home,apk,null,abnormal);
  }

  static File resolveDisposable(String key, File fallback, InfinityStartupTrace trace) {
    String configured=XBMCProperties.getStringProperty(key,"");
    if(!configured.isEmpty()) {
      File path=new File(configured);
      if(path.isDirectory()) { trace.event(key+".valid");return path; }
      // The historical 20 x 1s wait is removed, not merely moved to another thread.
      System.setProperty(key,"");trace.event(key+".missing.fallback");
    } else trace.event(key+".default");
    return fallback;
  }

  static void extractAssets(File apk, File home) throws IOException {
    if(!home.isDirectory()&&!home.mkdirs())throw new IOException("Cannot create cache home");
    String root=home.getCanonicalPath()+File.separator;
    byte[] buffer=new byte[32768];
    // Never recursively remove a configured directory or delete the APK on failure.
    // Only overwrite the same bundled assets that the inherited extractor installs.
    try(ZipFile zip=new ZipFile(apk)) {
      Enumeration<? extends ZipEntry> entries=zip.entries();
      while(entries.hasMoreElements()) {
        ZipEntry entry=entries.nextElement();if(!entry.getName().startsWith("assets/"))continue;
        File output=new File(home,entry.getName());
        if(!output.getCanonicalPath().startsWith(root))throw new IOException("Unsafe asset path");
        if(entry.isDirectory()) { if(!output.isDirectory()&&!output.mkdirs())throw new IOException("Cannot create asset directory");continue; }
        File parent=output.getParentFile();if(!parent.isDirectory()&&!parent.mkdirs())throw new IOException("Cannot create asset parent");
        try(InputStream input=zip.getInputStream(entry);OutputStream target=new FileOutputStream(output)) {
          int count;while((count=input.read(buffer))!=-1)target.write(buffer,0,count);
        }
      }
    }
  }
}
