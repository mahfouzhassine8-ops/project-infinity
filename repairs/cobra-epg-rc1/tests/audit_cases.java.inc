  public static void main(String[] args)throws Exception{
    routeHttp();
    runCase("C01","Explicit timezone offsets identify the same instant",h->{require(CobraGuideMath.parseTime("20260917003000 -0400")==CobraGuideMath.parseTime("20260917043000 +0000"),"Offset mismatch");});
    runCase("C02","Timezone omitted is UTC, regardless of device timezone",h->{TimeZone old=TimeZone.getDefault();try{TimeZone.setDefault(TimeZone.getTimeZone("Asia/Kathmandu"));require(CobraGuideMath.parseTime("20260917043000")==CobraGuideMath.parseTime("20260917043000 +0000"),"Used local timezone");}finally{TimeZone.setDefault(old);}});
    runCase("C03","Minute precision and Z timestamps are accepted",h->{require(CobraGuideMath.parseTime("202609170430Z")==CobraGuideMath.parseTime("20260917043000 +0000"),"Precision mismatch");});
    runCase("C04","Invalid dates and impossible numeric offsets rejected",h->{require(CobraGuideMath.parseTime("20260230010000 +0000")==0&&CobraGuideMath.parseTime("20260917010000 +2460")==0,"Accepted invalid date");});
    runCase("C05","Unsorted XMLTV programmes sorted, entities decoded",h->{long n=System.currentTimeMillis();CobraEpgData d=h.parse(wrap(xmlProgramme("a",n+100000,n+200000,"Next &amp; More")+xmlProgramme("a",n-10000,n+100000,"Live &amp; Now")));require(d.programs.get("a").get(0).title.equals("Live & Now"),"Wrong order/title");});
    runCase("C06","Invalid interval excluded without dropping valid programme",h->{long n=System.currentTimeMillis();CobraEpgData d=h.parse(wrap(xmlProgramme("a",n,n-1000,"Invalid")+xmlProgramme("a",n-1000,n+100000,"Valid")));require(d.programs.get("a").size()==1,"Invalid interval retained");});
    runCase("C07","Malformed XML rejected",h->{boolean rejected=false;try{h.parse("<tv><programme>");}catch(Exception e){rejected=true;}require(rejected,"Malformed feed accepted");});
    runCase("C08","HTML error body rejected",h->{boolean rejected=false;try{h.parse("<html>Service unavailable</html>");}catch(IOException e){rejected=true;}require(rejected,"HTML accepted");});
    runCase("C09","Destroy flag cancels XML parsing",h->{h.mCobraAsyncDestroyed=true;boolean rejected=false;try{h.parse("<tv/>");}catch(InterruptedIOException e){rejected=true;}require(rejected,"Destroyed parser continued");});
    runCase("C10","Duplicate display-name ambiguity within one feed suppressed",h->{long n=System.currentTimeMillis();CobraEpgData d=h.parse(wrap(channelXml("east","News")+channelXml("west","News")+xmlProgramme("east",n,n+10000,"E")+xmlProgramme("west",n,n+10000,"W")));require("".equals(d.aliases.get("news")),"Arbitrary regional alias chosen");});
    runCase("C11","Exact EPG ID preferred to a conflicting display name",h->{LiveSource s=h.source();CobraEpgData d=h.data(s);long n=System.currentTimeMillis();d.programs.put("id",rows(p("id",n-1000,n+50000,"Correct")));d.programs.put("other",rows(p("other",n-1000,n+50000,"Wrong")));d.aliases.put("news","other");h.mCobraEpg.put(s.id,d);require("Correct".equals(h.cobraCurrentProgram(channel("fixture:1","News","id")).title),"Name overrode exact ID");});
    runCase("C12","Exact IDs stay isolated between sources",h->{LiveSource a=h.source(),b=new LiveSource("other","https://fixture.invalid/b.xml");h.mSources.add(b);long n=System.currentTimeMillis();CobraEpgData da=h.data(a),db=h.data(b);da.programs.put("same",rows(p("same",n-1000,n+10000,"Source A")));db.programs.put("same",rows(p("same",n-1000,n+10000,"Source B")));h.mCobraEpg.put(a.id,da);h.mCobraEpg.put(b.id,db);require(h.cobraCurrentProgram(channel("other:1","N","same")).title.equals("Source B"),"Cross-source leakage");});
    runCase("C13","Valid short EPG used when no XMLTV ID matches",h->{LiveSource s=h.source();long n=System.currentTimeMillis();CobraEpgData d=h.data(s);d.programs.put("@stream:fixture:1",rows(p("@stream:fixture:1",n-1000,n+100000,"Short current")));h.mCobraEpg.put(s.id,d);require(h.cobraCurrentProgram(channel("fixture:1","N","unmatched")).title.equals("Short current"),"Fallback missing");});
    runCase("C14","Programme boundary selects next show, no overlap",h->{LiveSource s=h.source();long n=System.currentTimeMillis()/1000*1000;CobraEpgData d=h.data(s);d.programs.put("id",rows(p("id",n-60000,n,"Ended"),p("id",n,n+60000,"Started")));h.mCobraEpg.put(s.id,d);require(h.cobraCurrentProgram(channel("fixture:1","N","id")).title.equals("Started"),"Boundary wrong");});
    runCase("C15","Guide cache roundtrip preserves titles and intervals",h->{LiveSource s=h.source();CobraEpgData d=h.data(s);long n=System.currentTimeMillis();d.programs.put("a",rows(p("a",n-1000,n+10000,"News & more")));d.aliases.put("news","a");h.cobraWriteEpgCache(s.id,d);CobraEpgData got=h.cobraReadEpgCache(s.id,d.identity);require(got!=null&&got.programs.get("a").get(0).title.equals("News & more")&&got.aliases.get("news").equals("a"),"Cache roundtrip failed");});
    runCase("C16","Cache from different configuration rejected",h->{LiveSource s=h.source();CobraEpgData d=h.data(s);h.cobraWriteEpgCache(s.id,d);require(h.cobraReadEpgCache(s.id,"different-identity")==null,"Foreign cache accepted");});
    runCase("C17","Truncated cache ignored without a crash",h->{LiveSource s=h.source();java.nio.file.Files.write(h.cobraEpgCacheFile(s.id).toPath(),new byte[]{31,-117,8});require(h.cobraReadEpgCache(s.id,h.cobraEpgIdentity(s))==null,"Corrupt cache accepted");});
    runCase("C18","Cache older than retention rejected",h->{LiveSource s=h.source();CobraEpgData d=h.data(s);d.fetched-=9L*86400000;h.cobraWriteEpgCache(s.id,d);require(h.cobraReadEpgCache(s.id,d.identity)==null,"Expired cache accepted");});
    runCase("C19","HTTP XML response ingested by actual download method",h->{LiveSource s=h.source();long n=System.currentTimeMillis();responses.put(s.epgUrl,new Response(200,bytes(wrap(xmlProgramme("a",n-1000,n+10000,"Live")))));require(h.cobraDownloadEpg(s.epgUrl).programs.containsKey("a"),"HTTP parser failed");});
    runCase("C20","Gzip magic accepted without Content-Encoding header",h->{LiveSource s=h.source();long n=System.currentTimeMillis();ByteArrayOutputStream b=new ByteArrayOutputStream();try(GZIPOutputStream g=new GZIPOutputStream(b)){g.write(bytes(wrap(xmlProgramme("a",n-1000,n+10000,"Live"))));}responses.put(s.epgUrl,new Response(200,b.toByteArray()));require(h.cobraDownloadEpg(s.epgUrl).programs.containsKey("a"),"Gzip failed");});
    runCase("C21","HTTP authorization failure remains a visible error",h->{LiveSource s=h.source();responses.put(s.epgUrl,new Response(401,new byte[0]));try{h.cobraDownloadEpg(s.epgUrl);throw new AssertionError("401 accepted");}catch(LiveException e){require(h.cobraGuideFailure(e).equals("Guide HTTP 401"),"401 hidden");}});
    runCase("C22","Expanded guide byte limit enforced",h->{CobraBoundedGuideStream stream=h.new CobraBoundedGuideStream(new ByteArrayInputStream(new byte[20]));stream.remaining=8;boolean rejected=false;try{stream.read(new byte[20]);}catch(IOException e){rejected=true;}require(rejected,"Bound bypass");});
    runCase("C23","Same in-flight guide request coalesced",h->{LiveSource s=h.source();h.loadGuideAsync(s);h.loadGuideAsync(s);require(h.io.size()==1,"Duplicate work enqueued");});
    runCase("C24","Disabled source does not launch a guide request",h->{LiveSource s=h.source();h.mFeatures.enabled=false;h.loadGuideAsync(s);require(h.io.isEmpty(),"Disabled source queried");});
    runCase("C25","Destroyed activity does not launch a guide request",h->{LiveSource s=h.source();h.mCobraAsyncDestroyed=true;h.loadGuideAsync(s);require(h.io.isEmpty(),"Destroyed request queued");});
    runCase("C26","Fresh disk cache installed without redownloading",h->{LiveSource s=h.source();CobraEpgData d=h.data(s);long n=System.currentTimeMillis();d.programs.put("a",rows(p("a",n-1000,n+60000,"Cached")));h.cobraWriteEpgCache(s.id,d);h.loadGuideAsync(s);h.drain();require(h.mCobraEpg.containsKey(s.id)&&requested.isEmpty(),"Cache not reused");});
    runCase("C27","Automatic refresh failure preserves last-known-good disk cache",h->{LiveSource s=h.source();CobraEpgData d=h.data(s);long n=System.currentTimeMillis();d.fetched-=5L*3600000;d.programs.put("a",rows(p("a",n-1000,n+60000,"Saved")));h.cobraWriteEpgCache(s.id,d);h.mCobraEpg.put(s.id,d);h.loadGuideAsync(s);h.drain();require(h.cobraReadEpgCache(s.id,d.identity)!=null&&h.mCobraEpgStatus.get(s.id).contains("Saved guide"),"Lost saved cache");});
    runCase("C28","Failed provider does not prevent configured custom guide loading",h->{LiveSource s=h.source();String custom="https://fixture.invalid/custom.xml";h.mPrefs.store.put("cobra_custom_epg:"+s.id,custom);long n=System.currentTimeMillis();responses.put(custom,new Response(200,bytes(wrap(xmlProgramme("a",n-1000,n+60000,"Custom")))));h.loadGuideAsync(s);h.drain();require(h.mCobraEpg.get(s.id).programs.containsKey("a")&&requested.contains(s.epgUrl),"Custom guide blocked");});
    runCase("C29","Obsolete configuration response not installed in memory",h->{LiveSource old=h.source();h.loadGuideAsync(old);LiveSource newer=new LiveSource(old.id,"https://fixture.invalid/new.xml");h.mSources.set(0,newer);long n=System.currentTimeMillis();responses.put(old.epgUrl,new Response(200,bytes(wrap(xmlProgramme("a",n-1000,n+60000,"Old")))));h.drain();require(!h.mCobraEpg.containsKey(old.id),"Obsolete memory commit");});
    runCase("C30","Relative playlist guide URL discovered",h->{LiveSource s=new LiveSource("m","m3u","","https://fixture.invalid/list/channels.m3u");h.cobraDiscoverPlaylistGuide(s,"#EXTM3U x-tvg-url=\"../guide.xml\"\n#EXTINF:-1,Channel");require("https://fixture.invalid/guide.xml".equals(h.mPrefs.getString("cobra_epg_discovered|m","")),"Relative discovery incorrect");});
    runCase("F01","Current short EPG remains usable when matching XMLTV schedule expired",h->{LiveSource s=h.source();long n=System.currentTimeMillis();CobraEpgData d=h.data(s);d.programs.put("canonical",rows(p("canonical",n-7200000,n-3600000,"Yesterday")));d.programs.put("@stream:fixture:1",rows(p("@stream:fixture:1",n-60000,n+3600000,"Live fallback")));h.mCobraEpg.put(s.id,d);GuideProgram now=h.cobraCurrentProgram(channel("fixture:1","News","canonical"));require(now!=null&&now.title.equals("Live fallback"),"Valid current fallback is present but hidden by historical XMLTV match");});
    runCase("F02","Updated channel EPG ID invalidates prior resolution",h->{LiveSource s=h.source();long n=System.currentTimeMillis();CobraEpgData d=h.data(s);d.programs.put("old",rows(p("old",n-1000,n+60000,"Old mapping")));d.programs.put("new",rows(p("new",n-1000,n+60000,"Corrected mapping")));h.mCobraEpg.put(s.id,d);h.cobraResolveEpg(channel("fixture:1","News","old"));String actual=h.cobraResolveEpg(channel("fixture:1","News","new"));require(actual.equals("new"),"Resolved cache keyed only by channel ID retains '"+actual+"' after EPG ID correction");});
    runCase("F03","Library metadata corrections trigger presentation refresh",h->{Channel before=channel("fixture:1","News","old"),after=channel("fixture:1","News corrected","new");require(!h.cobraLibrariesEqual(Arrays.asList(before),Arrays.asList(after)),"Name/EPG-ID change considered unchanged because ID and stream URL match");});
    runCase("F04","Manual refresh failure retains restartable saved guide",h->{LiveSource s=h.source();long n=System.currentTimeMillis();CobraEpgData d=h.data(s);d.programs.put("a",rows(p("a",n-1000,n+60000,"Saved")));h.cobraWriteEpgCache(s.id,d);h.mCobraEpg.put(s.id,d);h.cobraRefreshGuide(channel("fixture:1","News","a"));h.drain();require(h.cobraReadEpgCache(s.id,d.identity)!=null,"Refresh deleted the disk cache before HTTP 503; memory survives, restart cache does not");});
    runCase("F05","Old in-flight response cannot overwrite newer configuration disk cache",h->{LiveSource old=h.source();long n=System.currentTimeMillis();responses.put(old.epgUrl,new Response(200,bytes(wrap(xmlProgramme("a",n-1000,n+60000,"Old")))));h.loadGuideAsync(old);LiveSource newer=new LiveSource(old.id,"https://fixture.invalid/new.xml");h.mSources.set(0,newer);responses.put(newer.epgUrl,new Response(200,bytes(wrap(xmlProgramme("a",n-1000,n+60000,"New")))));h.loadGuideAsync(newer);h.io.removeLast().run();h.drainUi();h.io.removeFirst().run();h.drainUi();require(h.mCobraEpg.get(old.id).identity.equals(h.cobraEpgIdentity(newer)),"Unexpected memory failure");require(h.cobraReadEpgCache(old.id,h.cobraEpgIdentity(newer))!=null,"Old response wrote cache before generation check; new identity cache no longer readable");});
    runCase("F06","Conflicting regional aliases across separate feeds stay unresolved",h->{long n=System.currentTimeMillis();CobraEpgData first=h.parse(wrap(channelXml("east","News")+xmlProgramme("east",n-1000,n+60000,"E")));CobraEpgData second=h.parse(wrap(channelXml("west","News")+xmlProgramme("west",n-1000,n+60000,"W")));h.cobraMergeEpg(first,second);require("".equals(first.aliases.get("news")),"Cross-feed merge keeps first 'news' alias despite conflicting canonical channel");});
    runCase("F07","Live coverage from fallback feed fills absent time range",h->{LiveSource s=h.source();long n=System.currentTimeMillis();CobraEpgData first=h.parse(wrap(xmlProgramme("same",n-7200000,n-3600000,"Old custom")));CobraEpgData second=h.parse(wrap(xmlProgramme("same",n-1000,n+60000,"Live provider")));h.cobraMergeEpg(first,second);h.mCobraEpg.put(s.id,first);require(h.cobraCurrentProgram(channel("fixture:1","News","same"))!=null,"First feed owns entire channel key; later current programmes discarded");});
    runCase("F08","XMLTV start-only programme retained instead of silently lost",h->{long n=System.currentTimeMillis();String xml=wrap("<programme channel=\"a\" start=\""+time(n-1000)+"\"><title>Valid start-only item</title></programme>"+xmlProgramme("a",n+60000,n+120000,"Next"));CobraEpgData d=h.parse(xml);require(d.programs.get("a").size()==2,"Schema-valid programme without optional stop was discarded; no unknown-duration record retained");});
    runCase("F09","Visible guide keeps refresh ticker without a video player",h->{h.mCobraPresentationTick.run();require(!h.mMain.pending.isEmpty(),"Ticker schedules again only when preview/fullscreen/multiview player exists");});
    runCase("F10","Guide refresh notices that all cached programme coverage has expired",h->{LiveSource s=h.source();long n=System.currentTimeMillis();CobraEpgData d=h.data(s);d.programs.put("a",rows(p("a",n-7200000,n-3600000,"Expired")));h.mCobraEpg.put(s.id,d);h.loadGuideAsync(s);require(!h.io.isEmpty(),"Four-hour fetch-age shortcut ignores absence of any current/future coverage");});
    runCase("F11","All explicitly advertised playlist guide URLs retained",h->{LiveSource s=new LiveSource("m","m3u","","https://fixture.invalid/channels.m3u");h.cobraDiscoverPlaylistGuide(s,"#EXTM3U x-tvg-url=\"https://fixture.invalid/a.xml,https://fixture.invalid/b.xml\"\n");String discovered=h.mPrefs.getString("cobra_epg_discovered|m","");require(discovered.contains("b.xml"),"Only the first comma-separated guide URL is retained");});
    System.out.println("SUMMARY\t"+passed+" passed\t"+failed+" failed\tHost test doubles; not Android/provider acceptance");
    java.nio.file.Files.writeString(java.nio.file.Path.of(args[0]),String.join("\n",resultLines)+"\n");
    if(failed>0)System.exit(1);
  }
