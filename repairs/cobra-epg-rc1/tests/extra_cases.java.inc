    runCase("R07","Start-only entries roundtrip with an explicitly unknown end",h->{LiveSource s=h.source();long n=System.currentTimeMillis();CobraEpgData d=h.parse(wrap("<programme channel=\"a\" start=\""+time(n+60000)+"\"><title>Unknown</title></programme>"));d.identity=h.cobraEpgIdentity(s);d.fetched=n;h.cobraWriteEpgCache(s.id,d);CobraEpgData read=h.cobraReadEpgCache(s.id,d.identity);GuideProgram p=read.programs.get("a").get(0);require(p.stop==-1L&&h.cobraProgrammeTimeLabel(p).contains("End time unavailable")&&!h.cobraProgrammeHasEnd(p)&&h.cobraProgrammeInSchedule(p,n),"Unknown end lost or invented");});
