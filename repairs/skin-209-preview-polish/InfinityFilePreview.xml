<?xml version="1.0" encoding="utf-8"?>
<window>
  <defaultcontrol always="true">81</defaultcontrol>
  <animation effect="fade" start="0" end="100" time="140" condition="!String.IsEqual(Window(Home).Property(Infinity.OptionalMotionAllowed),false)">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="100" condition="!String.IsEqual(Window(Home).Property(Infinity.OptionalMotionAllowed),false)">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>100%</width><height>100%</height>
      <texture colordiffuse="66000000">infinity_ui/contract_white.png</texture>
    </control>
    <control type="group" id="1">
      <left>5%</left><top>8%</top><width>90%</width><height>84%</height>
      <control type="image">
        <left>0</left><top>0</top><width>100%</width><height>100%</height>
        <texture border="24" colordiffuse="$VAR[InfinityPreviewSurface]">infinity_glass/surface.png</texture>
        <bordertexture border="24" colordiffuse="$VAR[InfinityLegacyBorder]">infinity_glass/rim.png</bordertexture>
        <bordersize>2</bordersize>
      </control>
      <control type="image" id="10">
        <left>28</left><top>24</top><width>96</width><height>96</height><aspectratio>keep</aspectratio>
        <texture>infinity_ui/icons/addons.png</texture>
      </control>
      <control type="label" id="11">
        <left>146</left><right>104</right><top>26</top><height>52</height>
        <label>$INFO[Window.Property(Preview.Title)]</label><font>InfinityBodyBold</font>
        <textcolor>$VAR[InfinityLegacyText]</textcolor><aligny>center</aligny><scroll>true</scroll>
      </control>
      <control type="label" id="12">
        <left>146</left><right>104</right><top>84</top><height>32</height>
        <label>$INFO[Window.Property(Preview.Author)]</label><font>InfinityTiny</font>
        <textcolor>$VAR[InfinityLegacySecondary]</textcolor><aligny>center</aligny><scroll>true</scroll>
      </control>
      <control type="button" id="82">
        <right>24</right><top>24</top><width>64</width><height>64</height><label />
        <texturefocus colordiffuse="$VAR[InfinityLegacyAccent]">infinity_legacy/close_focus.png</texturefocus>
        <texturenofocus colordiffuse="$VAR[InfinityLegacyText]">infinity_legacy/close.png</texturenofocus>
        <onleft>81</onleft><onright>81</onright><onup>81</onup><ondown>70</ondown>
      </control>
      <control type="textbox" id="20">
        <left>28</left><right>72</right><top>140</top><bottom>190</bottom>
        <font>InfinitySmall</font><textcolor>$VAR[InfinityLegacyText]</textcolor>
        <text>Reading file information…</text><pagecontrol>70</pagecontrol>
      </control>
      <control type="scrollbar" id="70">
        <right>28</right><top>140</top><width>26</width><bottom>190</bottom>
        <orientation>vertical</orientation><showonepage>false</showonepage>
        <texturesliderbackground>infinity_ui/track_dark.png</texturesliderbackground>
        <texturesliderbar>infinity_ui/blue.png</texturesliderbar>
        <texturesliderbarfocus>infinity_ui/blue.png</texturesliderbarfocus>
        <textureslidernib>infinity_ui/blue.png</textureslidernib>
        <textureslidernibfocus>infinity_ui/blue.png</textureslidernibfocus>
        <onleft>81</onleft><onright>81</onright><onup>82</onup><ondown>81</ondown>
      </control>
      <control type="textbox" id="30">
        <left>28</left><right>28</right><bottom>130</bottom><height>52</height>
        <font>InfinityTiny</font><textcolor>$VAR[InfinityLegacySecondary]</textcolor>
        <text>$INFO[Window.Property(Preview.Status)]</text>
      </control>
      <control type="button" id="80">
        <left>28</left><bottom>28</bottom><width>44%</width><height>86</height>
        <label>Install</label><font>InfinityBodyBold</font><align>center</align><aligny>center</aligny>
        <texturefocus border="16" colordiffuse="$VAR[InfinityLegacyAccent]">infinity_glass/focus.png</texturefocus>
        <texturenofocus border="16" colordiffuse="$VAR[InfinityLegacyField]">infinity_glass/field.png</texturenofocus>
        <textcolor>$VAR[InfinityLegacyText]</textcolor><focusedcolor>$VAR[InfinityLegacyText]</focusedcolor>
        <disabledcolor>$VAR[InfinityLegacyDisabled]</disabledcolor>
        <onleft>81</onleft><onright>81</onright><onup>70</onup><ondown>81</ondown>
      </control>
      <control type="button" id="81">
        <right>28</right><bottom>28</bottom><width>44%</width><height>86</height>
        <label>Cancel</label><font>InfinityBodyBold</font><align>center</align><aligny>center</aligny>
        <texturefocus border="16" colordiffuse="$VAR[InfinityLegacyAccent]">infinity_glass/focus.png</texturefocus>
        <texturenofocus border="16" colordiffuse="$VAR[InfinityLegacyField]">infinity_glass/field.png</texturenofocus>
        <textcolor>$VAR[InfinityLegacyText]</textcolor><focusedcolor>$VAR[InfinityLegacyText]</focusedcolor>
        <disabledcolor>$VAR[InfinityLegacyDisabled]</disabledcolor>
        <onleft condition="Control.IsEnabled(80)">80</onleft><onleft condition="!Control.IsEnabled(80)">82</onleft>
        <onright>82</onright><onup>70</onup><ondown>82</ondown>
      </control>
    </control>
  </controls>
</window>
