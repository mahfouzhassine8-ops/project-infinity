  "basis": {
    "CHOOSER_SHELL": "Existing single launcher, selection/preferences and chooser presentation only; feature settings delegated to their owner",
    "COBRA": "Explicit Cobra activities/services/jobs, Media3/OkHttp call sites, Cobra appearance renderer and theme package; copied persistence/service state",
    "INFINITY": "Explicit Kodi entry routes, JNI loaders, bundled Python execution and Infinity-only Gson/TV provider call sites",
    "MINIMAL_ANDROID_CONTRACT": "Android adapters/annotations, OS resource IDs and the scoped multi-owner termination/callback contract; no shared player or persistence state"
  },
  "container_exceptions": [
    "Shared Android notification channel retains the existing OS notification permission preference; distinct notifications/actions/services",
    "Chooser hosts the existing Cobra-owned customizable presentation and delegates Cobra appearance preferences to its actual owner",
    "Cobra settings delegates Ask Every Time to the single shell-owned launch preference",
    "Cobra diagnostic exports may read Infinity diagnostic files, never overwrite the source",
    "Existing generic startup extraction can deploy packaged Cobra theme resources; the extraction implementation is protected and not a Cobra feature implementation"
  ],
