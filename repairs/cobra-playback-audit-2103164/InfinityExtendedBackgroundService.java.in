package @APP_PACKAGE@;

import android.Manifest;
import android.app.Activity;
import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.app.Service;
import android.content.Context;
import android.content.Intent;
import android.content.SharedPreferences;
import android.content.pm.PackageManager;
import android.content.pm.ServiceInfo;
import android.os.Build;
import android.os.IBinder;
import android.util.Log;

/**
 * User-owned background continuity plus Cobra mini-player native media presence.
 * Mini playback never starts a stream: it only keeps an already-playing preview alive.
 */
public final class InfinityExtendedBackgroundService extends Service {
  private static final String TAG = "InfinityBackground";
  private static final String PREFS = "infinity_runtime";
  private static final String KEY_ENABLED = "extended_background";
  private static final String CHANNEL_ID = "infinity_extended_background";
  private static final int NOTIFICATION_ID = 10932;
  private static final int REQUEST_OPEN = 10933;
  private static final int REQUEST_DISABLE = 10934;
  private static final String ACTION_DISABLE =
      "com.projectinfinity.kodi.action.DISABLE_EXTENDED_BACKGROUND";
  private static final String ACTION_MINI_START =
      "com.projectinfinity.kodi.action.MINI_BACKGROUND_START";
  private static final String ACTION_MINI_STOP =
      "com.projectinfinity.kodi.action.MINI_BACKGROUND_STOP";
  private static final String EXTRA_MINI_TITLE = "mini_title";
  private static volatile boolean sRunning;
  private static volatile boolean sMiniPlayback;

  private android.media.session.MediaSession mMediaSession;
  private String mMiniTitle = "Cobra Live";
  private static final String EXTRA_GENERATION="mini_generation";
  private static final String ACTION_MINI_TOGGLE="com.projectinfinity.kodi.action.MINI_BACKGROUND_TOGGLE";
  private static final String ACTION_MINI_END="com.projectinfinity.kodi.action.MINI_BACKGROUND_END";
  private static final android.os.Handler MAIN=new android.os.Handler(android.os.Looper.getMainLooper());
  // Non-owning callbacks: ExoPlayer remains solely owned by the Cobra Activity.
  public interface MiniPlaybackOwner {
    boolean valid(); int state(); long position(); void play(); void pause(); void stop();
  }
  private static java.lang.ref.WeakReference<MiniPlaybackOwner> sOwner=new java.lang.ref.WeakReference<>(null);
  private static java.lang.ref.WeakReference<InfinityExtendedBackgroundService> sInstance=new java.lang.ref.WeakReference<>(null);
  private static long sGeneration;
  private static String sPendingTitle="Cobra Live";
  private long mMediaGeneration=-1;
  private final Runnable mMiniRefresh=new Runnable(){@Override public void run(){
    if(!sMiniPlayback)return;
    MiniPlaybackOwner owner=currentOwner();
    if(owner==null||!notificationsAllowed(InfinityExtendedBackgroundService.this)){failMini();return;}
    try{
      NotificationManager manager=(NotificationManager)getSystemService(NOTIFICATION_SERVICE);
      if(manager==null)throw new IllegalStateException("Notification manager unavailable");
      manager.notify(NOTIFICATION_ID,buildMiniPlaybackNotification());
      MAIN.postDelayed(this,1000);
    }catch(RuntimeException failure){Log.w(TAG,"Mini media update refused",failure);failMini();}
  }};
  private static void requireMain(){
    if(android.os.Looper.myLooper()!=android.os.Looper.getMainLooper())throw new IllegalStateException("Mini media mutations require main thread");
  }
  private static MiniPlaybackOwner currentOwner(){
    MiniPlaybackOwner owner=sOwner.get();
    try{return owner!=null&&owner.valid()?owner:null;}catch(RuntimeException e){return null;}
  }
  public static boolean isMiniPlaybackCurrent(MiniPlaybackOwner owner){
    return owner!=null&&owner==currentOwner();
  }
  private static void revokeOwner(boolean stop){
    requireMain();MiniPlaybackOwner owner=sOwner.get();sOwner.clear();sGeneration++;sMiniPlayback=false;
    if(stop&&owner!=null)try{owner.stop();}catch(RuntimeException failure){Log.w(TAG,"Mini playback stop rejected",failure);}
  }
  @Override public void onCreate(){super.onCreate();sInstance=new java.lang.ref.WeakReference<>(this);}
  /** Foreground return detaches media presence, NOT the existing player. */
  public static void detachMiniPlayback(Context context,MiniPlaybackOwner owner){
    requireMain();if(owner==null||owner!=sOwner.get())return;
    revokeOwner(false);
    InfinityExtendedBackgroundService service=sInstance.get();
    if(service!=null)service.finishDetachedMini();
    else if(!isEnabled(context))context.stopService(new Intent(context,InfinityExtendedBackgroundService.class));
  }
  private void finishDetachedMini(){
    MAIN.removeCallbacks(mMiniRefresh);releaseMediaSession();
    if(isEnabled(this)&&notificationsAllowed(this))onStartCommand(new Intent(this,InfinityExtendedBackgroundService.class),0,0);
    else endSession();
  }
  private void failMini(){revokeOwner(true);finishDetachedMini();}
  private void performMiniCommand(String action,long generation){
    if(generation!=sGeneration)return;
    MiniPlaybackOwner owner=currentOwner();
    if(owner==null){failMini();return;}
    try{
      if(ACTION_MINI_END.equals(action)){failMini();return;}
      if("play".equals(action))owner.play();
      else if("pause".equals(action))owner.pause();
      else if(owner.state()==android.media.session.PlaybackState.STATE_PAUSED)owner.play();else owner.pause();
      MAIN.removeCallbacks(mMiniRefresh);mMiniRefresh.run();
    }catch(RuntimeException e){Log.w(TAG,"Mini media command rejected",e);failMini();}
  }

  private static SharedPreferences preferences(Context context) {
    return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
  }

  public static boolean isEnabled(Context context) {
    return preferences(context).getBoolean(KEY_ENABLED, false);
  }

  public static boolean isRunning() { return sRunning; }
  public static boolean isMiniPlaybackRunning() { return sMiniPlayback; }

  public static boolean notificationsAllowed(Context context) {
    try { return notificationsAllowedChecked(context); }
    catch (RuntimeException error) {
      Log.w(TAG, "Notification state unavailable: " + error.getClass().getSimpleName());
      return false;
    }
  }

  private static boolean notificationsAllowedChecked(Context context) {
    if (Build.VERSION.SDK_INT >= 33 && context.checkSelfPermission(
        Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) return false;
    NotificationManager manager =
        (NotificationManager) context.getSystemService(Context.NOTIFICATION_SERVICE);
    if (manager == null) return false;
    if (Build.VERSION.SDK_INT >= 24 && !manager.areNotificationsEnabled()) return false;
    if (Build.VERSION.SDK_INT >= 26) {
      NotificationChannel channel = manager.getNotificationChannel(CHANNEL_ID);
      if (channel != null && channel.getImportance() == NotificationManager.IMPORTANCE_NONE) return false;
    }
    return true;
  }

  public static void openNotificationSettings(Activity activity) {
    try {
      Intent intent;
      if (Build.VERSION.SDK_INT >= 26) {
        intent = new Intent(android.provider.Settings.ACTION_APP_NOTIFICATION_SETTINGS)
            .putExtra(android.provider.Settings.EXTRA_APP_PACKAGE, activity.getPackageName());
      } else {
        intent = new Intent(android.provider.Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
            android.net.Uri.parse("package:" + activity.getPackageName()));
      }
      activity.startActivity(intent);
    } catch (RuntimeException error) {
      Log.w(TAG, "Notification settings unavailable: " + error.getClass().getSimpleName());
    }
  }

  public static boolean setEnabled(Activity activity, boolean enabled) {
    if (!enabled) {
      preferences(activity).edit().putBoolean(KEY_ENABLED, false).apply();
      if (!sMiniPlayback) stopForExit(activity);
      else request(activity, new Intent(activity, InfinityExtendedBackgroundService.class));
      return true;
    }
    if (activity.isFinishing() || activity.isDestroyed() || !notificationsAllowed(activity)) return false;
    preferences(activity).edit().putBoolean(KEY_ENABLED, true).apply();
    if (start(activity)) return true;
    preferences(activity).edit().putBoolean(KEY_ENABLED, false).apply();
    return false;
  }

  public static void sync(Activity activity) {
    if (activity.isFinishing() || activity.isDestroyed()) return;
    if (sMiniPlayback) return;
    if (!isEnabled(activity)) return;
    if (!notificationsAllowed(activity)) { stopForExit(activity); return; }
    if (!sRunning) start(activity);
  }

  public static boolean startMiniPlayback(Context context,String title,MiniPlaybackOwner owner){
    requireMain();
    if(owner==null||!owner.valid()||!notificationsAllowed(context))return false;
    MiniPlaybackOwner previous=sOwner.get();
    if(previous!=null&&previous!=owner)revokeOwner(true);
    sOwner=new java.lang.ref.WeakReference<>(owner);long generation=++sGeneration;
    sPendingTitle=title==null||title.trim().isEmpty()?"Cobra Live":title.trim();
    Intent intent=new Intent(context,InfinityExtendedBackgroundService.class).setAction(ACTION_MINI_START)
        .putExtra(EXTRA_GENERATION,generation)
        .putExtra(EXTRA_MINI_TITLE,title==null||title.trim().isEmpty()?"Cobra Live":title.trim());
    if(request(context,intent))return true;
    if(generation==sGeneration)revokeOwner(true);
    return false;
  }

  public static void stopMiniPlayback(Context context){
    requireMain();revokeOwner(false);
    InfinityExtendedBackgroundService service=sInstance.get();
    if(service!=null)service.finishDetachedMini();
    else if(!isEnabled(context))context.stopService(new Intent(context,InfinityExtendedBackgroundService.class));
  }

  private static boolean start(Context context) {
    return request(context, new Intent(context, InfinityExtendedBackgroundService.class));
  }

  private static boolean request(Context context, Intent intent) {
    try {
      if (Build.VERSION.SDK_INT >= 26) return context.startForegroundService(intent) != null;
      return context.startService(intent) != null;
    } catch (RuntimeException error) {
      Log.w(TAG, "Background start refused: " + error.getClass().getSimpleName());
      return false;
    }
  }

  public static void stopForExit(Context context) {
    revokeOwner(true);
    try { context.stopService(new Intent(context, InfinityExtendedBackgroundService.class)); }
    catch (RuntimeException error) {
      Log.w(TAG, "Background stop refused: " + error.getClass().getSimpleName());
    }
  }

  @Override public int onStartCommand(Intent intent,int flags,int startId){
    requireMain();String action=intent==null?"":intent.getAction();
    if(ACTION_DISABLE.equals(action))preferences(this).edit().putBoolean(KEY_ENABLED,false).apply();
    if(ACTION_MINI_TOGGLE.equals(action)||ACTION_MINI_END.equals(action)){
      performMiniCommand(action,intent.getLongExtra(EXTRA_GENERATION,-1));return START_NOT_STICKY;
    }
    if(ACTION_MINI_STOP.equals(action)){revokeOwner(false);releaseMediaSession();}
    if(ACTION_MINI_START.equals(action)){
      // Late start after foreground return/PiP dismiss or process restart is inert.
      if(currentOwner()!=null){
        // A previous request cannot revoke a newer, already authorized owner.
        // Promote only CURRENT ownership and its current metadata, never the stale intent.
        sMiniPlayback=true;mMiniTitle=sPendingTitle;
      }
    }
    if(sMiniPlayback&&currentOwner()==null){revokeOwner(true);releaseMediaSession();}
    if(!notificationsAllowed(this)||(!sMiniPlayback&&!isEnabled(this))){endSession();return START_NOT_STICKY;}
    try{
      ensureChannel();Notification notification=sMiniPlayback?buildMiniPlaybackNotification():buildNotification();
      if(Build.VERSION.SDK_INT>=34){
        int type=sMiniPlayback?ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK:ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE;
        if(sMiniPlayback&&isEnabled(this))type|=ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE;
        startForeground(NOTIFICATION_ID,notification,type);
      }else startForeground(NOTIFICATION_ID,notification);
      sRunning=true;MAIN.removeCallbacks(mMiniRefresh);
      if(sMiniPlayback)MAIN.postDelayed(mMiniRefresh,1000);
      return sMiniPlayback?START_NOT_STICKY:START_STICKY;
    }catch(RuntimeException failure){Log.w(TAG,"Foreground promotion refused",failure);endSession();return START_NOT_STICKY;}
  }

  private void ensureChannel() {
    if (Build.VERSION.SDK_INT < 26) return;
    NotificationManager manager =
        (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
    if (manager == null) throw new IllegalStateException("Notification manager unavailable");
    if (manager.getNotificationChannel(CHANNEL_ID) != null) return;
    NotificationChannel channel = new NotificationChannel(CHANNEL_ID,
        "Infinity background playback", NotificationManager.IMPORTANCE_LOW);
    channel.setDescription("Background session continuity and user-enabled Cobra mini-player audio.");
    channel.setShowBadge(false);
    manager.createNotificationChannel(channel);
  }

  private PendingIntent openPendingIntent(){
    Intent launch;
    if(sMiniPlayback){
      launch=new Intent(this,InfinityLiveActivity.class).putExtra("infinity_live_profile","cobra").putExtra("cobra_open_browse",true)
          .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK|Intent.FLAG_ACTIVITY_CLEAR_TOP|Intent.FLAG_ACTIVITY_SINGLE_TOP);
    }else{
      launch=getPackageManager().getLaunchIntentForPackage(getPackageName());
      if(launch==null)launch=new Intent(this,Splash.class).setAction(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER);
      launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK|Intent.FLAG_ACTIVITY_SINGLE_TOP);
    }
    int flags=PendingIntent.FLAG_UPDATE_CURRENT;if(Build.VERSION.SDK_INT>=23)flags|=PendingIntent.FLAG_IMMUTABLE;
    return PendingIntent.getActivity(this,REQUEST_OPEN,launch,flags);
  }

  private Notification.Builder builder() {
    return Build.VERSION.SDK_INT >= 26
        ? new Notification.Builder(this, CHANNEL_ID) : new Notification.Builder(this);
  }

  private Notification buildMiniPlaybackNotification(){
    ensureMediaSession();MiniPlaybackOwner owner=currentOwner();
    boolean paused=owner!=null&&owner.state()==android.media.session.PlaybackState.STATE_PAUSED;
    int flags=PendingIntent.FLAG_UPDATE_CURRENT;if(Build.VERSION.SDK_INT>=23)flags|=PendingIntent.FLAG_IMMUTABLE;
    PendingIntent toggle=PendingIntent.getService(this,10935,new Intent(this,InfinityExtendedBackgroundService.class)
        .setAction(ACTION_MINI_TOGGLE).setData(android.net.Uri.parse("infinity://mini/"+sGeneration+"/toggle")).putExtra(EXTRA_GENERATION,sGeneration),flags);
    PendingIntent stop=PendingIntent.getService(this,10936,new Intent(this,InfinityExtendedBackgroundService.class)
        .setAction(ACTION_MINI_END).setData(android.net.Uri.parse("infinity://mini/"+sGeneration+"/stop")).putExtra(EXTRA_GENERATION,sGeneration),flags);
    Notification.Builder builder=builder().setSmallIcon(android.R.drawable.stat_notify_sync_noanim)
        .setContentTitle(mMiniTitle).setContentText(paused?"Infinity • Cobra mini-player paused":"Infinity • Cobra mini-player background audio")
        .setContentIntent(openPendingIntent()).setCategory(Notification.CATEGORY_TRANSPORT)
        .setOngoing(true).setOnlyAlertOnce(true).setShowWhen(false)
        .addAction(new Notification.Action.Builder(paused?android.R.drawable.ic_media_play:android.R.drawable.ic_media_pause,paused?"Play":"Pause",toggle).build())
        .addAction(new Notification.Action.Builder(android.R.drawable.ic_menu_close_clear_cancel,"Stop",stop).build())
        .setStyle(new Notification.MediaStyle().setMediaSession(mMediaSession.getSessionToken()).setShowActionsInCompactView(0,1));
    if(Build.VERSION.SDK_INT>=31)builder.setForegroundServiceBehavior(Notification.FOREGROUND_SERVICE_IMMEDIATE);
    return builder.build();
  }

  private void ensureMediaSession(){
    MiniPlaybackOwner owner=currentOwner();if(owner==null)throw new IllegalStateException("No mini-player owner");
    if(mMediaSession==null||mMediaGeneration!=sGeneration){
      releaseMediaSession();mMediaGeneration=sGeneration;final long generation=mMediaGeneration;
      mMediaSession=new android.media.session.MediaSession(this,"InfinityCobraMini");
      mMediaSession.setCallback(new android.media.session.MediaSession.Callback(){
        @Override public void onPlay(){performMiniCommand("play",generation);}
        @Override public void onPause(){performMiniCommand("pause",generation);}
        @Override public void onStop(){performMiniCommand(ACTION_MINI_END,generation);}
      },MAIN);
      mMediaSession.setFlags(android.media.session.MediaSession.FLAG_HANDLES_MEDIA_BUTTONS|android.media.session.MediaSession.FLAG_HANDLES_TRANSPORT_CONTROLS);
    }
    mMediaSession.setMetadata(new android.media.MediaMetadata.Builder()
        .putString(android.media.MediaMetadata.METADATA_KEY_TITLE,mMiniTitle)
        .putString(android.media.MediaMetadata.METADATA_KEY_ARTIST,"Infinity • Cobra").build());
    int state=owner.state();
    mMediaSession.setPlaybackState(new android.media.session.PlaybackState.Builder()
        .setActions(android.media.session.PlaybackState.ACTION_PLAY|android.media.session.PlaybackState.ACTION_PAUSE
            |android.media.session.PlaybackState.ACTION_PLAY_PAUSE|android.media.session.PlaybackState.ACTION_STOP)
        .setState(state,owner.position(),state==android.media.session.PlaybackState.STATE_PLAYING?1f:0f).build());
    mMediaSession.setActive(true);
  }

  private void releaseMediaSession() {
    if (mMediaSession == null) return;
    try { mMediaSession.setActive(false);mMediaSession.release(); }
    catch (RuntimeException error) { Log.w(TAG, "Media session cleanup refused", error); }
    mMediaSession = null;
  }

  private Notification buildNotification() {
    int pendingFlags = PendingIntent.FLAG_UPDATE_CURRENT;
    if (Build.VERSION.SDK_INT >= 23) pendingFlags |= PendingIntent.FLAG_IMMUTABLE;
    PendingIntent disable = PendingIntent.getService(this, REQUEST_DISABLE,
        new Intent(this, InfinityExtendedBackgroundService.class).setAction(ACTION_DISABLE), pendingFlags);
    Notification.Builder builder = builder();
    builder.setSmallIcon(android.R.drawable.stat_notify_sync_noanim)
        .setContentTitle("Infinity • Extended Background Mode")
        .setContentText("Session continuity enabled. Android may still stop Infinity.")
        .setContentIntent(openPendingIntent())
        .setCategory(Notification.CATEGORY_SERVICE)
        .setOngoing(true).setOnlyAlertOnce(true).setShowWhen(false)
        .addAction(new Notification.Action.Builder(android.R.drawable.ic_menu_close_clear_cancel,
            "Turn off", disable).build());
    if (Build.VERSION.SDK_INT >= 31) builder.setForegroundServiceBehavior(Notification.FOREGROUND_SERVICE_IMMEDIATE);
    return builder.build();
  }

  private void endSession() {
    revokeOwner(true);sRunning=false;MAIN.removeCallbacks(mMiniRefresh);releaseMediaSession();
    try { stopForeground(true); }
    catch (RuntimeException error) { Log.w(TAG, "Foreground cleanup refused: " + error.getClass().getSimpleName()); }
    stopSelf();
  }

  @Override public void onTaskRemoved(Intent rootIntent) {
    endSession();super.onTaskRemoved(rootIntent);
  }

  @Override public void onDestroy(){
    if(sInstance.get()==this){revokeOwner(true);sInstance.clear();sRunning=false;}
    MAIN.removeCallbacks(mMiniRefresh);releaseMediaSession();super.onDestroy();
  }

  @Override public IBinder onBind(Intent intent) { return null; }
}
