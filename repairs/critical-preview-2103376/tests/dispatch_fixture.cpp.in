// The runner inserts the actual Kodi method bodies at the marked boundaries.
// OS queues, coordinate transforms and rendering are outside this host harness.
#include <cassert>
#include <cmath>
#include <functional>
#include <map>
#include <memory>
#include <string>
#include <vector>
#include "xbmc/dialogs/InfinityFilePreviewContracts.h"
#include "xbmc/input/actions/ActionIDs.h"
constexpr int LOGINFO = 1, WINDOW_INVALID = 9999, WINDOW_ID_MASK = 0xffff;
constexpr int CONTROL_LIST = 450, CONTROL_THUMBS = 451, XBMC_TOUCH = 1, TMSG_GUI_ACTION = 2;
constexpr int EVENT_RESULT_HANDLED = 1, EVENT_RESULT_UNHANDLED = 0;
using EVENT_RESULT = int;
struct CLog { template<class... T> static void Log(int, const char*, T...) {} };
struct CPoint {
  float x, y;
  CPoint(float a, float b): x(a), y(b) {}
  CPoint operator-(const CPoint& p) const { return {x-p.x,y-p.y}; }
};
namespace MOUSE { struct CMouseEvent { int m_id; }; }
struct CAction {
  int id; float x{0},y{0}; std::string text;
  CAction(int a):id(a) {}
  CAction(int a,const std::string& s):id(a),text(s) {}
  CAction(int a,int,float b,float c,float,float,float=0,float=0):id(a),x(b),y(c) {}
  int GetID() const { return id; }
  float GetAmount(int n) const { return n ? y : x; }
};
struct Variant { std::string value; std::string asString() const { return value; } };
struct CFileItem {
  std::string path, label;
  bool m_bIsFolder{false}; long long m_dwSize{123};
  const std::string& GetPath() const { return path; }
  const std::string& GetLabel() const { return label; }
};
using CFileItemPtr = std::shared_ptr<CFileItem>;
struct CFileItemList {
  std::string path{"/Download"}; std::vector<CFileItemPtr> items;
  int Size() const { return static_cast<int>(items.size()); }
  const std::string& GetPath() const { return path; }
  CFileItemPtr operator[](int n) const { return items.at(n); }
};
struct CGUIBaseContainer {
  bool m_waitForScrollEnd{false}; float m_posX{0},m_posY{0}; int selected{0};
  std::function<void(int)> click;
  int GetSelectedItem() const { return selected; }
  bool SelectItemFromPoint(CPoint p) { if (p.x<0 || p.x>=100 || p.y<0 || p.y>=3) return false; selected=static_cast<int>(p.y); return true; }
  void OnClick(int action) { click(action); }
  EVENT_RESULT OnMouseEvent(const CPoint&,const MOUSE::CMouseEvent&);
};
struct View {
  CGUIBaseContainer* list{nullptr};
  int GetSelectedItem() const { return list->selected; }
  bool HasControl(int id) const { return id==CONTROL_LIST; }
  void Reset() {} void SetParentWindow(int) {} void AddView(void*) {}
};
struct CFile { static inline bool exists{true}; static bool Exists(const char*) { return exists; } };
struct CBuiltins {
  static inline std::vector<std::string> commands;
  static CBuiltins& GetInstance() { static CBuiltins v; return v; }
  int Execute(const std::string& s) { commands.push_back(s); return 0; }
};
struct CGUIDialog {
  virtual ~CGUIDialog()=default;
  CGUIBaseContainer container; int focused{CONTROL_LIST};
  bool m_closing{false};
  bool IsActive() const { return !m_closing; }
  virtual bool OnAction(const CAction& a) {
    if(a.GetID()==ACTION_MOUSE_MOVE || a.GetID()==ACTION_MOUSE_RIGHT_CLICK) {
      bool inside=a.x>=0 && a.x<100 && a.y>=0 && a.y<10;
      focused=inside ? CONTROL_LIST : 0;
      if(!inside) return false;
      if(a.GetID()==ACTION_MOUSE_MOVE) { if(!container.m_waitForScrollEnd) container.SelectItemFromPoint({a.x,a.y}); return true; }
      if(container.OnMouseEvent({a.x,a.y},{a.GetID()})==EVENT_RESULT_HANDLED) return true;
      m_closing=true; return true; // CGUIWindow::OnMouseEvent right-click Back fallback.
    }
    return false;
  }
  virtual void OnWindowLoaded() {}
};
struct Share { std::string strName; bool m_ignore{false}; };
struct StringUtils { static bool EqualsNoCase(const std::string& a,const std::string& b) { return a==b; } };
class CGUIDialogFileBrowser : public CGUIDialog {
public:
  bool m_infinityZipInstallContext{true}, m_addNetworkShareEnabled{false}, previewControl{true};
  std::string m_addSourceType,m_selectedPath; std::vector<Share> m_shares;
  uint64_t m_infinityPreviewSequence{0}; KODI::FILEPREVIEW::Request m_infinityPreviewRequest;
  CFileItemList files; CFileItemList* m_vecItems{&files}; CFileItemList* m_Directory{&files};
  View m_viewControl; std::map<std::string,std::string> properties;
  int id{10126}, installs{0}, sourceMenus{0}, parents{0};
  CGUIDialogFileBrowser() {
    m_viewControl.list=&container;
    container.click=[this](int a) { if(a==ACTION_MOUSE_RIGHT_CLICK) OpenInfinityFilePreview(container.selected); };
    for(int i=0;i<3;++i) { auto f=std::make_shared<CFileItem>(); f->path="/Download/"+std::to_string(i)+".zip"; f->label="zip"; files.items.push_back(f); }
  }
  void SetProperty(const std::string& k,const std::string& v) { properties[k]=v; }
  Variant GetProperty(const std::string& k) const { auto p=properties.find(k); return {p==properties.end()?"":p->second}; }
  int GetID() const { return id; }
  int GetFocusedControlID() const { return focused; }
  void* GetControl(int control) { return control==9410 && !previewControl ? nullptr : this; }
  void OnClick(int n) { assert(n==container.selected); ++installs; }
  bool OnPopupMenu(int) { ++sourceMenus; return true; }
  void GoParentFolder() { ++parents; }
  bool OnAction(const CAction&) override;
  void OnWindowLoaded() override;
  bool OnInfinityZipLongPress(float,float);
  bool OpenInfinityFilePreview(int);
  bool ConfirmInfinityFilePreview();
  void ClearInfinityFilePreview();
};
struct WindowManager {
  std::map<int,CGUIDialog*> windows; int top{10126};
  int GetTopmostModalDialog() const { return top; }
  int GetActiveWindow() const { return 10000; }
  int GetActiveWindowOrDialog() const;
  template<class T> T* GetWindow(int id) const { auto p=windows.find(id); return p==windows.end()?nullptr:dynamic_cast<T*>(p->second); }
};
struct GUI { WindowManager windows; WindowManager& GetWindowManager() { return windows; } };
static GUI gui;
struct MediaManager { bool HasLocation(const std::string&) { return true; } };
static MediaManager media;
static int emptyMenus=0, otherActions=0;
struct Application {
  bool OnAction(const CAction& a) {
    if(a.GetID()==ACTION_BUILT_IN_FUNCTION) { if(a.text=="ActivateWindow(ContextMenu)") ++emptyMenus; else ++otherActions; return true; }
    auto* b=gui.windows.GetWindow<CGUIDialogFileBrowser>(gui.windows.top);
    return b ? b->OnAction(a) : false;
  }
} g_application;
struct Messenger { void PostMsg(int,int,int,void* p) { std::unique_ptr<CAction> a(static_cast<CAction*>(p)); g_application.OnAction(*a); } };
static Messenger messenger;
struct CServiceBroker {
  static GUI* GetGUI() { return &gui; }
  static Messenger* GetAppMessenger() { return &messenger; }
  static MediaManager& GetMediaManager() { return media; }
};
struct TouchTranslator {
  int mapped{ACTION_BUILT_IN_FUNCTION}, calls{0}; std::string action{"ActivateWindow(ContextMenu)"};
  void TranslateTouchAction(int,int,int,int& id,std::string& s) { ++calls; id=mapped; s=action; }
};
struct XBMC_Event { int type{XBMC_TOUCH}; struct Touch { int action{ACTION_TOUCH_LONGPRESS},pointers{1};float x{50},y{1},x2{0},y2{0},x3{0},y3{0}; } touch; };
struct InputManager {
  TouchTranslator translator; TouchTranslator* m_touchTranslator{&translator};
  bool OnEvent(const XBMC_Event& newEvent);
};
// @PRODUCTION_METHODS@

static void bind(CGUIDialogFileBrowser& b) {
  gui.windows.windows.clear(); gui.windows.windows[b.id]=&b; gui.windows.top=b.id;
  CBuiltins::commands.clear(); emptyMenus=otherActions=0; CFile::exists=true;
  b.OnWindowLoaded();
  // Exact default SetProperty lookup used by the 209 skin's onload.
  if(auto* owner=gui.windows.GetWindow<CGUIDialogFileBrowser>(gui.windows.GetActiveWindowOrDialog()))
    owner->SetProperty("Infinity.FilePreview.OptIn","v1");
}
int main(int argc,char** argv) {
  assert(argc==2); std::string test=argv[1]; InputManager input; XBMC_Event event;
  CGUIDialogFileBrowser b; bind(b);
  if(test=="builtin_hold") {
    input.OnEvent(event);
#if TEST_PARENT
    assert(emptyMenus==1 && CBuiltins::commands.empty());
#else
    assert(emptyMenus==0 && CBuiltins::commands.size()==1 && input.translator.calls==0);
    assert(b.GetProperty("Infinity.FilePreview.Path").asString()=="/Download/1.zip");
#endif
    assert(b.installs==0);
  } else if(test=="scroll_selection") {
    input.translator.mapped=ACTION_MOUSE_RIGHT_CLICK; b.container.m_waitForScrollEnd=true;
    input.OnEvent(event); assert(b.container.selected==1);
#if TEST_PARENT
    assert(CBuiltins::commands.empty());
#else
    assert(CBuiltins::commands.size()==1 && b.installs==0);
#endif
  } else if(test=="instance_optin") {
    b.id=10126+(1<<16); b.properties.clear(); bind(b); input.translator.mapped=ACTION_MOUSE_RIGHT_CLICK; input.OnEvent(event);
#if TEST_PARENT
    assert(CBuiltins::commands.empty());
#else
    assert(CBuiltins::commands.size()==1);
    assert(CBuiltins::commands.back()=="RunScript(special://skin/resources/lib/infinity_file_preview.py,75662)");
#endif
  } else if(test=="repeat_and_confirm") {
    input.translator.mapped=ACTION_MOUSE_RIGHT_CLICK;
    input.OnEvent(event); auto nonce=b.GetProperty("Infinity.FilePreview.Nonce").asString();
    input.OnEvent(event); assert(CBuiltins::commands.size()==1 && b.installs==0);
    assert(!b.ConfirmInfinityFilePreview() && b.installs==0);
    input.OnEvent(event); nonce=b.GetProperty("Infinity.FilePreview.Nonce").asString();
    b.SetProperty("Infinity.FilePreview.AcceptNonce",nonce); b.container.selected=2;
    assert(!b.ConfirmInfinityFilePreview() && b.installs==0);
    input.OnEvent(event); nonce=b.GetProperty("Infinity.FilePreview.Nonce").asString();
    b.SetProperty("Infinity.FilePreview.AcceptNonce",nonce);
    assert(b.ConfirmInfinityFilePreview() && b.installs==1);
    assert(!b.ConfirmInfinityFilePreview() && b.installs==1);
  } else if(test=="preserve_other_input") {
    b.m_infinityZipInstallContext=false; input.OnEvent(event); assert(emptyMenus==1);
    b.m_infinityZipInstallContext=true; b.SetProperty("Infinity.FilePreview.OptIn",""); input.OnEvent(event); assert(emptyMenus==2);
    b.SetProperty("Infinity.FilePreview.OptIn","v1"); CFile::exists=false; input.OnEvent(event); assert(emptyMenus==3);
    CFile::exists=true; event.touch.pointers=2; input.OnEvent(event); assert(emptyMenus==4);
    event.touch.pointers=1; event.touch.action=ACTION_TOUCH_TAP; input.OnEvent(event); assert(emptyMenus==5);
    event.touch.action=ACTION_TOUCH_LONGPRESS; event.touch.x=200; input.OnEvent(event); assert(emptyMenus==6);
    event.touch.x=50; gui.windows.top=9999; input.OnEvent(event); assert(emptyMenus==7);
    assert(CBuiltins::commands.empty() && b.installs==0);
  } else if(test=="source_editing") {
    b.m_addSourceType="video"; b.files.path=""; input.translator.mapped=ACTION_MOUSE_RIGHT_CLICK;
    input.OnEvent(event); assert(b.sourceMenus==1 && CBuiltins::commands.empty() && b.installs==0);
  } else if(test=="no_skin_contract") {
    b.previewControl=false; b.OnWindowLoaded();
#if !TEST_PARENT
    assert(b.GetProperty("Infinity.FilePreview.OptIn").asString().empty());
#endif
  } else if(test=="empty_list_space") {
    input.translator.mapped=ACTION_MOUSE_RIGHT_CLICK; event.touch.y=7;
    input.OnEvent(event);
    assert(b.m_closing && CBuiltins::commands.empty() && b.installs==0);
  } else { assert(false); }
}
