+  private String chooserAppearanceMode()
+  {
+    // Read Cobra's existing appearance preference; the chooser has no separate setting.
+    android.content.SharedPreferences prefs = getSharedPreferences("infinity_cobra_live", MODE_PRIVATE);
+    String mode = prefs.getString("cobra_appearance_mode", "dark");
