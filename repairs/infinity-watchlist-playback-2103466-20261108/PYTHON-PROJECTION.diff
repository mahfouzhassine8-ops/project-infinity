+def _watchlist_progress_identity(data, entry, key):
+    """Read-only comparison view; saved identities and ordinary keys stay intact."""
+    identity = _resume_identity(entry)
+    if not identity or identity.get('kind') not in ('movie', 'episode'):
+        return None
+    if identity['kind'] != 'episode' or identity.get('scope') != 'episode':
+        return identity
+    # These are existing parent proofs, never a promotion of an episode ID.
+    series = continue_series_ids(entry)
+    if series:
+        return media_identity('tv', {}, entry.get('season'), entry.get('episode'), series)
+    from infinity_modules.watchedbridge.bridge_state import identity as raw_identity
+    from infinity_modules.watchedbridge.provider_contracts import PROOFS, presentation
+    canonical = presentation(entry, raw_identity(entry), _dict(data.get(PROOFS)).get(key))
+    if canonical and canonical.get('scope') == 'show_episode':
+        return media_identity('tv', {}, entry.get('season'), entry.get('episode'), canonical['ids'])
+    return identity
+
+
+def watchlist_progress(data, saved):
+    """Select exact current playable progress without changing a saved action.
+
+    This is opt-in for Watchlist rendering/dispatch only. Inspect raw episodes,
+    because the ordinary Continue projection deliberately collapses TV series.
+    Conflicting alias components and newer hidden/completed state fail closed.
+    """
+    import math
+    if not isinstance(data, dict) or not isinstance(saved, dict):
+        return None
+    selected = _watchlist_progress_identity(data, saved, saved.get('key'))
+    if not selected:
+        return None
+    values, locations = [], []
+    for bucket in ('items', 'watched'):
+        for key, entry in _dict(data.get(bucket)).items():
+            if not KEY_RE.fullmatch(str(key)) or not isinstance(entry, dict):
+                continue
+            identity = _watchlist_progress_identity(data, entry, key)
+            if identity:
+                # Only comparison copies carry canonical scope; never persist it.
+                value = dict(entry, identity=identity)
+                value.pop('resume_verified_ids', None)
+                values.append(value)
+                locations.append((bucket, key, entry))
+    query = dict(saved, identity=selected)
+    query.pop('resume_verified_ids', None)
+    groups = _resume_groups(values + [query], series=False)
+    matches = [location for location, group in zip(locations, groups) if group == groups[-1]]
+    items = [(key, entry) for bucket, key, entry in matches if bucket == 'items']
+    if not items:
+        return None
+
+    def marker(entry):
+        try:
+            return (int(entry.get('updated') or entry.get('watched_at') or 0),
+                    int(entry.get('resume_revision') or 0))
+        except (TypeError, ValueError, OverflowError):
+            return (0, 0)
+
+    key, newest = max(items, key=lambda pair: (marker(pair[1]), pair[0]))
+    if not resume_visible(data, key):
+        return None  # Never fall back to an older visible alias.
+    for bucket, _, watched in matches:
+        if bucket != 'watched':
+            continue
+        occurrence = str(newest.get('playback_occurrence') or '')
+        if ((occurrence and watched.get('completed_occurrence') == occurrence) or
+                marker(watched) >= marker(newest)):
+            return None
+    try:
+        if type(newest.get('position')) is bool or type(newest.get('duration')) is bool:
+            return None
+        position, duration = float(newest.get('position')), float(newest.get('duration'))
+        if not (math.isfinite(position) and math.isfinite(duration) and
+                0 < position < duration and position / duration < 0.95):
+            return None
+    except (TypeError, ValueError, OverflowError):
+        return None
+    return _entry_copy(newest, key)
