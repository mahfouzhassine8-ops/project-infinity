      if(max<=0)return 0f;String value=mode==null?"auto":mode;
      float cap="60".equals(value)?60f:"90".equals(value)?90f:"120".equals(value)?120f:max;
      if((saver||thermal)&&cap>60f)cap=60f;
      float best=0f;for(float hz:supported)if(hz>0&&hz<=cap+.5f&&hz>best)best=hz;
      return best>0?best:(min<Float.MAX_VALUE?min:max);
    }
    static boolean requestedExactly(String mode,float chosen){
      if(mode==null||"auto".equals(mode)||"max".equals(mode))return true;
      try{return Math.abs(Float.parseFloat(mode)-chosen)<.75f;}catch(Exception ignored){return true;}
    }
  }

  private String cobraRefreshMode(){String v=mPrefs==null?"auto":mPrefs.getString(COBRA_REFRESH_MODE,"auto");return "60".equals(v)||"90".equals(v)||"120".equals(v)||"max".equals(v)?v:"auto";}
  private String cobraRefreshModeLabel(){String v=cobraRefreshMode();return "max".equals(v)?"MAX":"auto".equals(v)?"AUTO":v+" HZ";}
  private android.view.Display cobraCurrentDisplay(){try{return Build.VERSION.SDK_INT>=30?getDisplay():getWindowManager().getDefaultDisplay();}catch(RuntimeException e){return null;}}
  private boolean cobraBatterySaver(){try{android.os.PowerManager p=(android.os.PowerManager)getSystemService(Context.POWER_SERVICE);return p!=null&&p.isPowerSaveMode();}catch(RuntimeException e){return false;}}
  private boolean cobraThermalLimited(){if(Build.VERSION.SDK_INT<29)return false;try{android.os.PowerManager p=(android.os.PowerManager)getSystemService(Context.POWER_SERVICE);return p!=null&&p.getCurrentThermalStatus()>=android.os.PowerManager.THERMAL_STATUS_SEVERE;}catch(RuntimeException e){return false;}}
  private boolean cobraVideoOwnsRefresh(){return mPlayerOverlay!=null||mMultiOverlay!=null||isCobraInPictureInPicture();}
  private void cobraClearRefreshRequest(){
    if(Build.VERSION.SDK_INT<23)return;try{WindowManager.LayoutParams a=getWindow().getAttributes();if(a.preferredDisplayModeId!=0){a.preferredDisplayModeId=0;getWindow().setAttributes(a);}}catch(RuntimeException ignored){}
  }
  private void cobraApplyDisplayPerformance(String reason){
    android.view.Display display=cobraCurrentDisplay();if(display==null||Build.VERSION.SDK_INT<23){mCobraRefreshStatus="SYSTEM";cobraUpdatePerformanceOverlay();return;}
    android.view.Display.Mode current=display.getMode();mCobraActiveHz=current==null?0f:current.getRefreshRate();mCobraMaxHz=0f;
    ArrayList<android.view.Display.Mode> eligible=new ArrayList<>();ArrayList<Float> rates=new ArrayList<>();
    if(current!=null)for(android.view.Display.Mode mode:display.getSupportedModes())if(mode.getPhysicalWidth()==current.getPhysicalWidth()&&mode.getPhysicalHeight()==current.getPhysicalHeight()){eligible.add(mode);rates.add(mode.getRefreshRate());mCobraMaxHz=Math.max(mCobraMaxHz,mode.getRefreshRate());}
    if(cobraVideoOwnsRefresh()){
      cobraClearRefreshRequest();mCobraRequestedHz=0f;mCobraRefreshStatus="VIDEO OWNS REFRESH";cobraUpdatePerformanceOverlay();return;
    }
    float[] raw=new float[rates.size()];for(int i=0;i<rates.size();i++)raw[i]=rates.get(i);
    String selected=cobraRefreshMode();float chosenHz=CobraRefreshPolicy.choose(selected,raw,cobraBatterySaver(),cobraThermalLimited());android.view.Display.Mode chosen=null;
    for(android.view.Display.Mode mode:eligible)if(Math.abs(mode.getRefreshRate()-chosenHz)<.75f&&(chosen==null||mode.getRefreshRate()>chosen.getRefreshRate()))chosen=mode;
    if(chosen==null){cobraClearRefreshRequest();mCobraRequestedHz=0f;mCobraRefreshStatus="SYSTEM";cobraUpdatePerformanceOverlay();return;}
    mCobraRequestedHz=chosen.getRefreshRate();try{WindowManager.LayoutParams a=getWindow().getAttributes();if(a.preferredDisplayModeId!=chosen.getModeId()){a.preferredDisplayModeId=chosen.getModeId();getWindow().setAttributes(a);}}catch(RuntimeException ignored){}
    boolean safety=(cobraBatterySaver()||cobraThermalLimited())&&mCobraRequestedHz<=60.5f&&mCobraMaxHz>60.5f;
    boolean exact=CobraRefreshPolicy.requestedExactly(selected,mCobraRequestedHz);
    mCobraRefreshStatus=safety?"FALLBACK • POWER/THERMAL":exact?"REQUESTED":"FALLBACK";
    mMain.postDelayed(()->{android.view.Display d=cobraCurrentDisplay();if(d!=null&&Build.VERSION.SDK_INT>=23){mCobraActiveHz=d.getMode().getRefreshRate();if(Math.abs(mCobraActiveHz-mCobraRequestedHz)<.75f)mCobraRefreshStatus="ACTIVE";else if(!mCobraRefreshStatus.startsWith("FALLBACK"))mCobraRefreshStatus="REQUESTED";}cobraUpdatePerformanceOverlay();},350L);
  }
  private String cobraRefreshProof(){String requested=mCobraRequestedHz<=0?"System":String.format(Locale.US,"%.2f Hz",mCobraRequestedHz);return "Requested: "+requested+"\nActive display: "+String.format(Locale.US,"%.2f Hz",mCobraActiveHz)+"\nDisplay maximum: "+String.format(Locale.US,"%.2f Hz",mCobraMaxHz)+"\nStatus: "+mCobraRefreshStatus;}
  private void showCobraDisplayPerformancePicker(){
    cobraApplyDisplayPerformance("settings");LinearLayout rows=cobraOpenSheet("Display & Performance",cobraRefreshProof(),"display-performance");boolean dark=cobraSheetIsDark();String current=cobraRefreshMode();
    String[] values={"auto","60","90","120","max"};String[] labels={"Auto","60 Hz","90 Hz","120 Hz","Maximum supported"};
    for(int i=0;i<values.length;i++){final String value=values[i];String detail=value.equals(current)?"Selected":("auto".equals(value)?"Highest safe UI refresh; yields to video":"Request this UI refresh when the display supports it");cobraAddDetail(rows,"display",labels[i],detail,"cobra-refresh:"+value,value.equals(current),()->{mPrefs.edit().putString(COBRA_REFRESH_MODE,value).apply();cobraApplyDisplayPerformance("setting");showCobraDisplayPerformancePicker();});}
    boolean overlay=mPrefs.getBoolean(COBRA_PERFORMANCE_OVERLAY,false);cobraAddDetail(rows,"health","Performance proof overlay",overlay?"On • active Hz, UI FPS, buffer and live offset":"Off","cobra-performance-overlay",overlay,()->{mPrefs.edit().putBoolean(COBRA_PERFORMANCE_OVERLAY,!overlay).apply();cobraSyncPerformanceOverlay();showCobraDisplayPerformancePicker();});
    cobraInfoText(rows,"Fullscreen video, Multi-View and PiP release the UI refresh request so video cadence remains independent. ACTIVE means Android reports the requested display mode, not merely that Cobra asked for it.");
  }
  private TextView cobraSettingsSection(String title){TextView label=cobraText(title,cobraThemeColor("muted",mTheme.muted),10);label.setLetterSpacing(.12f);label.setTypeface(Typeface.create("sans-serif-medium",Typeface.NORMAL));label.setPadding(dp(12),dp(16),dp(12),dp(5));label.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_YES);return label;}

  private final android.view.Choreographer.FrameCallback mCobraPerformanceFrame=new android.view.Choreographer.FrameCallback(){@Override public void doFrame(long frameTimeNanos){
    if(!mCobraPerformanceFrameActive)return;if(mCobraFpsWindowNs==0)mCobraFpsWindowNs=frameTimeNanos;mCobraFpsFrames++;
    long elapsed=frameTimeNanos-mCobraFpsWindowNs;if(elapsed>=1000000000L){mCobraUiFps=(float)(mCobraFpsFrames*1000000000d/elapsed);mCobraFpsFrames=0;mCobraFpsWindowNs=frameTimeNanos;cobraUpdatePerformanceOverlay();}
    android.view.Choreographer.getInstance().postFrameCallback(this);
  }};
  private void cobraSyncPerformanceOverlay(){
    boolean wanted=mPrefs!=null&&mPrefs.getBoolean(COBRA_PERFORMANCE_OVERLAY,false)&&!isFinishing()&&!isDestroyed();
    if(wanted&&mCobraPerformanceOverlayView==null){TextView view=cobraText("",Color.WHITE,10);view.setTag("cobra_performance_proof_overlay");view.setPadding(dp(9),dp(6),dp(9),dp(6));view.setBackground(surface(0xd5000000,10,0x55ffffff,1));view.setClickable(false);view.setFocusable(false);mCobraPerformanceOverlayView=view;FrameLayout.LayoutParams p=new FrameLayout.LayoutParams(-2,-2,Gravity.TOP|Gravity.RIGHT);p.topMargin=dp(38);p.rightMargin=dp(10);try{((FrameLayout)getWindow().getDecorView()).addView(view,p);}catch(RuntimeException ignored){mCobraPerformanceOverlayView=null;}}
    if(!wanted&&mCobraPerformanceOverlayView!=null){if(mCobraPerformanceOverlayView.getParent() instanceof android.view.ViewGroup)((android.view.ViewGroup)mCobraPerformanceOverlayView.getParent()).removeView(mCobraPerformanceOverlayView);mCobraPerformanceOverlayView=null;}
    if(wanted&&!mCobraPerformanceFrameActive){mCobraPerformanceFrameActive=true;mCobraFpsWindowNs=0;mCobraFpsFrames=0;android.view.Choreographer.getInstance().postFrameCallback(mCobraPerformanceFrame);}else if(!wanted)mCobraPerformanceFrameActive=false;
    cobraUpdatePerformanceOverlay();
  }
  private void cobraStopPerformanceOverlay(){mCobraPerformanceFrameActive=false;if(mCobraPerformanceOverlayView!=null&&mCobraPerformanceOverlayView.getParent() instanceof android.view.ViewGroup)((android.view.ViewGroup)mCobraPerformanceOverlayView.getParent()).removeView(mCobraPerformanceOverlayView);mCobraPerformanceOverlayView=null;}
  private void cobraUpdatePerformanceOverlay(){
    if(mCobraPerformanceOverlayView==null)return;android.view.Display proofDisplay=cobraCurrentDisplay();if(proofDisplay!=null&&Build.VERSION.SDK_INT>=23){mCobraActiveHz=proofDisplay.getMode().getRefreshRate();if(!cobraVideoOwnsRefresh()&&mCobraRequestedHz>0&&Math.abs(mCobraActiveHz-mCobraRequestedHz)<.75f)mCobraRefreshStatus="ACTIVE";}long buffered=mPlayer==null?0:Math.max(0,mPlayer.getTotalBufferedDuration());long live=-1;try{if(mPlayer!=null)live=mPlayer.getCurrentLiveOffset();}catch(RuntimeException ignored){}
    String shift=mCobraTimeshiftSession==null?"OFF":mCobraTimeshiftSession.shortState();String liveText=live<0||live==C.TIME_UNSET?"—":String.format(Locale.US,"%.1fs",live/1000f);
    mCobraPerformanceOverlayView.setText(String.format(Locale.US,"DISPLAY %.2f Hz  •  UI %.0f fps\nBUFFER %.1fs  •  LIVE %s\nTIMESHIFT %s",mCobraActiveHz,mCobraUiFps,buffered/1000f,liveText,shift));
    mCobraPerformanceOverlayView.bringToFront();
  }

  static final class CobraFinalFeaturePolicy {
