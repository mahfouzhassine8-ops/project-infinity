    static int timeshiftSeconds(int value){return value<=60?60:value<=120?120:180;}
    static long throughputKbps(long bytes,long ms){return bytes<=0||ms<=0?-1:Math.max(0,(bytes*8L)/ms);}
    static boolean localTsEligible(String url,String extension){if(url==null)return false;String l=url.toLowerCase(Locale.US);if(!(l.startsWith("http://")||l.startsWith("https://"))||l.contains(".m3u8")||l.startsWith("rtsp://"))return false;return "ts".equalsIgnoreCase(extension)||l.matches(".*\\.ts(?:\\?.*)?$");}
  }
  private int cobraTimeshiftSeconds(){return CobraFinalFeaturePolicy.timeshiftSeconds(mPrefs==null?120:mPrefs.getInt(COBRA_TIMESHIFT_SECONDS,120));}
  private boolean cobraShouldUseLocalTimeshift(Channel channel,String url){return cobraLiveRewindEnabled()&&channel!=null&&cobraLiveChannel(channel)&&mPlayingVodKey.isEmpty()&&CobraFinalFeaturePolicy.localTsEligible(url,channel.containerExtension);}
  private boolean cobraLocalTimeshiftActive(){return mCobraTimeshiftSession!=null&&mCobraTimeshiftPlayer!=null&&mCobraTimeshiftSession.ready();}
  private void cobraStopLocalTimeshift(String reason){CobraLocalTimeshiftSession session=mCobraTimeshiftSession;mCobraTimeshiftSession=null;mCobraTimeshiftPlayer=null;mCobraTimeshiftGeneration++;if(session!=null){InfinityCobraDiagnostics.record(this,"timeshift","stop",reason+"; "+session.diagnostic());session.stop();}cobraUpdatePerformanceOverlay();}
  private void cobraStartLocalTimeshift(Channel channel,String sourceUrl){
    final int generation=++mCobraTimeshiftGeneration;final CobraLocalTimeshiftSession session=new CobraLocalTimeshiftSession(getCacheDir(),sourceUrl,channel.headers,cobraTimeshiftSeconds());mCobraTimeshiftSession=session;
    TextView state=mPlayerOverlay==null?null:(TextView)mPlayerOverlay.findViewWithTag("player_state");if(state!=null)state.setText("BUILDING BUFFER");
    try{session.start();}catch(Exception e){mCobraTimeshiftSession=null;InfinityCobraDiagnostics.failure(this,"timeshift-start",e);cobraStartDirectSinglePlayer(channel,sourceUrl,"timeshift-start-failed");return;}
    if(!submitCobraIo(()->{boolean ready=session.awaitReady(18000L);publishCobraUi(()->{
      if(generation!=mCobraTimeshiftGeneration||session!=mCobraTimeshiftSession||mPlaying==null||!channel.id.equals(mPlaying.id)){session.stop();return;}
      if(!ready){InfinityCobraDiagnostics.record(this,"timeshift","fallback","Local buffer was not ready; direct playback restored");mCobraTimeshiftSession=null;session.stop();cobraStartDirectSinglePlayer(channel,sourceUrl,"timeshift-timeout");return;}
      try{mPlayer=buildPlayer(mPlayerTexture,channel,true);mCobraTimeshiftPlayer=mPlayer;mPlayer.setMediaItem(mediaItem(session.playlistUrl()));mPlayer.prepare();startCobraPlayer(mPlayer);cobraStartPresentationTicker();cobraRequestShortEpg(channel);cobraUpdatePlaybackLabels();cobraUpdatePerformanceOverlay();InfinityCobraDiagnostics.record(this,"timeshift","ready",session.diagnostic());}
      catch(Exception error){releaseSinglePlayer();mCobraTimeshiftPlayer=null;mCobraTimeshiftSession=null;session.stop();cobraStartDirectSinglePlayer(channel,sourceUrl,"timeshift-player-failed");}
    });})) {mCobraTimeshiftSession=null;session.stop();cobraStartDirectSinglePlayer(channel,sourceUrl,"timeshift-worker-rejected");}
  }
  private void cobraStartDirectSinglePlayer(Channel channel,String url,String reason){
    if(channel==null||mPlaying==null||!channel.id.equals(mPlaying.id)||mPlayerTexture==null)return;
    try{mPlayer=buildPlayer(mPlayerTexture,channel,true);mPlayer.setMediaItem(mediaItem(url));mPlayer.prepare();startCobraPlayer(mPlayer);cobraStartPresentationTicker();cobraRequestShortEpg(channel);InfinityCobraDiagnostics.record(this,"playback","direct",reason);}
    catch(Exception error){releaseSinglePlayer();showError("Playback failed","Could not start this stream. "+error.getClass().getSimpleName());}cobraUpdatePlaybackLabels();
  }
  private void cobraUpdateTimeshiftSeek(){
    if(mCobraTimeshiftSeek==null)return;boolean available=false;long duration=0,position=0;try{available=mPlayer!=null&&cobraLiveChannel(mPlaying)&&mPlayer.isCurrentMediaItemSeekable();duration=mPlayer==null?0:mPlayer.getDuration();position=mPlayer==null?0:mPlayer.getCurrentPosition();}catch(RuntimeException ignored){}
    available=available&&duration>0&&duration!=C.TIME_UNSET;if(!available){mCobraTimeshiftSeek.setVisibility(View.GONE);return;}mCobraTimeshiftSeek.setVisibility(View.VISIBLE);if(!mCobraTimeshiftDragging)mCobraTimeshiftSeek.setProgress((int)Math.max(0,Math.min(1000,(position*1000L)/Math.max(1,duration))));
  }

  private void cobraRememberChannelTransition(Channel next){if(next==null||mPrefs==null)return;String current=mPrefs.getString(COBRA_LAST_CURRENT,"");if(!current.isEmpty()&&!current.equals(next.id))mPrefs.edit().putString(COBRA_LAST_PREVIOUS,current).putString(COBRA_LAST_CURRENT,next.id).apply();else if(current.isEmpty())mPrefs.edit().putString(COBRA_LAST_CURRENT,next.id).apply();cobraUpdateLastChannelButton();}
  private Channel cobraLastChannel(){String id=mPrefs==null?"":mPrefs.getString(COBRA_LAST_PREVIOUS,"");return id.isEmpty()?null:findChannel(id);}
  private void cobraTuneLastChannel(){Channel last=cobraLastChannel();if(last==null){toast("No previous channel yet");return;}playChannel(last);}
  private void cobraUpdateLastChannelButton(){if(mCobraLastChannelButton==null)return;boolean enabled=cobraLastChannel()!=null;mCobraLastChannelButton.setEnabled(enabled);mCobraLastChannelButton.setAlpha(enabled?1f:.35f);mCobraLastChannelButton.setContentDescription(enabled?"Last channel":"No previous channel yet");}

  private String cobraNetworkTransport(){
    try{android.net.ConnectivityManager cm=(android.net.ConnectivityManager)getSystemService(Context.CONNECTIVITY_SERVICE);android.net.Network n=cm==null?null:cm.getActiveNetwork();android.net.NetworkCapabilities c=n==null?null:cm.getNetworkCapabilities(n);if(c==null)return "Unknown";ArrayList<String> p=new ArrayList<>();if(c.hasTransport(android.net.NetworkCapabilities.TRANSPORT_VPN))p.add("VPN");if(c.hasTransport(android.net.NetworkCapabilities.TRANSPORT_WIFI))p.add("Wi-Fi");if(c.hasTransport(android.net.NetworkCapabilities.TRANSPORT_CELLULAR))p.add("Cellular");if(c.hasTransport(android.net.NetworkCapabilities.TRANSPORT_ETHERNET))p.add("Ethernet");return p.isEmpty()?"Other":android.text.TextUtils.join(" + ",p);}catch(Exception e){return "Unavailable";}
  }

  private static final class CobraLocalTimeshiftSession {
    private static final int PACKET=188,SEGMENT_MS=3000,READY_SEGMENTS=3;
    private final File directory;private final String source;private final Map<String,String> headers;private final int windowSeconds,maxSegments,storageSegments;private final long maxBytes;
    private final Object lock=new Object();private final java.util.ArrayDeque<Segment> segments=new java.util.ArrayDeque<>();private final java.util.concurrent.CountDownLatch readyLatch=new java.util.concurrent.CountDownLatch(1);
    private volatile boolean stopped=false,ready=false;private volatile String state="STARTING",lastError="";private volatile long bytesRead=0,reconnects=0,stallMs=0;private volatile long startedElapsed=android.os.SystemClock.elapsedRealtime();
