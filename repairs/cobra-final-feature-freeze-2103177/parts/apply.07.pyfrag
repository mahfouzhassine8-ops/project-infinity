      'display_modes':['auto','60','90','120','max'],'active_hz_proof':True,'ui_fps_overlay':True,'video_refresh_independent':True,
      'local_timeshift':True,'local_timeshift_windows_seconds':[60,120,180],'smart_reserve_seconds':6,'single_provider_ingest_when_local_timeshift':True,
      'normal_single_load_control':'Media3 default','stall_watchdog_reprepare':False,'network_diagnostics':True,'last_channel':True,'polish_settings_sections':True,
