    if 'mPlayer.prepare()' in watchdog or 'mPlayer.play()' in watchdog: raise RuntimeError('watchdog still restarts player')
    if 'new DefaultLoadControl();' not in member(text,'buildPlayer'): raise RuntimeError('single-view Media3 default buffer not restored')
    if 'mPlayer.setMediaItem(mediaItem(session.playlistUrl()))' not in text: raise RuntimeError('local timeshift player is not loopback-only')

    after=text.encode();path.write_bytes(after);out.mkdir(parents=True,exist_ok=True);(out/'source-before').mkdir(exist_ok=True);(out/'source-before'/path.name).write_bytes(before_b)
    report={
