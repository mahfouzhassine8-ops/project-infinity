optJSONObject("team");CobraSportsTeam parsed=cobraSportsParseTeam(spec,team,competitor);if(parsed==null)continue;if("home".equals(competitor.optString("homeAway","")))g.home=parsed;else g.away=parsed;}JSONArray broadcasts=c.optJSONArray("broadcasts");if(broadcasts!=null)for(int b=0;b<broadcasts.length();b++){JSONObject br=broadcasts.optJSONObject(b);JSONArray names=br==null?null:br.optJSONArray("names");if(names!=null)for(int n=0;n<names.length();n++){String name=names.optString(n,"").trim();if(!name.isEmpty()&&!g.broadcasts.contains(name))g.broadcasts.add(name);}}if(g.home!=null&&g.away!=null)out.add(g);}return out;}

  private static void cobraSportsCollectStandings(JSONObject node,ArrayList<String> out,int depth){if(node==null||depth>5)return;String group=node.optString("name",node.optString("abbreviation",""));JSONObject standings=node.optJSONObject("standings");JSONArray entries=standings==null?null:standings.optJSONArray("entries");if(entries!=null&&entries.length()>0){if(!group.isEmpty())out.add(group.toUpperCase(Locale.US));for(int i=0;i<entries.length();i++){JSONObject entry=entries.optJSONObject(i),team=entry==null?null:entry.optJSONObject("team");if(team==null)continue;StringBuilder line=new StringBuilder(team.optString("displayName","Team"));JSONArray stats=entry.optJSONArray("stats");String wins="",losses="",ties="",summary="";if(stats!=null)for(int s=0;s<stats.length();s++){JSONObject st=stats.optJSONObject(s);if(st==null)continue;String name=st.optString("name","");if("wins".equals(name))wins=st.optString("displayValue","");else if("losses".equals(name))losses=st.optString("displayValue","");else if("ties".equals(name))ties=st.optString("displayValue","");else if("overall".equals(name))summary=st.optString("displayValue","");}if(!summary.isEmpty())line.append("  •  ").append(summary);else if(!wins.isEmpty()||!losses.isEmpty()){line.append("  •  ").append(wins).append("-").append(losses);if(!ties.isEmpty()&&!"0".equals(ties))line.append("-").append(ties);}out.add(line.toString());}}
    JSONArray children=node.optJSONArray("children");if(children!=null)for(int i=0;i<children.length();i++)cobraSportsCollectStandings(children.optJSONObject(i),out,depth+1);
  }

  private Set<String> cobraSportsEnabledLeagues(){Set<String> raw=mPrefs.getStringSet(COBRA_SPORTS_LEAGUES,null);if(raw!=null&&!raw.isEmpty())return new HashSet<>(raw);return new HashSet<>(java.util.Arrays.asList("nfl","nba","mlb","nhl","ncaaf","ncaam"));}
  private Set<String> cobraSportsFavoriteTeams(){Set<String> raw=mPrefs.getStringSet(COBRA_SPORTS_FAVORITES,Collections.emptySet());return new HashSet<>(raw);}
  private boolean cobraSportsHideScores(){return mPrefs.getBoolean(COBRA_SPORTS_HIDE_SCORES,false);}
  private boolean cobraSportsMultiOverlay(){return mPrefs.getBoolean(COBRA_SPORTS_MULTI_OVERLAY,true);}
  private boolean cobraSportsFavorite(CobraSportsTeam team){return team!=null&&cobraSportsFavoriteTeams().contains(team.key);}
  private boolean cobraSportsFavoriteGame(CobraSportsGame game){return game!=null&&(cobraSportsFavorite(game.home)||cobraSportsFavorite(game.away));}
  private void cobraSportsToggleFavorite(CobraSportsTeam team){if(team==null)return;Set<String> favorites=cobraSportsFavoriteTeams();if(!favorites.add(team.key))favorites.remove(team.key);mPrefs.edit().putStringSet(COBRA_SPORTS_FAVORITES,favorites).apply();if(cobraSportsVisible())cobraSportsRenderCurrent();}
  private boolean cobraSportsVisible(){String title=mCobraStageTitle==null?"":mCobraStageTitle;return COBRA_OWNER_SPORTS.equals(cobraDrawerOwner())&&title.startsWith("COBRA • SPORTS");}
  private String cobraSportsClock(long time){if(time<=0)return "Time unavailable";return new SimpleDateFormat("EEE • MMM d • h:mm a",Locale.US).format(new Date(time));}
  private String cobraSportsScore(CobraSportsTeam team){if(team==null)return "";if(cobraSportsHideScores())return "—";return team.score==null||team.score.isEmpty()?"—":team.score;}
  private String cobraSportsMatchup(CobraSportsGame game){if(game==null)return "Game";String a=game.away==null?"Away":game.away.shortName,h=game.home==null?"Home":game.home.shortName;return a+" @ "+h;}
  private String cobraSportsMeta(CobraSportsGame game){if(game==null)return "";String state=game.live()?"LIVE":game.finalGame()?"FINAL":cobraSportsClock(game.startMs);if(game.live()&&!game.detail.isEmpty())state+=" • "+game.detail;if(!game.broadcasts.isEmpty())state+=" • "+android.text.TextUtils.join(" / ",game.broadcasts);return state;}
  private String cobraSportsScoreLine(CobraSportsGame game){if(game==null||game.home==null||game.away==null)return "";if(cobraSportsHideScores())return game.away.shortName+"  —  "+game.home.shortName;return game.away.shortName+"  "+cobraSportsScore(game.away)+"   •   "+game.home.shortName+"  "+cobraSportsScore(game.home);}

  private void showCobraSportsHub(){
    stopCobraPreview();mCobraInternalScreen="internal";clearStage("COBRA • SPORTS");cobraSportsPrepareHeader();cobraSportsRenderHub();long age=System.currentTimeMillis()-mCobraSportsLastRefresh;if(mCobraSportsGames.isEmpty()||age>COBRA_SPORTS_STALE_MS)cobraSportsRefresh(false);else cobraSportsScheduleNext();
  }
  private void cobraSportsPrepareHeader(){if(mHeader==null)return;mHeader.setText("☰  COBRA • SPORTS");mHeader.setClickable(true);mHeader.setFocusable(true);mHeader.setContentDescription("Open Cobra navigation drawer");mHeader.setTag("cobra_sports_drawer_header");mHeader.setOnClickListener(v->toggleCobraDrawer());CobraBrandDrawable brand=new CobraBrandDrawable();brand.setBounds(0,0,dp(40),dp(32));mHeader.setCompoundDrawablePadding(dp(8));mHeader.setCompoundDrawablesRelative(null,null,brand,null);}
  private void cobraSportsRenderCurrent(){if("COBRA • SPORTS".equals(mCobraStageTitle))cobraSportsRenderHub();}
  private void cobraSportsRenderHub(){
    if(mStage==null)return;while(mStage.getChildCount()>2)mStage.removeViewAt(2);cobraSportsPrepareHeader();int live=0;for(CobraSportsGame g:mCobraSportsGames)if(g.live())live++;String refreshed=mCobraSportsLastRefresh==0?"Not refreshed yet":new SimpleDateFormat("h:mm a",Locale.US).format(new Date(mCobraSportsLastRefresh));status((mCobraSportsLoading?"Refreshing sport