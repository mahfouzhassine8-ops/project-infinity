s…":live+" live game"+(live==1?"":"s"))+" • refreshed "+refreshed);
    ScrollView scroll=new ScrollView(this);scroll.setFillViewport(true);LinearLayout body=new LinearLayout(this);body.setOrientation(LinearLayout.VERTICAL);body.setPadding(dp(2),dp(4),dp(2),dp(30));scroll.addView(body);
    Button refresh=cobraTextButton(mCobraSportsLoading?"Refreshing…":"Refresh",cobraModeDark(),()->cobraSportsRefresh(true));refresh.setEnabled(!mCobraSportsLoading);Button multi=cobraTextButton("Smart Multi-View",cobraModeDark(),()->cobraSportsOpenSmartMultiView("live",null));Button spoiler=cobraTextButton(cobraSportsHideScores()?"Scores hidden":"Hide scores",cobraModeDark(),()->{mPrefs.edit().putBoolean(COBRA_SPORTS_HIDE_SCORES,!cobraSportsHideScores()).apply();cobraSportsRenderCurrent();cobraSportsRefreshMultiOverlays();});
    LinearLayout actions=new LinearLayout(this);actions.setGravity(Gravity.CENTER_VERTICAL);actions.setOrientation(cobraWidthDp()<500?LinearLayout.VERTICAL:LinearLayout.HORIZONTAL);
    if(cobraWidthDp()<500){LinearLayout top=new LinearLayout(this);top.setGravity(Gravity.CENTER_VERTICAL);top.addView(refresh,new LinearLayout.LayoutParams(0,dp(48),1));top.addView(spoiler,new LinearLayout.LayoutParams(0,dp(48),1));actions.addView(top,new LinearLayout.LayoutParams(-1,dp(50)));actions.addView(multi,new LinearLayout.LayoutParams(-1,dp(48)));body.addView(actions,new LinearLayout.LayoutParams(-1,dp(100)));}
    else{actions.addView(refresh,new LinearLayout.LayoutParams(0,dp(48),1));actions.addView(multi,new LinearLayout.LayoutParams(0,dp(48),1));actions.addView(spoiler,new LinearLayout.LayoutParams(0,dp(48),1));body.addView(actions,new LinearLayout.LayoutParams(-1,dp(50)));}
    if(mCobraSportsGames.isEmpty()){LinearLayout empty=new LinearLayout(this);empty.setOrientation(LinearLayout.VERTICAL);empty.setGravity(Gravity.CENTER);empty.setPadding(dp(16),dp(48),dp(16),dp(48));TextView title=cobraText(mCobraSportsLoading?"LOADING SPORTS…":"SPORTS DATA UNAVAILABLE",cobraModeColor("text"),22);title.setGravity(Gravity.CENTER);TextView detail=cobraText(mCobraSportsLoading?"Building your live scoreboard and matching layer.":(mCobraSportsLastError.isEmpty()?"Refresh to try again.":mCobraSportsLastError),cobraModeColor("muted"),14);detail.setGravity(Gravity.CENTER);empty.addView(title,new LinearLayout.LayoutParams(-1,-2));empty.addView(detail,new LinearLayout.LayoutParams(-1,-2));body.addView(empty,new LinearLayout.LayoutParams(-1,-2));}
    ArrayList<CobraSportsGame> all=new ArrayList<>(mCobraSportsGames);all.sort(cobraSportsComparator());ArrayList<CobraSportsGame> liveGames=new ArrayList<>(),favoriteGames=new ArrayList<>(),upcoming=new ArrayList<>();long now=System.currentTimeMillis();for(CobraSportsGame g:all){if(g.live())liveGames.add(g);if(cobraSportsFavoriteGame(g)&&g.startMs>now-86400000L)favoriteGames.add(g);if(g.upcoming()&&g.startMs>=now-3600000L)upcoming.add(g);}cobraSportsAddSection(body,"LIVE NOW",liveGames,12);cobraSportsAddSection(body,"MY TEAMS",favoriteGames,12);cobraSportsAddSection(body,"UPCOMING",upcoming,12);
    Set<String> enabled=cobraSportsEnabledLeagues();for(CobraSportsLeagueSpec spec:COBRA_SPORTS_SPECS)if(enabled.contains(spec.key)){ArrayList<CobraSportsGame> league=new ArrayList<>();for(CobraSportsGame g:all)if(spec.key.equals(g.leagueKey))league.add(g);cobraSportsAddLeagueSection(body,spec,league);}
    mStage.addView(scroll,new LinearLayout.LayoutParams(-1,0,1));body.post(()->cobraAnimateChildrenIn(body));
  }

  private Comparator<CobraSportsGame> cobraSportsComparator(){return (a,b)->{int al=a.live()?0:cobraSportsFavoriteGame(a)?1:a.upcoming()?2:3,bl=b.live()?0:cobraSportsFavoriteGame(b)?1:b.upcoming()?2:3;if(al!=bl)return al-bl;return Long.compare(a.startMs,b.startMs);};}
  private void cobraSportsAddSection(LinearLayout body,String title,List<CobraSportsGame> games,int max){if(games==null||games.isEmpty())return;TextView heading=cobraSettingsSection(title);body.addView(heading,new LinearLayout.LayoutParams(-1,dp(42)));android.widget.HorizontalScrollView scroll=new android.widget.HorizontalScrollView(this);scroll.setHorizontalScrollBarEnabled(false);LinearLayout rail=new LinearLayout(this);rail.setOrientation(LinearLayout.HORIZONTAL);int count=Math.min(max,games.size());for(int i=0;i<count;i++){CobraSportsGame game=games.get(i);LinearLayout.LayoutParams p=new LinearLayout.LayoutParams(dp(cobraWidthDp()<500?250:300),dp(174));p.rightMargin=dp(10);rail.addView(cobraSportsGameCard(game),p);}scroll.addView(rail);body.addView(scroll,new LinearLayout.LayoutParams(-1,dp(184)));}
  private void cobraSportsAddLeagueSection(LinearLayout body,CobraSportsLeagueSpec spec,List<CobraSportsGame> games){LinearLayout header=new LinearLayout(this);header.setGravity(Gravity.CENTER_VERTICAL);TextView title=cobraSettingsSection(spec.label.toUpperCase(Locale.US));header.addView(title,new LinearLayout.LayoutParams(0,dp(42),1));Button open=cobraTextButton("League ›",cobraModeDark(),()->showCobraSportsLeague(spec.key));header.addView(open,new LinearLayout.LayoutParams(dp(110),dp(42)));body.addView(header,new LinearLayout.LayoutParams(-1,dp(44)));if(games==null||games.isEmpty()){TextView empty=cobraText("No games in the current window",cobraModeColor("muted"),13);empty.setPadding(dp(14),dp(8),dp(14),dp(16));body.addView(empty,new LinearLayout.LayoutParams(-1,-2));return;}android.widget.HorizontalScrollView scroll=new android.widget.HorizontalScrollView(this);scroll.setHorizontalScrollBarEnabled(false);LinearLayout rail=new LinearLayout(this);rail.setOrientation(LinearLayout.HORIZONTAL);for(int i=0;i<Math.min(10,games.size());i++){LinearLayout.LayoutParams p=new LinearLayout.LayoutParams(dp(cobraWidthDp()<500?250:300),dp(174));p.rightMargin=dp(10);rail.addView(cobraSportsGameCard(games.get(i)),p);}scroll.addView(rail);body.addView(scroll,new LinearLayout.LayoutParams(-1,dp(184)));}

  private View cobraSportsGameCard(CobraSportsGame game){boolean dark=cobraModeDark();LinearLayout card=new LinearLayout(this);card.setOrientation(LinearLayout.VERTICAL);card.setPadding(dp(14),dp(12),dp(14),dp(12));card.setBackground(cobraPhoneGlass(!dark,20,true));card.setFocusable(true);card.setClickable(true);ca