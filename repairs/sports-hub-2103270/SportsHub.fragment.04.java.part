rd.setTag("cobra-sports-game:"+game.id);TextView league=cobraText(game.leagueLabel+(game.live()?"  •  LIVE":""),game.live()?0xffff4f64:cobraModeColor("accent"),11);league.setTypeface(Typeface.create("sans-serif-medium",Typeface.BOLD));league.setLetterSpacing(.08f);card.addView(league,new LinearLayout.LayoutParams(-1,dp(24)));LinearLayout marks=new LinearLayout(this);marks.setGravity(Gravity.CENTER_VERTICAL);marks.addView(cobraSportsTeamMark(game.away),new LinearLayout.LayoutParams(dp(34),dp(34)));TextView versus=cobraText("  "+(game.away==null?"Away":game.away.abbreviation)+"   @   "+(game.home==null?"Home":game.home.abbreviation)+"  ",cobraModeColor("text"),16);versus.setTypeface(Typeface.create("sans-serif-medium",Typeface.BOLD));versus.setGravity(Gravity.CENTER);marks.addView(versus,new LinearLayout.LayoutParams(0,dp(38),1));marks.addView(cobraSportsTeamMark(game.home),new LinearLayout.LayoutParams(dp(34),dp(34)));card.addView(marks,new LinearLayout.LayoutParams(-1,dp(42)));TextView score=cobraText(cobraSportsScoreLine(game),cobraModeColor("text"),15);score.setGravity(Gravity.CENTER);score.setTypeface(Typeface.create("sans-serif-medium",Typeface.BOLD));card.addView(score,new LinearLayout.LayoutParams(-1,dp(30)));TextView meta=cobraText(cobraSportsMeta(game),cobraModeColor("muted"),12);meta.setGravity(Gravity.CENTER);meta.setMaxLines(2);card.addView(meta,new LinearLayout.LayoutParams(-1,0,1));card.setContentDescription(cobraSportsMatchup(game)+", "+cobraSportsMeta(game));card.setOnClickListener(v->showCobraSportsGame(game.id));cobraPolishFocusable(card);return card;}
  private View cobraSportsTeamMark(CobraSportsTeam team){FrameLayout frame=new FrameLayout(this);TextView fallback=cobraText(team==null?"?":(team.abbreviation.isEmpty()?team.shortName.substring(0,Math.min(1,team.shortName.length())):team.abbreviation.substring(0,Math.min(3,team.abbreviation.length()))),cobraModeColor("accent"),11);fallback.setGravity(Gravity.CENTER);fallback.setTypeface(Typeface.DEFAULT_BOLD);frame.addView(fallback,new FrameLayout.LayoutParams(-1,-1));if(team!=null&&!team.logo.isEmpty()){android.widget.ImageView image=new android.widget.ImageView(this);image.setScaleType(android.widget.ImageView.ScaleType.CENTER_INSIDE);image.setContentDescription(team.name);frame.addView(image,new FrameLayout.LayoutParams(-1,-1));cobraSportsLoadLogo(team.logo,image);}return frame;}
  private void cobraSportsLoadLogo(String url,android.widget.ImageView view){if(url==null||url.isEmpty()||view==null)return;android.graphics.Bitmap cached=mCobraSportsLogos.get(url);if(cached!=null){view.setImageBitmap(cached);return;}submitCobraIo(()->{HttpURLConnection c=null;try{c=(HttpURLConnection)new URL(url).openConnection();c.setConnectTimeout(4000);c.setReadTimeout(5000);c.setRequestProperty("User-Agent","Cobra-Sports/2103270");InputStream in=c.getInputStream();ByteArrayOutputStream out=new ByteArrayOutputStream();byte[] b=new byte[4096];int n,total=0;while((n=in.read(b))!=-1&&(total+=n)<=1024*1024)out.write(b,0,n);in.close();if(total>1024*1024)return;final android.graphics.Bitmap bitmap=android.graphics.BitmapFactory.decodeByteArray(out.toByteArray(),0,out.size());if(bitmap==null)return;publishCobraUi(()->{mCobraSportsLogos.put(url,bitmap);if(view.isAttachedToWindow())view.setImageBitmap(bitmap);});}catch(Exception ignored){}finally{if(c!=null)c.disconnect();}});}

  private void cobraSportsRefresh(boolean force){if(mCobraSportsLoading)return;long now=System.currentTimeMillis();if(!force&&!mCobraSportsGames.isEmpty()&&now-mCobraSportsLastRefresh<COBRA_SPORTS_STALE_MS){cobraSportsScheduleNext();return;}mCobraSportsLoading=true;cobraSportsRenderCurrent();Set<String> enabled=cobraSportsEnabledLeagues();Set<String> liveLeagues=new HashSet<>();for(CobraSportsGame g:mCobraSportsGames)if(g.live())liveLeagues.add(g.leagueKey);boolean liveTick=!force&&!liveLeagues.isEmpty()&&now-mCobraSportsLastRefresh<COBRA_SPORTS_IDLE_REFRESH_MS;final Set<String> fetch=liveTick?liveLeagues:enabled;final long from=now-86400000L,to=now+8L*86400000L;
    if(!submitCobraIo(()->{ArrayList<CobraSportsGame> fresh=new ArrayList<>();ArrayList<String> failures=new ArrayList<>(),failedKeys=new ArrayList<>();for(CobraSportsLeagueSpec spec:COBRA_SPORTS_SPECS)if(fetch.contains(spec.key)){try{fresh.addAll(mCobraSportsRepository.scoreboard(spec,from,to));}catch(Exception e){failures.add(spec.label);failedKeys.add(spec.key);}}publishCobraUi(()->{Map<String,CobraSportsGame> merged=new LinkedHashMap<>();if(liveTick){for(CobraSportsGame g:mCobraSportsGames)merged.put(g.id,g);}else if(!failedKeys.isEmpty()){for(CobraSportsGame g:mCobraSportsGames)if(failedKeys.contains(g.leagueKey))merged.put(g.id,g);}for(CobraSportsGame g:fresh)merged.put(g.id,g);mCobraSportsGames.clear();mCobraSportsGames.addAll(merged.values());mCobraSportsTeams.clear();for(CobraSportsGame g:mCobraSportsGames){if(g.home!=null)mCobraSportsTeams.put(g.home.key,g.home);if(g.away!=null)mCobraSportsTeams.put(g.away.key,g.away);}mCobraSportsGames.sort(cobraSportsComparator());mCobraSportsLastRefresh=System.currentTimeMillis();mCobraSportsLoading=false;mCobraSportsLastError=failures.isEmpty()?"":("Unavailable leagues: "+android.text.TextUtils.join(", ",failures));cobraSportsRenderCurrent();cobraSportsRefreshMultiOverlays();cobraSportsScheduleNext();});})){mCobraSportsLoading=false;}
  }
  private void cobraSportsScheduleNext(){mMain.removeCallbacks(mCobraSportsTick);if(!cobraSportsVisible())return;boolean live=false;for(CobraSportsGame g:mCobraSportsGames)if(g.live()){live=true;break;}mMain.postDelayed(mCobraSportsTick,live?COBRA_SPORTS_LIVE_REFRESH_MS:COBRA_SPORTS_IDLE_REFRESH_MS);}
  private CobraSportsGame cobraSportsGame(String id){for(CobraSportsGame g:mCobraSportsGames)if(g.id.equals(id))return g;return null;}

  private void showCobraSportsGame(String gameId){CobraSportsGame game=cobraSportsGame(gameId);if(game==null){toast("Game is no longer in the current sports window");showCobraSportsHub();return;}mCobraInternalScreen="internal";clearStage("COBRA • SPORTS • GAME");cobraSportsPrepareHeader();status(game.leagueLabel+" • "+cobraSportsMeta(game));ScrollView scroll=new ScrollView(this);LinearLayout body=ne