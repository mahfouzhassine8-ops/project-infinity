ains("tnt")||text.contains("tbs")||text.contains("nfl")||text.contains("nba")||text.contains("mlb")||text.contains("nhl")||text.contains("football")||text.contains("soccer")||text.contains("basketball")||text.contains("baseball")||text.contains("hockey");if(!likely)continue;ArrayList<GuideProgram> programs=cobraPrograms(c);out.add(new CobraSportsChannelInfo(c,text,programs==null?new ArrayList<>():new ArrayList<>(programs)));if(out.size()>=6000)break;}return out;}
  private static String cobraSportsNorm(String value){if(value==null)return "";String s=value.toLowerCase(Locale.US).replace('&',' ');s=s.replaceAll("[^a-z0-9]+"," ").replaceAll("\\b(?:uhd|fhd|hd|4k|1080p|720p|east|west|us|usa)\\b"," ").replaceAll("\\s+"," ").trim();s=s.replace("espn 2","espn2").replace("espn 3","espn3").replace("fox sports 1","fs1").replace("fox sports 2","fs2").replace("nfl net","nfl network").replace("nba tv","nbatv").replace("mlb tv","mlb network").replace("nhl tv","nhl network");return " "+s+" ";}
  private static boolean cobraSportsContains(String haystack,String needle){String n=cobraSportsNorm(needle).trim();return !n.isEmpty()&&haystack.contains(" "+n+" ");}
  private static boolean cobraSportsTeamHit(String text,CobraSportsTeam team){if(team==null)return false;if(cobraSportsContains(text,team.shortName)||cobraSportsContains(text,team.name))return true;String ab=team.abbreviation==null?"":team.abbreviation.trim();return ab.length()>=3&&cobraSportsContains(text,ab);}
  private ArrayList<CobraSportsMatch> cobraSportsResolve(CobraSportsGame game,List<CobraSportsChannelInfo> channels){ArrayList<CobraSportsMatch> out=new ArrayList<>();if(game==null)return out;for(CobraSportsChannelInfo info:channels){int score=0;ArrayList<String> evidence=new ArrayList<>();boolean network=false;for(String b:game.broadcasts)if(cobraSportsContains(info.text,b)){score=Math.max(score,65);network=true;evidence.add("network "+b);}boolean sports=info.text.contains(" sport ")||info.text.contains(" sports ");GuideProgram best=null;for(GuideProgram p:info.programs){if(p==null)continue;long center=game.startMs;boolean near=center<=0||p.stop>=center-2*3600000L&&p.start<=center+5*3600000L;if(!near)continue;String text=cobraSportsNorm(p.title+" "+p.description);boolean away=cobraSportsTeamHit(text,game.away),home=cobraSportsTeamHit(text,game.home);int ps=0;if(away&&home){ps=100;evidence.add("EPG matchup");}else if(away||home){ps=45;evidence.add("EPG team");}for(String b:game.broadcasts)if(cobraSportsContains(text,b)){ps=Math.max(ps,70);evidence.add("EPG network");}if(ps>score){score=ps;best=p;}else if(ps>=45&&best==null)best=p;}if(network&&sports)score+=5;if(score>=45){CobraSportsMatch match=new CobraSportsMatch();match.channel=info.channel;match.program=best;match.score=Math.min(100,score);match.evidence=android.text.TextUtils.join(" • ",evidence);out.add(match);}}out.sort((a,b)->Integer.compare(b.score,a.score));return out;}
  private boolean cobraSportsUniqueStrong(List<CobraSportsMatch> matches){if(matches==null||matches.isEmpty()||!matches.get(0).strong())return false;return matches.size()==1||matches.get(0).score-matches.get(1).score>=15;}
  private void cobraSportsResolveAsync(CobraSportsGame game,CobraSportsResolverCallback consumer){final ArrayList<CobraSportsChannelInfo> snapshot=cobraSportsChannelSnapshot();toast("Finding available broadcasts…");submitCobraIo(()->{ArrayList<CobraSportsMatch> matches=cobraSportsResolve(game,snapshot);publishCobraUi(()->{String top=matches.isEmpty()?"none":matches.get(0).channel.name+" ("+matches.get(0).score+")";mCobraSportsLastResolver=cobraSportsMatchup(game)+" → "+top;consumer.accept(matches);});});}
  private void cobraSportsWatch(CobraSportsGame game){cobraSportsResolveAsync(game,matches->{if(matches.isEmpty()){toast("No matching channel found in your current providers");return;}if(cobraSportsUniqueStrong(matches)){playChannel(matches.get(0).channel);return;}LinearLayout rows=cobraOpenSheet("Watch on",cobraSportsMatchup(game)+" • choose a broadcast","sports-watch");for(int i=0;i<Math.min(8,matches.size());i++){CobraSportsMatch m=matches.get(i);String confidence=m.score>=70?"Strong match":m.score>=55?"Good match":"Possible match";rows.addView(cobraSheetRow("play",m.channel.name,confidence+(m.evidence.isEmpty()?"":" • "+m.evidence),false,cobraSheetIsDark(),()->playChannel(m.channel)));}});}
  private void cobraSportsRecord(CobraSportsGame game){cobraSportsResolveAsync(game,matches->{CobraSportsMatch best=matches.isEmpty()?null:matches.get(0);if(best==null||!best.strong()){toast("No reliable recordable channel match found");return;}GuideProgram p=best.program;if(p==null){ArrayList<GuideProgram> programs=cobraPrograms(best.channel);if(programs!=null)for(GuideProgram candidate:programs)if(candidate.stop>=game.startMs-3600000L&&candidate.start<=game.startMs+4*3600000L){String text=cobraSportsNorm(candidate.title+" "+candidate.description);if(cobraSportsTeamHit(text,game.home)||cobraSportsTeamHit(text,game.away)){p=candidate;break;}}}if(p==null){toast("No recordable guide event found for this game");return;}showProgramActions(best.channel,p);});}

  private void cobraSportsOpenSmartMultiView(String scope,String focusId){if(mMultiChannels!=null&&mMultiChannels.length>=4){toast("All four Multi-View slots are already pinned");return;}ArrayList<CobraSportsGame> candidates=new ArrayList<>();for(CobraSportsGame g:mCobraSportsGames){if(!g.live())continue;if("myteams".equals(scope)&&!cobraSportsFavoriteGame(g))continue;if(!"live".equals(scope)&&!"myteams".equals(scope)&&!scope.equals(g.leagueKey))continue;candidates.add(g);}candidates.sort((a,b)->{if(focusId!=null){if(focusId.equals(a.id))return -1;if(focusId.equals(b.id))return 1;}boolean af=cobraSportsFavoriteGame(a),bf=cobraSportsFavoriteGame(b);if(af!=bf)return af?-1:1;return Long.compare(a.startMs,b.startMs);});if(candidates.isEmpty()){toast("No live games are available for this Smart Multi-View");return;}final ArrayList<CobraSportsChannelInfo> snapshot=cobraSportsChannelSnapshot();toast("Building Smart Sports Multi-View…");submitCobraIo(()->{LinkedHashMap<String,CobraSportsGame> selected=new LinkedHashMap<>();for(CobraSportsGame g:candidates){Ar