d);}
        }
      }return out;
    }
    @Override public CobraSportsSummary summary(CobraSportsGame game)throws Exception{
      CobraSportsLeagueSpec spec=cobraSportsSpec(game.leagueKey);CobraSportsSummary out=new CobraSportsSummary();if(spec==null)return out;
      JSONObject root=cobraSportsJson(base(spec)+"/summary?event="+URLEncoder.encode(game.id,"UTF-8"));
      JSONObject box=root.optJSONObject("boxscore");JSONArray teams=box==null?null:box.optJSONArray("teams");
      if(teams!=null)for(int i=0;i<teams.length();i++){JSONObject row=teams.optJSONObject(i);JSONObject team=row==null?null:row.optJSONObject("team");String name=team==null?"Team":team.optString("displayName","Team");out.lines.add(name.toUpperCase(Locale.US));JSONArray stats=row==null?null:row.optJSONArray("statistics");
        if(stats!=null)for(int j=0;j<stats.length()&&j<12;j++){JSONObject stat=stats.optJSONObject(j);if(stat==null)continue;String label=stat.optString("label",stat.optString("name","")),value=stat.optString("displayValue","");if(!label.isEmpty()&&!value.isEmpty())out.lines.add(label+"  •  "+value);}
      }
      JSONArray leaders=root.optJSONArray("leaders");if(leaders!=null&&leaders.length()>0){out.lines.add("LEADERS");for(int i=0;i<leaders.length()&&i<8;i++){JSONObject group=leaders.optJSONObject(i);if(group==null)continue;String label=group.optString("displayName",group.optString("name",""));JSONArray ls=group.optJSONArray("leaders");if(ls==null||ls.length()==0)continue;JSONObject lead=ls.optJSONObject(0),ath=lead==null?null:lead.optJSONObject("athlete");String athlete=ath==null?"":ath.optString("displayName","");String value=lead==null?"":lead.optString("displayValue","");if(!label.isEmpty()&&!athlete.isEmpty())out.lines.add(label+"  •  "+athlete+(value.isEmpty()?"":" • "+value));}}
      if(out.lines.isEmpty())out.lines.add("Detailed statistics are not available for this game.");return out;
    }
    @Override public ArrayList<String> standings(CobraSportsLeagueSpec spec)throws Exception{
      JSONObject root=cobraSportsJson("https://site.api.espn.com/apis/v2/sports/"+spec.sport+"/"+spec.league+"/standings");ArrayList<String> out=new ArrayList<>();cobraSportsCollectStandings(root,out,0);if(out.isEmpty())out.add("Standings are not available for this league.");return out;
    }
  }

  private JSONObject cobraSportsJson(String url)throws Exception{
    HttpURLConnection connection=(HttpURLConnection)new URL(url).openConnection();connection.setConnectTimeout(6000);connection.setReadTimeout(8000);connection.setInstanceFollowRedirects(true);connection.setRequestProperty("Accept","application/json");connection.setRequestProperty("Accept-Encoding","gzip");connection.setRequestProperty("User-Agent","Cobra-Sports/2103270");
    try{int status=connection.getResponseCode();if(status<200||status>=300)throw new java.io.IOException("Sports feed HTTP "+status);InputStream raw=new BufferedInputStream(connection.getInputStream());if("gzip".equalsIgnoreCase(connection.getContentEncoding()))raw=new GZIPInputStream(raw);ByteArrayOutputStream out=new ByteArrayOutputStream();byte[] buffer=new byte[8192];int n,total=0;while((n=raw.read(buffer))!=-1){total+=n;if(total>6*1024*1024)throw new java.io.IOException("Sports response too large");out.write(buffer,0,n);}raw.close();return new JSONObject(new String(out.toByteArray(),StandardCharsets.UTF_8));}finally{connection.disconnect();}
  }

  private static CobraSportsLeagueSpec cobraSportsSpec(String key){for(CobraSportsLeagueSpec spec:COBRA_SPORTS_SPECS)if(spec.key.equals(key))return spec;return null;}
  private static long cobraSportsIso(String value){if(value==null||value.isEmpty())return 0L;String[] patterns={"yyyy-MM-dd'T'HH:mmX","yyyy-MM-dd'T'HH:mm:ssX","yyyy-MM-dd'T'HH:mm:ss.SSSX","yyyy-MM-dd'T'HH:mm:ssXXX"};for(String p:patterns)try{SimpleDateFormat f=new SimpleDateFormat(p,Locale.US);f.setTimeZone(TimeZone.getTimeZone("UTC"));Date d=f.parse(value);if(d!=null)return d.getTime();}catch(Exception ignored){}return 0L;}
  private static CobraSportsTeam cobraSportsParseTeam(CobraSportsLeagueSpec spec,JSONObject team,JSONObject competitor){if(team==null)return null;CobraSportsTeam out=new CobraSportsTeam();out.id=team.optString("id","");if(out.id.isEmpty())return null;out.leagueKey=spec.key;out.key=spec.key+"|"+out.id;out.name=team.optString("displayName",team.optString("name","Team"));out.shortName=team.optString("shortDisplayName",team.optString("name",out.name));out.abbreviation=team.optString("abbreviation","");out.logo=team.optString("logo","");if(competitor!=null){out.score=competitor.optString("score","");JSONArray records=competitor.optJSONArray("records");if(records!=null&&records.length()>0){JSONObject rec=records.optJSONObject(0);if(rec!=null)out.record=rec.optString("summary","");}}return out;}
  private static ArrayList<CobraSportsGame> cobraSportsParseScoreboard(CobraSportsLeagueSpec spec,JSONObject root){ArrayList<CobraSportsGame> out=new ArrayList<>();JSONArray events=root==null?null:root.optJSONArray("events");if(events==null)return out;for(int i=0;i<events.length();i++){JSONObject e=events.optJSONObject(i);if(e==null)continue;JSONArray comps=e.optJSONArray("competitions");JSONObject c=comps!=null&&comps.length()>0?comps.optJSONObject(0):null;if(c==null)continue;CobraSportsGame g=new CobraSportsGame();g.id=e.optString("id","");if(g.id.isEmpty())continue;g.leagueKey=spec.key;g.leagueLabel=spec.label;g.sport=spec.sport;g.league=spec.league;g.name=e.optString("name","");g.shortName=e.optString("shortName",g.name);g.startMs=cobraSportsIso(e.optString("date",""));JSONObject status=e.optJSONObject("status"),type=status==null?null:status.optJSONObject("type");g.state=type==null?"pre":type.optString("state","pre");g.detail=type==null?"":type.optString("shortDetail",type.optString("detail",""));g.completed=type!=null&&type.optBoolean("completed",false);JSONObject venue=c.optJSONObject("venue");g.venue=venue==null?"":venue.optString("fullName","");JSONArray competitors=c.optJSONArray("competitors");if(competitors!=null)for(int j=0;j<competitors.length();j++){JSONObject competitor=competitors.optJSONObject(j);JSONObject team=competitor==null?null:competitor.