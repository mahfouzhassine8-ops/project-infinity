w LinearLayout(this);body.setOrientation(LinearLayout.VERTICAL);body.setPadding(dp(4),dp(8),dp(4),dp(28));scroll.addView(body);TextView eyebrow=cobraText(game.leagueLabel+(game.live()?"  •  LIVE":""),game.live()?0xffff4f64:cobraModeColor("accent"),12);eyebrow.setLetterSpacing(.10f);body.addView(eyebrow,new LinearLayout.LayoutParams(-1,dp(30)));LinearLayout hero=new LinearLayout(this);hero.setOrientation(LinearLayout.VERTICAL);hero.setGravity(Gravity.CENTER);hero.setPadding(dp(16),dp(18),dp(16),dp(18));hero.setBackground(cobraPhoneGlass(!cobraModeDark(),24,true));TextView matchup=cobraText(cobraSportsMatchup(game),cobraModeColor("text"),24);matchup.setTypeface(Typeface.create("sans-serif-medium",Typeface.BOLD));matchup.setGravity(Gravity.CENTER);hero.addView(matchup,new LinearLayout.LayoutParams(-1,-2));TextView score=cobraText(cobraSportsScoreLine(game),cobraModeColor("text"),26);score.setTypeface(Typeface.DEFAULT_BOLD);score.setGravity(Gravity.CENTER);hero.addView(score,new LinearLayout.LayoutParams(-1,dp(54)));TextView detail=cobraText(cobraSportsMeta(game)+(game.venue.isEmpty()?"":"\n"+game.venue),cobraModeColor("muted"),14);detail.setGravity(Gravity.CENTER);hero.addView(detail,new LinearLayout.LayoutParams(-1,-2));body.addView(hero,new LinearLayout.LayoutParams(-1,-2));
    LinearLayout actions=new LinearLayout(this);actions.setGravity(Gravity.CENTER);Button watch=cobraTextButton("Watch Live",cobraModeDark(),()->cobraSportsWatch(game));Button multi=cobraTextButton("Multi-View",cobraModeDark(),()->cobraSportsOpenSmartMultiView(game.leagueKey,game.id));Button stats=cobraTextButton("Stats",cobraModeDark(),()->showCobraSportsStats(game));actions.addView(watch,new LinearLayout.LayoutParams(0,dp(54),1));actions.addView(multi,new LinearLayout.LayoutParams(0,dp(54),1));actions.addView(stats,new LinearLayout.LayoutParams(0,dp(54),1));body.addView(actions,new LinearLayout.LayoutParams(-1,dp(58)));
    LinearLayout teams=new LinearLayout(this);teams.setOrientation(LinearLayout.VERTICAL);cobraSportsAddTeamRow(teams,game.away,game.id);cobraSportsAddTeamRow(teams,game.home,game.id);body.addView(teams,new LinearLayout.LayoutParams(-1,-2));Button record=cobraTextButton("Record / Schedule from guide",cobraModeDark(),()->cobraSportsRecord(game));body.addView(record,new LinearLayout.LayoutParams(-1,dp(54)));mStage.addView(scroll,new LinearLayout.LayoutParams(-1,0,1));}
  private void cobraSportsAddTeamRow(LinearLayout parent,CobraSportsTeam team,String gameId){if(team==null)return;String detail=(team.record.isEmpty()?"":team.record+" • ")+(cobraSportsFavorite(team)?"Following":"Tap to follow");cobraAddDetail(parent,"favorite",team.name,detail,"cobra-sports-team:"+team.key,cobraSportsFavorite(team),()->{cobraSportsToggleFavorite(team);showCobraSportsGame(gameId);});}

  private void showCobraSportsLeague(String key){CobraSportsLeagueSpec spec=cobraSportsSpec(key);if(spec==null)return;mCobraInternalScreen="internal";clearStage("COBRA • SPORTS • "+spec.label.toUpperCase(Locale.US));cobraSportsPrepareHeader();ArrayList<CobraSportsGame> games=new ArrayList<>();for(CobraSportsGame g:mCobraSportsGames)if(key.equals(g.leagueKey))games.add(g);games.sort(cobraSportsComparator());status(games.size()+" games in current window");ScrollView scroll=new ScrollView(this);LinearLayout body=new LinearLayout(this);body.setOrientation(LinearLayout.VERTICAL);body.setPadding(dp(2),dp(4),dp(2),dp(30));scroll.addView(body);LinearLayout tools=new LinearLayout(this);Button multi=cobraTextButton("Smart Multi-View",cobraModeDark(),()->cobraSportsOpenSmartMultiView(key,null));Button standings=cobraTextButton("Standings",cobraModeDark(),()->showCobraSportsStandings(key));tools.addView(multi,new LinearLayout.LayoutParams(0,dp(52),1));tools.addView(standings,new LinearLayout.LayoutParams(0,dp(52),1));body.addView(tools,new LinearLayout.LayoutParams(-1,dp(54)));for(CobraSportsGame g:games){LinearLayout row=cobraDetailRow(g.live()?"play":"guide",cobraSportsScoreLine(g),cobraSportsMeta(g),"cobra-sports-league-game:"+g.id,false,()->showCobraSportsGame(g.id));LinearLayout.LayoutParams p=new LinearLayout.LayoutParams(-1,-2);p.topMargin=dp(6);body.addView(row,p);}if(games.isEmpty())cobraInfoText(body,"No games returned for the current sports window.");mStage.addView(scroll,new LinearLayout.LayoutParams(-1,0,1));}

  private void showCobraSportsStats(CobraSportsGame game){LinearLayout rows=cobraOpenSheet("Stats • "+cobraSportsMatchup(game),"Loading game statistics…","sports-stats");TextView loading=cobraText("Loading…",cobraSheetIsDark()?Color.WHITE:cobraModeColor("text"),14);rows.addView(loading,new LinearLayout.LayoutParams(-1,dp(60)));submitCobraIo(()->{try{final CobraSportsSummary summary=mCobraSportsRepository.summary(game);publishCobraUi(()->{if(!"sports-stats".equals(mCobraSheetKind))return;rows.removeAllViews();for(String line:summary.lines)cobraInfoText(rows,line);});}catch(Exception e){publishCobraUi(()->{if(!"sports-stats".equals(mCobraSheetKind))return;rows.removeAllViews();cobraInfoText(rows,"Statistics are unavailable right now.");});}});}
  private void showCobraSportsStandings(String key){CobraSportsLeagueSpec spec=cobraSportsSpec(key);if(spec==null)return;LinearLayout rows=cobraOpenSheet(spec.label+" standings","Loading standings…","sports-standings");cobraInfoText(rows,"Loading…");submitCobraIo(()->{try{final ArrayList<String> lines=mCobraSportsRepository.standings(spec);publishCobraUi(()->{if(!"sports-standings".equals(mCobraSheetKind))return;rows.removeAllViews();for(String line:lines)cobraInfoText(rows,line);});}catch(Exception e){publishCobraUi(()->{if(!"sports-standings".equals(mCobraSheetKind))return;rows.removeAllViews();cobraInfoText(rows,"Standings are unavailable right now.");});}});}

