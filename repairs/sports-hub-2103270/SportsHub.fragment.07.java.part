rayList<CobraSportsMatch> matches=cobraSportsResolve(g,snapshot);if(!cobraSportsUniqueStrong(matches))continue;String id=matches.get(0).channel.id;if(!selected.containsKey(id))selected.put(id,g);if(selected.size()>=4)break;}publishCobraUi(()->cobraSportsLaunchSmartMulti(selected,snapshot));});}
  private void cobraSportsLaunchSmartMulti(LinkedHashMap<String,CobraSportsGame> selected,List<CobraSportsChannelInfo> snapshot){ArrayList<Channel> out=new ArrayList<>();Map<String,CobraSportsGame> assignments=new LinkedHashMap<>();if(mMultiChannels!=null)for(Channel c:mMultiChannels)if(c!=null&&out.size()<4){out.add(c);CobraSportsGame old=mCobraSportsMultiAssignments.get(c.id);if(old!=null)assignments.put(c.id,old);}for(Map.Entry<String,CobraSportsGame> entry:selected.entrySet()){if(out.size()>=4)break;Channel channel=null;for(CobraSportsChannelInfo info:snapshot)if(info.channel.id.equals(entry.getKey())){channel=info.channel;break;}if(channel==null)continue;boolean duplicate=false;for(Channel c:out)if(c.id.equals(channel.id)){duplicate=true;break;}if(!duplicate){out.add(channel);assignments.put(channel.id,entry.getValue());}}if(out.size()<2){if(out.size()==1&&mMultiChannels==null){playChannel(out.get(0));return;}toast("Fewer than two unambiguous live broadcasts were found");return;}mCobraSportsMultiAssignments.clear();mCobraSportsMultiAssignments.putAll(assignments);openMultiView(out);mMain.post(this::cobraSportsRefreshMultiOverlays);}
  private void cobraSportsRefreshMultiOverlays(){if(mCobraTiles==null||mCobraTiles.isEmpty())return;for(CobraVideoTile tile:mCobraTiles.values()){View old=tile.view.findViewWithTag("cobra_sports_multi_overlay");if(old!=null)tile.view.removeView(old);CobraSportsGame g=mCobraSportsMultiAssignments.get(tile.channel.id);if(g==null||!cobraSportsMultiOverlay())continue;TextView label=cobraText(cobraSportsScoreLine(g)+"\n"+(g.live()?"LIVE • ":"")+g.detail,Color.WHITE,11);label.setTag("cobra_sports_multi_overlay");label.setMaxLines(2);label.setPadding(dp(8),dp(5),dp(8),dp(5));label.setBackgroundColor(0xbb07111c);FrameLayout.LayoutParams p=new FrameLayout.LayoutParams(-2,-2,Gravity.LEFT|Gravity.TOP);p.leftMargin=dp(8);p.topMargin=dp(8);tile.view.addView(label,p);}}

  private void showCobraSportsSettings(){LinearLayout rows=cobraOpenSheet("Sports settings","Favorite teams • leagues • spoilers • Multi-View","sports-settings");boolean dark=cobraSheetIsDark();rows.addView(cobraSheetRow("favorite","Favorite teams",cobraSportsFavoriteTeams().size()+" followed",false,dark,()->showCobraSportsFavoriteLeagues()));rows.addView(cobraSheetRow("guide","Enabled leagues",cobraSportsEnabledLeagues().size()+" enabled",false,dark,()->showCobraSportsLeagueSettings()));rows.addView(cobraSheetRow("settings","Hide scores",cobraSportsHideScores()?"On":"Off",cobraSportsHideScores(),dark,()->{mPrefs.edit().putBoolean(COBRA_SPORTS_HIDE_SCORES,!cobraSportsHideScores()).apply();closeCobraActionSheet();showCobraSportsSettings();cobraSportsRenderCurrent();cobraSportsRefreshMultiOverlays();}));rows.addView(cobraSheetRow("multiview","Sports Multi-View overlay",cobraSportsMultiOverlay()?"On":"Off",cobraSportsMultiOverlay(),dark,()->{mPrefs.edit().putBoolean(COBRA_SPORTS_MULTI_OVERLAY,!cobraSportsMultiOverlay()).apply();closeCobraActionSheet();showCobraSportsSettings();cobraSportsRefreshMultiOverlays();}));rows.addView(cobraSheetRow("health","Sports diagnostics","Resolver and data-source status",false,dark,()->showCobraSportsDiagnostics()));}
  private void showCobraSportsLeagueSettings(){LinearLayout rows=cobraOpenSheet("Enabled sports leagues","Tap to enable or disable • at least one remains enabled","sports-leagues");Set<String> enabled=cobraSportsEnabledLeagues();for(CobraSportsLeagueSpec spec:COBRA_SPORTS_SPECS){boolean selected=enabled.contains(spec.key);rows.addView(cobraSheetRow("guide",spec.label,selected?"Enabled":"Disabled",selected,cobraSheetIsDark(),()->{Set<String> next=cobraSportsEnabledLeagues();if(next.contains(spec.key)){if(next.size()==1){toast("Keep at least one league enabled");return;}next.remove(spec.key);}else next.add(spec.key);mPrefs.edit().putStringSet(COBRA_SPORTS_LEAGUES,next).apply();mCobraSportsLastRefresh=0;closeCobraActionSheet();showCobraSportsLeagueSettings();cobraSportsRefresh(true);}));}}
  private void showCobraSportsFavoriteLeagues(){LinearLayout rows=cobraOpenSheet("Favorite teams","Choose a league","sports-favorite-leagues");for(CobraSportsLeagueSpec spec:COBRA_SPORTS_SPECS)if(cobraSportsEnabledLeagues().contains(spec.key)){int count=0;for(String key:cobraSportsFavoriteTeams())if(key.startsWith(spec.key+"|"))count++;final int n=count;rows.addView(cobraSheetRow("favorite",spec.label,n==0?"No teams followed":n+" followed",false,cobraSheetIsDark(),()->cobraSportsLoadTeamPicker(spec)));}}
  private void cobraSportsLoadTeamPicker(CobraSportsLeagueSpec spec){closeCobraActionSheet();LinearLayout rows=cobraOpenSheet("Favorite teams • "+spec.label,"Loading teams…","sports-team-picker");cobraInfoText(rows,"Loading teams…");submitCobraIo(()->{try{final ArrayList<CobraSportsTeam> teams=mCobraSportsRepository.teams(spec);publishCobraUi(()->{if(!"sports-team-picker".equals(mCobraSheetKind))return;rows.removeAllViews();teams.sort((a,b)->a.name.compareToIgnoreCase(b.name));for(CobraSportsTeam team:teams){mCobraSportsTeams.put(team.key,team);boolean selected=cobraSportsFavorite(team);rows.addView(cobraSheetRow("favorite",team.name,selected?"Following":"Tap to follow",selected,cobraSheetIsDark(),()->{cobraSportsToggleFavorite(team);closeCobraActionSheet();cobraSportsLoadTeamPicker(spec);}));}});}catch(Exception e){publishCobraUi(()->{if(!"sports-team-picker".equals(mCobraSheetKind))return;rows.removeAllViews();cobraInfoText(rows,"Could not load teams right now.");});}});}
  private void showCobraSportsDiagnostics(){LinearLayout rows=cobraOpenSheet("Sports diagnostics","Observation only • no provider credentials","sports-diagnostics");int live=0;for(CobraSportsGame g:mCobraSportsGames)if(g.live())live++;String refresh=mCobraSportsLastRefresh==0?"Never":new SimpleDateFormat("MMM d • h:mm:ss a",Locale.US).format(new Date(mCobraSportsLastRefresh));cobraInfoText(rows,"Data repository 