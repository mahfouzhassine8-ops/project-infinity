package @APP_PACKAGE@;

import android.content.Context;
import android.content.Intent;
import android.os.Handler;
import android.os.Looper;
import android.os.SystemClock;
import android.util.AtomicFile;
import java.io.*;
import java.nio.charset.StandardCharsets;
import java.util.UUID;
import java.util.concurrent.*;
import org.json.JSONObject;

/** Kodi writes; the chooser reads. No native load, Activity retention or automatic kill. */
final class InfinityKodiShutdown {
  static final String TOKEN="infinity_kodi_launch_token", OWNER="infinity_kodi_owner_token", PID="infinity_kodi_owner_pid";
  static final String STATE="infinity-kodi-process.json";
  private static final String processToken=UUID.randomUUID().toString();
  private static final long processEpoch=System.currentTimeMillis();
  private static final ExecutorService writes=Executors.newSingleThreadExecutor(r->{Thread t=new Thread(r,"InfinityKodiStatus");t.setDaemon(true);return t;});
  private static final ScheduledExecutorService reads=Executors.newSingleThreadScheduledExecutor(r->{Thread t=new Thread(r,"InfinityChooserStatus");t.setDaemon(true);return t;});
  private static volatile Snapshot cached=Snapshot.empty();
  private static volatile boolean initialized;
  private static String launchToken="";
  private static long closeEpoch;
  interface Listener { void changed(Snapshot state); }
  interface Life { boolean alive(int pid); }
  static final class Snapshot {
    final int pid;final String owner,launch,error;final long began,closeAt;
    final InfinityExitCompletion.Plan.Phase phase;
    final boolean alive,live,complete;
    Snapshot(int pid,String owner,String launch,String error,long began,long closeAt,InfinityExitCompletion.Plan.Phase phase,boolean alive,boolean live,boolean complete){
      this.pid=pid;this.owner=owner;this.launch=launch;this.error=error;this.began=began;this.closeAt=closeAt;this.phase=phase;this.alive=alive;this.live=live;this.complete=complete;
    }
    static Snapshot empty(){return new Snapshot(0,"","","",0,0,InfinityExitCompletion.Plan.Phase.RUNNING,false,false,false);}
    boolean pending(){return alive && phase!=InfinityExitCompletion.Plan.Phase.RUNNING && phase!=InfinityExitCompletion.Plan.Phase.COMPLETE;}
    boolean stalled(){return pending() && closeAt>0 && System.currentTimeMillis()-closeAt>=15000;}
  }
  static Snapshot state(){return cached;}
  static boolean initialized(){return initialized;}
  static boolean pending(){return cached.pending();}
  static boolean live(){return cached.alive&&cached.live&&!cached.pending();}
  static InfinityExitCompletion.Plan.Phase phase(){return cached.phase;}

  static synchronized void publish(Context context,String token){
    if(token!=null&&!token.isEmpty())launchToken=token;
    Main owner=Main.MainActivity;
    InfinityExitCompletion.Plan.Phase phase=owner==null?InfinityExitCompletion.Plan.Phase.RUNNING:owner.mInfinityExitPlan.phase();
    if(owner!=null && owner.isFinishing() && phase==InfinityExitCompletion.Plan.Phase.RUNNING)phase=InfinityExitCompletion.Plan.Phase.WAITING_FOR_STOP;
    if(phase==InfinityExitCompletion.Plan.Phase.RUNNING)closeEpoch=0;
    if(phase!=InfinityExitCompletion.Plan.Phase.RUNNING&&closeEpoch==0)closeEpoch=System.currentTimeMillis();
    write(context,phase,Main.infinityLiveActivity()!=null,"");
  }
  static synchronized void boot(Context context,String token){launchToken=token==null?"":token;write(context,InfinityExitCompletion.Plan.Phase.RUNNING,false,"");}
  static synchronized void failed(Context context,String token,String error){launchToken=token;write(context,InfinityExitCompletion.Plan.Phase.RUNNING,false,error);}
  private static void write(Context context,InfinityExitCompletion.Plan.Phase phase,boolean live,String error){
    final File file=new File(context.getFilesDir(),STATE);
    final JSONObject row=new JSONObject();
    try{
      row.put("schema",1);row.put("pid",android.os.Process.myPid());row.put("owner",processToken);row.put("launch",launchToken);
      row.put("began",processEpoch);row.put("close_at",closeEpoch);row.put("phase",phase.name());row.put("live",live);row.put("error",error);
    }catch(Exception impossible){return;}
    final byte[] bytes=row.toString().getBytes(StandardCharsets.UTF_8);
    writes.execute(()->{AtomicFile atomic=new AtomicFile(file);FileOutputStream out=null;
      try{out=atomic.startWrite();out.write(bytes);atomic.finishWrite(out);}
      catch(IOException failure){if(out!=null)atomic.failWrite(out);}
    });
  }
  static boolean expected(Intent request){return request==null || !request.hasExtra(OWNER) ||
      (request.getIntExtra(PID,-1)==android.os.Process.myPid()&&processToken.equals(request.getStringExtra(OWNER)));}
  static Intent force(Context context,Snapshot state){return new Intent(context,InfinityPowerControlActivity.class)
      .setAction(InfinityExitCompletion.FORCE).putExtra(PID,state.pid).putExtra(OWNER,state.owner);}
  static boolean alive(int pid){
    if(pid<=0)return false;
    try{android.system.Os.kill(pid,0);return true;}
    catch(android.system.ErrnoException e){return e.errno!=android.system.OsConstants.ESRCH;}
  }
  static Snapshot read(File directory,Life life,Snapshot previous)throws Exception{
    File path=new File(directory,STATE);if(!path.exists())return previous;
    byte[] bytes=new AtomicFile(path).readFully();if(bytes.length>8192)throw new IOException("Status too large");
    JSONObject row=new JSONObject(new String(bytes,StandardCharsets.UTF_8));
    if(row.getInt("schema")!=1)throw new IOException("Status schema");
    int pid=row.getInt("pid");String owner=row.getString("owner"),launch=row.optString("launch"),error=row.optString("error");
    long began=row.getLong("began"),closeAt=row.getLong("close_at");
    InfinityExitCompletion.Plan.Phase phase=InfinityExitCompletion.Plan.Phase.valueOf(row.getString("phase"));
    boolean alive=life.alive(pid),complete=false;
    if(phase==InfinityExitCompletion.Plan.Phase.COMPLETE)phase=InfinityExitCompletion.Plan.Phase.DESTROYING;
    if(!alive && closeAt>0 && phase!=InfinityExitCompletion.Plan.Phase.FORCED){
      File receipt=new File(directory,"infinity-native-cleanup.json");
      if(receipt.length()>0&&receipt.length()<4096){
        try(FileInputStream in=new FileInputStream(receipt)){
          byte[] data=new byte[(int)receipt.length()];int at=0,n;while(at<data.length&&(n=in.read(data,at,data.length-at))>0)at+=n;
          JSONObject end=new JSONObject(new String(data,0,at,StandardCharsets.UTF_8));
          complete=end.optInt("pid",-1)==pid && end.optLong("epoch_ms",0)>=Math.max(began,closeAt) &&
              "native.CXBMCApp.Destroy.complete".equals(end.optString("milestone"));
        }catch(Exception unavailable){}
      }
      if(complete)phase=InfinityExitCompletion.Plan.Phase.COMPLETE;
    }
    if(!alive && !complete && error.isEmpty())error=closeAt>0 ? "Kodi ended before cleanup completion could be confirmed. Health Center has the exit evidence." : "Kodi stopped during startup or playback. Open Health Center for the exit evidence.";
    return new Snapshot(pid,owner,launch,error,began,closeAt,phase,alive,alive&&row.optBoolean("live"),complete);
  }
  static final class Watch implements AutoCloseable {
    private volatile boolean closed;private ScheduledFuture<?> task;
    Watch(Context context,Listener listener){
      final File directory=context.getApplicationContext().getFilesDir();final Handler ui=new Handler(Looper.getMainLooper());
      task=reads.scheduleWithFixedDelay(()->{
        if(closed)return;Snapshot next;
        try{next=read(directory,InfinityKodiShutdown::alive,cached);}
        catch(Exception unavailable){next=cached;}
        final Snapshot delivered=next;
        ui.post(()->{if(!closed){cached=delivered;initialized=true;listener.changed(delivered);}});
      },0,250,TimeUnit.MILLISECONDS);
    }
    public void close(){closed=true;if(task!=null)task.cancel(false);}
  }
  private InfinityKodiShutdown(){}
}
