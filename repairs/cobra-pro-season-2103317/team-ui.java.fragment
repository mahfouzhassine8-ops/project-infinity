  static final class TeamRow extends ViewGroup {
    final Logo logo;final Ink name,meta;final Action favorite,chevron;final boolean header,light;
    TeamRow(Context c,boolean light,boolean header){super(c);this.light=light;this.header=header;setBackground(surface(c,light,false,12));setFocusable(true);setClickable(true);logo=new Logo(c,light);name=new Ink(c,light?INK:Color.WHITE,header?21:16,true);meta=new Ink(c,light?MUTED:0xffa9c2d4,header?12:11,false);meta.setSingleLine(false);meta.setMaxLines(header?2:1);favorite=new Action(c,"favorite","",false,light,()->performLongClick());favorite.overlay=true;favorite.setContentDescription("Team preferences");chevron=new Action(c,"right","",false,light,()->performClick());chevron.setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);for(View v:new View[]{favorite,logo,name,meta,chevron})addView(v);}
    void bind(String team,String url,String detail,boolean saved,Art art){logo.bind(team,url,art);name.text(team);meta.text(detail);favorite.setSelected(saved);favorite.setContentDescription((saved?"Remove favorite ":"Favorite ")+team);setContentDescription(team+", "+detail);}
    static int height(Context c,boolean header){return px(c,(header?90:60)+Math.max(0,font(c)-1)*(header?50:30));}
    @Override protected void onMeasure(int ws,int hs){setMeasuredDimension(MeasureSpec.getSize(ws),height(getContext(),header));}
    @Override protected void onLayout(boolean ch,int l,int t,int r,int b){int w=r-l,h=b-t,p=px(getContext(),10),s=px(getContext(),header?64:40),f=px(getContext(),36),x=header?p:p+f;place(logo,x,(h-s)/2,s,s);int tx=x+s+px(getContext(),10),end=w-p-f,nh=px(getContext(),header?29:24),mh=px(getContext(),header?35:20);place(name,tx,(h-nh-mh)/2,Math.max(0,end-tx),nh);place(meta,tx,(h-nh-mh)/2+nh,Math.max(0,end-tx),mh);place(favorite,header?w-p-f:p,(h-f)/2,f,f);place(chevron,w-p-f,(h-f)/2,header?0:f,header?0:f);}
  }
  static final class WeekGameRow extends ViewGroup {
    final Ink date,matchup,score,meta;final Logo away,home;final Action chevron;final Paint p=new Paint(3);final boolean light;
    WeekGameRow(Context c,boolean light){super(c);this.light=light;setWillNotDraw(false);setFocusable(true);setClickable(true);date=new Ink(c,light?MUTED:0xffa9c2d4,11,false);date.setGravity(Gravity.CENTER);away=new Logo(c,light);home=new Logo(c,light);matchup=new Ink(c,light?INK:Color.WHITE,12,true);matchup.setGravity(Gravity.CENTER);score=new Ink(c,light?INK:Color.WHITE,15,true);score.setGravity(Gravity.CENTER);meta=new Ink(c,light?MUTED:0xffa9c2d4,11,false);meta.setGravity(Gravity.CENTER);chevron=new Action(c,"right","",false,light,()->performClick());chevron.setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);for(View v:new View[]{date,away,home,matchup,score,meta,chevron})addView(v);setBackground(surface(c,light,false,0));}
    void bind(SportsGame game,String day,Art art){date.text(day);away.bind(game.away,game.awayLogo,art);home.bind(game.home,game.homeLogo,art);matchup.text(game.awayAbbr+"  @  "+game.homeAbbr);score.text(game.upcoming?game.time:game.score);score.setTextSize(game.upcoming||"Scores hidden".equals(game.score)?11:15);meta.text(game.upcoming?game.network:game.live?"LIVE • "+game.status:"Final");setContentDescription(day+", "+game.away+" at "+game.home+", "+score.getText()+", "+meta.getText());}
    static int height(Context c){return px(c,64+Math.max(0,font(c)-1)*35);}
    @Override protected void onMeasure(int ws,int hs){setMeasuredDimension(MeasureSpec.getSize(ws),height(getContext()));}
    @Override protected void onLayout(boolean ch,int l,int t,int r,int b){int w=r-l,h=b-t,p=px(getContext(),5),s=px(getContext(),30),dw=Math.min(px(getContext(),75),w/5),chev=px(getContext(),24),sc=Math.min(px(getContext(),105),w/3),teamW=Math.max(0,w-dw-sc-chev-2*p);place(date,p,0,dw,h);place(away,dw+p,(h-s)/2,s,s);place(home,dw+teamW-s,(h-s)/2,s,s);place(matchup,dw+p+s+px(getContext(),2),0,Math.max(0,teamW-2*s-px(getContext(),4)),h);place(score,w-sc-chev-p,h/2-px(getContext(),18),sc,px(getContext(),22));place(meta,w-sc-chev-p,h/2+px(getContext(),5),sc,px(getContext(),20));place(chevron,w-chev-p,(h-chev)/2,chev,chev);}
    @Override protected void onDraw(Canvas c){p.setColor(light?0xffcbdfe9:0xff274353);c.drawRect(0,getHeight()-px(getContext(),1),getWidth(),getHeight(),p);}
  }
