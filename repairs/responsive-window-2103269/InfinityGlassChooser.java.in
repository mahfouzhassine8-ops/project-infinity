/** Trusted built-in chooser presentation. No startup, player, JNI or data-store ownership.
 * Art is independent text-free material plates, not a flattened interactive screenshot.
 * All labels, marks, focus, hit areas and controls are independently laid out native Views.
 */
final class InfinityGlassChooser extends FrameLayout {
  interface Actions {
    void enter(String experience);
    void settings(String experience);
    void themes();
    String appearance();
    void appearanceChanged();
  }
  static final int ENTER_INFINITY=0x00f02571, ENTER_COBRA=0x00f02572;
  static final int SETTINGS_INFINITY=0x00f02573, SETTINGS_COBRA=0x00f02574;
  static final int PILL_INFINITY=0x00f02575, PILL_COBRA=0x00f02576;
  private final Actions actions;
  private final String mode;
  final boolean light;
  private final SharedPreferences preferences;
  final FrameLayout content;
  final Stage stage;
  private boolean subscribed, refreshQueued;
  private final Runnable refresh = new Runnable() {
    @Override public void run() {
      refreshQueued=false;
      if (isAttachedToWindow() && !mode.equals(actions.appearance())) actions.appearanceChanged();
    }
  };
  private final SharedPreferences.OnSharedPreferenceChangeListener listener = (prefs,key) -> {
    if (key==null || "cobra_appearance_mode".equals(key) || "cobra_system_dark_variant".equals(key)) requestThemeCheck();
  };
  static int background(boolean light) {return light?0xffeef1f5:0xff041326;}
  InfinityGlassChooser(Context context, Actions actions) {
    super(context);
    this.actions=actions;
    mode=actions.appearance(); light="light".equals(mode);
    preferences=context.getSharedPreferences("infinity_cobra_live",Context.MODE_PRIVATE);
    setBackgroundColor(background(light));
    setTag("infinity_glass_chooser_2103257");
    stage=new Stage(context,light,actions);
    content=new FrameLayout(context) {
      @Override public void scrollTo(int x,int y) { super.scrollTo(0,0); }
      @Override public boolean shouldDelayChildPressedState() { return false; }
      @Override protected void onMeasure(int w,int h) {
        stage.viewportHint=Math.max(0,MeasureSpec.getSize(h)-getPaddingTop()-getPaddingBottom());
        super.onMeasure(w,h);
      }
    };
    content.setClipToPadding(true);content.setClipChildren(true);
    content.setOverScrollMode(OVER_SCROLL_NEVER);
    content.addView(stage,new FrameLayout.LayoutParams(-1,-1));
    addView(content,new FrameLayout.LayoutParams(-1,-1));
  }
  private void requestThemeCheck() {
    if (!refreshQueued) {refreshQueued=true;post(refresh);}
  }
  @Override protected void onAttachedToWindow() {
    super.onAttachedToWindow();
    if (!subscribed) {preferences.registerOnSharedPreferenceChangeListener(listener);subscribed=true;}
    requestThemeCheck();
  }
  @Override protected void onDetachedFromWindow() {
    if(subscribed){preferences.unregisterOnSharedPreferenceChangeListener(listener);subscribed=false;}
    removeCallbacks(refresh);refreshQueued=false;super.onDetachedFromWindow();
  }
  @Override protected void onConfigurationChanged(Configuration config) {
    super.onConfigurationChanged(config);requestThemeCheck();requestLayout();
  }
  void focusEntry(){stage.infinity.requestFocus();}

  private static final class Box {
    final View view; final float x,y,w,h; final boolean minimumTouch;
    Box(View v,float x,float y,float w,float h,boolean touch){view=v;this.x=x;this.y=y;this.w=w;this.h=h;minimumTouch=touch;}
  }
