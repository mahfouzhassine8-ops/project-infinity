        }
      }
    }
    @Override protected void onLayout(boolean changed,int l,int t,int r,int b){
      if(responsive){for(java.util.Map.Entry<View,Rect> item:responsiveBoxes.entrySet()){Rect box=item.getValue();item.getKey().layout(box.left,box.top,box.right,box.bottom);}outline.set(px(2),px(2),getWidth()-px(2),getHeight()-px(2));ring.setStrokeWidth(px(2));return;}
      material.layout(0,0,getWidth(),getHeight());
      for(Box p:parts){int w=p.view.getMeasuredWidth(),h=p.view.getMeasuredHeight();
        int x=Math.round((p.x+p.w/2)*scale-w/2),y=Math.round((p.y+p.h/2)*scale-h/2);
        x=Math.max(0,Math.min(getWidth()-w,x));y=Math.max(0,Math.min(getHeight()-h,y));p.view.layout(x,y,x+w,y+h);
      }
