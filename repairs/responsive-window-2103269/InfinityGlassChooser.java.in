      gear.setNextFocusRightId(cobra?SETTINGS_INFINITY:SETTINGS_COBRA);
      ring.setStyle(Paint.Style.STROKE);ring.setColor(cobra?(light?0xff087797:0xff83e5ff):(light?0xff896018:0xffffdc86));
    }
    private Drawable pillSurface(boolean cobra){
      GradientDrawable shape=new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,new int[]{0xfaffffff,cobra?0xcbb5ebf6:0xcbeedcb2,0xeaffffff});
      shape.setCornerRadius(100);shape.setStroke(2,0xfaffffff);
      return new RippleDrawable(ColorStateList.valueOf(cobra?0x400098cc:0x408c621c),shape,null);
    }
    private void label(String text,float x,float y,float w,float h,float size,boolean serif,int color,float tracking){part(new Label(getContext(),text,size,serif,color,tracking),x,y,w,h,false);}
    private void part(View v,float x,float y,float w,float h,boolean touch){parts.add(new Box(v,x,y,w,h,touch));addView(v);}
    @Override protected void onMeasure(int ws,int hs){
      int w=MeasureSpec.getSize(ws),h=MeasureSpec.getSize(hs);setMeasuredDimension(w,h);scale=w/rw;
      material.setVisibility(responsive?GONE:VISIBLE);
      if(responsive){measureResponsive(w,h);return;}
      setBackground(null);for(Box part:parts){part.view.setVisibility(VISIBLE);if(part.view instanceof Label){((Label)part.view).setText(((Label)part.view).approvedText);((Label)part.view).responsiveSize=0;}}
      material.measure(MeasureSpec.makeMeasureSpec(w,MeasureSpec.EXACTLY),MeasureSpec.makeMeasureSpec(h,MeasureSpec.EXACTLY));
      int min=Math.round(48*getResources().getDisplayMetrics().density);
      for(Box b:parts){
        int bw=Math.round(b.w*scale),bh=Math.round(b.h*scale);
        if(b.minimumTouch){bw=Math.min(w,Math.max(min,bw));bh=Math.min(h,Math.max(min,bh));}
        if(b.view instanceof Label)((Label)b.view).scale=scale;
