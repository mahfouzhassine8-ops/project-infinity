        b.view.measure(MeasureSpec.makeMeasureSpec(Math.max(1,bw),MeasureSpec.EXACTLY),MeasureSpec.makeMeasureSpec(Math.max(1,bh),MeasureSpec.EXACTLY));
      }
    }
    private int px(float v){return Math.round(v*getResources().getDisplayMetrics().density);}
    private void responsivePart(View v,int x,int y,int w,int h){
      Rect r=new Rect(x,y,x+Math.max(1,w),y+Math.max(1,h));responsiveBoxes.put(v,r);
      v.measure(MeasureSpec.makeMeasureSpec(r.width(),MeasureSpec.EXACTLY),MeasureSpec.makeMeasureSpec(r.height(),MeasureSpec.EXACTLY));
    }
    private void measureResponsive(int w,int h){
      responsiveBoxes.clear();
      GradientDrawable glass=new GradientDrawable(GradientDrawable.Orientation.TL_BR,new int[]{light?0xfaffffff:0xff14283a,light?(cobra?0xffd0edf4:0xfff4e7c9):0xff06101c});
      glass.setCornerRadius(px(18));glass.setStroke(px(1),cobra?(light?0xff59b7d0:0xff53cbeb):(light?0xffcead6c:0xffd7ba74));setBackground(glass);
      boolean artwork=h>=px(220)&&w>=px(140);int titleY=h<px(160)?px(8):artwork?px(116):px(68);
      int titleHeight=px(32);int bottom=light?px(56):px(8);
      for(Box part:parts){View v=part.view;v.setVisibility(VISIBLE);
        if(v==gear){gear.visualSize=px(48);responsivePart(v,Math.max(0,w-px(56)),px(8),Math.min(w,px(48)),px(48));}
        else if(v==pill){pill.setText(w<px(180)?"ENTER  ›":pill.approvedText);pill.responsiveSize=14;responsivePart(v,px(8),h-px(56),w-px(h<px(160)?72:16),px(48));}
        else if(v instanceof Mark){if(!artwork){v.setVisibility(GONE);continue;}responsivePart(v,(w-px(96))/2,px(58),px(96),px(48));}
        else if(v instanceof Label){Label label=(Label)v;
          if(label.approvedText.equals("INFINITY")||label.approvedText.equals("COBRA")){label.responsiveSize=18;responsivePart(v,px(8),titleY,w-px(h<px(160)?72:16),titleHeight);}
          else if(h-titleY-titleHeight-bottom>=px(44)){label.responsiveSize=12;responsivePart(v,px(8),titleY+titleHeight,w-px(16),px(40));}
