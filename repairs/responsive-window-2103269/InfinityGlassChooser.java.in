      setOnLongClickListener(v->{actions.themes();return true;});
      infinity.setNextFocusRightId(ENTER_COBRA);cobra.setNextFocusLeftId(ENTER_INFINITY);
      infinity.setNextFocusUpId(SETTINGS_INFINITY);cobra.setNextFocusUpId(SETTINGS_COBRA);
