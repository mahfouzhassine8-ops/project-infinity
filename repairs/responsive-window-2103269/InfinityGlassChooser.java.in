      label("ONE PLATFORM. YOUR WAY.",light?206:263,light?225:214,light?432:422,27,19,false,ink,.17f);
      add(new Material(c,light?"light_orb":"dark_orb",false,light),light?679:679,light?39:32,light?120:192,light?111:135,false);
      label("HM",light?710:730,light?73:69,light?63:91,51,43,true,light?ink:0xffffe4a4,0);
      label(light?"BUILT\nDIFFERENT\nFOR A HIGHER\nEXPERIENCE":"BUILT DIFFERENT\nFOR A HIGHER",
          light?678:680,light?165:174,light?123:199,light?83:49,light?12:15,false,muted,.13f);
      label("CHOOSE YOUR EXPERIENCE",light?59:77,light?330:296,light?722:789,72,light?48:57,true,ink,-.015f);
      if(light)label("ENTERTAINMENT WITHOUT LIMITS",181,404,478,29,16,false,muted,.23f);
      infinity=new Card(c,light,false,actions);cobra=new Card(c,light,true,actions);
      add(infinity,light?29:58,light?474:438,light?385:400,light?670:581,false);
      add(cobra,light?425:482,light?474:438,light?385:403,light?670:581,false);
      label("INFINITY LIVES IN HOW YOU EXPERIENCE IT",light?173:182,light?1283:1135,light?504:578,30,16,false,light?ink:muted,.13f);
      label("ANY SCREEN · YOUR PREFERENCES · ALWAYS WITH YOU",light?109:162,light?1200:1166,light?623:617,29,light?14:15,false,muted,.14f);
      if(light)label("MOVIES  •  SHOWS  •  LIVE TV  •  AND MORE",171,1734,500,29,13,false,muted,.24f);
