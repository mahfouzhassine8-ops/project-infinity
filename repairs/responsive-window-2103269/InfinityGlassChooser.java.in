        responsiveBrand.layout(px(12),px(58),getWidth()-px(12),px(82));
        infinity.layout(infinityBounds.left,infinityBounds.top,infinityBounds.right,infinityBounds.bottom);
        cobra.layout(cobraBounds.left,cobraBounds.top,cobraBounds.right,cobraBounds.bottom);
        infinity.setNextFocusRightId(stacked?SETTINGS_INFINITY:ENTER_COBRA);infinity.setNextFocusDownId(stacked?ENTER_COBRA:SETTINGS_INFINITY);
