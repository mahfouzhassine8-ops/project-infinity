    float scale=1;final float rw,rh; final Paint ring=new Paint(Paint.ANTI_ALIAS_FLAG);final RectF outline=new RectF();
    Card(Context c,boolean light,boolean cobra,Actions actions){
      super(c);this.light=light;this.cobra=cobra;this.actions=actions;rw=light?385:(cobra?403:400);rh=light?670:581;
      setId(cobra?ENTER_COBRA:ENTER_INFINITY);setTag(cobra?"experience-enter-cobra":"experience-enter-infinity");
      setContentDescription(cobra?"Cobra. Control your experience. Open Cobra.":"Infinity. Beyond entertainment. Open Infinity.");
      setFocusable(true);setClickable(true);setWillNotDraw(false);setClipChildren(false);
      setOnClickListener(v->actions.enter(cobra?"live":"infinity"));
      setDescendantFocusability(FOCUS_BEFORE_DESCENDANTS);
      material=new Material(c,(light?"light_":"dark_")+(cobra?"cyan":"gold"),false,light);addView(material);
      int ink=light?0xff071c36:0xfff5f4f1;
      gear=new Gear(c,light,cobra);gear.setId(cobra?SETTINGS_COBRA:SETTINGS_INFINITY);
      gear.setTag(cobra?"experience-settings-cobra":"experience-settings-infinity");
      gear.setContentDescription(cobra?"Cobra settings and recovery":"Infinity settings and Health Center");
      gear.setOnClickListener(v->actions.settings(cobra?"live":"infinity"));
      part(gear,light?245:258,light?30:31,light?112:115,112,true);
      part(new Mark(c,light,cobra?"cyan_mark":"gold_mark"),light?(cobra?48:56):(cobra?61:75),light?(cobra?140:166):(cobra?145:178),light?(cobra?292:279):(cobra?281:244),light?(cobra?188:156):(cobra?169:128),false);
      label(cobra?"COBRA":"INFINITY",20,light?328:320,rw-40,66,light?45:49,true,ink,.04f);
      label(cobra?"CONTROL YOUR\nEXPERIENCE":"BEYOND\nENTERTAINMENT",30,light?423:409,rw-60,57,light?21:22,false,ink,.08f);
      if(light){
        pill=new Label(c,cobra?"ENTER COBRA  ›":"ENTER INFINITY  ›",19,false,ink,.055f);
        pill.setId(cobra?PILL_COBRA:PILL_INFINITY);pill.setTag(cobra?"experience-pill-cobra":"experience-pill-infinity");
        pill.setFocusable(true);pill.setClickable(true);pill.setContentDescription(cobra?"Enter Cobra":"Enter Infinity");
        pill.setBackground(pillSurface(cobra));pill.setOnClickListener(v->actions.enter(cobra?"live":"infinity"));
        part(pill,36,550,rw-72,78,true);pill.setNextFocusUpId(gear.getId());
      }else pill=null;
      gear.setNextFocusDownId(light?pill.getId():getId());
