<?xml version="1.0" encoding="utf-8"?>
<settings version="1">
  <section id="service.infinity.compat">
    <category id="general" label="Infinity Control Center">
      <group id="1">
        <setting id="compat_mode" type="string" label="Compatibility Mode">
          <level>0</level><default>auto</default>
          <constraints><options>
            <option label="Auto (Recommended)">auto</option>
            <option label="Protected">protected</option>
            <option label="System Default">system</option>
            <option label="Safe Mode">safe</option>
          </options></constraints><control type="spinner" format="string"/>
        </setting>
        <setting id="auto_safe_mode" type="boolean" label="Automatic Safe Mode After Repeated Unclean Starts"><level>0</level><default>true</default><control type="toggle"/></setting>
        <setting id="safe_mode_threshold" type="integer" label="Unclean Start Threshold"><level>1</level><default>3</default><constraints><minimum>2</minimum><maximum>5</maximum></constraints><control type="spinner" format="integer"/></setting>
        <setting id="protect_player_ui" type="boolean" label="Protect Infinity Player UI"><level>0</level><default>true</default><control type="toggle"/></setting>
        <setting id="follow_infinity_theme" type="boolean" label="Follow Infinity Light/Dark Theme"><level>0</level><default>true</default><control type="toggle"/></setting>
        <setting id="allow_system_font" type="boolean" label="Allow Infinity System Font"><level>0</level><default>true</default><control type="toggle"/></setting>
        <setting id="health_breadcrumbs" type="boolean" label="Write Health Center Diagnostics"><level>1</level><default>true</default><control type="toggle"/></setting>
      </group>
    </category>
  </section>
</settings>
