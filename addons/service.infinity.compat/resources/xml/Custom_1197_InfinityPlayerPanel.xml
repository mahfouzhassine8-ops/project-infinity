      <texture colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Scrim)]">special://xbmc/addons/skin.estuary/media/white.png</texture>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>34%</width><height>100%</height>
      <texture colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Surface)]">special://xbmc/addons/skin.estuary/media/white.png</texture>
    </control>
    <control type="button" id="9798">
      <left>38</left><top>32</top><width>78</width><height>64</height><label>☰</label>
      <font>font13</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor>
