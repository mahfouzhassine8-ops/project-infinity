<?xml version="1.0" encoding="utf-8"?>
<window>
  <defaultcontrol always="true">602</defaultcontrol>
  <controls>
    <!-- Infinity owns this OSD. The underlying Kodi video surface is never sized here. -->
    <control type="button" id="9000">
      <left>0</left><top>0</top><width>100%</width><height>100%</height>
      <texturefocus colordiffuse="00FFFFFF">special://xbmc/addons/skin.estuary/media/white.png</texturefocus>
      <texturenofocus colordiffuse="00FFFFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus>
      <label></label><onclick>Dialog.Close(VideoOSD)</onclick>
    </control>

    <!-- Bottom scrim follows Infinity palette; same structure in light/dark/OLED. -->
    <control type="image">
      <left>0</left><bottom>0</bottom><width>100%</width><height>300</height>
      <texture colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Scrim)]">special://xbmc/addons/skin.estuary/media/white.png</texture>
    </control>

    <control type="label">
      <left>55</left><right>55</right><bottom>225</bottom><height>46</height>
      <font>font13</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor>
      <label>$INFO[VideoPlayer.Title]</label><scroll>true</scroll>
    </control>

    <control type="progress" id="87">
      <left>55</left><right>55</right><bottom>185</bottom><height>8</height>
      <texturebg colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Border)]">special://xbmc/addons/skin.estuary/media/white.png</texturebg>
      <lefttexture></lefttexture>
      <midtexture colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Accent)]">special://xbmc/addons/skin.estuary/media/white.png</midtexture>
      <righttexture></righttexture><info>Player.Progress</info>
    </control>

    <control type="label">
      <left>55</left><bottom>150</bottom><width>300</width><height>30</height>
      <font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextSecondary)]</textcolor><label>$INFO[Player.Time]</label>
    </control>
    <control type="label">
      <right>55</right><bottom>150</bottom><width>300</width><height>30</height>
      <align>right</align><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextSecondary)]</textcolor><label>$INFO[Player.Duration]</label>
    </control>

    <!-- LARGE/NORMAL LANDSCAPE: subtitles/audio left, transport center, secondary controls right. -->
    <control type="group" id="9100">
      <visible>String.IsEqual(Window(Home).Property(Infinity.Orientation),landscape)</visible>
      <control type="grouplist" id="210">
        <left>55</left><bottom>45</bottom><width>410</width><height>88</height>
        <orientation>horizontal</orientation><itemgap>12</itemgap>
        <control type="button" id="70046"><width>92</width><height>76</height><label>CC</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick>ActivateWindow(osdsubtitlesettings)</onclick></control>
        <control type="button" id="70049"><width>108</width><height>76</height><label>AUDIO</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick>ActivateWindow(osdaudiosettings)</onclick></control>
      </control>

      <control type="grouplist" id="211">
        <left>35%</left><right>35%</right><bottom>45</bottom><height>88</height>
        <orientation>horizontal</orientation><itemgap>14</itemgap><align>center</align>
        <control type="button" id="601"><width>82</width><height>76</height><label>REW</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick condition="Player.Paused">PlayerControl(Play)</onclick><onclick condition="!Player.Paused">PlayerControl(Rewind)</onclick><visible>Player.SeekEnabled</visible></control>
        <control type="button" id="602"><width>100</width><height>80</height><label>PLAY</label><font>font13</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="3319BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick>PlayerControl(Play)</onclick></control>
        <control type="button" id="606"><width>82</width><height>76</height><label>FWD</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick condition="Player.Paused">PlayerControl(Play)</onclick><onclick condition="!Player.Paused">PlayerControl(Forward)</onclick><visible>Player.SeekEnabled</visible></control>
      </control>

      <control type="grouplist" id="212">
        <right>55</right><bottom>45</bottom><width>410</width><height>88</height>
        <orientation>horizontal</orientation><itemgap>12</itemgap><align>right</align>
        <control type="button" id="70043"><width>92</width><height>76</height><label>INFO</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick>Info</onclick></control>
        <control type="button" id="70050"><width>92</width><height>76</height><label>VIDEO</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick>ActivateWindow(osdvideosettings)</onclick></control>
        <control type="button" id="7999"><width>92</width><height>76</height><label>LOCK</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick>Dialog.Close(VideoOSD)</onclick><onclick>ActivateWindow(1199)</onclick></control>
      </control>
    </control>

    <!-- PORTRAIT / compact cover: preserve same ownership and actions, use one centered touch row. -->
    <control type="grouplist" id="220">
      <left>20</left><right>20</right><bottom>45</bottom><height>96</height>
      <orientation>horizontal</orientation><itemgap>8</itemgap><align>center</align>
      <visible>!String.IsEqual(Window(Home).Property(Infinity.Orientation),landscape)</visible>
      <control type="button" id="72046"><width>82</width><height>82</height><label>CC</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick>ActivateWindow(osdsubtitlesettings)</onclick></control>
      <control type="button" id="72049"><width>92</width><height>82</height><label>AUDIO</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick>ActivateWindow(osdaudiosettings)</onclick></control>
      <control type="button" id="72101"><width>82</width><height>82</height><label>REW</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick condition="Player.Paused">PlayerControl(Play)</onclick><onclick condition="!Player.Paused">PlayerControl(Rewind)</onclick></control>
      <control type="button" id="72202"><width>104</width><height>88</height><label>PLAY</label><font>font13</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="3319BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick>PlayerControl(Play)</onclick></control>
      <control type="button" id="72106"><width>82</width><height>82</height><label>FWD</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick condition="Player.Paused">PlayerControl(Play)</onclick><onclick condition="!Player.Paused">PlayerControl(Forward)</onclick></control>
      <control type="button" id="72799"><width>82</width><height>82</height><label>LOCK</label><font>font12</font><textcolor>$INFO[Window(Home).Property(Infinity.Palette.TextPrimary)]</textcolor><focusedcolor>FFFFFFFF</focusedcolor><texturefocus colordiffuse="$INFO[Window(Home).Property(Infinity.Palette.Focus)]">special://xbmc/addons/skin.estuary/media/white.png</texturefocus><texturenofocus colordiffuse="2219BFFF">special://xbmc/addons/skin.estuary/media/white.png</texturenofocus><onclick>Dialog.Close(VideoOSD)</onclick><onclick>ActivateWindow(1199)</onclick></control>
    </control>
  </controls>
</window>
