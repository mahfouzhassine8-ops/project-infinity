{
  "schema": 1,
  "name": "Infinity Cobra Mobile + TV Guide",
  "version": "1.3.6",
  "runtime": {
    "minimum_runtime": 3,
    "scope": "cobra-live-only"
  },
  "protected_contracts": {
    "rotation": "native",
    "fold": "native",
    "background_resume": "native",
    "renderer": "native",
    "provider_playback": "native",
    "infinity_handoff": "native"
  },
  "appearance": {
    "default": "dark",
    "modes": ["system", "light", "dark", "oled"],
    "player_overlay": "dark_high_contrast"
  },
  "performance": {
    "channel_library": "virtualized_recycled_views",
    "warm_start": "last_good_private_cache",
    "refresh": "background_non_blocking",
    "large_library_target": 12000,
    "selection_updates_preview_in_place": true
  },
  "views": {
    "default": "mobile",
    "available": ["mobile", "tv_guide"],
    "mobile": {
      "preview_first": true,
      "preview_aspect": "16:9",
      "preview_controls": ["fullscreen", "play_pause", "favorite", "captions", "volume", "more"],
      "channel_row_height_dp": 70,
      "category_control": "favorites_recent_and_categories_hub",
      "top_tabs": ["favorites", "recently_played"],
      "recently_played_policy": "successful_ready_state_only",
      "startup_preview": "last_successfully_played_channel",
      "bottom_navigation": false,
      "drawer_mode": "push_content",
      "drawer_collapse_control": true,
      "drawer_destinations": ["mobile", "search", "tv", "movies", "shows", "recordings", "my_list", "view_mode", "settings", "power"],
      "channel_primary_action": "preview_then_fullscreen",
      "channel_long_press_action": "context_sheet",
      "context_actions": ["favorite", "schedule_recording", "add_to_group", "share", "channel_epg", "hide_channel"],
      "orientation": {
        "portrait": "preview_tools_virtual_list",
        "landscape": "preview_tools_virtual_list",
        "fold_cover": "single_column_touch_first"
      }
    },
    "tv_guide": {
      "timeline": true,
      "now_marker": true,
      "channel_column": true,
      "favorites_and_groups": true,
      "category_hub_first": true,
      "category_selection_opens_selected_view": true,
      "preview_player": true,
      "preview_controls": true,
      "first_activation": "preview",
      "second_activation": "fullscreen",
      "back_from_fullscreen": "reuse_live_session_in_preview",
      "expanded_grid": true,
      "view_modes": {
        "grid": "orientation_adaptive_timeline",
        "compact": "virtual_dense_list",
        "cards": "responsive_touch_grid",
        "focus": "adaptive_hero_with_virtual_browser"
      },
      "orientation": {
        "portrait_grid": "channel_now_next_list",
        "landscape_grid": "three_slot_timeline",
        "portrait_focus": "hero_plus_vertical_grid",
        "landscape_focus": "hero_left_channel_rail_right"
      },
      "input": ["touch", "dpad"]
    }
  },
  "player": {
    "status_badge": "auto_hide_with_chrome",
    "pip_chrome": "video_only",
    "mini_to_fullscreen": "reuse_exoplayer_session",
    "fullscreen_to_mini": "reuse_exoplayer_session",
    "chrome": "slim_dark_single_control_row",
    "play_pause": "direct_in_mini_and_fullscreen",
    "aspect_control": "always_reachable",
    "aspect_modes": [
      "best_fit",
      "crop_fill",
      "16:9",
      "4:3",
      "wide_1_10",
      "wide_1_25",
      "wide_1_40",
      "short_wide",
      "zoom_1_25",
      "zoom_1_50",
      "zoom_2_00",
      "custom_width_height"
    ]
  },
  "multiview": {
    "entry": "keep_current_video_alive",
    "picker": "docked_category_browser",
    "picker_tabs": ["favorites", "recently_played", "all", "categories"],
    "initial_current_session_reuse": true,
    "maximum_screens": 4,
    "add_screen_control": true,
    "single_view_control": true,
    "remove_screen_control": true,
    "portrait_picker": "video_above_browser_below",
    "landscape_picker": "video_left_browser_right"
  },
  "settings": {
    "subscription_account_status": true,
    "subscription_expiry_from_provider_when_available": true,
    "guide_view_selector_location": "drawer"
  },
  "navigation": {
    "internal_back_returns_to_cobra_root": true,
    "root_back_backgrounds_task": true,
    "intentional_exit_via_power_menu": true
  },
  "presentation": {
    "density": "comfortable",
    "surface_style": "cobra_glass",
    "rounded_surfaces": true,
    "focus_ring": true,
    "drawer_motion_ms": 190,
    "portrait_category_height_dp": 58,
    "guide_channel_width_dp": 152,
    "guide_program_width_dp": 220,
    "guide_row_height_dp": 66,
    "guide_header_height_dp": 52,
    "guide_preview_height_dp": 210,
    "mobile_preview_height_dp": 240,
    "mobile_navigation_height_dp": 0
  }
}
