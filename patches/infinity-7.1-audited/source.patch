+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+
+// The Android/UI thread publishes events; Kodi's main/render thread consumes them.
+// This object owns no Android windows, JNIEnv pointers, Views or player objects.
+class CInfinityBridgeState final
+{
+public:
+  static constexpr int VERSION = 3;
+  static constexpr int MAX_DIMENSION = 32768;
+
+  static uint64_t PackSize(int width, int height)
+  {
+    if (width <= 0 || height <= 0 || width > MAX_DIMENSION || height > MAX_DIMENSION)
+      return 0;
+    return (static_cast<uint64_t>(width) << 32) | static_cast<uint32_t>(height);
+  }
+  static int Width(uint64_t size) { return static_cast<int>(size >> 32); }
+  static int Height(uint64_t size) { return static_cast<int>(size & 0xffffffffu); }
+
+  void SetPlayback(bool hasVideo, bool playing, bool external, float aspect)
+  {
+    // One atomic flags word prevents a stale, separately loaded eligibility flag.
+    unsigned flags = hasVideo ? 1u : 0u;
+    if (hasVideo && playing && !external)
+      flags |= 2u;
+    m_playback.store(flags);
+    m_aspect.store(std::isfinite(aspect) && aspect > 0.0f ? aspect : 16.0f / 9.0f);
+  }
+  bool HasActiveVideo() const { return (m_playback.load() & 1u) != 0; }
+  bool CanEnterPictureInPicture() const { return (m_playback.load() & 2u) != 0; }
+  float VideoAspectRatio() const { return m_aspect.load(); }
+
+  void QueueGeometry(int width, int height)
+  {
+    const uint64_t size = PackSize(width, height);
+    if (size == 0)
+      return; // Never publish transient zero-sized layout or an invalid surface.
+    m_requested.store(size);
+    m_pending.store(true);
+  }
+  void SetSurfaceReady(bool ready)
+  {
+    m_surfaceReady.store(ready);
+    if (!ready)
+      m_committed.store(0);
+    else
+      m_pending.store(true);
+  }
+  bool TakeGeometry(int& width, int& height)
+  {
+    if (!m_surfaceReady.load() || !m_pending.exchange(false))
+      return false;
+    const uint64_t size = m_requested.load();
+    width = Width(size);
+    height = Height(size);
+    return size != 0;
+  }
+  void QueueDisplayModes() { m_displayModesPending.store(true); }
+  bool TakeDisplayModes() { return m_displayModesPending.exchange(false); }
+  void RetryGeometry() { m_pending.store(true); }
+  void CommitGeometry(int width, int height) { m_committed.store(PackSize(width, height)); }
+  int WindowWidth() const
+  {
+    const uint64_t size = m_surfaceReady.load() ? m_committed.load() : 0;
+    return size != 0 ? Width(size) : -1;
+  }
+  int WindowHeight() const
+  {
+    const uint64_t size = m_surfaceReady.load() ? m_committed.load() : 0;
+    return size != 0 ? Height(size) : -1;
+  }
+
+private:
+  std::atomic<unsigned> m_playback{0};
+  std::atomic<float> m_aspect{16.0f / 9.0f};
+  std::atomic<uint64_t> m_requested{0};
+  std::atomic<uint64_t> m_committed{0};
+  std::atomic<bool> m_pending{false};
+  std::atomic<bool> m_surfaceReady{false};
+  std::atomic<bool> m_displayModesPending{false};
+};
