+void CWinSystemAndroid::ApplyInfinityGeometry()
+{
+  auto& state = CXBMCApp::Get().InfinityState();
+  auto* gui = CServiceBroker::GetGUI();
+  state.SetEngineReady(g_application.IsInitialized() && gui && m_android && m_bWindowCreated && m_nativeWindow);
+  int theme = 0, mode = 0;
+  uint64_t themeRevision = 0;
+  if (state.TakeTheme(theme, mode, themeRevision))
+  {
+    auto* home = gui ? gui->GetWindowManager().GetWindow(WINDOW_HOME) : nullptr;
+    if (home)
+    {
+      // Dynamic skin variables consume this property. No skin reload, display-mode
+      // enumeration or playback reset is requested for a color-only change.
+      home->SetProperty("Infinity.SystemTheme", theme == 2 ? "dark" : theme == 1 ? "light" : "unknown");
+      home->SetProperty("Infinity.DeviceMode", (mode & 8) ? "tv" : "mobile");
+      home->SetProperty("Infinity.BridgeVersion", CInfinityBridgeState::VERSION);
+      home->SetProperty("Infinity.ThemeRevision", static_cast<int64_t>(themeRevision));
+      gui->GetWindowManager().MarkDirty();
+      CLog::Log(LOGINFO, "Infinity theme fact applied: mode={} revision={} (no geometry reset)", theme, themeRevision);
+    }
+    else state.RetryTheme();
+  }
+  if (state.TakeDisplayModes())
+  {
+    if (g_application.IsInitialized() && m_android && m_bWindowCreated)
+    {
+      UpdateDisplayModes();
+      state.RetryGeometry();
+    }
+    else
+      state.QueueDisplayModes();
+  }
+  CInfinityBridgeState::Geometry request;
+  if (!state.TakeGeometry(request)) return;
+  const int width = request.Width();
+  const int height = request.Height();
+  if (!g_application.IsInitialized() || !gui || !m_bWindowCreated || !m_nativeWindow)
+  {
+    state.RetryGeometry();
+    return;
+  }
+  auto& graphics = GetGfxContext();
+  const RESOLUTION active = graphics.GetVideoResolution();
+  if (!graphics.IsValidResolution(active))
+  {
+    graphics.SetVideoResolution(RES_DESKTOP, true);
+    state.RetryGeometry();
+    return;
+  }
+  if (m_nativeWindow->GetWidth() == width && m_nativeWindow->GetHeight() == height &&
+      m_nWidth == width && m_nHeight == height &&
+      CDisplaySettings::GetInstance().GetResolutionInfo(active).iWidth == width &&
+      CDisplaySettings::GetInstance().GetResolutionInfo(active).iHeight == height)
+  {
+    state.CommitGeometry(request);
+    return;
+  }
+
+  if (!state.IsCurrent(request)) return; // An intervening surface/mode/size event superseded it.
+  // This runs in Kodi's main/render loop, not in Android's UI callbacks.
+  // Preserve EGL/surface ownership and the physical display mode/refresh-rate identity.
+  if (!m_nativeWindow->SetBuffersGeometry(width, height, 0) ||
+      !ResizeWindow(width, height, -1, -1))
+  {
+    state.RetryGeometry();
+    return;
+  }
+  auto& resolution = CDisplaySettings::GetInstance().GetResolutionInfo(active);
+  resolution.iWidth = width;
+  resolution.iHeight = height;
+  resolution.iSubtitles = static_cast<int>(height * 0.965f);
+  graphics.ResetOverscan(resolution);
+  m_nWidth = width;
+  m_nHeight = height;
+
+  // Kodi's existing path resets graphics/scissors, mouse resolution and GUI layout.
+  // Keep the active resolution enum: do not turn Android fullscreen into RES_WINDOW.
+  graphics.ApplyModeChange(active);
+  gui->GetWindowManager().MarkDirty();
+  if (state.CommitGeometry(request))
+  {
+    if (auto* home = gui->GetWindowManager().GetWindow(WINDOW_HOME))
+    {
+      home->SetProperty("Infinity.CommittedWidth", width);
+      home->SetProperty("Infinity.CommittedHeight", height);
+      home->SetProperty("Infinity.GeometrySequence", static_cast<int64_t>(request.sequence));
+    }
+    CLog::Log(LOGINFO, "Infinity geometry committed: {}x{} generation={} sequence={} (bridge v4)",
+              width, height, request.generation, request.sequence);
+  }
 }
 
