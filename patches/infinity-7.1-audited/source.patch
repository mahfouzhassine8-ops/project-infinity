+package @APP_PACKAGE@;
+
+import android.app.PictureInPictureParams;
+import android.content.pm.PackageManager;
+import android.content.res.Configuration;
+import android.graphics.Rect;
+import android.os.Build;
+import android.util.Log;
+import android.util.Rational;
+import android.view.View;
+
+/** One event-driven adapter. Kodi owns player truth, geometry commits and resume. */
+final class InfinityCoreBridge implements View.OnLayoutChangeListener
+{
+  static final int VERSION = 3;
+  private final Main activity;
+  private final View view;
+  private boolean attached;
+  private boolean resumed;
+  private boolean supported;
+
+  InfinityCoreBridge(Main activity, View view)
+  {
+    this.activity = activity;
+    this.view = view;
+  }
+
+  void attach()
+  {
+    try {
+      if (activity._infinityBridgeVersion() != VERSION) {
+        Log.e("InfinityBridge", "Native/Java contract mismatch; Infinity features disabled");
+        return;
+      }
+    } catch (LinkageError error) {
+      Log.e("InfinityBridge", "Native bridge missing; Infinity features disabled", error);
+      return;
+    }
+    attached = true;
+    Log.i("InfinityBridge", "Source-built JNI contract v3 attached");
+    supported = Build.VERSION.SDK_INT >= 26 &&
+        activity.getPackageManager().hasSystemFeature(PackageManager.FEATURE_PICTURE_IN_PICTURE);
+    view.addOnLayoutChangeListener(this);
+    publishWindow();
+  }
+
+  void detach()
+  {
+    attached = false;
+    resumed = false;
+    view.removeOnLayoutChangeListener(this);
+  }
+
+  void onResume()
+  {
+    resumed = true;
+    onWindowChanged();
+  }
+
+  void onStop()
+  {
+    resumed = false;
+    updatePictureInPictureParams();
+  }
+
+  private void publishWindow()
+  {
+    if (!attached) return;
+    final int night = activity.getResources().getConfiguration().uiMode & Configuration.UI_MODE_NIGHT_MASK;
+    final int theme = night == Configuration.UI_MODE_NIGHT_YES ? 2 :
+                      night == Configuration.UI_MODE_NIGHT_NO ? 1 : 0;
+    final boolean pip = Build.VERSION.SDK_INT >= 26 && activity.isInPictureInPictureMode();
+    final boolean multi = Build.VERSION.SDK_INT >= 24 && activity.isInMultiWindowMode();
+    final int mode = (pip ? 1 : 0) | (multi ? 2 : 0);
+    // Preserve Kodi's TV resolution/GUI-limit policy outside PiP and multi-window.
+    final boolean managed = pip || multi ||
+        !activity.getPackageManager().hasSystemFeature(PackageManager.FEATURE_LEANBACK);
+    activity.infinityPublishWindowSnapshot(view.getWidth(), view.getHeight(), theme, mode, managed);
+    activity._infinitySyncDisplayState();
+  }
+
+  void onWindowChanged()
+  {
+    if (!attached) return;
+    publishWindow();
+    updatePictureInPictureParams();
+    // Actual settled dimensions arrive through onLayoutChange; no timers or polling.
+    view.requestLayout();
+  }
+
+  @Override
+  public void onLayoutChange(View v, int left, int top, int right, int bottom,
+                             int oldLeft, int oldTop, int oldRight, int oldBottom)
+  {
+    if (!attached || (right - left == oldRight - oldLeft && bottom - top == oldBottom - oldTop))
+      return;
+    publishWindow();
+    updatePictureInPictureParams();
+  }
+
+  private boolean eligible()
+  {
+    return attached && resumed && supported && !activity.isFinishing() &&
+        !activity.isDestroyed() && activity._infinityCanEnterPictureInPicture();
+  }
+
+  private PictureInPictureParams params(boolean autoEnter)
+  {
+    float aspect = activity._infinityVideoAspectRatio();
+    if (Float.isNaN(aspect) || Float.isInfinite(aspect) || aspect <= 0) aspect = 16f / 9f;
+    // Platform PiP limits, rather than the foldable display's potentially square aspect.
+    final int numerator = Math.max(4185, Math.min(23900, Math.round(aspect * 10000)));
+    PictureInPictureParams.Builder builder = new PictureInPictureParams.Builder()
+        .setAspectRatio(new Rational(numerator, 10000));
+    Rect source = new Rect();
+    if (view.getGlobalVisibleRect(source) && !source.isEmpty()) builder.setSourceRectHint(source);
+    if (Build.VERSION.SDK_INT >= 31) builder.setAutoEnterEnabled(autoEnter);
+    return builder.build();
+  }
+
+  void updatePictureInPictureParams()
+  {
+    if (!attached || !supported || activity.isFinishing() || activity.isDestroyed()) return;
+    try {
+      activity.setPictureInPictureParams(params(eligible()));
+    } catch (IllegalArgumentException | IllegalStateException | SecurityException error) {
+      Log.w("InfinityBridge", "PiP parameters rejected by Android", error);
+    }
+  }
+
+  void onUserLeaveHint()
+  {
+    if (!eligible() || activity.isInPictureInPictureMode()) return;
+    // Android 12+ receives auto-enter state at playback events, before the Home gesture.
+    // API 26-30 uses the original explicit lifecycle entry path, with a real player gate.
+    if (Build.VERSION.SDK_INT >= 31) return;
+    try {
+      activity.enterPictureInPictureMode(params(false));
+    } catch (IllegalArgumentException | IllegalStateException | SecurityException error) {
+      Log.w("InfinityBridge", "PiP entry rejected by Android", error);
+    }
+  }
+}
