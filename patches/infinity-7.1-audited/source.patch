+void CXBMCApp::InfinitySyncDisplayState()
+{
+  if (m_exiting)
+    return;
+  // Theme and mode facts are independent from settled geometry.
+  m_infinity.SetConfiguration(infinityGetSystemTheme(), infinityGetModeSnapshot());
+  // Read an immutable size snapshot, not Android Views or physical display modes.
+  const uint64_t size = infinityGetWindowSize();
+  m_infinity.QueueGeometry(CInfinityBridgeState::Width(size), CInfinityBridgeState::Height(size));
+}
+
+void CXBMCApp::infinitySyncDisplayStateFromBridge()
+{
+  InfinitySyncDisplayState();
+}
+
+void CXBMCApp::InfinityUpdatePlaybackState(bool stopped)
+{
+  if (stopped || m_exiting)
+    m_infinity.SetPlayback(false, false, false, 16.0f / 9.0f);
+  else
+  {
+    const auto& components = CServiceBroker::GetAppComponents();
+    const auto player = components.GetComponent<CApplicationPlayer>();
+    const bool active = player && player->IsPlaying() && player->HasVideo();
+    m_infinity.SetPlayback(active, active && !player->IsPaused(),
+                          active && player->IsExternalPlaying(),
+                          active ? player->GetRenderAspectRatio() : 16.0f / 9.0f);
+  }
+  // Like Kodi's existing media-session hook, notify Java from playback events.
+  // Java marshals to the UI thread and re-reads current facts; no stale bool payload.
+  infinityNotifyPlaybackChanged();
+}
