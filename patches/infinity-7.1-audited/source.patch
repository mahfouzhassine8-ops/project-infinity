+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <mutex>
+
+// No Views, JNIEnv, surface pointers or player objects cross this boundary.
+// UI/native callbacks publish bounded facts. Only the render owner applies work.
+class CInfinityBridgeState final
+{
+public:
+  static constexpr int VERSION = 4;
+  static constexpr int MAX_DIMENSION = 32768;
+  static constexpr int SNAPSHOT_LENGTH = 16;
+  struct Geometry
+  {
+    uint64_t size{0};
+    uint64_t generation{0};
+    uint64_t sequence{0};
+    int Width() const { return CInfinityBridgeState::Width(size); }
+    int Height() const { return CInfinityBridgeState::Height(size); }
+  };
+
+  static uint64_t PackSize(int width, int height)
+  {
+    if (width <= 0 || height <= 0 || width > MAX_DIMENSION || height > MAX_DIMENSION)
+      return 0;
+    return (static_cast<uint64_t>(width) << 32) | static_cast<uint32_t>(height);
+  }
+  static int Width(uint64_t size) { return static_cast<int>(size >> 32); }
+  static int Height(uint64_t size) { return static_cast<int>(size & 0xffffffffu); }
+
+  void SetPlayback(bool hasVideo, bool playing, bool external, float aspect)
+  {
+    unsigned flags = hasVideo ? 1u : 0u;
+    if (hasVideo && playing && !external) flags |= 2u;
+    m_aspect.store(std::isfinite(aspect) && aspect > 0 ? aspect : 16.0f / 9.0f);
+    m_playback.store(flags);
+  }
+  bool HasActiveVideo() const { return (m_playback.load() & 1u) != 0; }
+  bool CanEnterPictureInPicture() const
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_active && m_engineReady && m_surfaceReady && (m_playback.load() & 2u) != 0;
+  }
+  float VideoAspectRatio() const { return m_aspect.load(); }
+
+  void SetEngineReady(bool ready)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_engineReady = m_active && ready;
+  }
+  void SetSurfaceReady(bool ready)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_active || ready == m_surfaceReady) return;
+    ++m_generation;
+    m_surfaceReady = ready;
+    m_committed = {};
+    if (!ready)
+    {
+      m_requested = {};
+      m_pending = false;
+    }
+    else if (m_requested.size)
+    {
+      // A size published before the first surface can be adopted by that surface.
+      // Destroy invalidates old requests, so this never replays a dead surface's work.
+      m_requested.generation = m_generation;
+      m_pending = true;
+    }
+  }
+  void SetConfiguration(int theme, int mode)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_active) return;
+    const int validTheme = (theme == 1 || theme == 2) ? theme : 0;
+    if (validTheme != m_theme || mode != m_mode)
+    {
+      m_theme = validTheme;
+      m_mode = mode;
+      ++m_themeRevision;
+      m_themePending = true;
+    }
+    const bool managed = (mode & 4) != 0;
+    if (managed != m_managed)
+    {
+      m_managed = managed;
+      ++m_generation;
+      m_requested = {};
+      m_committed = {};
+      m_pending = false;
+    }
+  }
+  void QueueGeometry(int width, int height)
+  {
+    const uint64_t size = PackSize(width, height);
+    if (!size) return;
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_active || !m_managed) return;
+    if (m_requested.size == size && m_requested.generation == m_generation) return;
+    m_requested = {size, m_generation, ++m_sequence};
+    m_pending = true;
+  }
+  bool TakeGeometry(Geometry& request)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_active || !m_engineReady || !m_surfaceReady || !m_managed || !m_pending || !m_requested.size)
+      return false;
+    m_pending = false;
+    request = m_requested;
+    return true;
+  }
+  bool IsCurrent(const Geometry& request) const
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return Current(request);
+  }
+  bool CommitGeometry(const Geometry& request)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!Current(request)) return false;
+    m_committed = request;
+    return true;
+  }
+  void RetryGeometry()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_active && m_managed && m_requested.size) m_pending = true;
+  }
+  int WindowWidth() const
+  {
+    const auto s = Snapshot();
+    return s[4] && s[9] ? static_cast<int>(s[10]) : -1;
+  }
+  int WindowHeight() const
+  {
+    const auto s = Snapshot();
+    return s[4] && s[9] ? static_cast<int>(s[11]) : -1;
+  }
+  bool TakeTheme(int& theme, int& mode, uint64_t& revision)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_active || !m_engineReady || !m_themePending) return false;
+    theme = m_theme; mode = m_mode; revision = m_themeRevision;
+    m_themePending = false;
+    return true;
+  }
+  void RetryTheme()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_active) m_themePending = true;
+  }
+  void QueueDisplayModes() { m_displayModesPending.store(true); }
+  bool TakeDisplayModes() { return m_displayModesPending.exchange(false); }
+  void Shutdown()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_active = m_engineReady = m_surfaceReady = m_pending = m_themePending = false;
+    ++m_generation;
+    m_requested = {}; m_committed = {};
+    m_playback.store(0);
+    m_displayModesPending.store(false);
+  }
+  // ABI v4: version, capabilities, active, engineReady, surfaceReady, generation,
+  // requestedSeq/W/H, committedSeq/W/H, systemTheme, themeRevision, mode, managed.
+  std::array<int64_t, SNAPSHOT_LENGTH> Snapshot() const
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return {{VERSION, 15, m_active, m_engineReady, m_surfaceReady,
+             static_cast<int64_t>(m_generation), static_cast<int64_t>(m_requested.sequence),
+             Width(m_requested.size), Height(m_requested.size),
+             static_cast<int64_t>(m_committed.sequence), Width(m_committed.size), Height(m_committed.size),
+             m_theme, static_cast<int64_t>(m_themeRevision), m_mode, m_managed}};
+  }
+
+private:
+  bool Current(const Geometry& request) const
+  {
+    return m_active && m_engineReady && m_surfaceReady && m_managed && request.size &&
+           request.generation == m_generation && request.sequence == m_requested.sequence;
+  }
+  mutable std::mutex m_mutex;
+  std::atomic<unsigned> m_playback{0};
+  std::atomic<float> m_aspect{16.0f / 9.0f};
+  std::atomic<bool> m_displayModesPending{false};
