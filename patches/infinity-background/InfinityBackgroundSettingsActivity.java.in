package @APP_PACKAGE@;

import android.app.Activity;
import android.app.AlertDialog;
import android.content.Intent;
import android.content.res.Configuration;
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.net.Uri;
import android.os.Bundle;
import android.provider.Settings;
import android.view.Gravity;
import android.view.Window;
import android.view.WindowManager;
import android.widget.Button;
import android.widget.FrameLayout;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.Switch;
import android.widget.TextView;

/** Truthful control surface for Infinity Extended Background Mode. */
public final class InfinityBackgroundSettingsActivity extends Activity {
  private int mBackground;
  private int mPanel;
  private int mPanelSoft;
  private int mText;
  private int mMuted;
  private int mAccent;
  private int mLine;
  private Switch mMaster;
  private TextView mStatus;
  private boolean mRefreshing;

  @Override
  protected void onCreate(Bundle state) {
    super.onCreate(state);
    requestWindowFeature(Window.FEATURE_NO_TITLE);
    getWindow().setFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN,
        WindowManager.LayoutParams.FLAG_FULLSCREEN);
    build();
  }

  @Override
  protected void onResume() {
    super.onResume();
    InfinityExtendedBackgroundService.sync(this);
    refresh();
  }

  @Override
  public void onConfigurationChanged(Configuration configuration) {
    super.onConfigurationChanged(configuration);
    build();
    refresh();
  }

  private int dp(int value) {
    return Math.max(1, Math.round(value * getResources().getDisplayMetrics().density));
  }

  private boolean isLight() {
    int night = getResources().getConfiguration().uiMode & Configuration.UI_MODE_NIGHT_MASK;
    return night == Configuration.UI_MODE_NIGHT_NO;
  }

  private GradientDrawable surface(int fill, int radius, int stroke, int width) {
    GradientDrawable d = new GradientDrawable();
    d.setColor(fill);
    d.setCornerRadius(dp(radius));
    if (width > 0) d.setStroke(dp(width), stroke);
    return d;
  }

  private TextView label(String value, int size, int color) {
    TextView text = new TextView(this);
    text.setText(value);
    text.setTextSize(size);
    text.setTextColor(color);
    text.setGravity(Gravity.CENTER_VERTICAL);
    return text;
  }

  private Button button(String value) {
    Button button = new Button(this);
    button.setText(value);
    button.setTextColor(mText);
    button.setTextSize(14);
    button.setAllCaps(false);
    button.setGravity(Gravity.CENTER);
    button.setBackground(surface(mPanelSoft, 14, mLine, 1));
    return button;
  }

  private void build() {
    boolean light = isLight();
    mBackground = Color.parseColor(light ? "#F2F5F8" : "#06080D");
    mPanel = Color.parseColor(light ? "#FFFFFFFF" : "#FF121822");
    mPanelSoft = Color.parseColor(light ? "#FFE8EEF3" : "#FF16202A");
    mText = Color.parseColor(light ? "#FF111820" : "#FFF2F7FA");
    mMuted = Color.parseColor(light ? "#FF5D6A75" : "#FF93A4B1");
    mAccent = Color.parseColor("#FF12D7E7");
    mLine = Color.parseColor(light ? "#2A101820" : "#4012D7E7");

    FrameLayout root = new FrameLayout(this);
    root.setBackgroundColor(mBackground);
    ScrollView scroll = new ScrollView(this);
    scroll.setFillViewport(true);
    root.addView(scroll, new FrameLayout.LayoutParams(
        FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT));

    LinearLayout outer = new LinearLayout(this);
    outer.setOrientation(LinearLayout.VERTICAL);
    outer.setGravity(Gravity.CENTER_HORIZONTAL);
    outer.setPadding(dp(18), dp(26), dp(18), dp(26));
    scroll.addView(outer, new ScrollView.LayoutParams(
        ScrollView.LayoutParams.MATCH_PARENT, ScrollView.LayoutParams.WRAP_CONTENT));

    LinearLayout panel = new LinearLayout(this);
    panel.setOrientation(LinearLayout.VERTICAL);
    panel.setPadding(dp(22), dp(20), dp(22), dp(22));
    panel.setBackground(surface(mPanel, 22, mLine, 1));
    LinearLayout.LayoutParams panelParams = new LinearLayout.LayoutParams(
        Math.min(getResources().getDisplayMetrics().widthPixels - dp(36), dp(760)),
        LinearLayout.LayoutParams.WRAP_CONTENT);
    outer.addView(panel, panelParams);

    TextView brand = label("∞  INFINITY", 18, mAccent);
    brand.setTypeface(null, Typeface.BOLD);
    panel.addView(brand, new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, dp(42)));

    TextView title = label("Extended Background Mode", 26, mText);
    title.setTypeface(null, Typeface.BOLD);
    panel.addView(title, new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, dp(56)));

    TextView subtitle = label(
        "Keep the current Infinity session eligible to continue while the app is in the background. Android can still stop the app when the system needs to.",
        14, mMuted);
    subtitle.setGravity(Gravity.TOP);
    subtitle.setPadding(0, dp(2), 0, dp(16));
    panel.addView(subtitle, new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT));

    LinearLayout masterCard = new LinearLayout(this);
    masterCard.setOrientation(LinearLayout.HORIZONTAL);
    masterCard.setGravity(Gravity.CENTER_VERTICAL);
    masterCard.setPadding(dp(16), dp(12), dp(16), dp(12));
    masterCard.setBackground(surface(mPanelSoft, 16, mLine, 1));

    LinearLayout masterText = new LinearLayout(this);
    masterText.setOrientation(LinearLayout.VERTICAL);
    TextView masterTitle = label("Extended Background Mode", 17, mText);
    masterTitle.setTypeface(null, Typeface.BOLD);
    TextView masterBody = label("Opt-in foreground session continuity", 13, mMuted);
    masterText.addView(masterTitle, new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, dp(30)));
    masterText.addView(masterBody, new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, dp(24)));
    masterCard.addView(masterText, new LinearLayout.LayoutParams(0, dp(58), 1));

    mMaster = new Switch(this);
    mMaster.setShowText(false);
    mMaster.setOnCheckedChangeListener((view, checked) -> {
      if (mRefreshing) return;
      boolean accepted = InfinityExtendedBackgroundService.setEnabled(this, checked);
      if (!accepted && checked) {
        new AlertDialog.Builder(this)
            .setTitle("Android access required")
            .setMessage("Infinity needs notifications enabled so Android can show the required foreground-service notice and its Turn off control.")
            .setPositiveButton("NOTIFICATION SETTINGS", (d, which) ->
                InfinityExtendedBackgroundService.openNotificationSettings(this))
            .setNegativeButton("Cancel", null)
            .show();
      }
      refresh();
    });
    masterCard.addView(mMaster, new LinearLayout.LayoutParams(dp(70), dp(58)));
    LinearLayout.LayoutParams masterParams = new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, dp(82));
    masterParams.topMargin = dp(12);
    panel.addView(masterCard, masterParams);

    mStatus = label("", 13, mMuted);
    mStatus.setPadding(dp(4), dp(10), dp(4), dp(12));
    panel.addView(mStatus, new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, dp(56)));

    Button manage = button("Battery & Background Access  •  Manage");
    manage.setOnClickListener(v -> openAppSettings());
    panel.addView(manage, rowParams());

    Button notifications = button("Notification Access  •  Manage");
    notifications.setOnClickListener(v ->
        InfinityExtendedBackgroundService.openNotificationSettings(this));
    panel.addView(notifications, rowParams());

    TextView note = label(
        "These Android pages are the controls that can affect how long the system lets Infinity remain alive in the background.",
        13, mMuted);
    note.setGravity(Gravity.TOP);
    note.setPadding(dp(4), dp(10), dp(4), dp(14));
    panel.addView(note, new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT));

    Button close = button("Done");
    close.setOnClickListener(v -> finish());
    panel.addView(close, rowParams());

    setContentView(root);
    refresh();
  }

  private LinearLayout.LayoutParams rowParams() {
    LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(
        LinearLayout.LayoutParams.MATCH_PARENT, dp(54));
    p.bottomMargin = dp(10);
    return p;
  }

  private void refresh() {
    if (mMaster == null || mStatus == null) return;
    boolean enabled = InfinityExtendedBackgroundService.isEnabled(this);
    boolean running = InfinityExtendedBackgroundService.isRunning();
    mRefreshing = true;
    mMaster.setChecked(enabled);
    mRefreshing = false;
    if (running) {
      mStatus.setText("ACTIVE  •  Android foreground service is running");
      mStatus.setTextColor(mAccent);
    } else if (enabled) {
      mStatus.setText("ENABLED  •  Waiting for Android to start the foreground service");
      mStatus.setTextColor(mMuted);
    } else {
      mStatus.setText("OFF");
      mStatus.setTextColor(mMuted);
    }
  }

  private void openAppSettings() {
    try {
      Intent intent = new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
          Uri.parse("package:" + getPackageName()));
      startActivity(intent);
    } catch (RuntimeException error) {
      new AlertDialog.Builder(this)
          .setTitle("Android settings unavailable")
          .setMessage("This device did not expose the app settings page.")
          .setPositiveButton("OK", null)
          .show();
    }
  }
}
