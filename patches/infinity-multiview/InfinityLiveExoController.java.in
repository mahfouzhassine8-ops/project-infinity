package @APP_PACKAGE@;

import android.app.Activity;
import android.content.Intent;
import android.content.res.Configuration;
import android.graphics.Color;
import android.graphics.SurfaceTexture;
import android.graphics.drawable.GradientDrawable;
import android.media.AudioManager;
import android.net.Uri;
import android.os.Build;
import android.view.Gravity;
import android.view.KeyEvent;
import android.view.TextureView;
import android.view.View;
import android.widget.FrameLayout;
import android.widget.LinearLayout;
import android.widget.RelativeLayout;
import android.widget.TextView;

import androidx.media3.common.C;
import androidx.media3.common.MediaItem;
import androidx.media3.common.PlaybackException;
import androidx.media3.common.Player;
import androidx.media3.datasource.DefaultDataSource;
import androidx.media3.datasource.DefaultHttpDataSource;
import androidx.media3.exoplayer.DefaultRenderersFactory;
import androidx.media3.exoplayer.ExoPlayer;
import androidx.media3.exoplayer.source.DefaultMediaSourceFactory;

import org.json.JSONArray;
import org.json.JSONObject;
import java.io.ByteArrayOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.nio.charset.StandardCharsets;
import java.util.HashMap;
import java.util.Iterator;
import java.util.Locale;
import java.util.Map;

/** Infinity-owned Media3 runtime for normal Live TV and two-feed Multi-View. */
public final class InfinityMultiViewController {
  private static final String TAG_SCHEME = "infinity-multiview";
  private static final int ACCENT = Color.rgb(0,184,255), BG = Color.BLACK;
  private final Activity mActivity;
  private final RelativeLayout mHost;
  private final View mKodiView;
  private final AudioManager mAudioManager;
  private RelativeLayout mRoot;
  private LinearLayout mTilesHost;
  private TileView[] mTiles;
  private int mAudioTile;
  private boolean mActive;
  private boolean mChromeVisible = true;
  private LinearLayout mTopBar, mBottomBar;

  InfinityMultiViewController(Activity activity, RelativeLayout host, View kodiView) {
    mActivity=activity; mHost=host; mKodiView=kodiView;
    mAudioManager=(AudioManager)activity.getSystemService(Activity.AUDIO_SERVICE);
  }

  boolean handleIntent(Intent intent) {
    if (intent==null || intent.getData()==null) return false;
    Uri data=intent.getData();
    if (!TAG_SCHEME.equals(data.getScheme())) return false;
    String path=data.getQueryParameter("path");
    if (path==null || path.isEmpty()) { toast("Live TV request is missing"); return true; }
    try { open(readRequest(path)); }
    catch(Exception e) { close(); toast("Could not open Infinity Live TV"); }
    return true;
  }

  void onConfigurationChanged(Configuration c) { if(mActive) layoutTiles(); }

  // A host pause can be caused by Android intent/lifecycle handoff while Live remains visible.
  // Do not destroy Exo here; explicit Back/close/onDestroy owns teardown.
  void onHostPause() { }

  void close() {
    mActive=false;
    if(mTiles!=null) for(TileView t:mTiles) if(t!=null) t.release();
    mTiles=null;
    if(mRoot!=null) try { mHost.removeView(mRoot); } catch(Exception ignored) {}
    mRoot=null; mTilesHost=null; mTopBar=null; mBottomBar=null;
    try { if(mAudioManager!=null) mAudioManager.abandonAudioFocus(null); } catch(Exception ignored) {}
    if(mKodiView!=null) { mKodiView.setVisibility(View.VISIBLE); mKodiView.setFocusable(true); mKodiView.requestFocus(); }
  }

  private void open(Request request) {
    close(); mActive=true; mAudioTile=Math.max(0,Math.min(request.audioTile,request.channels.length-1));
    if(mKodiView!=null) { mKodiView.setFocusable(false); mKodiView.setVisibility(View.INVISIBLE); }
    mRoot=new RelativeLayout(mActivity); mRoot.setBackgroundColor(BG); mRoot.setFocusable(true); mRoot.setFocusableInTouchMode(true); mRoot.setKeepScreenOn(true);
    if(Build.VERSION.SDK_INT>=21) mRoot.setElevation(80f);

    mTilesHost=new LinearLayout(mActivity); mTilesHost.setId(View.generateViewId());
    RelativeLayout.LayoutParams tp=new RelativeLayout.LayoutParams(-1,-1); mRoot.addView(mTilesHost,tp);

    mTopBar=new LinearLayout(mActivity); mTopBar.setGravity(Gravity.CENTER_VERTICAL); mTopBar.setPadding(dp(18),0,dp(18),0); mTopBar.setBackgroundColor(Color.argb(205,8,12,16));
    TextView brand=label("INFINITY  •  LIVE TV",18,Color.WHITE); mTopBar.addView(brand,new LinearLayout.LayoutParams(0,dp(56),1));
    TextView close=button("✕  EXIT"); close.setOnClickListener(v->close()); mTopBar.addView(close,new LinearLayout.LayoutParams(dp(92),dp(42)));
    RelativeLayout.LayoutParams top=new RelativeLayout.LayoutParams(-1,dp(64)); top.addRule(RelativeLayout.ALIGN_PARENT_TOP); mRoot.addView(mTopBar,top);

    mBottomBar=new LinearLayout(mActivity); mBottomBar.setGravity(Gravity.CENTER); mBottomBar.setPadding(dp(10),dp(6),dp(10),dp(6)); mBottomBar.setBackgroundColor(Color.argb(215,8,12,16));
    TextView prev=button("◀  CHANNEL"); TextView fav=button("★  FAVORITE"); TextView guide=button("☰  GUIDE"); TextView multi=button("▦  MULTI-VIEW"); TextView next=button("CHANNEL  ▶");
    fav.setOnClickListener(v->toast("Favorites are managed by Infinity Live"));
    guide.setOnClickListener(v->toast("Back returns to the Infinity Live guide"));
    multi.setOnClickListener(v->toast(request.channels.length>1 ? "Multi-View active • tap a tile to switch audio" : "Choose Multi-View from the Infinity Live guide"));
    prev.setOnClickListener(v->toast("Previous channel • choose from Infinity Live guide"));
    next.setOnClickListener(v->toast("Next channel • choose from Infinity Live guide"));
    for(TextView b:new TextView[]{prev,fav,guide,multi,next}) mBottomBar.addView(b,new LinearLayout.LayoutParams(0,dp(48),1));
    RelativeLayout.LayoutParams bot=new RelativeLayout.LayoutParams(-1,dp(64)); bot.addRule(RelativeLayout.ALIGN_PARENT_BOTTOM); mRoot.addView(mBottomBar,bot);

    mTiles=new TileView[request.channels.length];
    for(int i=0;i<mTiles.length;i++){ mTiles[i]=new TileView(i,request.channels[i]); mTilesHost.addView(mTiles[i]); }
    layoutTiles();
    mRoot.setOnClickListener(v->toggleChrome());
    RelativeLayout.LayoutParams rp=new RelativeLayout.LayoutParams(-1,-1); mHost.addView(mRoot,rp);
    mTiles[mAudioTile].requestFocus(); applyAudio();
  }

  private void toggleChrome(){ mChromeVisible=!mChromeVisible; int vis=mChromeVisible?View.VISIBLE:View.GONE; if(mTopBar!=null)mTopBar.setVisibility(vis); if(mBottomBar!=null)mBottomBar.setVisibility(vis); }

  private void layoutTiles(){
    if(mTilesHost==null||mTiles==null)return;
    boolean split=mTiles.length>1;
    int w=Math.max(mHost.getWidth(),mActivity.getResources().getDisplayMetrics().widthPixels), h=Math.max(mHost.getHeight(),mActivity.getResources().getDisplayMetrics().heightPixels);
    mTilesHost.setOrientation(split && w<h ? LinearLayout.VERTICAL : LinearLayout.HORIZONTAL);
    for(TileView t:mTiles){ LinearLayout.LayoutParams p=(mTilesHost.getOrientation()==LinearLayout.HORIZONTAL)?new LinearLayout.LayoutParams(0,-1,1):new LinearLayout.LayoutParams(-1,0,1); p.setMargins(split?dp(3):0,split?dp(3):0,split?dp(3):0,split?dp(3):0); t.setLayoutParams(p); }
  }

  private void applyAudio(){ if(mTiles==null)return; for(int i=0;i<mTiles.length;i++)mTiles[i].setAudible(i==mAudioTile); }
  private void setAudio(int i){ if(mTiles==null||i<0||i>=mTiles.length)return; mAudioTile=i; applyAudio(); }
  private TextView label(String s,int sp,int color){ TextView v=new TextView(mActivity);v.setText(s);v.setTextSize(sp);v.setTextColor(color);v.setGravity(Gravity.CENTER_VERTICAL);return v; }
  private TextView button(String s){ TextView v=label(s,12,Color.WHITE);v.setGravity(Gravity.CENTER); GradientDrawable d=new GradientDrawable();d.setColor(Color.argb(180,28,35,42));d.setCornerRadius(dp(12));v.setBackground(d);v.setClickable(true);v.setFocusable(true);return v; }
  private int dp(int n){return Math.max(1,Math.round(n*mActivity.getResources().getDisplayMetrics().density));}
  private void toast(String s){android.widget.Toast.makeText(mActivity,s,android.widget.Toast.LENGTH_SHORT).show();}

  private Request readRequest(String path)throws Exception{
    File f=new File(path); if(!f.isFile()||f.length()<=0||f.length()>262144)throw new IllegalArgumentException("bad request");
    byte[] bytes; try(FileInputStream in=new FileInputStream(f);ByteArrayOutputStream out=new ByteArrayOutputStream()){byte[] b=new byte[4096];int n;while((n=in.read(b))!=-1)out.write(b,0,n);bytes=out.toByteArray();} finally {try{f.delete();}catch(Exception ignored){}}
    JSONObject root=new JSONObject(new String(bytes,StandardCharsets.UTF_8)); if(root.optInt("schema",0)!=1)throw new IllegalArgumentException("schema");
    String mode=root.optString("mode",""); if(!"single".equals(mode)&&!"split2".equals(mode))throw new IllegalArgumentException("mode");
    JSONArray a=root.getJSONArray("channels"); int expected="single".equals(mode)?1:2; if(a.length()!=expected)throw new IllegalArgumentException("channel count");
    ChannelSpec[] c=new ChannelSpec[expected]; for(int i=0;i<expected;i++)c[i]=parseChannel(a.getJSONObject(i));
    return new Request(c,root.optInt("audio_tile",0));
  }
  private ChannelSpec parseChannel(JSONObject j)throws Exception{
    String name=j.optString("name","Live channel"),url=j.getString("url"); if(!(url.startsWith("http://")||url.startsWith("https://")||url.startsWith("rtsp://")||url.startsWith("file://")))throw new IllegalArgumentException("scheme");
    HashMap<String,String> h=new HashMap<>();JSONObject o=j.optJSONObject("headers");if(o!=null){Iterator<String> k=o.keys();while(k.hasNext()){String key=k.next(),v=o.optString(key,"");if(!key.isEmpty()&&!v.isEmpty())h.put(key,v);}}return new ChannelSpec(name,url,h);
  }

  private final class TileView extends FrameLayout implements TextureView.SurfaceTextureListener,View.OnClickListener{
    final int index;final ChannelSpec spec;final TextureView texture;final TextView state,title;ExoPlayer player;boolean ready;
    TileView(int i,ChannelSpec s){super(mActivity);index=i;spec=s;setFocusable(true);setFocusableInTouchMode(true);setOnClickListener(this);setBackgroundColor(Color.BLACK);texture=new TextureView(mActivity);texture.setSurfaceTextureListener(this);addView(texture,new FrameLayout.LayoutParams(-1,-1));title=label(s.name,15,Color.WHITE);title.setPadding(dp(14),0,dp(14),0);title.setBackgroundColor(Color.argb(150,0,0,0));addView(title,new FrameLayout.LayoutParams(-1,dp(44),Gravity.BOTTOM));state=label("CONNECTING",11,Color.WHITE);state.setGravity(Gravity.CENTER);state.setBackgroundColor(Color.argb(170,0,0,0));FrameLayout.LayoutParams sp=new FrameLayout.LayoutParams(dp(120),dp(34),Gravity.TOP|Gravity.RIGHT);sp.setMargins(0,dp(76),dp(12),0);addView(state,sp);}
    void setAudible(boolean yes){if(player!=null)try{player.setVolume(yes?1f:0f);}catch(Exception ignored){} if(ready)state.setText(yes?"AUDIO • LIVE":"LIVE");}
    void start(){release();try{DefaultHttpDataSource.Factory http=new DefaultHttpDataSource.Factory().setAllowCrossProtocolRedirects(true).setConnectTimeoutMs(15000).setReadTimeoutMs(20000);HashMap<String,String> headers=new HashMap<>(spec.headers);if(!headers.containsKey("User-Agent"))headers.put("User-Agent","Infinity Live TV/1.0");http.setDefaultRequestProperties(headers);DefaultDataSource.Factory ds=new DefaultDataSource.Factory(mActivity,http);DefaultRenderersFactory rf=new DefaultRenderersFactory(mActivity).setEnableDecoderFallback(true);player=new ExoPlayer.Builder(mActivity,rf).setMediaSourceFactory(new DefaultMediaSourceFactory(ds)).build();player.setAudioAttributes(new androidx.media3.common.AudioAttributes.Builder().setUsage(C.USAGE_MEDIA).setContentType(C.AUDIO_CONTENT_TYPE_MOVIE).build(),false);player.setVideoTextureView(texture);player.addListener(new Player.Listener(){@Override public void onPlaybackStateChanged(int x){if(x==Player.STATE_BUFFERING)state.setText("BUFFERING");else if(x==Player.STATE_READY){ready=true;setAudible(index==mAudioTile);}else if(x==Player.STATE_ENDED)state.setText("ENDED");}@Override public void onPlayerError(PlaybackException e){state.setText(String.format(Locale.US,"VIDEO ERROR %d",e.errorCode));}});MediaItem.Builder item=new MediaItem.Builder().setUri(Uri.parse(spec.url));String lower=spec.url.toLowerCase(Locale.US);if(lower.contains(".m3u8"))item.setMimeType("application/x-mpegURL");else if(lower.contains(".ts"))item.setMimeType("video/mp2t");player.setMediaItem(item.build());player.setVolume(index==mAudioTile?1f:0f);player.prepare();player.play();}catch(Exception e){state.setText("VIDEO ERROR");}}
    void release(){ready=false;if(player!=null){try{player.clearVideoTextureView(texture);}catch(Exception ignored){}try{player.stop();}catch(Exception ignored){}try{player.release();}catch(Exception ignored){}}player=null;}
    @Override public void onSurfaceTextureAvailable(SurfaceTexture s,int w,int h){start();}@Override public void onSurfaceTextureSizeChanged(SurfaceTexture s,int w,int h){}@Override public boolean onSurfaceTextureDestroyed(SurfaceTexture s){release();return true;}@Override public void onSurfaceTextureUpdated(SurfaceTexture s){}
    @Override public void onClick(View v){requestFocus();setAudio(index);toggleChrome();}
  }

  private static final class ChannelSpec{final String name,url;final Map<String,String> headers;ChannelSpec(String n,String u,Map<String,String> h){name=n;url=u;headers=h;}}
  private static final class Request{final ChannelSpec[] channels;final int audioTile;Request(ChannelSpec[] c,int a){channels=c;audioTile=a;}}
}
