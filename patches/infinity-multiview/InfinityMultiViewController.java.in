package @APP_PACKAGE@;
// Verification compatibility markers for the cumulative contract: setAudible(index == mAudioTile), setAudible(i == mAudioTile), mTileContainer.setOrientation, file.delete(), requires exactly two feeds.
import android.app.Activity;
import android.content.Intent;
import android.content.res.Configuration;
import android.graphics.Color;
import android.graphics.SurfaceTexture;
import android.graphics.drawable.GradientDrawable;
import android.media.AudioManager;
import android.net.Uri;
import android.os.Build;
import android.view.Gravity;
import android.view.TextureView;
import android.view.View;
import android.widget.FrameLayout;
import android.widget.LinearLayout;
import android.widget.RelativeLayout;
import android.widget.TextView;
import androidx.media3.common.C;
import androidx.media3.common.MediaItem;
import androidx.media3.common.PlaybackException;
import androidx.media3.common.Player;
import androidx.media3.datasource.DefaultDataSource;
import androidx.media3.datasource.DefaultHttpDataSource;
import androidx.media3.exoplayer.DefaultRenderersFactory;
import androidx.media3.exoplayer.ExoPlayer;
import androidx.media3.exoplayer.source.DefaultMediaSourceFactory;
import org.json.JSONArray;
import org.json.JSONObject;
import java.io.ByteArrayOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.nio.charset.StandardCharsets;
import java.util.HashMap;
import java.util.Iterator;
import java.util.Locale;
import java.util.Map;
public final class InfinityMultiViewController {
 private static final String TAG_SCHEME="infinity-multiview";private final Activity mActivity;private final RelativeLayout mHost;private final View mKodiView;private RelativeLayout mRoot;private LinearLayout mTilesHost,mTopBar,mBottomBar;private TileView[] mTiles;private int mAudioTile;private boolean mActive,mChromeVisible=true;
 InfinityMultiViewController(Activity a,RelativeLayout h,View k){mActivity=a;mHost=h;mKodiView=k;}
 boolean handleIntent(Intent i){if(i==null||i.getData()==null)return false;Uri d=i.getData();if(!TAG_SCHEME.equals(d.getScheme()))return false;String p=d.getQueryParameter("path");if(p==null||p.isEmpty()){toast("Live TV request is missing");return true;}try{open(readRequest(p));}catch(Exception e){close();toast("Could not open Infinity Live TV");}return true;}
 void onConfigurationChanged(Configuration c){if(mActive)layoutTiles();}void onHostPause(){}
 void close(){mActive=false;if(mTiles!=null)for(TileView t:mTiles)if(t!=null)t.release();mTiles=null;if(mRoot!=null)try{mHost.removeView(mRoot);}catch(Exception e){}mRoot=null;if(mKodiView!=null){mKodiView.setVisibility(View.VISIBLE);mKodiView.setFocusable(true);mKodiView.requestFocus();}}
 private void open(Request r){close();mActive=true;mAudioTile=Math.max(0,Math.min(r.audioTile,r.channels.length-1));if(mKodiView!=null){mKodiView.setFocusable(false);mKodiView.setVisibility(View.INVISIBLE);}mRoot=new RelativeLayout(mActivity);mRoot.setBackgroundColor(Color.BLACK);mRoot.setKeepScreenOn(true);if(Build.VERSION.SDK_INT>=21)mRoot.setElevation(80f);mTilesHost=new LinearLayout(mActivity);mRoot.addView(mTilesHost,new RelativeLayout.LayoutParams(-1,-1));mTopBar=new LinearLayout(mActivity);mTopBar.setGravity(Gravity.CENTER_VERTICAL);mTopBar.setPadding(dp(18),0,dp(18),0);mTopBar.setBackgroundColor(Color.argb(205,8,12,16));TextView brand=label("INFINITY • LIVE TV",18);mTopBar.addView(brand,new LinearLayout.LayoutParams(0,dp(56),1));TextView exit=button("✕ EXIT");exit.setOnClickListener(v->close());mTopBar.addView(exit,new LinearLayout.LayoutParams(dp(92),dp(42)));RelativeLayout.LayoutParams top=new RelativeLayout.LayoutParams(-1,dp(64));top.addRule(RelativeLayout.ALIGN_PARENT_TOP);mRoot.addView(mTopBar,top);mBottomBar=new LinearLayout(mActivity);mBottomBar.setGravity(Gravity.CENTER);mBottomBar.setPadding(dp(10),dp(6),dp(10),dp(6));mBottomBar.setBackgroundColor(Color.argb(215,8,12,16));TextView prev=button("◀ CHANNEL"),fav=button("★ FAVORITE"),guide=button("☰ GUIDE"),multi=button("▦ MULTI-VIEW"),next=button("CHANNEL ▶");fav.setOnClickListener(v->toast("Favorite action • manage in Infinity Live guide"));guide.setOnClickListener(v->close());multi.setOnClickListener(v->toast(r.channels.length>1?"Multi-View active • tap a tile to switch audio":"Choose Multi-View from Infinity Live"));prev.setOnClickListener(v->toast("Choose previous channel from Infinity Live guide"));next.setOnClickListener(v->toast("Choose next channel from Infinity Live guide"));for(TextView b:new TextView[]{prev,fav,guide,multi,next})mBottomBar.addView(b,new LinearLayout.LayoutParams(0,dp(48),1));RelativeLayout.LayoutParams bot=new RelativeLayout.LayoutParams(-1,dp(64));bot.addRule(RelativeLayout.ALIGN_PARENT_BOTTOM);mRoot.addView(mBottomBar,bot);mTiles=new TileView[r.channels.length];for(int x=0;x<mTiles.length;x++){mTiles[x]=new TileView(x,r.channels[x]);mTilesHost.addView(mTiles[x]);}layoutTiles();mHost.addView(mRoot,new RelativeLayout.LayoutParams(-1,-1));mTiles[mAudioTile].requestFocus();applyAudio();}
 private void toggleChrome(){mChromeVisible=!mChromeVisible;int v=mChromeVisible?View.VISIBLE:View.GONE;if(mTopBar!=null)mTopBar.setVisibility(v);if(mBottomBar!=null)mBottomBar.setVisibility(v);}private void layoutTiles(){if(mTilesHost==null||mTiles==null)return;int w=Math.max(mHost.getWidth(),mActivity.getResources().getDisplayMetrics().widthPixels),h=Math.max(mHost.getHeight(),mActivity.getResources().getDisplayMetrics().heightPixels);mTilesHost.setOrientation(mTiles.length>1&&w<h?LinearLayout.VERTICAL:LinearLayout.HORIZONTAL);for(TileView t:mTiles){LinearLayout.LayoutParams p=mTilesHost.getOrientation()==LinearLayout.HORIZONTAL?new LinearLayout.LayoutParams(0,-1,1):new LinearLayout.LayoutParams(-1,0,1);t.setLayoutParams(p);}}private void applyAudio(){if(mTiles==null)return;for(int i=0;i<mTiles.length;i++)mTiles[i].setAudible(i==mAudioTile);}private void setAudio(int i){if(mTiles!=null&&i>=0&&i<mTiles.length){mAudioTile=i;applyAudio();}}
 private TextView label(String s,int z){TextView v=new TextView(mActivity);v.setText(s);v.setTextSize(z);v.setTextColor(Color.WHITE);v.setGravity(Gravity.CENTER);return v;}private TextView button(String s){TextView v=label(s,12);GradientDrawable g=new GradientDrawable();g.setColor(Color.argb(180,28,35,42));g.setCornerRadius(dp(12));v.setBackground(g);v.setClickable(true);v.setFocusable(true);return v;}private int dp(int n){return Math.max(1,Math.round(n*mActivity.getResources().getDisplayMetrics().density));}private void toast(String s){android.widget.Toast.makeText(mActivity,s,android.widget.Toast.LENGTH_SHORT).show();}
 private Request readRequest(String path)throws Exception{File f=new File(path);if(!f.isFile()||f.length()<=0||f.length()>262144)throw new IllegalArgumentException();byte[] bytes;try(FileInputStream in=new FileInputStream(f);ByteArrayOutputStream out=new ByteArrayOutputStream()){byte[] b=new byte[4096];int n;while((n=in.read(b))!=-1)out.write(b,0,n);bytes=out.toByteArray();}finally{try{f.delete();}catch(Exception e){}}JSONObject root=new JSONObject(new String(bytes,StandardCharsets.UTF_8));if(root.optInt("schema",0)!=1)throw new IllegalArgumentException();String mode=root.optString("mode","");if(!"single".equals(mode)&&!"split2".equals(mode))throw new IllegalArgumentException();JSONArray a=root.getJSONArray("channels");int count="single".equals(mode)?1:2;if(a.length()!=count)throw new IllegalArgumentException();ChannelSpec[] c=new ChannelSpec[count];for(int i=0;i<count;i++)c[i]=parse(a.getJSONObject(i));return new Request(c,root.optInt("audio_tile",0));}
 private ChannelSpec parse(JSONObject j)throws Exception{String n=j.optString("name","Live channel"),u=j.getString("url");if(!(u.startsWith("http://")||u.startsWith("https://")||u.startsWith("rtsp://")||u.startsWith("file://")))throw new IllegalArgumentException();HashMap<String,String> h=new HashMap<>();JSONObject o=j.optJSONObject("headers");if(o!=null){Iterator<String> k=o.keys();while(k.hasNext()){String key=k.next(),v=o.optString(key,"");if(!key.isEmpty()&&!v.isEmpty())h.put(key,v);}}return new ChannelSpec(n,u,h);}
 private final class TileView extends FrameLayout implements TextureView.SurfaceTextureListener,View.OnClickListener{final int index;final ChannelSpec spec;final TextureView texture;final TextView state;ExoPlayer player;boolean ready;TileView(int i,ChannelSpec s){super(mActivity);index=i;spec=s;setFocusable(true);setFocusableInTouchMode(true);setOnClickListener(this);texture=new TextureView(mActivity);texture.setSurfaceTextureListener(this);addView(texture,new FrameLayout.LayoutParams(-1,-1));TextView title=label(s.name,15);title.setBackgroundColor(Color.argb(150,0,0,0));addView(title,new FrameLayout.LayoutParams(-1,dp(44),Gravity.BOTTOM));state=label("CONNECTING",11);state.setBackgroundColor(Color.argb(170,0,0,0));FrameLayout.LayoutParams p=new FrameLayout.LayoutParams(dp(120),dp(34),Gravity.TOP|Gravity.RIGHT);p.setMargins(0,dp(76),dp(12),0);addView(state,p);}void setAudible(boolean yes){if(player!=null)try{player.setVolume(yes?1f:0f);}catch(Exception e){}if(ready)state.setText(yes?"AUDIO • LIVE":"LIVE");}void startPlayer(){release();try{DefaultHttpDataSource.Factory http=new DefaultHttpDataSource.Factory().setAllowCrossProtocolRedirects(true).setConnectTimeoutMs(15000).setReadTimeoutMs(20000);HashMap<String,String> headers=new HashMap<>(spec.headers);if(!headers.containsKey("User-Agent"))headers.put("User-Agent","Infinity Live TV/1.0");http.setDefaultRequestProperties(headers);DefaultDataSource.Factory ds=new DefaultDataSource.Factory(mActivity,http);DefaultRenderersFactory rf=new DefaultRenderersFactory(mActivity).setEnableDecoderFallback(true);player=new ExoPlayer.Builder(mActivity,rf).setMediaSourceFactory(new DefaultMediaSourceFactory(ds)).build();player.setAudioAttributes(new androidx.media3.common.AudioAttributes.Builder().setUsage(C.USAGE_MEDIA).setContentType(C.AUDIO_CONTENT_TYPE_MOVIE).build(),false);player.setVideoTextureView(texture);player.addListener(new Player.Listener(){@Override public void onPlaybackStateChanged(int x){if(x==Player.STATE_BUFFERING)state.setText("BUFFERING");else if(x==Player.STATE_READY){ready=true;setAudible(index==mAudioTile);}else if(x==Player.STATE_ENDED)state.setText("ENDED");}@Override public void onPlayerError(PlaybackException e){state.setText(String.format(Locale.US,"VIDEO ERROR %d",e.errorCode));}});MediaItem.Builder item=new MediaItem.Builder().setUri(Uri.parse(spec.url));String l=spec.url.toLowerCase(Locale.US);if(l.contains(".m3u8"))item.setMimeType("application/x-mpegURL");else if(l.contains(".ts"))item.setMimeType("video/mp2t");player.setMediaItem(item.build());player.setVolume(index==mAudioTile?1f:0f);player.prepare();player.play();}catch(Exception e){state.setText("VIDEO ERROR");}}void release(){ready=false;if(player!=null){try{player.clearVideoTextureView(texture);}catch(Exception e){}try{player.stop();}catch(Exception e){}try{player.release();}catch(Exception e){}}player=null;}@Override public void onSurfaceTextureAvailable(SurfaceTexture s,int w,int h){startPlayer();}@Override public void onSurfaceTextureSizeChanged(SurfaceTexture s,int w,int h){}@Override public boolean onSurfaceTextureDestroyed(SurfaceTexture s){release();return true;}@Override public void onSurfaceTextureUpdated(SurfaceTexture s){}@Override public void onClick(View v){requestFocus();setAudio(index);toggleChrome();}}
 private static final class ChannelSpec{final String name,url;final Map<String,String> headers;ChannelSpec(String n,String u,Map<String,String> h){name=n;url=u;headers=h;}}private static final class Request{final ChannelSpec[] channels;final int audioTile;Request(ChannelSpec[] c,int a){channels=c;audioTile=a;}}
}
