package @APP_PACKAGE@;

import android.app.Activity;
import android.content.Intent;
import android.content.res.Configuration;
import android.graphics.Color;
import android.graphics.SurfaceTexture;
import android.graphics.drawable.GradientDrawable;
import android.media.AudioManager;
import android.net.Uri;
import android.os.Build;
import android.view.Gravity;
import android.view.KeyEvent;
import android.view.TextureView;
import android.view.View;
import android.widget.FrameLayout;
import android.widget.LinearLayout;
import android.widget.RelativeLayout;
import android.widget.TextView;

import androidx.media3.common.C;
import androidx.media3.common.MediaItem;
import androidx.media3.common.PlaybackException;
import androidx.media3.common.Player;
import androidx.media3.datasource.DefaultDataSource;
import androidx.media3.datasource.DefaultHttpDataSource;
import androidx.media3.exoplayer.DefaultRenderersFactory;
import androidx.media3.exoplayer.ExoPlayer;
import androidx.media3.exoplayer.source.DefaultMediaSourceFactory;

import org.json.JSONArray;
import org.json.JSONObject;

import java.io.ByteArrayOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.nio.charset.StandardCharsets;
import java.util.HashMap;
import java.util.Iterator;
import java.util.Locale;
import java.util.Map;

/**
 * Infinity-owned two-feed Live TV runtime.
 *
 * Live TV is intentionally a separate playback branch. Kodi's normal
 * CApplicationPlayer remains untouched; each Live TV tile owns one Media3
 * ExoPlayer and one TextureView. Only the focused tile is audible.
 */
public final class InfinityMultiViewController
{
  private static final String TAG_SCHEME = "infinity-multiview";
  private static final int ACCENT = Color.rgb(0, 184, 255);
  private static final int BG = Color.rgb(0, 0, 0);
  private static final int PANEL = Color.rgb(12, 20, 27);
  private static final int MUTED = Color.rgb(171, 192, 207);
  private static final int ERROR = Color.rgb(255, 98, 90);

  private final Activity mActivity;
  private final RelativeLayout mHost;
  private final View mKodiView;
  private final AudioManager mAudioManager;
  private final AudioManager.OnAudioFocusChangeListener mAudioFocusListener;

  private MultiViewRoot mRoot;
  private LinearLayout mTileContainer;
  private TileView[] mTiles;
  private int mAudioTile = 0;
  private boolean mActive = false;

  InfinityMultiViewController(Activity activity, RelativeLayout host, View kodiView)
  {
    mActivity = activity;
    mHost = host;
    mKodiView = kodiView;
    mAudioManager = (AudioManager) activity.getSystemService(Activity.AUDIO_SERVICE);
    mAudioFocusListener = focusChange -> {
      if (focusChange == AudioManager.AUDIOFOCUS_LOSS
          || focusChange == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT
          || focusChange == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT_CAN_DUCK)
      {
        muteAll();
      }
      else if (focusChange == AudioManager.AUDIOFOCUS_GAIN)
      {
        applyAudioOwner();
      }
    };
  }

  boolean handleIntent(Intent intent)
  {
    if (intent == null || intent.getData() == null)
      return false;
    final Uri data = intent.getData();
    if (!TAG_SCHEME.equals(data.getScheme()))
      return false;

    final String requestPath = data.getQueryParameter("path");
    if (requestPath == null || requestPath.isEmpty())
    {
      showMessage("Live TV request is missing");
      return true;
    }

    try
    {
      final Request request = readRequest(requestPath);
      open(request);
    }
    catch (Exception exc)
    {
      close();
      showMessage("Could not open Live TV");
    }
    return true;
  }

  void onConfigurationChanged(Configuration configuration)
  {
    if (mActive)
      updateOrientation();
  }

  void onHostPause()
  {
    // Never leave provider decoders or audio running behind Infinity.
    if (mActive)
      close();
  }

  void close()
  {
    mActive = false;
    if (mTiles != null)
    {
      for (TileView tile : mTiles)
      {
        if (tile != null)
          tile.release();
      }
    }
    mTiles = null;

    if (mRoot != null)
    {
      try
      {
        mHost.removeView(mRoot);
      }
      catch (Exception ignored)
      {
      }
    }
    mRoot = null;
    mTileContainer = null;

    try
    {
      if (mAudioManager != null)
        mAudioManager.abandonAudioFocus(mAudioFocusListener);
    }
    catch (Exception ignored)
    {
    }

    if (mKodiView != null)
    {
      mKodiView.setFocusable(true);
      mKodiView.requestFocus();
    }
  }

  private void open(Request request)
  {
    close();
    mAudioTile = request.audioTile == 1 ? 1 : 0;
    mActive = true;

    try
    {
      if (mAudioManager != null)
      {
        mAudioManager.requestAudioFocus(
            mAudioFocusListener,
            AudioManager.STREAM_MUSIC,
            AudioManager.AUDIOFOCUS_GAIN);
      }
    }
    catch (Exception ignored)
    {
    }

    mRoot = new MultiViewRoot();
    mRoot.setOrientation(LinearLayout.VERTICAL);
    mRoot.setBackgroundColor(BG);
    mRoot.setFocusable(true);
    mRoot.setFocusableInTouchMode(true);
    mRoot.setKeepScreenOn(true);
    if (Build.VERSION.SDK_INT >= 21)
      mRoot.setElevation(50.0f);

    final TextView header = text("INFINITY  •  LIVE TV", Color.WHITE, 18, Gravity.CENTER_VERTICAL);
    header.setPadding(dp(20), 0, dp(20), 0);
    mRoot.addView(header, new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(56)));

    mTileContainer = new LinearLayout(mActivity);
    mTileContainer.setBackgroundColor(BG);
    mRoot.addView(mTileContainer, new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, 0, 1.0f));

    final TextView footer = text(
        "D-pad: choose feed    •    OK/tap: hear focused feed    •    Back: return to Infinity Live TV",
        MUTED, 13, Gravity.CENTER);
    footer.setPadding(dp(12), 0, dp(12), 0);
    mRoot.addView(footer, new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(48)));

    mTiles = new TileView[] {
        new TileView(0, request.channels[0]),
        new TileView(1, request.channels[1])
    };
    mTileContainer.addView(mTiles[0]);
    mTileContainer.addView(mTiles[1]);
    updateOrientation();

    final RelativeLayout.LayoutParams params = new RelativeLayout.LayoutParams(
        RelativeLayout.LayoutParams.MATCH_PARENT,
        RelativeLayout.LayoutParams.MATCH_PARENT);
    mHost.addView(mRoot, params);
    if (mKodiView != null)
      mKodiView.setFocusable(false);
    mTiles[mAudioTile].requestFocus();
    applyAudioOwner();
  }

  private void updateOrientation()
  {
    if (mTileContainer == null || mTiles == null)
      return;
    final int width = Math.max(mHost.getWidth(), mActivity.getResources().getDisplayMetrics().widthPixels);
    final int height = Math.max(mHost.getHeight(), mActivity.getResources().getDisplayMetrics().heightPixels);
    final boolean sideBySide = width >= height;
    mTileContainer.setOrientation(sideBySide ? LinearLayout.HORIZONTAL : LinearLayout.VERTICAL);
    for (TileView tile : mTiles)
    {
      final LinearLayout.LayoutParams params = sideBySide
          ? new LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.MATCH_PARENT, 1.0f)
          : new LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, 0, 1.0f);
      params.setMargins(dp(4), dp(4), dp(4), dp(4));
      tile.setLayoutParams(params);
    }
  }

  private void setAudioTile(int index)
  {
    if (index < 0 || index > 1 || mTiles == null)
      return;
    mAudioTile = index;
    applyAudioOwner();
  }

  private void muteAll()
  {
    if (mTiles == null)
      return;
    for (TileView tile : mTiles)
    {
      if (tile != null)
        tile.setAudible(false);
    }
  }

  private void applyAudioOwner()
  {
    if (mTiles == null)
      return;
    for (int i = 0; i < mTiles.length; ++i)
    {
      if (mTiles[i] != null)
      {
        mTiles[i].setAudible(i == mAudioTile);
        mTiles[i].updateChrome();
      }
    }
  }

  private TextView text(String value, int color, int sp, int gravity)
  {
    final TextView view = new TextView(mActivity);
    view.setText(value);
    view.setTextColor(color);
    view.setTextSize(sp);
    view.setGravity(gravity);
    return view;
  }

  private int dp(int value)
  {
    return Math.max(1, Math.round(value * mActivity.getResources().getDisplayMetrics().density));
  }

  private void showMessage(String message)
  {
    android.widget.Toast.makeText(mActivity, message, android.widget.Toast.LENGTH_LONG).show();
  }

  private Request readRequest(String path) throws Exception
  {
    final File file = new File(path);
    if (!file.isFile() || file.length() <= 0 || file.length() > 256 * 1024)
      throw new IllegalArgumentException("Invalid Live TV request file");

    final byte[] bytes;
    try (FileInputStream input = new FileInputStream(file); ByteArrayOutputStream out = new ByteArrayOutputStream())
    {
      final byte[] buffer = new byte[4096];
      int read;
      while ((read = input.read(buffer)) != -1)
      {
        if (out.size() + read > 256 * 1024)
          throw new IllegalArgumentException("Live TV request too large");
        out.write(buffer, 0, read);
      }
      bytes = out.toByteArray();
    }
    finally
    {
      // Provider URLs and headers are one-shot and must not remain on disk.
      try
      {
        file.delete();
      }
      catch (Exception ignored)
      {
      }
    }

    final JSONObject root = new JSONObject(new String(bytes, StandardCharsets.UTF_8));
    if (root.optInt("schema", 0) != 1 || !"split2".equals(root.optString("mode", "")))
      throw new IllegalArgumentException("Unsupported Live TV request schema");
    final JSONArray channels = root.getJSONArray("channels");
    if (channels.length() != 2)
      throw new IllegalArgumentException("Infinity Live TV requires exactly two feeds");

    final ChannelSpec[] specs = new ChannelSpec[] {
        parseChannel(channels.getJSONObject(0)),
        parseChannel(channels.getJSONObject(1))
    };
    return new Request(specs, root.optInt("audio_tile", 0));
  }

  private ChannelSpec parseChannel(JSONObject json) throws Exception
  {
    final String name = json.optString("name", "Live channel");
    final String url = json.getString("url");
    if (!(url.startsWith("http://") || url.startsWith("https://")
        || url.startsWith("rtsp://") || url.startsWith("file://")))
      throw new IllegalArgumentException("Unsupported Live TV stream scheme");

    final HashMap<String, String> headers = new HashMap<>();
    final JSONObject object = json.optJSONObject("headers");
    if (object != null)
    {
      final Iterator<String> keys = object.keys();
      while (keys.hasNext())
      {
        final String key = keys.next();
        final String value = object.optString(key, "");
        if (!key.isEmpty() && !value.isEmpty() && key.length() <= 128 && value.length() <= 4096)
          headers.put(key, value);
      }
    }
    return new ChannelSpec(name, url, headers);
  }

  private final class MultiViewRoot extends LinearLayout
  {
    MultiViewRoot()
    {
      super(mActivity);
    }

    @Override
    public boolean dispatchKeyEvent(KeyEvent event)
    {
      if (event.getAction() != KeyEvent.ACTION_DOWN)
        return super.dispatchKeyEvent(event);
      final int code = event.getKeyCode();
      if (code == KeyEvent.KEYCODE_BACK || code == KeyEvent.KEYCODE_ESCAPE)
      {
        close();
        return true;
      }
      if (mTiles == null)
        return super.dispatchKeyEvent(event);
      if (code == KeyEvent.KEYCODE_DPAD_LEFT || code == KeyEvent.KEYCODE_DPAD_UP)
      {
        mTiles[0].requestFocus();
        return true;
      }
      if (code == KeyEvent.KEYCODE_DPAD_RIGHT || code == KeyEvent.KEYCODE_DPAD_DOWN)
      {
        mTiles[1].requestFocus();
        return true;
      }
      if (code == KeyEvent.KEYCODE_DPAD_CENTER || code == KeyEvent.KEYCODE_ENTER
          || code == KeyEvent.KEYCODE_NUMPAD_ENTER)
      {
        setAudioTile(mTiles[1].hasFocus() ? 1 : 0);
        return true;
      }
      return super.dispatchKeyEvent(event);
    }
  }

  private final class TileView extends FrameLayout implements TextureView.SurfaceTextureListener,
      View.OnFocusChangeListener, View.OnClickListener
  {
    final int index;
    final ChannelSpec spec;
    final TextureView texture;
    final View border;
    final TextView title;
    final TextView state;
    ExoPlayer player;
    boolean prepared = false;
    boolean audible = false;
    String lastError = "";

    TileView(int index, ChannelSpec spec)
    {
      super(mActivity);
      this.index = index;
      this.spec = spec;
      setFocusable(true);
      setFocusableInTouchMode(true);
      setOnFocusChangeListener(this);
      setOnClickListener(this);
      setBackgroundColor(PANEL);

      texture = new TextureView(mActivity);
      texture.setSurfaceTextureListener(this);
      addView(texture, new FrameLayout.LayoutParams(
          FrameLayout.LayoutParams.MATCH_PARENT,
          FrameLayout.LayoutParams.MATCH_PARENT));

      title = text(spec.name, Color.WHITE, 15, Gravity.CENTER_VERTICAL);
      title.setPadding(dp(14), 0, dp(120), 0);
      title.setBackgroundColor(Color.argb(180, 0, 0, 0));
      addView(title, new FrameLayout.LayoutParams(
          FrameLayout.LayoutParams.MATCH_PARENT, dp(44), Gravity.BOTTOM));

      state = text("CONNECTING", MUTED, 12, Gravity.CENTER);
      state.setBackgroundColor(Color.argb(185, 0, 0, 0));
      final FrameLayout.LayoutParams stateParams = new FrameLayout.LayoutParams(
          dp(132), dp(36), Gravity.TOP | Gravity.RIGHT);
      stateParams.setMargins(0, dp(12), dp(12), 0);
      addView(state, stateParams);

      border = new View(mActivity);
      border.setClickable(false);
      border.setFocusable(false);
      addView(border, new FrameLayout.LayoutParams(
          FrameLayout.LayoutParams.MATCH_PARENT,
          FrameLayout.LayoutParams.MATCH_PARENT));
      updateChrome();
    }

    void updateChrome()
    {
      final GradientDrawable drawable = new GradientDrawable();
      drawable.setColor(Color.TRANSPARENT);
      final int color = hasFocus() ? Color.WHITE : (audible ? ACCENT : Color.argb(120, 80, 100, 110));
      drawable.setStroke(dp(audible || hasFocus() ? 3 : 1), color);
      drawable.setCornerRadius(dp(12));
      border.setBackground(drawable);
      if (prepared)
        state.setText(audible ? "AUDIO  •  LIVE" : "LIVE");
      else if (!lastError.isEmpty())
        state.setText(lastError);
      state.setTextColor(lastError.isEmpty() ? (audible ? ACCENT : MUTED) : ERROR);
    }

    void setAudible(boolean value)
    {
      audible = value;
      if (player != null)
      {
        try
        {
          player.setVolume(value ? 1.0f : 0.0f);
        }
        catch (Exception ignored)
        {
        }
      }
    }

    void startPlayer()
    {
      release();
      prepared = false;
      lastError = "";
      state.setText("CONNECTING");
      state.setTextColor(MUTED);
      try
      {
        final DefaultHttpDataSource.Factory httpFactory = new DefaultHttpDataSource.Factory()
            .setAllowCrossProtocolRedirects(true)
            .setConnectTimeoutMs(15000)
            .setReadTimeoutMs(20000);
        final HashMap<String, String> headers = new HashMap<>(spec.headers);
        if (!headers.containsKey("User-Agent") && !headers.containsKey("user-agent"))
          headers.put("User-Agent", "Infinity Live TV/1.0");
        httpFactory.setDefaultRequestProperties(headers);
        final DefaultDataSource.Factory dataSourceFactory = new DefaultDataSource.Factory(mActivity, httpFactory);
        final DefaultMediaSourceFactory mediaSourceFactory = new DefaultMediaSourceFactory(dataSourceFactory);
        final DefaultRenderersFactory renderersFactory = new DefaultRenderersFactory(mActivity)
            .setEnableDecoderFallback(true);

        player = new ExoPlayer.Builder(mActivity, renderersFactory)
            .setMediaSourceFactory(mediaSourceFactory)
            .build();
        player.setAudioAttributes(
            new androidx.media3.common.AudioAttributes.Builder()
                .setUsage(C.USAGE_MEDIA)
                .setContentType(C.AUDIO_CONTENT_TYPE_MOVIE)
                .build(),
            false);
        player.setRepeatMode(Player.REPEAT_MODE_OFF);
        player.setVideoTextureView(texture);
        player.addListener(new Player.Listener()
        {
          @Override
          public void onPlaybackStateChanged(int playbackState)
          {
            if (playbackState == Player.STATE_BUFFERING)
            {
              state.setText("BUFFERING");
              state.setTextColor(MUTED);
            }
            else if (playbackState == Player.STATE_READY)
            {
              prepared = true;
              lastError = "";
              setAudible(index == mAudioTile);
              updateChrome();
            }
            else if (playbackState == Player.STATE_ENDED)
            {
              prepared = false;
              state.setText("ENDED");
              state.setTextColor(MUTED);
            }
          }

          @Override
          public void onPlayerError(PlaybackException error)
          {
            prepared = false;
            lastError = String.format(Locale.US, "VIDEO ERROR %d", error.errorCode);
            updateChrome();
          }
        });

        final MediaItem.Builder item = new MediaItem.Builder().setUri(Uri.parse(spec.url));
        final String mime = mimeType(spec.url);
        if (mime != null)
          item.setMimeType(mime);
        player.setMediaItem(item.build());
        player.setVolume(index == mAudioTile ? 1.0f : 0.0f);
        player.prepare();
        player.play();
      }
      catch (Exception exc)
      {
        prepared = false;
        lastError = "VIDEO ERROR";
        updateChrome();
      }
    }

    String mimeType(String url)
    {
      final String lower = url.toLowerCase(Locale.US);
      if (lower.contains(".m3u8"))
        return "application/x-mpegURL";
      if (lower.contains(".ts") || lower.contains(".mpegts"))
        return "video/mp2t";
      return null;
    }

    void release()
    {
      prepared = false;
      if (player != null)
      {
        try
        {
          player.clearVideoTextureView(texture);
        }
        catch (Exception ignored)
        {
        }
        try
        {
          player.stop();
        }
        catch (Exception ignored)
        {
        }
        try
        {
          player.release();
        }
        catch (Exception ignored)
        {
        }
      }
      player = null;
    }

    @Override
    public void onSurfaceTextureAvailable(SurfaceTexture surfaceTexture, int width, int height)
    {
      startPlayer();
    }

    @Override
    public void onSurfaceTextureSizeChanged(SurfaceTexture surfaceTexture, int width, int height)
    {
    }

    @Override
    public boolean onSurfaceTextureDestroyed(SurfaceTexture surfaceTexture)
    {
      release();
      return true;
    }

    @Override
    public void onSurfaceTextureUpdated(SurfaceTexture surfaceTexture)
    {
    }

    @Override
    public void onFocusChange(View view, boolean hasFocus)
    {
      updateChrome();
    }

    @Override
    public void onClick(View view)
    {
      requestFocus();
      setAudioTile(index);
    }
  }

  private static final class ChannelSpec
  {
    final String name;
    final String url;
    final Map<String, String> headers;

    ChannelSpec(String name, String url, Map<String, String> headers)
    {
      this.name = name;
      this.url = url;
      this.headers = headers;
    }
  }

  private static final class Request
  {
    final ChannelSpec[] channels;
    final int audioTile;

    Request(ChannelSpec[] channels, int audioTile)
    {
      this.channels = channels;
      this.audioTile = audioTile;
    }
  }
}
