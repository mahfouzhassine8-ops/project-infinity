  private final class CobraDirectoryRow extends LinearLayout{
    final TextView name=cobraModeLabel(14,true),count=cobraModeLabel(11,false);
    CobraDirectoryRow(){super(InfinityLiveActivity.this);setOrientation(HORIZONTAL);setGravity(Gravity.CENTER_VERTICAL);setPadding(dp(12),0,dp(12),0);addView(name,new LinearLayout.LayoutParams(0,-1,1));count.setGravity(Gravity.RIGHT|Gravity.CENTER_VERTICAL);LinearLayout.LayoutParams p=new LinearLayout.LayoutParams(-2,-1);p.leftMargin=dp(6);addView(count,p);setFocusable(true);setFocusableInTouchMode(false);setClickable(true);}
    void bind(String label,String total,boolean active){name.setText(label);count.setText(total);name.setTextColor(cobraModeColor("text"));count.setTextColor(cobraModeColor("muted"));setBackground(cobraModeSurface("grid".equals(mCobraGuideStyle)?3:12,false));setSelected(active);setContentDescription(label+(total.isEmpty()?"":", "+total));setLayoutParams(new android.widget.AbsListView.LayoutParams(-1,dp(Math.round(50+18*Math.max(0,getResources().getConfiguration().fontScale-1)))));}
  }
  private final class CobraGuideRuler extends View{
    final android.graphics.Paint paint=new android.graphics.Paint(3);
    CobraGuideRuler(){super(InfinityLiveActivity.this);setContentDescription("TV guide time ruler. Tap to return to now.");setOnClickListener(v->cobraMoveGuideTime(0));}
    @Override protected void onDraw(android.graphics.Canvas canvas){
      if(mCobraModeLayout==null)return;int cw=dp(mCobraModeLayout.channelWidth),w=getWidth();long span=mCobraModeLayout.timeSpan;
      paint.setColor(cobraModeColor("rail"));canvas.drawRect(0,0,w,getHeight(),paint);paint.setColor(cobraModeColor("muted"));paint.setTypeface(Typeface.create("sans-serif-medium",0));paint.setTextSize(10*getResources().getDisplayMetrics().scaledDensity);paint.setTextAlign(android.graphics.Paint.Align.LEFT);int labelClip=canvas.save();canvas.clipRect(0,0,cw,getHeight());canvas.drawText("CHANNEL",dp(8),getHeight()-dp(10),paint);canvas.restoreToCount(labelClip);
      int saved=canvas.save();canvas.clipRect(cw,0,w,getHeight());for(long t=mCobraGuideWindow;t<=mCobraGuideWindow+span;t+=1800000L){float x=cw+(w-cw)*(t-mCobraGuideWindow)/(float)span;paint.setColor(cobraModeColor("muted"));canvas.drawText(formatTime(t),x+dp(5),getHeight()-dp(10),paint);paint.setColor(cobraModeColor("line"));canvas.drawLine(x,getHeight()-dp(5),x,getHeight(),paint);}
      long now=System.currentTimeMillis();if(now>=mCobraGuideWindow&&now<=mCobraGuideWindow+span){float x=cw+(w-cw)*(now-mCobraGuideWindow)/(float)span;paint.setColor(cobraModeColor("accent"));canvas.drawCircle(x,getHeight()-dp(3),dp(3),paint);}canvas.restoreToCount(saved);
    }
  }
  private final class CobraBroadcastRow extends FrameLayout{
    Channel channel;final Button title;final ArrayList<Button> cells=new ArrayList<>();final ArrayList<float[]> ranges=new ArrayList<>();int used=0,labelWidth;float downX,downY;boolean swiping;
    final android.graphics.Paint paint=new android.graphics.Paint(3);
    CobraBroadcastRow(){super(InfinityLiveActivity.this);title=cobraTextButton("",cobraModeDark(),()->{});title.setGravity(Gravity.LEFT|Gravity.CENTER_VERTICAL);title.setPadding(dp(8),dp(2),dp(6),dp(2));title.setMaxLines(2);title.setTextSize(12);addView(title);setDescendantFocusability(android.view.ViewGroup.FOCUS_AFTER_DESCENDANTS);}
    void bind(Channel c,int position){
      channel=c;setLayoutParams(new android.widget.AbsListView.LayoutParams(-1,cobraModeRowHeight("grid")));title.setText(String.format(Locale.US,"%03d  ",position+1)+c.name);title.setTag("cobra-channel:"+c.id);title.setTextColor(cobraModeColor("text"));title.setBackground(cobraModeSurface(3,true));title.setSelected(cobraModeSelected(c));title.setOnClickListener(v->selectGuidePreview(c));title.setOnLongClickListener(v->{showCobraChannelActions(c);return true;});title.setOnFocusChangeListener((v,focus)->{if(focus)cobraInspectProgramme(c,null);});
      title.setOnKeyListener((v,key,event)->{if(event.getAction()!=KeyEvent.ACTION_DOWN)return false;if(key==KeyEvent.KEYCODE_DPAD_LEFT){mCobraModeGroupsExpanded=true;mCobraGuideRoute="categories";cobraLayoutGuide();cobraRenderGuideBrowser();(mCobraGuideDirectory.getVisibility()==View.VISIBLE?mCobraGuideDirectory:mCobraGuideBrowser).requestFocus();return true;}return false;});
      used=0;ranges.clear();ArrayList<GuideProgram> programmes=cobraPrograms(c);long span=mCobraModeLayout.timeSpan;
      if(programmes!=null)for(GuideProgram p:programmes){float[] r=CobraGuideMath.interval(p.start,p.stop,mCobraGuideWindow,span);if(r==null)continue;if(used>=64)break;Button cell=obtainCell(used);final int index=used;cell.setText(p.title);cell.setContentDescription(c.name+", "+p.title+", "+formatTime(p.start)+" to "+formatTime(p.stop));cell.setTag("cobra-program:"+c.id+":"+p.start);cell.setSelected(cobraModeSelected(c)&&p.start<=System.currentTimeMillis()&&p.stop>System.currentTimeMillis());cell.setOnClickListener(v->{if(p.start<=System.currentTimeMillis()&&p.stop>System.currentTimeMillis()){mCobraInspectedChannel=null;mCobraInspectedProgram=null;selectGuidePreview(c);}else showProgramActions(c,p);});cell.setOnLongClickListener(v->{showProgramActions(c,p);return true;});cell.setOnFocusChangeListener((v,focus)->{if(focus)cobraInspectProgramme(c,p);});cell.setOnKeyListener((v,key,event)->{if(event.getAction()!=KeyEvent.ACTION_DOWN)return false;if(key==KeyEvent.KEYCODE_DPAD_LEFT&&index==0){title.requestFocus();return true;}if(key==KeyEvent.KEYCODE_DPAD_RIGHT&&index==used-1){cobraMoveGuideTime(1);return true;}return false;});ranges.add(r);used++;}
      if(used==0){Button empty=obtainCell(0);empty.setText(cobraGuideStatus(c));empty.setSelected(false);empty.setTag("cobra-gap:"+c.id);empty.setContentDescription(c.name+", "+cobraGuideStatus(c)+", tap to preview or hold for schedule");empty.setOnClickListener(v->selectGuidePreview(c));empty.setOnLongClickListener(v->{showProgramGuide(c);return true;});empty.setOnFocusChangeListener((v,focus)->{if(focus)cobraInspectProgramme(c,null);});empty.setOnKeyListener(null);ranges.add(new float[]{0,1});used=1;}
      for(int i=used;i<cells.size();i++)cells.get(i).setVisibility(View.GONE);requestLayout();invalidate();
    }
    Button obtainCell(int index){if(index>=cells.size()){Button b=cobraTextButton("",cobraModeDark(),()->{});b.setGravity(Gravity.LEFT|Gravity.CENTER_VERTICAL);b.setMaxLines(2);b.setEllipsize(android.text.TextUtils.TruncateAt.END);b.setTextSize(12);b.setPadding(dp(8),dp(3),dp(6),dp(3));cells.add(b);addView(b);}Button b=cells.get(index);b.setBackground(cobraModeSurface(3,true));b.setTextColor(cobraModeColor("text"));b.setVisibility(View.VISIBLE);return b;}
    @Override protected void onMeasure(int ws,int hs){int w=View.MeasureSpec.getSize(ws),h=cobraModeRowHeight("grid");labelWidth=Math.min(w,dp(mCobraModeLayout==null?106:mCobraModeLayout.channelWidth));setMeasuredDimension(w,h);title.measure(View.MeasureSpec.makeMeasureSpec(Math.max(1,labelWidth-dp(2)),View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(h-dp(2),View.MeasureSpec.EXACTLY));for(int i=0;i<used;i++){float[] r=ranges.get(i);int width=Math.max(1,Math.round((w-labelWidth)*(r[1]-r[0]))-dp(2));cells.get(i).measure(View.MeasureSpec.makeMeasureSpec(width,View.MeasureSpec.EXACTLY),View.MeasureSpec.makeMeasureSpec(h-dp(2),View.MeasureSpec.EXACTLY));}}
    @Override protected void onLayout(boolean changed,int l,int t,int r,int b){title.layout(0,0,title.getMeasuredWidth(),title.getMeasuredHeight());for(int i=0;i<used;i++){View v=cells.get(i);float[] bounds=ranges.get(i);int x=labelWidth+Math.round((getWidth()-labelWidth)*bounds[0]);v.layout(x,0,x+v.getMeasuredWidth(),v.getMeasuredHeight());}}
    @Override protected void dispatchDraw(android.graphics.Canvas c){super.dispatchDraw(c);if(mCobraModeLayout==null)return;long span=mCobraModeLayout.timeSpan,now=System.currentTimeMillis();if(now>=mCobraGuideWindow&&now<mCobraGuideWindow+span){float x=labelWidth+(getWidth()-labelWidth)*(now-mCobraGuideWindow)/(float)span;paint.setColor(cobraModeColor("accent"));paint.setStrokeWidth(dp(1));c.drawLine(x,0,x,getHeight(),paint);}if(channel!=null&&cobraModeSelected(channel)){paint.setColor(cobraModeColor("accent"));c.drawRect(0,0,dp(3),getHeight()-dp(2),paint);}}
    @Override public boolean onInterceptTouchEvent(android.view.MotionEvent e){if(e.getActionMasked()==android.view.MotionEvent.ACTION_DOWN){downX=e.getX();downY=e.getY();swiping=false;}else if(e.getActionMasked()==android.view.MotionEvent.ACTION_MOVE){float dx=e.getX()-downX,dy=e.getY()-downY;if(Math.abs(dx)>dp(24)&&Math.abs(dx)>Math.abs(dy)*2){swiping=true;getParent().requestDisallowInterceptTouchEvent(true);return true;}}return false;}
    @Override public boolean onTouchEvent(android.view.MotionEvent e){if(!swiping)return super.onTouchEvent(e);if(e.getActionMasked()==android.view.MotionEvent.ACTION_UP){float dx=e.getX()-downX;swiping=false;if(Math.abs(dx)>dp(48))cobraMoveGuideTime(dx<0?1:-1);getParent().requestDisallowInterceptTouchEvent(false);}else if(e.getActionMasked()==android.view.MotionEvent.ACTION_CANCEL){swiping=false;getParent().requestDisallowInterceptTouchEvent(false);}return true;}
  }
